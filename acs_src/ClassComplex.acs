script "Complex_Decorate" (int type, int arg1, int arg2)
{
    int result;

    switch (type)
    {
      case 1:
        if (CheckInventory("SamsaraReloadMode") >= 2 && CheckInventory("SamsaraHasInfiniteAmmo") <= 1) { SetInventory("SamsaraDoomguyComSSGAlternate", CheckInventory("ComplexDoom_SSGShell") % 2); }
        else
        {
            if (arg1 > 0) { SetInventory("SamsaraDoomguyComSSGAlternate", !CheckInventory("SamsaraDoomguyComSSGAlternate")); }
        }
        break;
    }
}