str SharkyHealthArmorStrings[8][2] =
{
	{ "What, got yourself a papercut? Don't you worry.", "This will heal a cut or bruise, but you may want more." },
	{ "Stimpack, okay.", "Not a bad choice, a stimpack." },
	{ "Ah, those medkits'll get you through some scrapes, huh?", "Hey, if you're really hurtin', that thing'll do you some good, huh?" },
	{ "Soulspheres are the best health item I sell.", "This will do more than I heal ya up." },
