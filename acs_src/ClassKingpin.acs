function void KingpinDisplayDialogue(int arg1, int arg2, int arg3, int arg4)
{
	str text = "";
	int price = 0;
	switch(arg1)
	{
		default:
			text = "Hey, welcome to Pawn-O-Matic, huh?";
			break;
		case 1:
			text = strparam(s:"\c[KPPawnOMaticWhite]", s:pawnOMaticUpgradeDialogue[arg2][arg3][arg4], s:" That will be \c[KPPawnOMaticRed]",d:pawnOMaticUpgradePrices[arg2][arg3], s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticUpgradePrices[arg2][arg3] > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase)");
			break;
		case 2:
			text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyRandomWeapons[arg3], s:" That will be \c[KPPawnOMaticRed]",d:pawnOMaticItemPrices[0][arg2], s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticItemPrices[0][arg2] > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase)");
			break;
		case 3: 
			if(pawnOMaticItemBulkBuy[arg1-3][arg2-1] == 0)
				text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyAmmoStrings[arg2-1][arg3], s:" That will be \c[KPPawnOMaticRed]",d:pawnOMaticItemPrices[1][arg2], s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticItemPrices[1][arg2] > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase)");
			else
			{
				if(arg4 > 0)
					text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyAmmoStrings[arg2-1][arg3], s:" You want \c[KPPawnOMaticRed]",d:arg4, s:"\c[KPPawnOMaticWhite]? That will be \c[KPPawnOMaticRed]", d:pawnOMaticItemPrices[1][arg2]*arg4, s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticItemPrices[1][arg2]*arg4 > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase - Use movement keys to adjust amount)");
				else
					text = strparam(s:"\c[KPPawnOMaticRed](Activate again to cancel)");
			}
			break;
		case 4:
			if(pawnOMaticItemBulkBuy[arg1-3][arg2-1] == 0)
				text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyHealthArmorStrings[arg2-1][arg3], s:" That will be \c[KPPawnOMaticRed]",d:pawnOMaticItemPrices[2][arg2], s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticItemPrices[2][arg2] > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase)");
			else
			{
				if(arg4 > 0)
					text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyHealthArmorStrings[arg2-1][arg3], s:" You want \c[KPPawnOMaticRed]",d:arg4, s:"\c[KPPawnOMaticWhite]? That will be \c[KPPawnOMaticRed]", d:pawnOMaticItemPrices[2][arg2]*arg4, s:"\c[KPPawnOMaticWhite] dollar", s:pawnOMaticItemPrices[2][arg2]*arg4 > 1 ? "s" : "", s:".", s:"\n\n\c[KPPawnOMaticRed](Activate again to purchase - Use movement keys to adjust amount)");
				else
					text = strparam(s:"\c[KPPawnOMaticRed](Activate again to cancel)");
			}
			break;
		case 9:
			text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkySoldNoBuy[arg2][arg3]);
			break;
		case 10:
			text = strparam(s:"\c[KPPawnOMaticWhite]", s:SharkyDenied[arg2][arg3]);
			break;
	}
	Setfont("KPFONTBG");
	SetHudSize(1800,1200,1);
	SetHudClipRect(200,1012,1400,140,1400);
	HudMessage(s:text;HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP|HUDMSG_COLORSTRING,62,CR_UNTRANSLATED,200.1,1012.1,0.0);
	SetHudClipRect(0,0,0,0,0);
	SetHudSize(1200,800,1);
}

Script "Kingpin_PawnOMatic" (int playerNum, int sTid) Net
{
	int breakloop;
	int pawnOpen;
	int cigarAnimator;
	int lastInputTimer;
	int scrollingItem;
	int intendedItem = 1;
	int maxInputDelay = 4;
	int scrollersCounter = 20;
	//Big menu items, on the left
	int currentMenu = 1;
	int currentMenuItem = 0;
	int lastMenu = 1;
	//Sub menu related variables
	int currentUpgradeMenu = 0;
	int triggerUpgradeMenu;
	//Item related variables
	int currentItem = 0;
	int selectedItemOpen;
	int triggerItems;
	int modSelected;
	int bulkCounter = 1;
	int welcomeMessage = true;
	int messageDialog = 0;
	//Variables related to bulk buying
	int maxBulkBuy, itemLimit;
	while(CheckInventory("Kingpin_PawnOMaticOpen"))
	{
		//Draw the default stuff for pawn-o-matic. Also, get input
		int playerInputX = GetPlayerInput(-1,INPUT_SIDEMOVE);
		int playerInputY = -GetPlayerInput(-1,INPUT_FORWARDMOVE);
		int buttons = GetPlayerInput(-1,INPUT_BUTTONS);
		int oldbuttons = GetPlayerInput(-1,INPUT_OLDBUTTONS);
		int useKey = (buttons & BT_USE) && !(oldbuttons & BT_USE);
		cigarAnimator = ((timer()%116)/2)+1;
		SetFont("KPSTORE");
		SetHudSize(1200,800,1);
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,61,CR_UNTRANSLATED,600.0,400.0,0.0);
		SetFont(strparam(s:"KPCIGR",s:cigarAnimator < 10 ? "0" : "",d:cigarAnimator));
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,60,CR_UNTRANSLATED,576.0,480.0,0.0);
		SetFont("KPLITOFF");
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,59,CR_UNTRANSLATED,600.0,400.0,0.0);
		//Only display the text if it's 0. It will never do this until reopened
		if(welcomeMessage == true) KingpinDisplayDialogue(0,0,0,0);
		SetFont("KPDIALOG");
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP|HUDMSG_ALPHA,63,CR_UNTRANSLATED,600.0,420.0,0.0,0.67);
		//Bulk ammo/health buying
		
		//Check for the input delay and if items are currently scrolling
		if(lastInputTimer >= maxInputDelay && !scrollingItem)
		{	
			if(modSelected && currentMenu > 2 && pawnOMaticItemBulkBuy[currentMenu-3][currentMenuItem-1])
			{
				//Update the display
				KingpinDisplayDialogue(currentMenu,currentMenuItem,messageDialog,pawnOMaticItemBulkBuy[currentMenu-3][currentMenuItem-1] > 0 ? bulkCounter : 0);
				//Check ammo
				if(currentMenu == 3)
				{
					itemLimit = GetAmmoCapacity(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0]);
					maxBulkBuy = itemLimit - CheckInventory(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0]);
				}
				else if(currentMenu == 4)
				{
					//Check health
					if(pawnOMaticItemBulkBuy[currentMenu-3][currentMenuItem-1] == 1)
					{
						itemLimit = ACS_NamedExecuteWithResult("SamsaraPlayerHealer", -1, 200);
						maxBulkBuy = itemLimit - GetActorProperty(0,APROP_Health);
					}
					//Check armor
					else if(pawnOMaticItemBulkBuy[currentMenu-3][currentMenuItem-1] == 2)
					{
						itemLimit = ACS_NamedExecuteWithResult("SamsaraArmorCapResultChecker", 0, 0);
						maxBulkBuy = itemLimit - CheckInventory("BasicArmor");
					}
				}
				//Constrain financially
				maxBulkBuy = min(maxBulkBuy,CheckInventory("Kingpin_Cash")/pawnOMaticItemPrices[currentMenu-2][currentMenuItem]);
				
				//Clamp the value here
				if(bulkCounter > maxBulkBuy)
				{
					bulkCounter = maxBulkBuy;
					//Cancel transaction if out of money
					if(maxBulkBuy == 0)
					{
						modSelected = 0;
						messageDialog = random(0,1);
						KingpinDisplayDialogue(10,0,messageDialog,0);
						welcomeMessage = false;
						PlaySound(sTid,StrParam(s:"PawnOMatic/LowCash",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
						bulkCounter = -1;
					}
				}
	
				//Alter bulk counter depending on input
				if(playerInputX != 0 || playerInputY != 0)
				{
					if(playerInputX > 0)
					{
						bulkCounter++;
						if(bulkCounter > maxBulkBuy)
							bulkCounter = 0;
					}
					else if(playerInputX < 0)
					{
						bulkCounter--;
						if(bulkCounter < 0)
							bulkCounter = maxBulkBuy;
					}
					else if(playerInputY < 0)
					{
						bulkCounter+=10;
						if(bulkCounter > maxBulkBuy)
							bulkCounter = 0;
					}
					else if(playerInputY > 0)
					{
						bulkCounter-=10;
						if(bulkCounter < 0)
							bulkCounter = maxBulkBuy;
					}
					
					//Reset the input timer
					lastInputTimer = 0;
				}
			}
			//If Up-Down input...
			else if(playerInputY != 0)
			{
				//This will scroll up and down on the main list
				if(!triggerItems && !triggerUpgradeMenu)
				{
					PlaySound(sTid,"PawnOMatic/Selection",CHAN_5,1.0,0,ATTN_NONE);
					if(playerInputY > 0) currentMenu++;
					else if(playerInputY < 0) currentMenu--;		
					
					//Clamp main menu values
					if(currentMenu < 1) currentMenu = 8;
					else if(currentMenu > 8) currentMenu = 1;
					else if(currentMenu == 5) currentMenu = 8;
					else if(currentMenu == 7) currentMenu = 4;
				}
				//That assumes the upgrade menu is open. If so, do this
				else if(!triggerItems)
				{
					PlaySound(sTid,"PawnOMatic/Selection",CHAN_5,1.0,0,ATTN_NONE);
					if(playerInputY > 0) currentUpgradeMenu++;
					else if(playerInputY < 0) currentUpgradeMenu--;	
					
					if(currentUpgradeMenu < 1) currentUpgradeMenu = 7;
					else if(currentUpgradeMenu > 7) currentUpgradeMenu = 1;
				}
				//You must be in the items menu, then
				else
				{
					PlaySound(sTid,"PawnOMatic/Selection",CHAN_5,1.0,0,ATTN_NONE);
					if(playerInputY > 0) currentMenuItem++;
					else if(playerInputY < 0) currentMenuItem--;
					
					//We use the fixed 4 if this is the upgrades menu
					if(currentMenu == 1)
					{
						if(currentMenuItem < 1) currentMenuItem = 4;
						if(currentMenuItem > 4) currentMenuItem = 1;
					}
					//Otherwise, we get dynamic values
					else
					{
						//WTF? Why -2?
						if(currentMenuItem < 1) currentMenuItem = pawnOMaticItemPrices[currentMenu-2][0];
						if(currentMenuItem > pawnOMaticItemPrices[currentMenu-2][0]) currentMenuItem = 1;
					}
				}	
				//Reset input timer
				lastInputTimer = 0;
				
				//Queue "no thanks" if an item was selected
				if(modSelected > 0)
				{
					modSelected = 0;
					messageDialog = random(0,2);
					KingpinDisplayDialogue(9,1,messageDialog,0);
					welcomeMessage = false;
					PlaySound(sTid,StrParam(s:"PawnOMatic/NoThanks",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
				}
			}	
			//If the upgrade menu isn't open, then we must handle the menu items
			else if(!triggerUpgradeMenu && (playerInputX != 0 || useKey && currentMenuItem == 0))
			{
				PlaySound(sTid,"PawnOMatic/Selection",CHAN_5,1.0,0,ATTN_NONE);
					
				//Behavior is different, depending on what menu to pick
				if(currentMenu > 1)
				{
					//Moving to the right or use key activates this
					if((playerInputX > 0 || useKey) && !triggerItems)
					{
						//Exit here
						if(currentMenu == 8) 
						{
							TakeInventory("Kingpin_PawnOMaticOpen",1);
							SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
							break;
						}		
						
						//Switch to items menu
						triggerItems = true;	
						
						//Set the selected menu to the current menu index
						selectedItemOpen = currentMenu;	
						
						//Flip the intended item index to the one needed, so it will scroll
						intendedItem = 1+(4*currentMenu);
							if(intendedItem >= 20)
								intendedItem = 1;
								
						//Tell it to scroll the items menu
						scrollingItem = true;
						
						//Set the default menu item index
						currentMenuItem = 1;
						
						//Force the panels to go to their starting point
						currentItem = 1;
					}	
					//Moving to the left will go back to input of the main menu to the left
					else if(playerInputX < 0)
					{
						triggerItems = false;
						selectedItemOpen = 0;	
						intendedItem = 1;	
						scrollingItem = true;			
						currentMenuItem = 0;
					}
				}
				//This is the upgrade menu
				else if(currentMenu == 1)
				{
					if((playerInputX > 0 || useKey) && !triggerItems)
					{
						triggerItems = false;		
						triggerUpgradeMenu = true;
						currentItem = 1;
						
						//Flip the intended item index to the one needed, so it will scroll
						intendedItem = 1+(4*currentMenu);
							if(intendedItem >= 32)
								intendedItem = 1;
								
						//Tell it to scroll the items menu
						scrollingItem = true;
						
						//Set the default upgrade item index
						currentUpgradeMenu = 1;
						currentMenuItem = 0;
					}
					else if(playerInputX < 0 && triggerItems)
					{
						triggerUpgradeMenu = true;
						triggerItems = false;
						selectedItemOpen = 0;	
						
						//Set the item to scroll back to
						intendedItem = 1+(4*currentMenu);
						
						//Force the item to scroll
						currentItem = 1;
						scrollingItem = true;			
						currentMenuItem = 0;
					}				
				}
				
				//Reset input timer
				lastInputTimer = 0;
				PlaySound(sTid,"PawnOMatic/Scrollers",CHAN_6,1.0,1,ATTN_NONE);
				
				//Queue "no thanks" if an item was selected
				if(modSelected > 0)
				{
					modSelected = 0;
					messageDialog = random(0,2);
					KingpinDisplayDialogue(9,1,messageDialog,0);
					welcomeMessage = false;
					PlaySound(sTid,StrParam(s:"PawnOMatic/NoThanks",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
				}
			}
			//Otherwise, do this stuff if the upgrade menu is open
			else if(triggerUpgradeMenu && (playerInputX != 0 || useKey))
			{
				PlaySound(sTid,"PawnOMatic/Selection",CHAN_5,1.0,0,ATTN_NONE);
				if((playerInputX > 0 || useKey) && !triggerItems)
				{
					//Switch to modifications menu
					triggerItems = true;	
					triggerUpgradeMenu = false;
					
					//Set the selected menu to the current menu index
					selectedItemOpen = currentUpgradeMenu;	
					
					//Flip the intended item index to the one needed, so it will scroll
					intendedItem = 1+(4*currentUpgradeMenu);
						if(intendedItem >= 32)
							intendedItem = 1;
												
					//Force the panels to go to their starting point
					currentItem = 1;
					
					//Tell it to scroll the items menu
					scrollingItem = true;
					
					//Set the default menu item index
					currentMenuItem = 1;
				}
				//Moving to the left will go back to input of the main menu to the left
				else if(playerInputX < 0)
				{
					triggerItems = false;
					triggerUpgradeMenu = false;
					selectedItemOpen = 0;	
					intendedItem = 1;	
					scrollingItem = true;			
					currentMenuItem = 0;
					currentUpgradeMenu = 0;
				}
				
				//Reset input timer
				lastInputTimer = 0;
				PlaySound(sTid,"PawnOMatic/Scrollers",CHAN_6,1.0,1,ATTN_NONE);
			}
		}
		
		//Update the scrollers counter value
		scrollersCounter = (triggerItems && currentMenu == 1) ? 32 : 20;
		//Flip scroller things
		if(currentItem != intendedItem)
		{
			if(timer()%2 == 0)
			{
				currentItem++;
				if(currentItem >= scrollersCounter)
					currentItem = 1;
			}
		}
		else
		{
			scrollingItem = 0;
			StopSound(sTid,CHAN_6);
		}
		
		if(triggerItems && currentMenu == 1)
		{
			SetFont(strparam(s:"KPITEM",s:currentItem < 10 ? "0" : "",d:currentItem));
			HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,56,CR_UNTRANSLATED,600.0,400.0,0.0);
		}
		else
		{
			SetFont(strparam(s:"KPITM2",s:currentItem < 10 ? "0" : "",d:currentItem));
			HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,56,CR_UNTRANSLATED,600.0,400.0,0.0);	
		}
		
		//Draw the selected item next to price
		if(triggerItems && currentMenu == 1)
			SetFont(strparam(s:"KPSELE",d:currentItem));
		else
			SetFont(strparam(s:"KPSEL2",d:currentItem));
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,55,CR_UNTRANSLATED,600.0,400.0,0.0);
		
		SetFont(strparam(s:"KPSTLT1",d:currentMenu));
		HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,58,CR_UNTRANSLATED,600.0,400.0,0.0);
		
		if(currentMenuItem > 0 || currentUpgradeMenu > 0)
		{
			if(currentUpgradeMenu > 0 && currentMenuItem == 0)
			{
				SetFont(strparam(s:"KPSTLT2",d:currentUpgradeMenu));
				HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,57,CR_UNTRANSLATED,600.0,400.0,0.0);
			}
			else
			{
				SetFont(strparam(s:"KPSTLT2",d:currentMenuItem));
				HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,57,CR_UNTRANSLATED,600.0,400.0,0.0);
			}
			
			if(triggerItems)
			{
				if(currentMenu == 1)
				{
					SetFont(strparam(s:"KPDIGT",d:(pawnOMaticUpgradePrices[currentUpgradeMenu-1][currentMenuItem-1]/100)%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,54,CR_UNTRANSLATED,574.0,400.0,0.0);
				
					SetFont(strparam(s:"KPDIGT",d:(pawnOMaticUpgradePrices[currentUpgradeMenu-1][currentMenuItem-1]/10)%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,53,CR_UNTRANSLATED,600.0,400.0,0.0);
					
					SetFont(strparam(s:"KPDIGT",d:pawnOMaticUpgradePrices[currentUpgradeMenu-1][currentMenuItem-1]%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,52,CR_UNTRANSLATED,626.0,400.0,0.0);
				}
				else
				{
					SetFont(strparam(s:"KPDIGT",d:(pawnOMaticItemPrices[currentMenu-2][currentMenuItem]/100)%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,54,CR_UNTRANSLATED,574.0,400.0,0.0);
				
					SetFont(strparam(s:"KPDIGT",d:(pawnOMaticItemPrices[currentMenu-2][currentMenuItem]/10)%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,53,CR_UNTRANSLATED,600.0,400.0,0.0);
					
					SetFont(strparam(s:"KPDIGT",d:pawnOMaticItemPrices[currentMenu-2][currentMenuItem]%10));
					HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,52,CR_UNTRANSLATED,626.0,400.0,0.0);
				}
			}
			//Remove digits
			else RemoveMessages(52,54);
						
			//Buying weapon upgrades
			if(lastInputTimer >= maxInputDelay && !scrollingItem && useKey)
			{
				//Purchase weapon upgrades
				if(currentMenu == 1 && currentMenuItem < 5)
				{
					lastInputTimer = 0;
					if(!CheckInventory(KingpinWeapons[currentUpgradeMenu][0]))
					{
						messageDialog = random(0,1);
						KingpinDisplayDialogue(10,1,messageDialog,0);
						welcomeMessage = false;
						PlaySound(sTid,StrParam(s:"PawnOMatic/NoWeapon",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
					}
					else if(CheckInventory(pawnOMaticUpgradeOptions[currentUpgradeMenu-1][currentMenuItem-1][0]))
					{
						messageDialog = random(0,1);
						KingpinDisplayDialogue(10,2,messageDialog,0);
						welcomeMessage = false;
						PlaySound(sTid,StrParam(s:"PawnOMatic/AlreadyHave",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
					}
					else if(CheckInventory("Kingpin_Cash") < pawnOMaticUpgradePrices[currentUpgradeMenu-1][currentMenuItem-1])
					{
						messageDialog = random(0,1);
						KingpinDisplayDialogue(10,0,messageDialog,0);
						welcomeMessage = false;
						PlaySound(sTid,StrParam(s:"PawnOMatic/LowCash",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
					}
					else
					{
						lastInputTimer = -4;
						if(modSelected == 0)
						{
							//Play sound for confirmation
							messageDialog = random(0,1);
							KingpinDisplayDialogue(1,currentUpgradeMenu-1,currentMenuItem-1,messageDialog);
							welcomeMessage = false;
							if (StrCmp(pawnOMaticUpgradeOptions[currentUpgradeMenu-1][currentMenuItem-1][1], "")) { PlaySound(sTid,StrParam(s:pawnOMaticUpgradeOptions[currentUpgradeMenu-1][currentMenuItem-1][1],d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE); }
							modSelected = currentUpgradeMenu;
						}
						else
						{
							TakeInventory("Kingpin_Cash",pawnOMaticUpgradePrices[currentUpgradeMenu-1][currentMenuItem-1]);
							GiveInventory(pawnOMaticUpgradeOptions[currentUpgradeMenu-1][currentMenuItem-1][0],1);
							messageDialog = random(0,2);
							KingpinDisplayDialogue(9,0,messageDialog,0);
							welcomeMessage = false;
							PlaySound(sTid,"PawnOMatic/Register",CHAN_5,1.0,0,ATTN_NONE);
							PlaySound(sTid,StrParam(s:"PawnOMatic/Sold",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
							modSelected = 0;
						}
					}
				}
				//Other items
				else
				{
					if(currentMenuItem < pawnOMaticItemPrices[currentMenu-2][0]+1)
					{
						bool hitlimit = false;
						int itemtype = 0;

						if (currentMenu == 2) { hitlimit = CheckInventory(KingpinWeapons[currentMenuItem-1][0]); }
						else if (currentMenu == 3)
						{
							hitlimit = CheckInventory(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0]) >= GetAmmoCapacity(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0]);
							itemtype = 2;
						} else if (currentMenu == 4) {
							if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "HealPack0") || !StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "SuperHealth"))
							{
								hitlimit = GetActorProperty(0, APROP_Health) >= ACS_NamedExecuteWithResult("SamsaraPlayerHealer", -1, 200);
								itemtype = 1;
							} else if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "HealPack1") || !StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "HealPack2")) {
								hitlimit = GetActorProperty(0, APROP_Health) >= ACS_NamedExecuteWithResult("SamsaraPlayerHealer", -1);
								itemtype = 1;
							} else if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "ArmorScrap")) {
								hitlimit = ACS_NamedExecuteWithResult("SamsaraArmorCapCheck", 0, 0, 0, 2);
								itemtype = 2;
							} else if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "ArmorPack1")) {
								hitlimit = ACS_NamedExecuteWithResult("SamsaraArmorCapCheck", 5);
								itemtype = 2;
							} else if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "ArmorPack3")) {
								hitlimit = ACS_NamedExecuteWithResult("SamsaraArmorCapCheck", 7);
								itemtype = 2;
							} else if (!StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0], "MegaPack")) {
								hitlimit = GetActorProperty(0, APROP_Health) >= ACS_NamedExecuteWithResult("SamsaraPlayerHealer", -1, 200) && ACS_NamedExecuteWithResult("SamsaraArmorCapCheck", 11);
								itemtype = 2;
							}
						}

						if(hitlimit)
						{
							switch (itemtype)
							{
								default:
									messageDialog = random(0,1);
									KingpinDisplayDialogue(10,2,messageDialog,0);
									break;

								case 1:
									messageDialog = random(0,3);
									KingpinDisplayDialogue(10,3,messageDialog,0);
									break;

								case 2:
									messageDialog = random(0,1);
									KingpinDisplayDialogue(10,4,messageDialog,0);
									break;
							}
							welcomeMessage = false;
							switch (itemtype)
							{
								default: PlaySound(sTid,StrParam(s:"PawnOMatic/AlreadyHave",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE); break;
								case 1: PlaySound(sTid,StrParam(s:"PawnOMatic/AlreadyHaveHealth",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE); break;
								case 2: PlaySound(sTid,StrParam(s:"PawnOMatic/AlreadyHaveItem",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE); break;
							}
						}
						else if(CheckInventory("Kingpin_Cash") < pawnOMaticItemPrices[currentMenu-2][currentMenuItem])
						{
							messageDialog = random(0,1);
							KingpinDisplayDialogue(10,0,messageDialog,0);
							welcomeMessage = false;
							PlaySound(sTid,StrParam(s:"PawnOMatic/LowCash",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
						}
						else
						{
							lastInputTimer = -4;
							if(modSelected == 0)
							{
								modSelected = currentMenuItem;
								//Purchase weapons
								if(currentMenu == 2)
								{
									messageDialog = random(0,8);
									KingpinDisplayDialogue(2,currentMenuItem,messageDialog,0);
									PlaySound(sTid,StrParam(s:"PawnOMatic/Weapon",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
								}

								//Purchase Ammo, Health and Armor
								else if(currentMenu > 2)
								{
									messageDialog = random(0,1);
									KingpinDisplayDialogue(currentMenu,currentMenuItem,messageDialog,pawnOMaticItemBulkBuy[currentMenu-3][currentMenuItem-1] > 0 ? bulkCounter : 0);
									if (StrCmp(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][1], "")) { PlaySound(sTid,StrParam(s:pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][1],d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE); }
								}
								welcomeMessage = false;
								
								//Set the default bulk counter
								bulkCounter = 1;	
							}
							else
							{
								if(currentMenu > 2)
								{
									//If the bulk counter is greater than 0, make the purchase
									if(bulkCounter > 0)
									{
										TakeInventory("Kingpin_Cash",pawnOMaticItemPrices[currentMenu-2][currentMenuItem] * bulkCounter);
									
										GiveInventory("SamsaraPickupAndShutUp",1);
										//Looks like I will need a for loop for things like health
										for(int give = 0; give < bulkCounter; give++) 
											GiveInventory(pawnOMaticItemOptions[currentMenu-3][currentMenuItem-1][0],1);
										TakeInventory("SamsaraPickupAndShutUp",INTMAX);
										
										messageDialog = random(0,2);
										KingpinDisplayDialogue(9,0,messageDialog,0);
										welcomeMessage = false;
										PlaySound(sTid,"PawnOMatic/Register",CHAN_5,1.0,0,ATTN_NONE);
										PlaySound(sTid,StrParam(s:"PawnOMatic/Sold",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
									}
									//Otherwise, cancel the purchase.
									else
									{
										modSelected = 0;
										messageDialog = random(0,2);
										KingpinDisplayDialogue(9,1,messageDialog,0);
										welcomeMessage = false;
										PlaySound(sTid,StrParam(s:"PawnOMatic/NoThanks",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
									}
								}
								else if(currentMenu == 2)
								{
									TakeInventory("Kingpin_Cash",pawnOMaticItemPrices[currentMenu-2][currentMenuItem] * bulkCounter);
								
									GiveInventory(KingpinWeapons[currentMenuItem-1][0],1);
									if (StrCmp(KingpinWeapons[currentMenuItem-1][1], "")) { GiveInventory(KingpinWeapons[currentMenuItem-1][1],1); }
									
									messageDialog = random(0,2);
									KingpinDisplayDialogue(9,0,messageDialog,0);
									welcomeMessage = false;
									PlaySound(sTid,"PawnOMatic/Register",CHAN_5,1.0,0,ATTN_NONE);
									PlaySound(sTid,StrParam(s:"PawnOMatic/Sold",d:messageDialog+1),CHAN_VOICE,1.0,0,ATTN_NONE);
								}
								modSelected = 0;
							}
						}
					}
				}
			}
		}
		else
		{
			RemoveMessages(57,57);
			SetFont("KPDIGT0");
			HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,54,CR_UNTRANSLATED,574.0,400.0,0.0);	
			HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,53,CR_UNTRANSLATED,600.0,400.0,0.0);	
			HudMessage(s:"A";HUDMSG_PLAIN|HUDMSG_NOTWITHFULLMAP,52,CR_UNTRANSLATED,626.0,400.0,0.0);
		}
		
		lastInputTimer++;
		
		Delay(1);
	}
	
	// Play the exit sound and stop other noises
	PlaySound(sTid,"PawnOMAtic/Exit",CHAN_VOICE,1.0,0,ATTN_NONE);
	StopSound(sTid,CHAN_5);
	StopSound(sTid,CHAN_6);
	Thing_Remove(sTid);
	SetInventory("Kingpin_PawnOMaticSoundTid",0);
	RemoveMessages(50,63);
}