	{ "Hey, you're all full up... You can't hold any more.", "You don't need any more health... You're full up.", "Hey, you don't need any more... You're all patched up now.", "Hey, you're fine... You don't need any more health." },
	{ "Hey, you can't carry any more.", "You're maxed out." }
};

str SharkyRandomWeapons[9] =
{
	"Hey, very good choice.",
	"Haha, my personal favorite.",
	"Oh, I like that one a lot.",
	"Very good choice.",
	"Yeah, nice selection.",
	"That'll work.",
