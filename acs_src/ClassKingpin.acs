    { "Kingpin_Pistol", "" },
    { "Kingpin_Shotgun", "GotWeapon2" },
    { "Kingpin_GrenadeLauncher", "GotWeapon3" },
    { "Kingpin_TommyGun", "GotWeapon4" },
