	{ 25, 50, 100, 50 },
	{ 200, 100, 150, 250 },
	{ 50, 200, 100, 50 },
	{ 100, 200, 100, 300 },
	{ 50, 150, 250, 500 },
	{ 100, 200, 100, 250 },
	{ 100, 150, 350, 500 },
};

