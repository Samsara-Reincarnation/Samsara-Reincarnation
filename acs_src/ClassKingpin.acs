{
	{ "Kingpin_Pipe", "", "", "", "", "" },
	{ "Kingpin_Pistol", "Kingpin_PistolMagazine", "-1", "KPHWEAP1", "KPHAMMO1", "Kingpin_Pistol_Magnum", "Kingpin_Pistol_Reload", "Kingpin_Pistol_RateOfFire", "Kingpin_Pistol_Silencer" },
	{ "Kingpin_Crowbar", "", "", "KPHWEAP2", "", "", "", "", "" },
	{ "Kingpin_Shotgun", "Kingpin_ShotgunMagazine", "Shell", "KPHWEAP3", "KPHAMMO2", "Kingpin_Shotgun_Magazine", "Kingpin_Shotgun_DoubleBarrel", "Kingpin_Shotgun_SelectFire", "Kingpin_Shotgun_BleedShot" },
	{ "Kingpin_GrenadeLauncher", "Kingpin_GrenadeLauncherMagazine", "RocketAmmo", "KPHWEAP4", "KPHAMMO3", "Kingpin_GrenadeLauncher_ConcussionGrenades", "Kingpin_GrenadeLauncher_MagazineCapacity", "Kingpin_GrenadeLauncher_Fragmentation", "Kingpin_GrenadeLauncher_ClusterBombs" },
	{ "Kingpin_TommyGun", "Kingpin_TommyGunMagazine", "Clip", "KPHWEAP5", "KPHAMMO1", "Kingpin_TommyGun_MagazineCapacity", "Kingpin_TommyGun_Damage", "Kingpin_TommyGun_Accuracy", "Kingpin_TommyGun_Buzzsaw" },
	{ "Kingpin_Bazooka", "Kingpin_BazookaMagazine", "RocketAmmo", "KPHWEAP6", "KPHAMMO4", "Kingpin_Bazooka_LaserSystem", "Kingpin_Bazooka_FastRockets", "Kingpin_Bazooka_BigBubba", "Kingpin_Bazooka_HighExplosives" },
	{ "Kingpin_Flamethrower", "", "Cell", "KPHWEAP7", "KPHAMMO5", "Kingpin_Flamethrower_Range", "Kingpin_Flamethrower_FuelPump", "Kingpin_Flamethrower_HotterFlame", "Kingpin_Flamethrower_Napalmer" },
	{ "Kingpin_HMG", "Kingpin_HMGMagazine", "Cell", "KPHWEAP8", "KPHAMMO6", "Kingpin_HMG_SelectFire", "Kingpin_HMG_AntiMaterial", "Kingpin_HMG_CoolingRod", "Kingpin_HMG_TacticalScope" },
};

Script "Kingpin_DrawHud" (int startIndex)
{
	int offset, digit, i;
	int kp_cash = CheckInventory("Kingpin_Cash");
	int kp_cashDigits = strlen(strparam(d:kp_cash));
	int kp_health = GetActorProperty(0,APROP_Health);
	//Clamp from negative health
	if(kp_health < 0) kp_health = 0;
	int kp_healthDigits = strlen(strparam(d:kp_health));
	int kp_armor = CheckInventory("BasicArmor");
	int kp_armorDigits = strlen(strparam(d:kp_armor));
	int kp_kills = CheckInventory("KillCountAmount");
	int kp_killsDigits = strlen(strparam(d:kp_kills));
	int currentWeapon = CheckInventory("Kingpin_SelectedWeapon");
	
	//Set hud size. This seems pretty safe
	SetHudSize(800,600,0);	
	//Draw money icon
	SetFont("KPHMONEY");
	HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+29,CR_UNTRANSLATED,700.2,28.0,0.0,0.33);
	//Draw money amount
	RemoveMessages(startIndex+24,startIndex+28);
	SetFont("KPHUDL");
	for(i = kp_cashDigits; i > 0; i--)
	{
		//Since these are aligned from the left, we need an offset for the drawing function
		offset = kp_cashDigits-i;
		//This formula will compute the current digit
		digit = (kp_cash % pow(10,i)) / pow(10,i-1);
		//Finally, draw the digit
		HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_COLORSTRING,startIndex+24+offset,"KPGreenMoney",704.1 + (offset * 16.0),28.0 + (offset * 3.0),0.0);	
	}
	
	//Draw kills icon
	SetFont("KPHKILL");
	HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+30,CR_UNTRANSLATED,700.2,72.0,0.0,0.33);
	//Draw money amount
	RemoveMessages(startIndex+31,startIndex+35);
	SetFont("KPHUDL");
	for(i = kp_killsDigits; i > 0; i--)
	{
		//Since these are aligned from the left, we need an offset for the drawing function
		offset = kp_killsDigits-i;
		//This formula will compute the current digit
		digit = (kp_kills % pow(10,i)) / pow(10,i-1);
		//Finally, draw the digit
		HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_COLORSTRING,startIndex+31+offset,"KPRed",704.1 + (offset * 16.0),72.0 + (offset * 3.0),0.0);	
	}
	
	//Draw health amount
	RemoveMessages(startIndex+21,startIndex+23);
	SetFont("KPHUDL");
	for(i = kp_healthDigits; i > 0; i--)
	{
		//Since these are aligned from the left, we need an offset for the drawing function
		offset = kp_healthDigits-i;
		//This formula will compute the current digit
		digit = (kp_health % pow(10,i)) / pow(10,i-1);
		//Finally, draw the digit
		HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+21+offset,CR_UNTRANSLATED,80.2 + (offset * 16.0),576.0 + (offset * 3.0),0.0);	
	}
	//Draw Health Icon - inconsistent placement, I know
	SetFont("KPHLIFE");
	HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+20,CR_UNTRANSLATED,20.1,580.0,0.0,0.33);
	
	//Draw armor amount
	RemoveMessages(startIndex+17,startIndex+19);
	SetFont("KPHUDL");
	for(i = kp_armorDigits; i > 0; i--)
	{
		//Since these are aligned from the left, we need an offset for the drawing function
		offset = kp_armorDigits-i;
		//This formula will compute the current digit
		digit = (kp_armor % pow(10,i)) / pow(10,i-1);
		//Finally, draw the digit
		HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+17+offset,CR_UNTRANSLATED,80.2 + (offset * 16.0),500.0 + (offset * 3.0),0.0);	
	}
	SetHudSize(960,640,0);	
	//Draw armor icon
	SetFont("KPHBODY");
	HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+16,CR_UNTRANSLATED,80.2,580.2,0.0,0.33);
	SetFont("KPHARMOR");
	HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+15,CR_UNTRANSLATED,80.2,580.2,0.0,kp_armor*1.0/100);
	//Draw armor outline, here
	if(kp_armor >= 150)
		SetFont("KPHARMB");
	else if(kp_armor >= 75)
		SetFont("KPHARMG");
	else if(kp_armor >= 50)
		SetFont("KPHARMY");
	else if(kp_armor >= 25)
		SetFont("KPHARMO");
	else if(kp_armor > 0)
		SetFont("KPHARMR");
	else
		RemoveMessages(startIndex+14,startIndex+14);
	if(kp_armor > 0) HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN|HUDMSG_ALPHA,startIndex+14,CR_UNTRANSLATED,80.2,580.2,0.0,0.5);
	SetHudSize(800,600,0);	
	
	//Draw ammo/weapon info
	SetFont("KPHUDL"); 
	//Draw total ammo
	RemoveMessages(startIndex+10,startIndex+13);
	if((StrCmp(KingpinHUDWeapons[currentWeapon][2], "") && StrCmp(KingpinHUDWeapons[currentWeapon][2], "-1")) || (!StrCmp(KingpinHUDWeapons[currentWeapon][2], "-1") && CheckInventory("PistolModeOn")))
	{
		int kp_ammo = CheckInventory(!StrCmp(KingpinHUDWeapons[currentWeapon][2], "-1") ? "Clip" : KingpinHUDWeapons[currentWeapon][2]);
		if(kp_ammo > 9999) kp_ammo = 9999;
		int kp_ammoDigits = strlen(strparam(d:kp_ammo));
		for(i = kp_ammoDigits; i > 0; i--)
		{
			//Since these are aligned from the left, we need an offset for the drawing function
			//This formula will compute the current digit
			digit = (kp_ammo % pow(10,i)) / pow(10,i-1);
			//Finally, draw the digit
			HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+10+i,CR_UNTRANSLATED,760.2 - (i * 16.0),568.0 + (i * 3.0),0.0);	
		}
	}
	//Draw clip ammo
	RemoveMessages(startIndex+6,startIndex+9);
	if(StrCmp(KingpinHUDWeapons[currentWeapon][1], "") && CheckInventory("SamsaraReloadMode") >= 2)
	{
		int kp_clip = CheckInventory(KingpinHUDWeapons[currentWeapon][1]);
		if(kp_clip > 9999) kp_clip = 9999;
		int kp_clipDigits = strlen(strparam(d:kp_clip));
		for(i = kp_clipDigits; i > 0; i--)
		{
			//Since these are aligned from the left, we need an offset for the drawing function
			//This formula will compute the current digit
			digit = (kp_clip % pow(10,i)) / pow(10,i-1);
			//Finally, draw the digit
			HudMessage(d:digit;HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+6+i,CR_UNTRANSLATED,796.2 - (i * 16.0),524.0 + (i * 3.0),0.0);	
		}
	}
	//Draw ammo type icon
	if(strlen(KingpinHUDWeapons[currentWeapon][4]) > 0)
	{
		SetHudSize(1280,960,0);	
		SetFont(KingpinHUDWeapons[currentWeapon][4]); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+5,CR_UNTRANSLATED,1276.2,940.2,0.0);	
	}
	else RemoveMessages(startIndex+5,startIndex+5);
	//Draw weapon icon
	if(strlen(KingpinHUDWeapons[currentWeapon][3]) > 0)
	{
		SetHudSize(960,640,0);
		SetFont(KingpinHUDWeapons[currentWeapon][3]); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+4,CR_UNTRANSLATED,940.2,540.2,0.0);	
	}
	else RemoveMessages(startIndex+4,startIndex+4);
	//Finally, draw upgrades
	RemoveMessages(startIndex,startIndex+3);
	if(strlen(KingpinHUDWeapons[currentWeapon][5]) > 0 && CheckInventory(KingpinHUDWeapons[currentWeapon][5]))
	{
		SetHudSize(1280,960,0);	
		SetFont("KPUPGR1"); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+3,CR_UNTRANSLATED,1100.2,732.2,0.0);	
	}
	if(strlen(KingpinHUDWeapons[currentWeapon][6]) > 0 && CheckInventory(KingpinHUDWeapons[currentWeapon][6]))
	{
		SetHudSize(1280,960,0);	
		SetFont("KPUPGR2"); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+2,CR_UNTRANSLATED,1160.2,732.2,0.0);	
	}
	if(strlen(KingpinHUDWeapons[currentWeapon][7]) > 0 && CheckInventory(KingpinHUDWeapons[currentWeapon][7]))
	{
		SetHudSize(1280,960,0);	
		SetFont("KPUPGR3"); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex+1,CR_UNTRANSLATED,1220.2,732.2,0.0);	
	}
	if(strlen(KingpinHUDWeapons[currentWeapon][8]) > 0 && CheckInventory(KingpinHUDWeapons[currentWeapon][8]))
	{
		SetHudSize(1280,960,0);	
		SetFont("KPUPGR4"); 
		HudMessage(s:"A";HUDMSG_NOTWITHFULLMAP|HUDMSG_PLAIN,startIndex,CR_UNTRANSLATED,1280.2,732.2,0.0);	
	}
}

Script "Kingpin_RocketFlare" (void)
{
	int flareTid = uniqueTid();
	SpawnForced("Kingpin_RocketFlare",0,0,0,flareTid);
	SetPointerExt(AAPTR_MASTER,0,flareTid);
	Thing_ChangeTid(flareTid,0);
}

Script "Kingpin_Bazooka" (int type, int arg1, int arg2)
{
	int lTid;
	switch(type)
	{
		case 0:
			SetPointer(AAPTR_TRACER,arg1);
			break;
		case 1:
			int myTid = ActivatorTid();
			int missileTid = uniqueTid();
			Thing_ChangeTid(0,missileTid);
			SetActivator(0,AAPTR_Target);
			lTid = abs(CheckInventory("Kingpin_Bazooka_LaserTID"));
			SetActivator(missileTid);
			Thing_ChangeTid(missileTid,0);
			ACS_NamedExecuteWithResult("Kingpin_Bazooka",0,lTid);
			break;
		case 2:
			lTid = uniqueTid();
			SpawnForced("Kingpin_Bazooka_Seeker",GetActorX(0),GetActorY(0),GetActorZ(0),lTid);
			SetActivator(0,AAPTR_Target);
			SetInventory("Kingpin_Bazooka_LaserTID",0);
			GiveInventory("Kingpin_Bazooka_LaserTID",lTid);
			break;	
	}
}

Script "Kingpin_ThrowMoney" (void)
{
	int moneyTid = UniqueTid();
	int monsterHealth = GetActorProperty(0,APROP_SpawnHealth);
	str moneyActor = "Kingpin_CashPickup";
	if(monsterHealth >= 1000) moneyActor = "Kingpin_CashPickupBagS";
	else if(monsterHealth >= 500) moneyActor = "Kingpin_CashPickupBagS";
	SpawnForced(moneyActor,GetActorX(0),GetActorY(0),GetActorZ(0)+(GetActorProperty(0,APROP_Height)*2),moneyTid);
	SetActorAngle(moneyTid,random(0,1.0));
	SetActorVelocity(moneyTid,4*cos(GetActorAngle(moneyTid)),4*sin(GetActorAngle(moneyTid)),random(0,4.0),0,0);
	SetActorProperty(moneyTid, APROP_Accuracy, Random(1, monsterHealth / 10));
    Thing_ChangeTID(moneyTid, 0);
}

script "Kingpin_Flamethrower" (int normalcost, int fuelpumpcost)
{
    if (CheckInventory("Kingpin_Flamethrower_Hold")) { terminate; }

    if (CheckInventory("Cell") < (CheckInventory("Kingpin_Flamethrower_FuelPump") ? fuelpumpcost : normalcost) && !CheckInventory("SamsaraHasInfiniteAmmo")) { terminate; }

    if (CheckInventory("SamsaraCurrentWaterLevel") >= 3 && !CheckInventory("SamsaraCanFireWeaponsUnderwater")) { terminate; }

    GiveInventory("Kingpin_Flamethrower_Hold", 1);

    while (CheckWeapon("Kingpin_Flamethrower") && !isDead(0) && CheckInventory("Kingpin_Flamethrower_Hold"))
    {
        PlaySound(0, StrParam(s:"Kingpin/Flamethrower/Flame", d:((Timer() % 3)) + 1), CHAN_AUTO);
        GiveInventory("Kingpin_Flamethrower_FireTrigger", 1);
        Delay(1);
    }

    SetInventory("Kingpin_Flamethrower_Hold", 0);
}

Script "Kingpin_FlamethrowerDistance" (int px, int py, int pz)
{
	int rX = GetActorX(0)/65536 - px;
	int rY = GetActorY(0)/65536 - py;
	int rZ = GetActorZ(0)/65536 - pz;
	int result = sqrt(rX*rX + rY*rY + rZ*rZ);
	//PrintBold(s:"Trail Start X: ",d:px,s:"Trail Start Y: ",d:py,s:"Trail Start Z: ",d:pz,s:"\n",s:"Trail End X: ",d:GetActorX(0)>>16,s:"Trail End Y: ",d:GetActorY(0)>>16,s:"Trail End Z: ",d:GetActorZ(0)>>16);
	SetResultValue(result);
}

Script "Kingpin_ReturnUpgrade" (int upgrade)
{
	SetActivator(0,AAPTR_Target);
	switch(upgrade)
	{
		case 21:
			SetResultValue(CheckInventory("Kingpin_Flamethrower_Range"));
			break;
	}
}

Script "Kingpin_FlamethrowerTracer" (int upgrade)
{
	int myOldTid = ActivatorTid();
	int myTid = UniqueTid();
	Thing_ChangeTid(0, myTid);

	SetActivator(0,AAPTR_Tracer);

	int requiredIgnition = (ClassifyActor(0) & ACTOR_Player || ClassifyActor(0) & ACTOR_Bot ? 6 : CheckFlag(0,"NOBLOOD") ? 72 : 36)/upgrade;

	int actorClass = ClassifyActor(0);
	if(!(actorClass & ACTOR_ALIVE) && !(actorClass & ACTOR_MONSTER || (!isSinglePlayer() && !isCoop() && (isPlayerOrBot(0) || GetActorProperty(0, APROP_FRIENDLY)))))
		terminate;

	if(!CheckInventory("Kingpin_FlamethrowerHitTarget"))
	{
		if(!CheckInventory("Kingpin_FlamethrowerBurnt"))
		{
			GiveInventory("Kingpin_FlamethrowerHitTarget",1);
			GiveInventory("Kingpin_FlamethrowerIgnition",1);

			if(CheckInventory("Kingpin_FlamethrowerIgnition") >= requiredIgnition && !CheckInventory("Kingpin_FlamethrowerBurnt"))
			{
				bool isPVEGame = isSinglePlayer() || isCoop();

				//Gross hack for enemy gender
				int gender = -GetActorProperty(0,APROP_STAMINA);
				if(isPlayerOrBot(0)) gender = 0; // do not play sounds for players
				TakeInventory("Kingpin_FlamethrowerHitTarget",1);
				TakeInventory("Kingpin_FlamethrowerIgnition",50);
				GiveInventory("Kingpin_FlamethrowerBurnt",1);
				GiveInventory("Kingpin_FlamethrowerStacker",1);
				ACS_NamedExecuteWithResult("Kingpin_Decorate",8);
				int burnerTid = UniqueTid();
				if(gender == 2) PlaySound(0,"Kingpin/Flamethrower/BurnF",CHAN_AUTO,1.0,0,ATTN_NORM);
				else if(gender == 1) PlaySound(0,"Kingpin/Flamethrower/Burn",CHAN_AUTO,1.0,0,ATTN_NORM);
				SpawnForced(isPVEGame ? "Kingpin_FlamethrowerBurnerCoop" : "Kingpin_FlamethrowerBurner",GetActorX(0),GetActorY(0),GetActorZ(0),burnerTid);
				SetActivator(myTid,AAPTR_Target);
				SetPointerExt(AAPTR_Target,0,burnerTid);
				SetActivator(myTid,AAPTR_Tracer);
				SetPointerExt(AAPTR_Tracer,0,burnerTid);
				Thing_ChangeTid(myTid, myOldTid);
				terminate;
			}

			Thing_ChangeTid(myTid, myOldTid);
			Delay(1);
			TakeInventory("Kingpin_FlamethrowerHitTarget",1);

			Delay(105);
			if(!CheckInventory("Kingpin_FlamethrowerBurnt")) TakeInventory("Kingpin_FlamethrowerIgnition",1);
		}
		else
		{		
			GiveInventory("Kingpin_FlamethrowerHitTarget",1);
			GiveInventory("Kingpin_FlamethrowerIgnition",1);
			if(CheckInventory("Kingpin_FlamethrowerIgnition") >= requiredIgnition)
			{
				TakeInventory("Kingpin_FlamethrowerHitTarget",1);
				TakeInventory("Kingpin_FlamethrowerIgnition",50);
				GiveInventory("Kingpin_FlamethrowerStacker",1);
				Thing_ChangeTid(myTid, myOldTid);
				ACS_NamedExecuteWithResult("Kingpin_Decorate",8);
				terminate;
			}

			Thing_ChangeTid(myTid, myOldTid);
			Delay(1);
			TakeInventory("Kingpin_FlamethrowerHitTarget",1);

			Delay(105);
			if(!CheckInventory("Kingpin_FlamethrowerBurnt")) TakeInventory("Kingpin_FlamethrowerIgnition",1);
		}
	}
	else
		Thing_ChangeTid(myTid, myOldTid);
}

Script "Kingpin_EnemyBurn" (void)
{
	int radius = GetActorProperty(0,APROP_Radius)/4;
	int height = GetActorProperty(0,APROP_Height);
	While(CheckInventory("Kingpin_OnFire"))
	{
		SpawnForced("Kingpin_FlamethrowerFireVisual",GetActorX(0)+randSign()*radius,GetActorY(0)+randSign()*radius,GetActorZ(0)+random(0,height*4),0);
		Delay(2);
	}
}

Script "Kingpin_BurnHandler" (void)
{
	if(ACS_NamedExecuteWithResult("Kingpin_BurningOnPlayer"))
	{
		while(ACS_NamedExecuteWithResult("Kingpin_BurningPlayerIsAlive") && ClassifyActor(0) > 1)
		{
			if(ACS_NamedExecuteWithResult("Kingpin_Decorate",10) <= 0)
			{
				SetActorState(0,"Remove",1);
				terminate;
			}
			Delay(2);
		}
	}
	else
	{
		while(ACS_NamedExecuteWithResult("Kingpin_BurningPlayerIsAlive") && ClassifyActor(0) > 1)
		{
			if(ACS_NamedExecuteWithResult("Kingpin_Decorate",10) <= 0)
			{
				SetActorState(0,"Remove",1);
				terminate;
			}
			Delay(2);
		}
	}
}

Script "Kingpin_BurningPlayerIsAlive" (void)
{
	SetActivator(0,AAPTR_Tracer);
	if(ClassifyActor(0) & ACTOR_Alive)
		SetResultValue(1);
	else
		SetResultValue(0);
}

Script "Kingpin_BurningOnPlayer" (void)
{
	SetActivator(0,AAPTR_Tracer);
	if(ClassifyActor(0) & ACTOR_Player || ClassifyActor(0) & ACTOR_Bot)
	{
		//ACS_NamedExecuteWithResult("Kingpin_ScreenBurn");
		SetResultValue(1);
	}
	else
	{
		SetResultValue(0);
	}
}

Script "Kingpin_Decorate" (int type, int arg1, int arg2)
{
	int result;
	switch(type)
	{
		case 2:
			SetActivator(0,AAPTR_Target);
			SetResultValue(1+(2*CheckInventory("Kingpin_Flamethrower_HotterFlame")));
			break;
		case 5:
			if(GetActorProperty(0,APROP_Health) < -GetActorProperty(0,APROP_SpawnHealth)/((random(0,2)+(2+(GetActorProperty(0,APROP_SpawnHealth)/200)))))
				GiveInventory("Kingpin_SetGib",1);			
			SetResultValue(1);
			break;
		case 7:
			if(GetSectorLightLevel(0) < 64) SetActorState(0,"Light4",1);
			else if(GetSectorLightLevel(0) < 128) SetActorState(0,"Light3",1);
			else if(GetSectorLightLevel(0) < 192) SetActorState(0,"Light2",1);
			else SetActorState(0,"Light1",1);
			break;
		case 8:
			Delay(105);
			TakeInventory("Kingpin_FlamethrowerStacker",1);
			break;
		case 9: //Flamethrower burn visuals
			SetActivator(0,AAPTR_Tracer);
			if(arg1 == 0)
				SetResultValue(GetActorProperty(0,APROP_Radius)>>16);
			else
				SetResultValue(GetActorProperty(0,APROP_Height)>>16);
			break;
		case 10:
			SetActivator(0,AAPTR_Tracer);
			SetResultValue(CheckInventory("Kingpin_FlamethrowerStacker"));
			break;
		case 11:
			switch(arg1)
			{
				case 1:
					if(GetActorClass(0) == "Kingpin_Thug") SetActorState(0,"Next",1);
					break;
				case 2:
					if(GetActorClass(0) == "Kingpin_CashPickup") SetActorState(0,"Next",1);
					break;
				case 3:
					if(GetActorClass(0) == "Kingpin_CashPickupBagS") SetActorState(0,"Next",1);
					break;
				case 4:
					if(GetActorClass(0) == "Kingpin_CashPickupBagL") SetActorState(0,"Next",1);
					break;
			}
			break;
		case 12:
			if (CheckInventory("SamsaraReloadMode") >= 2 && CheckInventory("SamsaraHasInfiniteAmmo") <= 1) { SetInventory("Kingpin_Shotgun_DoubleBarrelAlternate", CheckInventory("Kingpin_ShotgunMagazine") % 2); }
			else
			{
				if (arg1 > 0) { SetInventory("Kingpin_Shotgun_DoubleBarrelAlternate", !CheckInventory("Kingpin_Shotgun_DoubleBarrelAlternate")); }
			}
			break;
	}
}

Script "Kingpin_ScopeClient" (void) clientside
{
	FadeTo(0.0,0.0,0.0,1.0,0);
	FadeTo(0.0,0.0,0.0,0.0,0.5);
	While(CheckInventory("Kingpin_HMG_ScopeActive"))
	{
		SetHudSize(256,256,0);
		SetFont("KPSCOPE");

		HudMessage(s:"a"; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOTWITHFULLMAP|HUDMSG_LAYER_UNDERHUD, 1600, CR_UNTRANSLATED, 128.0, 128.0, 0, 1.0);

		Delay(1);
	}
	FadeTo(0.0,0.0,0.0,1.0,0);
	FadeTo(0.0,0.0,0.0,0.0,0.5);
	HudMessage(s:""; HUDMSG_PLAIN|HUDMSG_ALPHA|HUDMSG_NOTWITHFULLMAP|HUDMSG_LAYER_UNDERHUD, 1600, CR_UNTRANSLATED, 128.0, 128.0, 0.1, 0.0);
}

Script "Kingpin_BulletDamage" (int damage)
{
	int bulletX = GetActorX(0);
	int bulletY = GetActorY(0);
	int bulletZ = GetActorZ(0);

	SetActivator(0,AAPTR_Tracer);

	if(CheckFlag(0,"NOBLOOD")) { SetResultValue(damage); terminate; }

	int monsterX = GetActorX(0);
	int monsterY = GetActorY(0);
	int monsterZ = GetActorZ(0);
	int monsterHealth = GetActorProperty(0,APROP_Health);
	int monsterHeight = GetActorProperty(0,APROP_Height);
	int monsterWidth = GetActorProperty(0,APROP_Radius)*2;
	int health = GetActorProperty(0,APROP_SpawnHealth);

	/*if(CheckInventory("RTCW_MetalMonster"))
	{
		PlaySound(0,"RTCW/BulletHitMetal",CHAN_6,0.5,0,ATTN_NORM);
	}
	else
		PlaySound(0,"RTCW/BulletHitFlesh",CHAN_6,0.5,0,ATTN_NORM);*/

	if (health >= 1000)
	{
		SetResultValue(damage);
	}
	else if(monsterWidth >= monsterHeight && !CheckInventory("IsFatButBiped"))
	{
		int monsterAngle = GetActorAngle(0);
		int vang = VectorAngle(monsterX - bulletX, monsterY - bulletY);
		int angle = vang % 1.0;
				
		if(!CheckInventory("NoHeadShots") && bulletZ > monsterZ + FixedMul(monsterHeight,0.35) && bulletZ < monsterZ + FixedMul(monsterHeight,0.65) && ((abs(monsterAngle - angle)) < 0.65 && (abs(monsterAngle - angle)) > 0.35))
		{
			if(monsterHealth - (damage*2) <= -damage)
				GiveInventory("Kingpin_BloodHeadshotGenerator",1);
		
			SetResultValue(damage*2);
		}
		else
			SetResultValue(damage);
	}
	else
	{
		if(bulletZ > monsterZ + FixedMul(monsterHeight,0.75))
		{
			if(monsterHealth - (damage*2) <= -damage)
				GiveInventory("Kingpin_BloodHeadshotGenerator",1);
		
			int result;
			if(GetCvar("samsara_mixerloaded"))
				result = ACS_NamedExecuteWithResult("Goldeneye_HatShot",0,0,0,0);
			else
				result = 0;

			if(result == -1)
			{
				SetResultValue(-1);
				terminate;
			}
			//if(StrLeft(GetActorClass(0),4)=="RTCW" && GetCvar("samsara_mixerloaded"))
				//GiveInventory("RTCW_RemoveHat",1);
				

			SetResultValue(damage*2);
		}
		else
			SetResultValue(damage);
	}
}

Script "Kingpin_PawnOMatic_Initiate" (void) Net
{
	if(!CheckInventory("Kingpin_PawnOMaticOpen"))
	{
		if(!CheckInventory("CompendiumOpened"))
		{
			int sTid = uniqueTid();
			GiveInventory("Kingpin_PawnOMaticOpen",1);
			SetPlayerProperty(0,1,PROP_TOTALLYFROZEN);
			SpawnForced("Kingpin_PawnOMaticSoundController",0,0,0,sTid);
			SetInventory("Kingpin_PawnOMaticSoundTid",sTid);
			PlaySound(sTid,"PawnoMatic/Welcome",CHAN_VOICE,1.0,0,ATTN_NONE);
			
			ACS_NamedExecuteWithResult("Kingpin_PawnOMatic",PlayerNumber(),sTid);
		}
	}
	else
	{
		TakeInventory("Kingpin_PawnOMaticOpen",1);
		SetPlayerProperty(0,0,PROP_TOTALLYFROZEN);
	}
}

