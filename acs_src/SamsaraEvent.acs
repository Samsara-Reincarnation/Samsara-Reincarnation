                    {
                        ACS_NamedExecuteAlways("SAMSARA_CLIENT_CLASSLOADOUT", 0, SLOT_CHAINSAW, CheckInventory("SamsaraGoldfingerLoadoutSlot1"), pln);
                        loadoutPrevValue[pln][SLOT_CHAINSAW] = CheckInventory("SamsaraGoldfingerLoadoutSlot1");
