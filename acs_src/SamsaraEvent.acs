					if (CheckInventory("Goldeneye_Slapper") &&
						(CheckInventory("Goldfinger_PPKSilenced") || CheckInventory("Goldfinger_PPK") || CheckInventory("Goldfinger_ColtM1911") ||
						CheckInventory("Goldfinger_LugerP08") || CheckInventory("Goldfinger_WaltherP38")) &&
						(CheckInventory("Goldfinger_OddjobHat") || CheckInventory("Goldfinger_GolfClub")) &&
						CheckInventory("Goldfinger_MP40") &&
						(CheckInventory("Goldfinger_Shotgun") || CheckInventory("Goldfinger_OverUnder")) &&
						CheckInventory("Goldfinger_AK47") &&
                        (CheckInventory("Goldfinger_ThompsonDrum") || CheckInventory("Goldfinger_Thompson")) &&
                        CheckInventory("Goldfinger_SuperBazooka") && CheckInventory("Goldfinger_M79") && CheckInventory("Goldfinger_M1Carbine") &&
						(CheckInventory("Goldfinger_M1Garand") || CheckInventory("Goldfinger_Kar98k")) &&
						CheckInventory("Goldfinger_Laser") && CheckInventory("Goldfinger_M14") && CheckInventory("Goldfinger_AR7") &&
						(CheckInventory("Goldfinger_UZI") || CheckInventory("Goldfinger_SmithWesson22") || CheckInventory("Goldfinger_SmithWesson36")) &&
						(CheckInventory("Goldfinger_WatchDetonator") || CheckInventory("Goldfinger_Limpet") || CheckInventory("Goldfinger_LandMine") ||
                        CheckInventory("Goldfinger_Claymore")) &&
						!CheckInventory("SamsaraGoldfingerHasGoldMagnum"))
					{
						GiveInventory("Goldfinger_GoldMagnum", 1);
						GiveInventory("SamsaraGoldfingerHasGoldMagnum", 1);
						dualpickupcheck++;
					}

                    // due to the nature of loadout weapons (at least one weapon is not a dual wieldable), we are exempting the slot 1 from this check
					if (CheckInventory("Goldeneye_PP7DualToken") && CheckInventory("Goldeneye_KF7DualToken") && CheckInventory("Goldeneye_AutoShotgunDualToken") &&
                        CheckInventory("Goldeneye_AR33DualToken") && CheckInventory("Goldeneye_PhantomDualToken") && CheckInventory("Goldeneye_RocketLauncherDualToken") &&
                        CheckInventory("Goldeneye_GrenadeLauncherDualToken") && CheckInventory("Goldeneye_RCP90DualToken") && CheckInventory("Goldeneye_CougarDualToken") &&
                        CheckInventory("Goldeneye_LaserDualToken") && CheckInventory("Goldeneye_GoldenGunDualToken") && CheckInventory("Goldeneye_SniperDualToken") &&
                        CheckInventory("Goldeneye_D5KDualToken") && CheckInventory("SamsaraGoldfingerHasGoldMagnum") && !CheckInventory("Goldfinger_GoldMagnumDualToken"))
					{
						GiveInventory("Goldfinger_GoldMagnum", 1);
						GiveInventory("Goldfinger_GoldMagnumDualToken", 1);
						dualpickupcheck += 2;
					}

					if (dualpickupcheck > 0)
					{
						ACS_NamedExecuteWithResult("SamsaraSpecialPickupDisplayNetplayHack", 6 + dualpickupcheck - 1);
						dualpickupcheck = 0;
					}

					if (CheckInventory("Goldeneye_Slapper") &&
						(CheckInventory("Goldfinger_PPKSilenced") || CheckInventory("Goldfinger_PPK") || CheckInventory("Goldfinger_ColtM1911") ||
						CheckInventory("Goldfinger_LugerP08") || CheckInventory("Goldfinger_WaltherP38")) &&
						(CheckInventory("Goldfinger_OddjobHat") || CheckInventory("Goldfinger_GolfClub")) &&
						CheckInventory("Goldfinger_MP40") &&
						(CheckInventory("Goldfinger_Shotgun") || CheckInventory("Goldfinger_OverUnder")) &&
						CheckInventory("Goldfinger_AK47") &&
                        (CheckInventory("Goldfinger_ThompsonDrum") || CheckInventory("Goldfinger_Thompson")) &&
                        CheckInventory("Goldfinger_SuperBazooka") && CheckInventory("Goldfinger_M79") && CheckInventory("Goldfinger_M1Carbine") &&
						(CheckInventory("Goldfinger_M1Garand") || CheckInventory("Goldfinger_Kar98k")) &&
						CheckInventory("Goldfinger_Laser") && CheckInventory("Goldfinger_M14") && CheckInventory("Goldfinger_AR7") &&
						(CheckInventory("Goldfinger_UZI") || CheckInventory("Goldfinger_SmithWesson22") || CheckInventory("Goldfinger_SmithWesson36")) &&
						(CheckInventory("Goldfinger_WatchDetonator") || CheckInventory("Goldfinger_Limpet") || CheckInventory("Goldfinger_LandMine") ||
                        CheckInventory("Goldfinger_Claymore")) &&
						!CheckInventory("SamsaraGoldenEyeHasGoldPP7"))
					{ GiveInventory("SamsaraGoldenEyeHasGoldPP7", 1); }

					if (CheckInventory("Goldeneye_PP7DualToken") && CheckInventory("Goldeneye_ThrowingKnivesDualToken") && CheckInventory("Goldeneye_KF7DualToken") &&
						CheckInventory("Goldeneye_AutoShotgunDualToken") && CheckInventory("Goldeneye_AR33DualToken") && CheckInventory("Goldeneye_PhantomDualToken") &&
						CheckInventory("Goldeneye_RocketLauncherDualToken") && CheckInventory("Goldeneye_GrenadeLauncherDualToken") && CheckInventory("Goldeneye_RCP90DualToken") &&
						CheckInventory("Goldeneye_CougarDualToken") && CheckInventory("Goldeneye_LaserDualToken") && CheckInventory("Goldeneye_GoldenGunDualToken") &&
						CheckInventory("Goldeneye_SniperDualToken") && CheckInventory("Goldeneye_D5KDualToken") && CheckInventory("SamsaraGoldenEyeHasGoldPP7") &&
						!CheckInventory("Goldeneye_GoldPP7DualToken"))
					{ GiveInventory("Goldeneye_GoldPP7DualToken", 1); }

                    SetActorProperty(0, APROP_SoundClass, "JamesBondGoldfinger");
				}
				break;

