                                SetInventory("Goldfinger_WaltherP38", 0);
                            } else if (CheckInventory("SamsaraGoldfingerLoadoutFallbackRanged") == 3) {
                                SetInventory("Goldfinger_LugerP08", 1);

                                if (CheckWeapon("Goldfinger_PPKSilenced") || CheckWeapon("Goldfinger_PPK") || CheckWeapon("Goldfinger_ColtM1911") || CheckWeapon("Goldfinger_WaltherP38") || CheckInventory("SamsaraPistolStartMapChangeHack")) { SetWeapon("Goldfinger_LugerP08"); }

                                SetInventory("Goldfinger_PPKSilenced", 0);
                                SetInventory("Goldfinger_PPK", 0);
                                SetInventory("Goldfinger_ColtM1911", 0);
                                SetInventory("Goldfinger_WaltherP38", 0);
                            } else if (CheckInventory("SamsaraGoldfingerLoadoutFallbackRanged") >= 4) {
                                SetInventory("Goldfinger_WaltherP38", 1);

                                if (CheckWeapon("Goldfinger_PPKSilenced") || CheckWeapon("Goldfinger_PPK") || CheckWeapon("Goldfinger_ColtM1911") || CheckWeapon("Goldfinger_LugerP08") || CheckInventory("SamsaraPistolStartMapChangeHack")) { SetWeapon("Goldfinger_WaltherP38"); }

                                SetInventory("Goldfinger_PPKSilenced", 0);
                                SetInventory("Goldfinger_PPK", 0);
                                SetInventory("Goldfinger_ColtM1911", 0);
                                SetInventory("Goldfinger_LugerP08", 0);
                            }
                        }
