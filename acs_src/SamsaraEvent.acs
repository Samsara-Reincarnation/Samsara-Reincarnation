                                if (CheckWeapon("Goldfinger_SmithWesson22") || CheckWeapon("Goldfinger_SmithWesson36")) { SetWeapon("Goldfinger_UZI"); }

                                SetInventory("Goldfinger_SmithWesson22", 0);
                                SetInventory("Goldfinger_SmithWesson36", 0);
