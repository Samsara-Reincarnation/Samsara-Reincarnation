			SFAD ABCDEFGHIJKLMNOPQRSTU 2
			SFAD V 0 A_NoBlocking
			SFAD V 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SFAD "VWXYZ[\]" 2
			SFAE ABCDEFGHI 2
