Actor SoF_EnablePain : Trigger
{
	States
	{
		Pickup:
			TNT1 A 0 A_ChangeFlag("NOPAIN",false)
			Stop
	}
}

Actor SoF_DisablePain : Trigger
{
	States
	{
		Pickup:
			TNT1 A 0 A_ChangeFlag("NOPAIN",true)
			Stop
	}
}