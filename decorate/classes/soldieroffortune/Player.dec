			SF9B "TUVWXYZ[\]" 2
			SF9C A 2
			SF9C B -1
			Stop
		//Headshot Death
		DeathHeadShot:	
			SF9D A 0 A_PlayerScream
			SF9D ABCDEFGHIJK 2
			SF9D L 0 A_NoBlocking
			SF9D L 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SF9D LMNOPQRSTUVWXYZ 2
