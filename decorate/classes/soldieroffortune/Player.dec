		//Stand to Knees death animation
		DeathViolent:	
			SFB5 A 0 A_PlayerScream
			SFB5 ABCDEFG 2
			SFB5 H 0 A_NoBlocking
			SFB5 H 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SFB5 HIJKLMNOPQRSTU 2
			SFB5 V -1
