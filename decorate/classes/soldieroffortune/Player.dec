		//Pain Animations
		Pain:
			TNT1 A 0 A_TakeInventory("Hexen2EnemyFireDetector", 1)
			TNT1 A 0 A_GiveInventory("SoF_PainToken")
			TNT1 A 0 A_ChangeFlag("NOPAIN",true)
			TNT1 A 0 A_Pain
			TNT1 A 0 A_Jump(256,"PainArmLeft","PainArmRight","PainKneeLeft","PainKneeRight")
			Goto Spawn
		PainArmLeft:
			SF94 ABC 2
			Goto PainEnd
		PainArmRight:
			SF95 ABC 2
			Goto PainEnd
		PainKneeLeft:
			SF9F ABC 2
			Goto PainEnd
		PainKneeRight:
			SFA0 ABC 2
			Goto PainEnd
		PainEnd:
			TNT1 A 0 A_ChangeFlag("NOPAIN",false)
			TNT1 A 0 A_TakeInventory("SoF_PainToken")
			Goto Spawn
			
		Pain.SoFMPGLaser:
			TNT1 A 0 A_TakeInventory("Hexen2EnemyFireDetector", 1)
			TNT1 A 0 A_GiveInventory("SoF_PainToken")
			TNT1 A 0 A_ChangeFlag("NOPAIN",true)
			TNT1 A 0 A_Pain
			TNT1 A 0 A_JumpIfInventory("SoF_PainToken",1,"Spawn")
			TNT1 A 0 A_Jump(256,"PainMPGBack","PainMPGFront")
			Goto Spawn
		PainMPGBack:
			SFB1 ABC 2
			Goto PainEnd
		PainMPGFront:
			SFB3 ABC 2
			Goto PainEnd
		
		//Death Animations
		Death:
			TNT1 A 0 A_SpawnItem("UniversalBloodyHellGoreDeathEffect")
		Death.Massacre:
			TNT1 A 0 A_ChangeFlag("NOPAIN",false)
			TNT1 A 0 A_TakeInventory("SoF_PainToken")
			TNT1 A 0 A_Jump(256,"DeathChest","DeathGroin","DeathGut","DeathHeadShot","DeathLegLeft","DeathLegRight","DeathShoulderLeft","DeathShoulderRight","DeathThroat","DeathStandToKnees","DeathViolent")
			TNT1 A -1
			Stop
		//The only animation when dying while crouched
		CrouchDeath:
			SF29 A 0 A_PlayerScream
			SF29 ABCDEFGHI 2
			SF29 J 0 A_NoBlocking
			SF29 J 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SF29 JKLMNOPQRSTUVW 2
			SF29 X -1
			Stop
		//Use this if the player gets blown back, lots of backward velocity
		DeathBlowBack:
			SF96 ABCDEF 2
			SF96 G 0 A_NoBlocking
			SF96 G 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SF96 GHIJKLMNOPQRSTUVWXY 2
			SF96 Z -1
			Stop
		//This looks like a high velocity forward death animation
		DeathBlowForward:
			SF9E A 0 A_Jump(128,"DeathStumble")
			SF9E ABCDEFGHI 2
			SF9E J 0 A_NoBlocking
			SF9E J 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SF9E KLMNOPQR 2
			SF9E S -1
			Stop
		//Another variation of death with a high forward velocity
		DeathStumble:
			SFAC ABCDEFGHIKLMN 2
			SFAC O 0 A_NoBlocking
			SFAC O 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SFAC OPQRSTUVWXYZ 2
			SFAC "[" -1
			Stop			
		//Chest Death Animation
		DeathChest:
