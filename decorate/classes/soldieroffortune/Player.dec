			SFA7 A 0 A_PlayerScream
			SFA7 ABCDEFGHIJKLMNOPQRST 2
			SFA7 U 0 A_NoBlocking
			SFA7 U 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SFA7 "UVWXYZ[\]" 2
