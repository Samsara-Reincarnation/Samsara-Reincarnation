			"####" A 0 A_ChangeFlag("SOLID",false)
			"####" A 0 A_SpawnItemEx("SoF_BloodPoolSpawnerGib",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_NOCHECKPOSITION)
			"####" A 0 A_SpawnItemEx("SoF_GibSpawner",0,0,0,0,0,0,0,SXF_SETMASTER)
			"####" A 5
