Actor SoFClass : Boolean {}
Actor SoF_SelectedWeapon : Counter {}
Actor SoF_LastWeapon : TemporaryCounter {}
Actor SoF_PlayerJumping : TemporaryBoolean {}
Actor SoF_ShootingToken : TemporaryBoolean {}
Actor SoF_PainToken : TemporaryBoolean {}

Actor JohnMullins : SamsaraPlayerPawnNormalRedBlood
{
	Player.Scoreicon "SR36ICON"
	Player.StartItem "SoFClass", 1
	Player.StartItem "IsSamsaraClass", 1
	Player.StartItem "SamsaraTipsChecker", 1
	Player.StartItem "SoF_Pistol1"
	Player.StartItem "SoF_Pistol1Magazine", 18
	Player.StartItem "SoF_Knife"
	Player.StartItem "SoF_Knives", 3
	Player.StartItem "SoF_Pistol2Magazine", 9
	Player.StartItem "SoF_AssaultRifleMagazine", 40
	Player.StartItem "SoF_ShotgunMagazine", 8
	Player.StartItem "SoF_MachinegunMagazine", 40
	Player.StartItem "SoF_RocketMagazine", 4
	Player.StartItem "SoF_FlameGunMagazine", 60
	Player.StartItem "SoF_SluggerMagazine", 20
	Player.StartItem "SoF_MPGMagazine", 30
	Player.StartItem "SoF_MPistolMagazine", 32
	Player.StartItem "SoF_SniperMagazine", 6
	Player.StartItem "SoF_SelectedWeapon", 2
	Player.StartItem "Clip", 50
	Player.DisplayName "Soldier of Fortune"
	Player.SoundClass "John_Mullins"
	Player.ColorRange 112, 127
	States
	{
		Spawn:
            SF34 A 0 NoDelay ACS_NamedExecuteWithResult("DisableVoodooDoll")
			TNT1 A 0 A_TakeInventory("SoF_PainToken")
			TNT1 A 0 A_ChangeFlag("NOPAIN",false)
		SpawnLauncher:
			SF34 ABCDEFGHIJKLM 2
			Loop
		SpawnShotgun:
		SpawnMachineGun:
			SF35 ABCDEFGHIJKLM 2
			Loop
		SpawnKnife:
			SF36 ABCDEFGHIJKLM 2
			Loop
		SpawnPistol:
			SF37 ABCDEFGHIJ 2
			Loop
		SpawnRifle:
			SF38 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
			Loop
		
		// Walking Animations
		WalkLauncher:
			SFB9 ABCDEFGHIJ 2
			Loop
		WalkShotgun:
		WalkMachineGun:
			SFBA ABCDEFGHIJ 2
			Loop
		WalkKnife:
		WalkPistol:
			SFBB ABCDEFGHIJ 2
			Loop
		WalkRifle:
