		LeanToLauncher9:
			SF51 D 2
			Loop
			
		//Jump (Straight Up)
		JumpStraightKnife:
		JumpStraightPistol:
		JumpStraightRifle:
		JumpStraightShotgun:
		JumpStraightMachineGun:
			SF57 A 0 A_GiveInventory("SoF_PlayerJumping")
			SF57 IJKL 2
			Goto JumpStraightMultiLoop
		JumpStraightMultiLoop:
			SF57 M 2 
			SF57 M 0 A_CheckFloor("JumpStraightMultiEnd")
			Loop
		JumpStraightMultiEnd:
			SF57 NOPQRSTUVWX 2
			SF57 X 2 A_TakeInventory("SoF_PlayerJumping")
			Wait
		JumpStraightLauncher:
			SF58 A 0 A_GiveInventory("SoF_PlayerJumping")
			SF58 IJKL 2
			Goto JumpStraightLauncherLoop
		JumpStraightLauncherLoop:
			SF58 M 2 
			SF58 M 0 A_CheckFloor("JumpStraightLauncherEnd")
			Loop
		JumpStraightLauncherEnd:
			SF58 NOPQRSTUVWX 2
			SF58 X 2 A_TakeInventory("SoF_PlayerJumping")
			Wait
			
		//Jump (Forward)
		JumpForwardKnife:
		JumpForwardPistol:
		JumpForwardRifle:
		JumpForwardShotgun:
		JumpForwardMachineGun:
		JumpForwardLauncher:
			SF56 A 0 A_GiveInventory("SoF_PlayerJumping")
			SF56 ABCD 2
			Goto JumpForwardMultiLoop
		JumpForwardMultiLoop:
			SF56 E 2 
			SF56 E 0 A_CheckFloor("JumpForwardMultiEnd")
			Loop
		JumpForwardMultiEnd:
			SF56 FGHIJKLMNOP 2
			SF56 P 2 A_TakeInventory("SoF_PlayerJumping")
			Wait
		
