		Death.SoFMPGLaser:
			SFA3 A 0 A_PlayerScream
			SFA3 ABCDEFGHIJKLMNO 2
			TNT1 A 0 A_NoBlocking
			TNT1 A 0 A_SpawnItemEx("SoF_BloodPoolSpawnerGib",0,0,0,0,0,0,0,SXF_SETMASTER|SXF_USEBLOODCOLOR|SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("SoF_GibSpawner",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR|SXF_SETMASTER|1048576)
			TNT1 A -1
