			SFA4 ABCDEFGHIJKLMNOPQRSTUVWXYZ 2
			SFA4 "[" 0 A_NoBlocking
			SFA4 "[" 0 A_PlaySound("SoF/Corpse",CHAN_BODY)
			SFA4 "[\]" 2
