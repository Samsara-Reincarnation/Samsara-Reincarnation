Actor SoF_PhosphorusExplosionTrail1
{
    Height 2
    Radius 2
    Projectile
    Damage (0)
    Speed 12
    Gravity 0.75
    +NOTRIGGER
    +BLOODLESSIMPACT
    -NOGRAVITY
    States
    {
        Spawn:
