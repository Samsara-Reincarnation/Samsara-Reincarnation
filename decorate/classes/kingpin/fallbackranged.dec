actor Kingpin_Pistol_Magnum : Boolean {}
actor Kingpin_Pistol_Reload : Boolean {}
actor Kingpin_Pistol_RateOfFire : Boolean {}
actor Kingpin_Pistol_Silencer : Boolean {}
actor Kingpin_Pistol_SilencerActive : Boolean {}

actor Kingpin_Pistol : Kingpin_Weapon
{
    Inventory.PickupMessage "Copped a pistol."
    Weapon.SlotNumber 1
    Weapon.SelectionOrder 1900
    Weapon.AmmoType "Kingpin_PistolMagazine"
    Weapon.AmmoUse 1
    Obituary "%o was busted by %k."
    Tag "Pistol"
    +WIMPY_WEAPON
    States
    {
      Spawn:
        KKPU A -1
        stop

      ReadyActual:
        KP01 A 0 A_TakeInventory("Kingpin_ShootToken")
        KP01 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
      ReadyActualNonReloadable:
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"ReadyActualNonReloadableSilencer")
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadyActualNonReloadableMagnum")
        KP01 ABCDEFGHIJKLMNOP 5 A_WeaponReady
        goto ReadyActual

      ReadyActualNonReloadableMagnum:
        KP11 ABCDEFGHIJKLMNOP 5 A_WeaponReady
        goto ReadyActual

      ReadyActualNonReloadableSilencer:
        KP21 V 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadyActualNonReloadableSilencerMagnum")
        KP21 "VWXYZ[\]" 5 A_WeaponReady
        KP22 ABCDEFGH 5 A_WeaponReady
        TNT1 A 0
        goto ReadyActual

      ReadyActualNonReloadableSilencerMagnum:
        KP31 "VWXYZ[\]" 5 A_WeaponReady
        KP32 ABCDEFGH 5 A_WeaponReady
        TNT1 A 0
        goto ReadyActual

      ReadyActualReloadable:
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"ReadyActualReloadableSilencer")
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadyActualReloadableMagnum")
        KP01 ABCDEFGHIJKLMNOP 5 A_WeaponReady(WRF_ALLOWRELOAD)
        goto ReadyActual

      ReadyActualReloadableMagnum:
        KP11 ABCDEFGHIJKLMNOP 5 A_WeaponReady(WRF_ALLOWRELOAD)
        goto ReadyActual

      ReadyActualReloadableSilencer:
        KP21 V 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadyActualReloadableSilencerMagnum")
        KP21 "VWXYZ[\]" 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP22 ABCDEFGH 5 A_WeaponReady(WRF_ALLOWRELOAD)
        TNT1 A 0
        goto ReadyActual

      ReadyActualReloadableSilencerMagnum:
        KP31 "VWXYZ[\]" 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP32 ABCDEFGH 5 A_WeaponReady(WRF_ALLOWRELOAD)
        TNT1 A 0
        goto ReadyActual

      Deselect:
        KP01 Q 0 A_JumpIfHealthLower(1,"DeselectInstant")
        KP01 Q 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"DeselectSilencer")
        KP01 Q 3 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"DeselectMagnum")
        KP01 RSTU 3
        goto DeselectInstant

      DeselectMagnum:
        KP11 QRSTU 3
        goto DeselectInstant

      DeselectSilencer:
        KP22 I 3 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"DeselectSilencerMagnum")
        KP22 JKLM 3
        goto DeselectInstant

      DeselectSilencerMagnum:
        KP32 IJKLM 3
        goto DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 0 A_GiveInventory("Kingpin_SelectedWeapon",1)
        KP00 A 0 A_PlaySound("Kingpin/Pistol/Holster",CHAN_WEAPON)
        KP00 A 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"ReadySilencer")
        KP00 A 3 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadyMagnum")
        KP00 BCDEF 3
        goto ReadyActual

      ReadyMagnum:
        KP10 ABCDEF 3
        goto ReadyActual

      ReadySilencer:
        KP22 M 3 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReadySilencerMagnum")
        KP22 LKJI 3
        KP21 V 0
        goto ReadyActual

      ReadySilencerMagnum:
        KP32 MLKJI 3
        KP31 V 0
        goto ReadyActual

      Fire:
        KP00 G 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        KP00 G 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto FireStart
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        KP00 G 0 A_JumpIfInventory("Clip",1,"FireStart")
        goto FireDry

      FireReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        KP00 G 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,"FireStart")
      FireReloadableDryCheck:
        KP00 G 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto ReloadStart
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP00 G 0 A_JumpIfInventory("Clip",1,"ReloadStart")
        goto FireDry

      FireDry:
        KP01 A 0 A_ClearReFire
        KP01 A 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"FireDrySilencer")
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"FireDryMagnum")
        KP01 A 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryMagnum:
        KP11 A 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDrySilencer:
        KP21 V 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"FireDrySilencerMagnum")
        KP21 V 15 A_WeaponReady(WRF_NOFIRE)
        TNT1 A 0
        goto ReadyActual

      FireDrySilencerMagnum:
        KP31 V 15 A_WeaponReady(WRF_NOFIRE)
        TNT1 A 0
        goto ReadyActual

      FireStart:
        KP00 G 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 G 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"FireStartSilencer")
        KP00 G 0 A_AlertMonsters
        KP00 G 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 G 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
        KP00 G 0 A_GiveInventory("SamsaraKingpinPistolAttackHandler")
        KP00 G 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"FireStartMagnum")
        KP00 GHIJ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 0 A_JumpIfInventory("Kingpin_Pistol_RateOfFire",1,2)
        KP01 AA 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP01 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP01 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireStartMagnum:
        KP10 GHIJ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 0 A_JumpIfInventory("Kingpin_Pistol_RateOfFire",1,2)
        KP11 AA 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP11 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP11 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireStartSilencer:
        KP20 V 0 A_GiveInventory("SamsaraKingpinPistolAttackHandler")
        KP20 V 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"FireStartSilencerMagnum")
        KP20 VWXY 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 V 0 A_JumpIfInventory("Kingpin_Pistol_RateOfFire",1,2)
        KP21 VV 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 V 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP21 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP21 V 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireStartSilencerMagnum:
        KP30 VWXY 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 V 0 A_JumpIfInventory("Kingpin_Pistol_RateOfFire",1,2)
        KP31 VV 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 V 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP31 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP31 V 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,"ReadyActual")
        goto ReloadCheck

      Flash:
        KP99 GH 3 Bright
        stop

      AltFire:
        KP22 N 0 A_JumpIfInventory("Kingpin_Pistol_Silencer",1,1)
        goto ReadyActual
        KP22 N 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"AltFireRemove")
        goto AltFireAttach

      AltFireAttach:
        KP22 N 0 A_PlaySound("Kingpin/Pistol/SilencerAttach",CHAN_6)
        KP22 N 0 A_GiveInventory("Kingpin_Pistol_SilencerActive")
        KP22 N 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"AltFireAttachMagnum")
        KP22 NO 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 ABCDEFGHIJKLMNOPQRSTU 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 V 0
        goto ReadyActual

      AltFireAttachMagnum:
        KP32 NO 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 ABCDEFGHIJKLMNOPQRSTU 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 V 0
        goto ReadyActual

      AltFireRemove:
        KP20 U 0 A_PlaySound("Kingpin/Pistol/SilencerRemove",CHAN_6)
        KP20 U 0 A_TakeInventory("Kingpin_Pistol_SilencerActive")
        KP20 U 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"AltFireRemoveMagnum")
        KP20 UTSRQPONMLKJIHGFE 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0
        KP00 DEF 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 0
        goto ReadyActual

      AltFireRemoveMagnum:
        KP30 UTSRQPONMLKJIHGFE 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0
        KP10 DEF 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 0
        goto ReadyActual

      Reload:
      ReloadCheck:
        KP01 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",0,"ReadyActual")
        KP01 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto ReloadStart
        KP01 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP01 A 0 A_JumpIfInventory("Clip",1,"ReloadStart")
        goto ReadyActual

      ReloadStart:
        KP00 K 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 K 0 A_PlaySound("Kingpin/Pistol/ReloadOut",CHAN_5)
        goto ReloadAmmo

      ReloadFinish:
        KP00 K 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,"ReloadFinishSilencer")
        KP00 K 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReloadFinishMagnum")
        KP00 KLMNOPQRST 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 U 0 A_JumpIfInventory("Kingpin_Pistol_Reload",1,"ReloadFinishFast")
        KP00 U 0 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP00 UVWXY 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 // I can't do anything about this except kill the interpolation here, which works just fine
        KP00 "Z[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadFinishFast:
        KP00 U 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 V 6 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP01 A 0
        goto ReadyActual

      ReloadFinishMagnum:
        KP10 KLMNOPQRST 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 U 0 A_JumpIfInventory("Kingpin_Pistol_Reload",1,"ReloadFinishMagnumFast")
        KP10 U 0 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP10 UVWXY 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0
        KP10 "Z[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadFinishMagnumFast:
        KP10 U 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 V 6 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP11 A 0
        goto ReadyActual

      ReloadFinishSilencer:
        KP20 Z 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,"ReloadFinishSilencerMagnum")
        KP20 "Z[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 ABCDEF 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 G 0 A_JumpIfInventory("Kingpin_Pistol_Reload",1,"ReloadFinishSilencerFast")
        KP21 G 0 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP21 GHIJK 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0
        KP21 LMNO 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 V 0
        goto ReadyActual

      ReloadFinishSilencerFast:
        KP21 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 H 6 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP21 V 0
        goto ReadyActual

      ReloadFinishSilencerMagnum:
        KP30 "Z[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 ABCDEF 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 G 0 A_JumpIfInventory("Kingpin_Pistol_Reload",1,"ReloadFinishSilencerMagnumFast")
        KP31 G 0 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP31 GHIJK 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0
        KP31 LMNO 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 V 0
        goto ReadyActual

      ReloadFinishSilencerMagnumFast:
        KP31 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 H 6 A_PlaySound("Kingpin/Pistol/ReloadIn",CHAN_5)
        KP31 V 0
        goto ReadyActual

      ReloadAmmo:
        KP11 A 0 A_JumpIfInventory("PistolModeOn",1,"ReloadAmmoReserve")
        KP11 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",0,"ReloadFinish")
        KP11 A 0 A_GiveInventory("Kingpin_PistolMagazine")
        loop

      ReloadAmmoReserve:
        KP11 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",0,"ReloadFinish")
        KP11 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP11 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP11 A 0 A_JumpIfInventory("Clip",1,1)
        goto ReloadFinish
        KP11 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP11 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP11 A 0 A_TakeInventory("Clip",1)
        KP11 A 0 A_GiveInventory("Kingpin_PistolMagazine")
        goto ReloadAmmo
    }
}

actor SamsaraKingpinPistolAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto PickupPlaySound
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupPlaySound")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupPlaySound

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupPlaySound")
        TNT1 A 0 A_JumpIfInventory("Kingpin_PistolMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Kingpin_PistolMagazine",1)
        goto PickupPlaySound

      // Sound playing stuff
      PickupPlaySound:
        TNT1 A 0 A_JumpIfInventory("Kingpin_Pistol_SilencerActive",1,4)
        TNT1 A 0 A_JumpIfInventory("Kingpin_Pistol_Magnum",1,2)
        TNT1 A 0 A_PlaySound("Kingpin/Pistol/Fire",CHAN_WEAPON)
        goto PickupAttack
        TNT1 A 0 A_PlaySound("Kingpin/Magnum/Fire",CHAN_WEAPON)
        goto PickupAttack
        TNT1 A 0 A_PlaySound("Kingpin/Silencer/Fire",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_FireCustomMissile("Kingpin_Casing",-90,0,4,4)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(4,4,-1,0,"Kingpin_BulletSmoke",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(4,4,-1,0,"Kingpin_BulletSmokeCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 3, 96)
        stop
    }
}

actor Kingpin_PistolMagazine : Ammo
{
    Inventory.Amount 10
    Inventory.MaxAmount 10
    Tag "Pistol Magazine"
    +IGNORESKILL
}
