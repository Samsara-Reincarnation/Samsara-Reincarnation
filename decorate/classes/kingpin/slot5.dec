actor Kingpin_Bazooka_LaserSystem : Boolean {}
actor Kingpin_Bazooka_FastRockets : Boolean {}
actor Kingpin_Bazooka_BigBubba : Boolean {}
actor Kingpin_Bazooka_HighExplosives : Boolean {}
actor Kingpin_Bazooka_BigBubbaActive : Boolean {}

actor Kingpin_Bazooka : Kingpin_Weapon
{
    Inventory.PickupMessage "Copped a Bazooka."
    Weapon.SlotNumber 5
    Weapon.SelectionOrder 750
    Weapon.AmmoType1 "Kingpin_BazookaMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "RocketAmmo"
    Weapon.AmmoGive2 5
    Obituary "%o was minced by %k's rocket."
    Tag "Bazooka"
    +EXPLOSIVE
    States
    {
      ReadyActual:
        KP01 B 0 A_TakeInventory("Kingpin_ShootToken")
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"ReadyActualBigBubba")
        KP01 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
      ReadyActualNonReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyActualNonReloadableAmmo")
        KP01 B 0 A_JumpIfInventory("RocketAmmo",1,"ReadyActualNonReloadableAmmo")
        goto ReadyActualNonReloadableNoAmmo

      ReadyActualNonReloadableNoAmmo:
        KP41 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualNonReloadableNoAmmoLaser")
        KP41 BCDEFGHIJKLM 5 A_WeaponReady
        KP41 B 0
        goto ReadyActual

      ReadyActualNonReloadableNoAmmoLaser:
        KP51 BCDEFGHIJKLM 5 A_WeaponReady
        KP51 B 0
        goto ReadyActual

      ReadyActualNonReloadableAmmo:
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualNonReloadableAmmoLaser")
        KP01 BCDEFGHIJKLM 5 A_WeaponReady
        goto ReadyActual

      ReadyActualNonReloadableAmmoLaser:
        KP11 BCDEFGHIJKLM 5 A_WeaponReady
        KP11 B 0
        goto ReadyActual

      ReadyActualReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActualReloadableAmmo")
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"ReadyActualReloadableAmmo")
        goto ReadyActualReloadableNoAmmo

      ReadyActualReloadableNoAmmo:
        KP41 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualReloadableNoAmmoLaser")
        KP41 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP41 B 0
        goto ReadyActual

      ReadyActualReloadableNoAmmoLaser:
        KP51 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP51 B 0
        goto ReadyActual

      ReadyActualReloadableAmmo:
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualReloadableAmmoLaser")
        KP01 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        goto ReadyActual

      ReadyActualReloadableAmmoLaser:
        KP11 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP11 B 0
        goto ReadyActual

      // yeah I'm not doing an slz-styled reload check; this'll behave like the ssg for now (see end of fire states)
      ReadyActualBigBubba:
        KP21 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualBigBubbaReloadable")
      ReadyActualBigBubbaNonReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyActualBigBubbaNonReloadableAmmo")
        KP21 B 0 A_JumpIfInventory("RocketAmmo",5,"ReadyActualBigBubbaNonReloadableAmmo")
        goto ReadyActualBigBubbaNonReloadableNoAmmo

      ReadyActualBigBubbaNonReloadableNoAmmo:
        KP61 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualBigBubbaNonReloadableNoAmmoLaser")
        KP61 BCDEFGHIJKLM 5 A_WeaponReady
        KP61 B 0
        goto ReadyActual

      ReadyActualBigBubbaNonReloadableNoAmmoLaser:
        KP71 BCDEFGHIJKLM 5 A_WeaponReady
        KP71 B 0
        goto ReadyActual

      ReadyActualBigBubbaNonReloadableAmmo:
        KP21 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualBigBubbaNonReloadableAmmoLaser")
        KP21 BCDEFGHIJKLM 5 A_WeaponReady
        KP21 B 0
        goto ReadyActual

      ReadyActualBigBubbaNonReloadableAmmoLaser:
        KP31 BCDEFGHIJKLM 5 A_WeaponReady
        KP31 B 0
        goto ReadyActual

      ReadyActualBigBubbaReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActualBigBubbaReloadableAmmo")
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"ReadyActualBigBubbaReloadableAmmo")
        goto ReadyActualBigBubbaReloadableNoAmmo

      ReadyActualBigBubbaReloadableNoAmmo:
        KP61 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualBigBubbaReloadableNoAmmoLaser")
        KP61 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP61 B 0
        goto ReadyActual

      ReadyActualBigBubbaReloadableNoAmmoLaser:
        KP71 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP71 B 0
        goto ReadyActual

      ReadyActualBigBubbaReloadableAmmo:
        KP21 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyActualBigBubbaReloadableAmmoLaser")
        KP21 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP21 B 0
        goto ReadyActual

      ReadyActualBigBubbaReloadableAmmoLaser:
        KP31 BCDEFGHIJKLM 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP31 B 0
        goto ReadyActual

      Deselect:
        KP01 B 0 A_JumpIfHealthLower(1,"DeselectInstant")
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"DeselectBigBubba")
        KP01 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"DeselectReloadable")
      DeselectNonReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectAmmo")
        KP01 B 0 A_JumpIfInventory("RocketAmmo",1,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"DeselectAmmo")
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectNoAmmo:
        KP41 B 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"DeselectNoAmmoLaser")
        KP41 NOPQR 3
        KP41 S 0
        goto DeselectInstant

      DeselectNoAmmoLaser:
        KP51 BNOPQR 3
        KP51 S 0
        goto DeselectInstant

      DeselectAmmo:
        KP01 B 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"DeselectAmmoLaser")
        KP01 NOPQR 3
        KP01 S 0
        goto DeselectInstant

      DeselectAmmoLaser:
        KP11 BNOPQR 3
        KP11 S 0
        goto DeselectInstant

      DeselectBigBubba:
        KP21 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"DeselectBigBubbaReloadable")
      DeselectBigBubbaNonReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectBigBubbaAmmo")
        KP21 B 0 A_JumpIfInventory("RocketAmmo",5,"DeselectBigBubbaAmmo")
        goto DeselectBigBubbaNoAmmo

      DeselectBigBubbaReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"DeselectBigBubbaAmmo")
        KP21 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"DeselectBigBubbaAmmo")
        goto DeselectBigBubbaNoAmmo

      DeselectBigBubbaNoAmmo:
        KP61 B 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"DeselectBigBubbaNoAmmoLaser")
        KP61 NOPQR 3
        KP61 S 0
        goto DeselectInstant

      DeselectBigBubbaNoAmmoLaser:
        KP71 BNOPQR 3
        KP71 S 0
        goto DeselectInstant

      DeselectBigBubbaAmmo:
        KP21 B 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"DeselectBigBubbaAmmoLaser")
        KP21 NOPQR 3
        KP21 S 0
        goto DeselectInstant

      DeselectBigBubbaAmmoLaser:
        KP31 BNOPQR 3
        KP31 S 0
        goto DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 0 A_GiveInventory("Kingpin_SelectedWeapon",6)
        KP00 A 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"ReadyBigBubba")
        KP00 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyReloadable")
      ReadyNonReloadable:
        KP00 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        KP00 A 0 A_JumpIfInventory("RocketAmmo",1,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyReloadable:
        KP00 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyAmmo")
        KP00 A 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        KP40 A 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyNoAmmoLaser")
        KP40 BCDEF 3
        KP41 B 0
        goto ReadyActual

      ReadyNoAmmoLaser:
        KP50 ABCDEF 3
        KP51 B 0
        goto ReadyActual

      ReadyAmmo:
        KP00 A 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyAmmoLaser")
        KP00 BCDEF 3
        goto ReadyActual

      ReadyAmmoLaser:
        KP10 ABCDEF 3
        KP11 B 0
        goto ReadyActual

      ReadyBigBubba:
        KP20 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyBigBubbaReloadable")
      ReadyBigBubbaNonReloadable:
        KP20 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyBigBubbaAmmo")
        KP20 A 0 A_JumpIfInventory("RocketAmmo",5,"ReadyBigBubbaAmmo")
        goto ReadyBigBubbaNoAmmo

      ReadyBigBubbaReloadable:
        KP20 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyBigBubbaAmmo")
        KP20 A 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"ReadyBigBubbaAmmo")
        goto ReadyBigBubbaNoAmmo

      ReadyBigBubbaNoAmmo:
        KP60 A 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyBigBubbaNoAmmoLaser")
        KP60 BCDEF 3
        KP61 B 0
        goto ReadyActual

      ReadyBigBubbaNoAmmoLaser:
        KP70 ABCDEF 3
        KP71 B 0
        goto ReadyActual

      ReadyBigBubbaAmmo:
        KP20 A 3 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReadyBigBubbaAmmoLaser")
        KP20 BCDEF 3
        KP21 B 0
        goto ReadyActual

      ReadyBigBubbaAmmoLaser:
        KP30 ABCDEF 3
        KP31 B 0
        goto ReadyActual

      Fire:
        KP00 G 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"FireBigBubba")
        KP00 G 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        KP00 G 0 A_JumpIfInventory("RocketAmmo",1,"FireStart")
        goto FireDry

      FireReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        KP00 G 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"FireStart")
      FireReloadableDryCheck:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP00 G 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
        goto FireDry

      FireBigBubba:
        KP20 G 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireBigBubbaReloadable")
      FireBigBubbaNonReloadable:
        KP20 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        KP20 G 0 A_JumpIfInventory("RocketAmmo",5,"FireStart")
        goto FireDry

      FireBigBubbaReloadable:
        KP20 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        KP20 G 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"FireStart")
        goto FireReloadableDryCheck

      FireDry:
        KP41 B 0 A_ClearReFire
        KP41 B 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP41 B 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"FireDryBigBubba")
        KP41 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireDryLaser")
        KP41 B 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryLaser:
        KP51 B 15 A_WeaponReady(WRF_NOFIRE)
        KP51 B 0
        goto ReadyActual

      FireDryBigBubba:
        KP61 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireDryBigBubbaLaser")
        KP61 B 15 A_WeaponReady(WRF_NOFIRE)
        KP61 B 0
        goto ReadyActual

      FireDryBigBubbaLaser:
        KP71 B 15 A_WeaponReady(WRF_NOFIRE)
        KP71 B 0
        goto ReadyActual

      FireStart:
        KP00 G 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 G 0 A_AlertMonsters
        KP00 G 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 G 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"FireStartLastShotCalcBigBubba")
      FireStartLastShotCalc:
        KP00 G 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireStartLastShotCalcReloadable")
      FireStartLastShotCalcNonReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinue")
        KP00 G 0 A_JumpIfInventory("RocketAmmo",2,"FireContinue")
        goto FireContinueLast

      FireStartLastShotCalcReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireContinue")
        KP00 G 0 A_JumpIfInventory("Kingpin_BazookaMagazine",2,"FireContinue")
        goto FireContinueLast

      FireContinue:
        KP00 G 0 A_GiveInventory("SamsaraKingpinBazookaAttackHandler")
        KP00 G 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireContinueLaser")
        KP00 GHIJKLMN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinish:
        KP01 B 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueLaser:
        KP10 GHIJKLMN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishLaser:
        KP11 B 0
        goto FireFinish

      FireContinueLast:
        KP00 G 0 A_GiveInventory("SamsaraKingpinBazookaAttackHandler")
        KP00 G 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireContinueLastLaser")
        KP00 GHIJKL 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 M 0
        KP40 MN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishLast:
        KP41 B 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP41 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP41 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueLastLaser:
        KP10 GHIJKL 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 M 0
        KP50 MN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishLastLaser:
        KP51 B 0
        goto FireFinishLast

      FireStartLastShotCalcBigBubba:
        KP20 G 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireStartLastShotCalcBigBubbaReloadable")
      FireStartLastShotCalcBigBubbaNonReloadable:
        KP00 G 0 A_JumpIfInventory("SamsaraReloadMode",1,"FireContinueLastBigBubba")
        KP20 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinueBigBubba")
        KP20 G 0 A_JumpIfInventory("RocketAmmo",10,"FireContinueBigBubba")
        goto FireContinueLastBigBubba

      FireStartLastShotCalcBigBubbaReloadable:
        KP20 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireContinueBigBubba")
        KP20 G 0 A_JumpIfInventory("Kingpin_BazookaMagazine",10,"FireContinueBigBubba")
        goto FireContinueLastBigBubba

      FireContinueBigBubba:
        KP20 G 0 A_GiveInventory("SamsaraKingpinBazookaAttackHandler")
        KP20 G 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireContinueBigBubbaLaser")
        KP20 GHIJKLMN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishBigBubba:
        KP21 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireFinishBigBubbaReloadable")
        KP21 B 0 A_JumpIfInventory("SamsaraReloadMode",1,"FireFinishBigBubbaNonReloadable") // only play the animation with reloadmode 1
        goto ReadyActual

      FireFinishBigBubbaNonReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP21 B 0 A_JumpIfInventory("RocketAmmo",5,"ReloadStart")
        goto ReadyActual

      FireFinishBigBubbaReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP21 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"ReadyActual")
        goto ReloadCheck

      FireContinueBigBubbaLaser:
        KP30 GHIJKLMN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishBigBubbaLaser:
        KP31 B 0
        goto FireFinishBigBubba

      FireContinueLastBigBubba:
        KP20 G 0 A_GiveInventory("SamsaraKingpinBazookaAttackHandler")
        KP20 G 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"FireContinueLastBigBubbaLaser")
        KP20 GHIJKL 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP60 MN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishLastBigBubba:
        KP61 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireFinishLastBigBubbaReloadable")
        KP61 B 0 A_JumpIfInventory("SamsaraReloadMode",1,"FireFinishLastBigBubbaNonReloadable") // only play the animation with reloadmode 1
        goto ReadyActual

      FireFinishLastBigBubbaNonReloadable:
        KP61 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP61 B 0 A_JumpIfInventory("RocketAmmo",5,"ReloadStart")
        goto ReadyActual

      FireFinishLastBigBubbaReloadable:
        KP61 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP61 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"ReadyActual")
        goto ReloadCheck

      FireContinueLastBigBubbaLaser:
        KP30 GHIJKL 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP70 MN 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishLastBigBubbaLaser:
        KP71 B 0
        goto FireFinishLastBigBubba

      AltFire:
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubba",1,1)
        goto ReadyActual
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"AltFireRockets")
      AltFireBigBubba:
        KP01 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireBigBubbaReloadable")
      AltFireBigBubbaNonReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireBigBubbaSwap")
        KP01 B 0 A_JumpIfInventory("RocketAmmo",5,"AltFireBigBubbaSwap")
        goto ReadyActual

      AltFireBigBubbaReloadable:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireBigBubbaSwap")
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"AltFireBigBubbaSwap")
      AltFireBigBubbaReloadableDryCheck:
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP01 B 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
        goto ReadyActual

      AltFireBigBubbaSwap:
        KP01 B 0 A_PlaySound("Kingpin/Bazooka/ModeSwap",CHAN_5)
        KP01 B 0 A_GiveInventory("Kingpin_Bazooka_BigBubbaActive")
        KP01 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"AltFireBigBubbaSwapLaser")
        KP01 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 B 0
        goto ReadyActual

      AltFireBigBubbaSwapLaser:
        KP11 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 B 0
        goto ReadyActual

      AltFireRockets:
        KP21 B 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireRocketsReloadable")
      AltFireRocketsNonReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireRocketsSwapAmmo")
        KP21 B 0 A_JumpIfInventory("RocketAmmo",5,"AltFireRocketsSwapAmmo")
        KP21 B 0 A_JumpIfInventory("RocketAmmo",1,"AltFireRocketsSwapNoAmmo")
        goto ReadyActual

      AltFireRocketsReloadable:
        KP21 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireRocketsSwapAmmo")
        KP21 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,"AltFireRocketsSwapAmmo")
        KP21 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,"AltFireRocketsSwapNoAmmo")
        goto AltFireBigBubbaReloadableDryCheck

      AltFireRocketsSwapNoAmmo:
        KP61 B 0 A_PlaySound("Kingpin/Bazooka/ModeSwap",CHAN_5)
        KP61 B 0 A_TakeInventory("Kingpin_Bazooka_BigBubbaActive")
        KP61 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"AltFireRocketsSwapNoAmmoLaser")
        KP61 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP60 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      AltFireRocketsSwapNoAmmoLaser:
        KP71 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP70 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 B 0
        goto ReadyActual

      AltFireRocketsSwapAmmo:
        KP21 B 0 A_PlaySound("Kingpin/Bazooka/ModeSwap",CHAN_5)
        KP21 B 0 A_TakeInventory("Kingpin_Bazooka_BigBubbaActive")
        KP21 B 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"AltFireRocketsSwapAmmoLaser")
        KP21 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      AltFireRocketsSwapAmmoLaser:
        KP31 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 "]\[ZYXWVU" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 TSRQPO 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 B 0
        goto ReadyActual

      Reload:
      ReloadCheck:
        KP01 B 0 A_JumpIfInventory("Kingpin_BazookaMagazine",0,"ReadyActual")
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 B 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP01 B 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
        goto ReadyActual

      ReloadStart:
        KP00 O 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 O 0 A_PlaySound("Kingpin/Bazooka/Reload",CHAN_5)
        KP00 O 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
      ReloadFinish:
        KP00 O 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"ReloadFinishBigBubba")
        KP00 O 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReloadFinishLaser")
        KP00 "OPQRSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 A 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadFinishLaser:
        KP10 "OPQRSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 A 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 B 0
        goto ReadyActual

      ReloadFinishBigBubba:
        KP20 O 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,"ReloadFinishBigBubbaLaser")
        KP20 "OPQRSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 A 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 B 0
        goto ReadyActual

      ReloadFinishBigBubbaLaser:
        KP30 "OPQRSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 A 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 B 0
        goto ReadyActual

      ReloadAmmo:
        KP00 O 0 A_JumpIfInventory("Kingpin_BazookaMagazine",0,"ReloadFinish")
        KP00 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP00 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 O 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto ReloadFinish
        KP00 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP00 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 O 0 A_TakeInventory("RocketAmmo",1)
        KP00 O 0 A_GiveInventory("Kingpin_BazookaMagazine")
        loop
    }
}

actor SamsaraKingpinBazookaAttackHandler : Trigger
{
    States
    {
      // Weapon mode checking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"PickupBigBubbaRocket")
      // Rockets
      PickupRocket:
      // Ammo checking/taking stuff
      PickupAmmoCheckRocket:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRocketReloadable")
      PickupAmmoCheckRocketNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      PickupAmmoCheckRocketReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_BazookaMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Kingpin_BazookaMagazine",1)
        goto PickupAttack

      // Big Bubba rockets
      PickupBigBubbaRocket:
      // Ammo checking/taking stuff
      PickupAmmoCheckBigBubbaRocket:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckBigBubbaRocketReloadable")
      PickupAmmoCheckBigBubbaRocketNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",5,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",5)
        goto PickupAttack

      PickupAmmoCheckBigBubbaRocketReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_BazookaMagazine",5,1)
        stop
        TNT1 A 0 A_TakeInventory("Kingpin_BazookaMagazine",5)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Kingpin/Bazooka/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("Kingpin_Bazooka_FastRockets",1,"PickupAttackFast")
      // Normal rockets
      PickupAttackNormal:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackNormalCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackNormalCoop")
      PickupAttackNormalDM:
        TNT1 A 0 A_FireCustomMissile("Kingpin_Rocket",0,false,8,4)
        goto PickupFinish

      PickupAttackNormalCoop:
        TNT1 A 0 A_FireCustomMissile("Kingpin_RocketCoop",0,false,8,4)
        goto PickupFinish

      // Fast rockets
      PickupAttackFast:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackFastCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackFastCoop")
      PickupAttackFastDM:
        TNT1 A 0 A_FireCustomMissile("Kingpin_RocketFast",0,false,8,4)
        goto PickupFinish

      PickupAttackFastCoop:
        TNT1 A 0 A_FireCustomMissile("Kingpin_RocketFastCoop",0,false,8,4)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 5, 96)
        stop
    }
}

actor Kingpin_Rocket
{
    var int user_nukeCounter1;
    Projectile
    Radius 6
    Height 12
    Speed 20
    Damage (0)
    DamageType "KingpinExplosive"
    +FORCERADIUSDMG
    +SKYEXPLODE
    States
    {
      Spawn:
        KP00 A 0
        KP00 A 0 ACS_NamedExecuteWithResult("Kingpin_RocketFlare")
        KP00 A 0 A_SetUserVar("user_nukeCounter1",0)
        KP00 A 0 A_PlaySound("Kingpin/Rocket/Fly",CHAN_BODY,1,true)
      SpawnLaserCheck:
        KP00 A 0 A_JumpIfInventory("Kingpin_Bazooka_LaserSystem",1,1,AAPTR_TARGET)
        goto SpawnHECheck
        KP00 A 0 A_ChangeFlag("SEEKERMISSILE",true)
      SpawnHECheck:
        KP00 A 0 A_JumpIfInventory("Kingpin_Bazooka_HighExplosives",1,1,AAPTR_TARGET)
        goto SpawnLoop
        KP00 A 0 A_SetScale(1.5)
      SpawnLoop:
        KP00 A 0 A_CheckFlag("SEEKERMISSILE",1)
        goto SpawnLoopContinue
        KP00 A 0 ACS_NamedExecuteWithResult("Kingpin_Bazooka", 1)
        KP00 A 0 A_SeekerMissile(0,15,SMF_PRECISE|SMF_LOOK,0,10)
      SpawnLoopContinue:
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/20)*-4,0,(velz/20)*-4,0,0,0,0,0,0,25002)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/20)*-8,0,(velz/20)*-8,0,0,0,0,0,0,25001)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/20)*-12,0,(velz/20)*-12,0,0,0,0,0,0,25001)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/20)*-16,0,(velz/20)*-16,0,0,0,0,0,0,25002)
        KP00 A 1 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/20)*-20,0,(velz/20)*-20,0,0,0,0,0,0,25000)
        goto SpawnLoop

      Death:
        TNT1 A 0 A_PlaySound("silence")
        TNT1 A 0 A_StopSound(CHAN_BODY)
        TNT1 A 0 A_RemoveChildren(true)
        TNT1 A 0 A_JumpIfInventory("Kingpin_Bazooka_BigBubbaActive",1,"DeathNuke",AAPTR_TARGET)
        TNT1 A 0 A_Explode(100+(100*(scalex-1)*2),100+(100*(scalex-1)),XF_HURTSOURCE,true,50)
        TNT1 A 0 A_RadiusGive("Kingpin_ExplosionRecoil",512,RGF_PLAYERS)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_5)
        TNT1 AAAAAAAA 0 A_CustomMissile("Kingpin_ExplosionTrail",20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionEffect",0,0,32*scalex,0,0,0,0,SXF_TRANSFERSCALE)
        TNT1 A 1 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,32*scalex,0,0,0,0,SXF_TRANSFERSCALE)
        stop

      DeathNuke:
        TNT1 A 0 A_Explode(500+(500*(scalex-1)*2),100+(100*(scalex-1)),XF_HURTSOURCE,true)
        TNT1 A 0 A_PlaySound("Kingpin/Nuke/Explosion",CHAN_5,1,false,0.1)
        TNT1 A 0 A_Quake(5,90,0,1024,"nosoundforyoubitch")
        TNT1 A 0 A_RadiusGive("Kingpin_NukeFlash",1024,RGF_PLAYERS)
      DeathNukeLoop:
        TNT1 A 0 A_JumpIf(user_nukeCounter1 >= 90, "DeathNukeFinish")
        TNT1 A 0 A_SetUserVar("user_nukeCounter1",user_nukeCounter1+1)
        TNT1 A 0 A_Explode(10+(10*(scalex-1)*2),200+(200*(scalex-1)),XF_HURTSOURCE,true)
        TNT1 A 0 A_JumpIf((user_nukeCounter1 % 6) < 5, 4)
        TNT1 A 0 A_JumpIf(ceilingz - z < 100 * scalex, 2)
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",100*scalex,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        goto DeathNukeCloud
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",(ceilingz-z)/2,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
      DeathNukeCloud:
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,0,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,30,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,60,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,90,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,120,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,150,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,180,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,210,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,240,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,270,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,300,SXF_TRANSFERSCALE)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionNukeEffect",0,0,0,0,0,25*scalex,330,SXF_TRANSFERSCALE)
        TNT1 A 0 A_JumpIf((user_nukeCounter1 % 6) == 5, 13)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,0)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,30)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,60)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,90)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,120)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,150)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,180)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,210)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,240)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,270)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,300)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,0,5,0,0,330)
        TNT1 A 1 A_SpawnItemEx("Kingpin_ExplosionEffect",0,0,32*scalex,0,0,3)
        goto DeathNukeLoop

      DeathNukeFinish:
        TNT1 A 1
        stop
    }
}

