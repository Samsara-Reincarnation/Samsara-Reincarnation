actor Kingpin_RocketTrail
{
    Radius 2
    Height 4
    RenderStyle "Add"
    Scale 0.25
    +FORCEXYBILLBOARD
    +NOINTERACTION
    States
    {
      Spawn:
        KP01 ABCD 2 Bright A_SetScale(scalex*1.05)
        TNT1 A 0 A_JumpIf(tid > 25002, "Quit")
        KP01 EFGH 3 Bright A_SetScale(scalex*1.055)
        TNT1 A 0 A_JumpIf(tid > 25001, "Quit")
        KP01 IJK 3 Bright A_SetScale(scalex*1.05)
        TNT1 A 0 A_JumpIf(tid > 25000, "Quit")
        KP01 LMN 3 Bright A_SetScale(scalex*1.05)
        stop

      Quit:
        TNT1 A 1
        stop
    }
}

actor Kingpin_Bazooka_LaserTID : Counter {}

actor Kingpin_Bazooka_LaserSight : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_FireBullets(0,0,-1,0,"Kingpin_Bazooka_LaserPuff",FBF_NOFLASH|FBF_NORANDOMPUFFZ,8192)
        stop

      PickupCoop:
        TNT1 A 0 A_FireBullets(0,0,-1,0,"Kingpin_Bazooka_LaserPuffCoop",FBF_NOFLASH|FBF_NORANDOMPUFFZ,8192)
        stop
    }
}

actor Kingpin_Bazooka_LaserPuff
{
    Radius 2
    Height 4
    Scale 0.5
    +ALWAYSPUFF
    +BLOODLESSIMPACT
    +DONTBLAST
    +DONTSPLASH
    +FORCEXYBILLBOARD
    +NOGRAVITY
    +NOINTERACTION
    +NOTIMEFREEZE
    +NOTRIGGER
    +PUFFGETSOWNER
    +PUFFONACTORS
    +SKYEXPLODE
    States
    {
      Spawn:
        KP04 B 0 Bright
        KP04 B 1 Bright ACS_NamedExecuteWithResult("Kingpin_Bazooka", 2)
        stop
    }
}

actor Kingpin_Bazooka_LaserPuffCoop : Kingpin_Bazooka_LaserPuff { +MTHRUSPECIES }

actor Kingpin_Bazooka_Seeker
{
    Radius 1
    Height 1
    Species "KPBazooka"
    +SHOOTABLE
    +NOBLOCKMAP
    +NOBLOOD
    +NODAMAGE
    +THRUACTORS
    States
    {
      Spawn:
        TNT1 A 0
        TNT1 A 2
        stop
    }
}

actor Kingpin_BazookaMagazine : Ammo
{
    Inventory.Amount 5
    Inventory.MaxAmount 5
    Tag "Bazooka Magazine"
    +IGNORESKILL
}
