        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-16,0,(velz/40)*-16,0,0,0,0,0,0,25002)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-20,0,(velz/40)*-20,0,0,0,0,0,0,25001)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-24,0,(velz/40)*-24,0,0,0,0,0,0,25002)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-28,0,(velz/40)*-28,0,0,0,0,0,0,25002)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-32,0,(velz/40)*-32,0,0,0,0,0,0,25002)
        KP00 A 0 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-36,0,(velz/40)*-36,0,0,0,0,0,0,25003)
        KP00 A 1 A_SpawnItemEx("Kingpin_RocketTrail",(sqrt(velx*velx+vely*vely)/40)*-40,0,(velz/40)*-40,0,0,0,0,0,0,25000)
        goto SpawnLoop
    }
}

