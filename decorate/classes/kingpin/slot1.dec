actor Kingpin_Crowbar : Kingpin_Weapon
{
    Inventory.PickupMessage "Copped a crowbar."
    Weapon.SlotNumber 1
    Weapon.SlotPriority 0
    Weapon.SelectionOrder 2000
    Obituary "%o was severely dented by %k."
    Tag "Crowbar"
    +MELEEWEAPON
    States
    {
      ReadyActual:
        KP00 O 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 "OPQRSTUVWXYZ[\]" 5 A_WeaponReady
        KP01 ABC 5 A_WeaponReady
        loop

      Deselect:
        KP00 O 3 A_JumpIfHealthLower(1,"DeselectInstant")
        KP01 DEFG 3
        KP01 H 0
        goto DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 3 A_GiveInventory("Kingpin_SelectedWeapon",2)
        KP00 BCDEF 3
        goto ReadyActual

      Fire:
        KP00 G 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 G 0 A_GiveInventory("SamsaraKingpinCrowbarAttackHandler")
        KP00 GHIJ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 O 0 A_ReFire(1)
        goto ReadyActual
        KP00 L 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 L 0 A_GiveInventory("SamsaraKingpinCrowbarAttackHandler")
        KP00 KLMN 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 O 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual
    }
}

actor SamsaraKingpinCrowbarAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Kingpin/Pipe/Swing",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_FireBullets(0,0,1,0,"Kingpin_MeleeSmoke",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ,64)
        stop

      PickupCoop:
        TNT1 A 0 A_FireBullets(0,0,1,0,"Kingpin_MeleeSmokeCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ,64)
        stop
    }
}
