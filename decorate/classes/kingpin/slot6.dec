actor Kingpin_FlamethrowerSetFear : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_CheckFlag("BOSS","PickupStop")
        TNT1 A 0 A_ChangeFlag("FRIGHTENED",true)
        stop
    }
}

actor Kingpin_FlamethrowerUnSetFear : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_CheckFlag("BOSS","PickupStop")
        TNT1 A 0 A_ChangeFlag("FRIGHTENED",false)
        stop
    }
}

actor Kingpin_FlamethrowerBurner
{
    var int user_radius;
    var int user_height;
    Projectile
    Radius 2
    Height 4
    Speed 0
    Damage (0)
    DamageType "KingpinFire"
	Obituary "%o was roasted in %k's torch."
    +DONTBLAST
    +DONTREFLECT
    +FORCEPAIN
    +FORCERADIUSDMG
    +NODAMAGETHRUST
    +THRUACTORS
    States
    {
      Spawn:
        TNT1 A 0
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_BurnHandler")
      Death:
        TNT1 A 0 A_SetUserVar("user_radius",CallACS("Kingpin_Decorate", 9))
        TNT1 A 0 A_SetUserVar("user_height",CallACS("Kingpin_Decorate", 9, 1))
        TNT1 A 0 A_Explode(CallACS("Kingpin_Decorate", 10),16,0,false,16)
        TNT1 A 0 A_ChangeFlag("PAINLESS",true)
        TNT1 A 0 A_ChangeFlag("FORCEPAIN",false)
        TNT1 A 0 A_GiveInventory("Kingpin_FlamethrowerSetFear",1,AAPTR_TRACER)
      SpawnLoop:
        TNT1 A 0 A_CheckFlag("SHOOTABLE",1,AAPTR_TRACER)
        goto Remove
        TNT1 A 0 A_CheckFlag("CORPSE","Remove",AAPTR_TRACER)
        TNT1 A 0 A_SpawnItemEx("Kingpin_FlamethrowerFireVisual",random(-user_radius/2,user_radius/2),random(-user_radius/2,user_radius/2),random(0,user_height),0,0,0,0,SXF_NOCHECKPOSITION)
        TNT1 A 0 A_Explode(CallACS("Kingpin_Decorate", 10),16,0,false,16)
        TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
        TNT1 A 0 A_CheckFlag("SHOOTABLE",1,AAPTR_TRACER)
        goto Remove
        TNT1 A 0 A_CheckFlag("CORPSE","Remove",AAPTR_TRACER)
        TNT1 A 0 A_Explode(CallACS("Kingpin_Decorate", 10),16,0,false,16)
        TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
        TNT1 A 0 A_CheckFlag("SHOOTABLE",1,AAPTR_TRACER)
        goto Remove
        TNT1 A 0 A_CheckFlag("CORPSE","Remove",AAPTR_TRACER)
        TNT1 A 0 A_SpawnItemEx("Kingpin_FlamethrowerFireVisual",random(-user_radius/2,user_radius/2),random(-user_radius/2,user_radius/2),random(0,user_height),0,0,0,0,SXF_NOCHECKPOSITION)
        TNT1 A 0 A_Explode(CallACS("Kingpin_Decorate", 10),16,0,false,16)
        TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
        TNT1 A 0 A_CheckFlag("SHOOTABLE",1,AAPTR_TRACER)
        goto Remove
        TNT1 A 0 A_CheckFlag("CORPSE","Remove",AAPTR_TRACER)
        TNT1 A 0 A_Explode(CallACS("Kingpin_Decorate", 10),16,0,false,16)
        TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION|WARPF_INTERPOLATE)
        loop

      Remove:
        TNT1 A 0 A_GiveInventory("Kingpin_FlamethrowerUnSetFear",1,AAPTR_TRACER)
        TNT1 A 0 A_TakeInventory("Kingpin_FlamethrowerIgnition",0x7FFFFFFF,0,AAPTR_TRACER)
        TNT1 A 0 A_TakeInventory("Kingpin_FlamethrowerStacker",0x7FFFFFFF,0,AAPTR_TRACER)
        TNT1 A 0 A_TakeInventory("Kingpin_FlamethrowerHitTarget",0x7FFFFFFF,0,AAPTR_TRACER)
        TNT1 A 1 A_TakeInventory("Kingpin_FlamethrowerBurnt",0x7FFFFFFF,0,AAPTR_TRACER)
        stop
    }
}

