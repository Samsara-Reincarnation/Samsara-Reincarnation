actor Kingpin_FlamethrowerStream
{
    Radius 2
    Height 4
    RenderStyle "Add"
    Scale 0.15
    +FORCEXYBILLBOARD
    +NOINTERACTION
    +THRUACTORS
    States
    {
      Spawn:
        KP04 C 0
        TNT1 A 0 A_Stop
        TNT1 A 0 A_JumpIfCloser(32,"Quit")
        TNT1 A 0 A_SpawnItemEx("Kingpin_FlamethrowerStream2",4*cos(pitch),0,4*sin(pitch))
        TNT1 A 0 A_SpawnItemEx("Kingpin_FlamethrowerStream2",-4*cos(pitch),0,-4*sin(pitch))
        KP04 C 1 A_Stop
        stop

      Quit:
        TNT1 A 1
        stop
    }
}

