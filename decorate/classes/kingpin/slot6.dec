actor Kingpin_Flamethrower_Range : Boolean {}
actor Kingpin_Flamethrower_FuelPump : Boolean {}
actor Kingpin_Flamethrower_HotterFlame : Boolean {}
actor Kingpin_Flamethrower_Napalmer : Boolean {}
actor SamsaraKingpinFlamethrowerIdleSoundCheck : Boolean {}
actor SamsaraKingpinFlamethrowerReadyFrame : Counter { Inventory.MaxAmount 11 }
actor SamsaraKingpinFlamethrowerActiveCalls : Boolean {} // for rage rune

actor Kingpin_Flamethrower : Kingpin_Weapon
{
    Inventory.PickupMessage "Flamethrower"
    Weapon.SlotNumber 6
    Weapon.SelectionOrder 300
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 30
    Weapon.AmmoUse 1
    Tag "Flamethrower"
    States
    {
      ReadyActual:
        KP00 O 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 O 0 A_GunFlash("ReadyActualFlash",GFF_NOEXTCHANGE)
        KP00 O 0 A_GiveInventory("SamsaraKingpinFlamethrowerIdleSoundStarter")
        KP00 O 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"ReadyActualFuelPump")
        KP00 O 0 A_TakeInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 O 5 A_WeaponReady
        KP00 P 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 P 5 A_WeaponReady
        KP00 Q 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 Q 5 A_WeaponReady
        KP00 R 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 R 5 A_WeaponReady
        KP00 S 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 S 5 A_WeaponReady
        KP00 T 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 T 5 A_WeaponReady
        KP00 U 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 U 5 A_WeaponReady
        KP00 V 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 V 5 A_WeaponReady
        KP00 W 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 W 5 A_WeaponReady
        KP00 X 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 X 5 A_WeaponReady
        KP00 Y 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 Y 5 A_WeaponReady
        KP00 Z 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP00 Z 5 A_WeaponReady
        loop

      ReadyActualFuelPump:
        KP10 O 0 A_TakeInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 O 5 A_WeaponReady
        KP10 P 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 P 5 A_WeaponReady
        KP10 Q 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 Q 5 A_WeaponReady
        KP10 R 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 R 5 A_WeaponReady
        KP10 S 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 S 5 A_WeaponReady
        KP10 T 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 T 5 A_WeaponReady
        KP10 U 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 U 5 A_WeaponReady
        KP10 V 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 V 5 A_WeaponReady
        KP10 W 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 W 5 A_WeaponReady
        KP10 X 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 X 5 A_WeaponReady
        KP10 Y 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 Y 5 A_WeaponReady
        KP10 Z 0 A_GiveInventory("SamsaraKingpinFlamethrowerReadyFrame") KP10 Z 5 A_WeaponReady
        KP10 O 0
        goto ReadyActual

      ReadyActualFlash:
        KP91 "ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]" 1 Bright
        KP92 "ABCDEFGHIJKLMNOPQRSTUVWXYZ[\]" 1 Bright
        KP93 AB 1 Bright
        stop

      Deselect:
        KP00 O 0 A_GiveInventory("SamsaraKingpinFlamethrowerIdleSoundStopper")
        KP00 O 0 A_GunFlash("DeselectFlash",GFF_NOEXTCHANGE)
        KP00 O 0 A_JumpIfHealthLower(1,"DeselectInstant")
        KP00 O 3 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"DeselectFuelPump")
        KP00 "[\]" 3
        KP01 AB 3
        KP01 C 0 A_GunFlash("StopFlash",GFF_NOEXTCHANGE)
        goto DeselectInstant

      DeselectFuelPump:
        KP10 "O[\]" 3
        KP11 AB 3
        KP11 C 0 A_GunFlash("StopFlash",GFF_NOEXTCHANGE)
        goto DeselectInstant

      DeselectFlash:
        KP91 A 3 Bright
        KP94 ABCD 3 Bright
        KP94 E 0 Bright
        stop

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 0 A_GiveInventory("Kingpin_SelectedWeapon",7)
        KP00 A 0 A_GunFlash("ReadyFlash",GFF_NOEXTCHANGE)
        KP00 A 3 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"ReadyFuelPump")
        KP00 BCDEF 3
        goto ReadyActual

      ReadyFuelPump:
        KP10 ABCDEF 3
        KP10 O 0
        goto ReadyActual

      ReadyFlash:
        KP90 ABCDEF 3
        KP91 A 0
        stop

      Fire:
        KP00 O 0 A_TakeInventory("SamsaraKingpinFlamethrowerActiveCalls")
        KP00 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        KP00 O 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireFuelPump")
        KP00 O 0 A_JumpIfInventory("Cell",2,"FireWaterCheck")
        goto FireDry

      FireFuelPump:
        KP10 O 0 A_JumpIfInventory("Cell",1,"FireWaterCheck")
        goto FireDry

      FireWaterCheck:
        KP00 O 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        KP00 O 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        KP00 O 0 A_ClearReFire
        KP00 O 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP00 O 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireDryFuelPump")
        KP00 O 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryFuelPump:
        KP10 O 15 A_WeaponReady(WRF_NOFIRE)
        KP10 O 0
        goto ReadyActual

      FireStart:
        KP00 O 0 A_GunFlash("StopFlash",GFF_NOEXTCHANGE)
        KP00 O 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireStartFuelPump")
        // silly zan stuff coming up
        KP00 O 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",1,2)  KP00 O 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 P 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",2,2)  KP00 P 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 Q 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",3,2)  KP00 Q 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 R 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",4,2)  KP00 R 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 S 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",5,2)  KP00 S 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 T 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",6,2)  KP00 T 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 U 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",7,2)  KP00 U 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 V 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",8,2)  KP00 V 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 W 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",9,2)  KP00 W 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 X 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",10,2) KP00 X 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        KP00 Y 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",0,2)  KP00 Y 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart
        /*                              endpoint                             */ KP00 Z 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStart

      FireLoopStart:
        KP00 G 0 A_GiveInventory("SamsaraKingpinFlamethrowerIdleSoundStopper")
        KP00 G 0 ACS_NamedExecuteWithResult("Kingpin_Flamethrower")
      FireLoop1:
        KP00 G 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 G 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop1FuelPump")
        KP00 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 G 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 G 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 G 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 G 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 H 0 A_ReFire("FireLoop2")
        goto FireFinish

      FireLoop2:
        KP00 H 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop2FuelPump")
        KP00 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 H 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 H 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 H 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 H 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 H 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 I 0 A_ReFire("FireLoop3")
        goto FireFinish

      FireLoop3:
        KP00 I 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop3FuelPump")
        KP00 I 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 I 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 I 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 I 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 I 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 I 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 J 0 A_ReFire("FireLoop4")
        goto FireFinish

      FireLoop4:
        KP00 J 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop4FuelPump")
        KP00 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 J 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 J 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 J 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 J 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 J 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 K 0 A_ReFire("FireLoop5")
        goto FireFinish

      FireLoop5:
        KP00 K 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop5FuelPump")
        KP00 K 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 K 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 K 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 K 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 K 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 K 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 L 0 A_ReFire("FireLoop6")
        goto FireFinish

      FireLoop6:
        KP00 L 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop6FuelPump")
        KP00 L 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 L 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 L 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 L 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 L 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 L 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 M 0 A_ReFire("FireLoop7")
        goto FireFinish

      FireLoop7:
        KP00 M 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop7FuelPump")
        KP00 M 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 M 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 M 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 M 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 M 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 M 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 N 0 A_ReFire("FireLoop8")
        goto FireFinish

      FireLoop8:
        KP00 N 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireLoop8FuelPump")
        KP00 N 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 N 0 A_JumpIfInventory("Cell",2,1)
        goto FireFinish
        KP00 N 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP00 N 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP00 N 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP00 N 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 G 0 A_ReFire("FireLoop1")
        goto FireFinish

      FireFinish:
        KP00 G 0 A_TakeInventory("Kingpin_Flamethrower_Hold")
        KP00 G 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"FireFinishFuelPump")
        KP00 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 O 0 A_PlaySound("Kingpin/Flamethrower/End",CHAN_AUTO)
        goto ReadyActual

      FireStartFuelPump:
        // I warned you
        KP10 O 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",1,2)  KP10 O 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 P 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",2,2)  KP10 P 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 Q 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",3,2)  KP10 Q 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 R 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",4,2)  KP10 R 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 S 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",5,2)  KP10 S 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 T 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",6,2)  KP10 T 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 U 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",7,2)  KP10 U 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 V 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",8,2)  KP10 V 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 W 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",9,2)  KP10 W 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 X 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",10,2) KP10 X 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        KP10 Y 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerReadyFrame",0,2)  KP10 Y 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump
        /*                              endpoint                             */ KP10 Z 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE) goto FireLoopStartFuelPump

      FireLoopStartFuelPump: // hack
        KP10 G 0
        goto FireLoopStart

      FireLoop1FuelPump:
        KP10 G 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 G 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 G 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 G 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 G 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 H 0 A_ReFire("FireLoop2")
        goto FireFinish

      FireLoop2FuelPump:
        KP10 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 H 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 H 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 H 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 H 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 H 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 I 0 A_ReFire("FireLoop3")
        goto FireFinish

      FireLoop3FuelPump:
        KP10 I 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 I 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 I 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 I 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 I 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 I 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 J 0 A_ReFire("FireLoop4")
        goto FireFinish

      FireLoop4FuelPump:
        KP10 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 J 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 J 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 J 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 J 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 J 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 K 0 A_ReFire("FireLoop5")
        goto FireFinish

      FireLoop5FuelPump:
        KP10 K 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 K 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 K 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 K 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 K 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 K 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 L 0 A_ReFire("FireLoop6")
        goto FireFinish

      FireLoop6FuelPump:
        KP10 L 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 L 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 L 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 L 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 L 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 L 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 M 0 A_ReFire("FireLoop7")
        goto FireFinish

      FireLoop7FuelPump:
        KP10 M 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 M 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 M 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 M 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 M 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 M 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 N 0 A_ReFire("FireLoop8")
        goto FireFinish

      FireLoop8FuelPump:
        KP10 N 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 N 0 A_JumpIfInventory("Cell",1,1)
        goto FireFinish
        KP10 N 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        KP10 N 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireFinish")
        KP10 N 0 A_GiveInventory("Kingpin_Flamethrower_AmmoTaker")
        KP10 N 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 G 0 A_ReFire("FireLoop1")
        goto FireFinish

      FireFinishFuelPump:
        KP10 G 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 O 0 A_PlaySound("Kingpin/Flamethrower/End",CHAN_AUTO)
        goto ReadyActual

      StopFlash:
        TNT1 A 1
        stop
    }
}

actor Kingpin_Flamethrower_Hold : Boolean {}

actor Kingpin_Flamethrower_AmmoTaker : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("Kingpin_Flamethrower_FuelPump",1,"PickupFuelPump")
      // Normal
      PickupNormal:
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",2)
        stop

      // Fuel pump
      PickupFuelPump:
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        stop
    }
}

actor Kingpin_Flamethrower_FireTrigger : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireStream",0,false,10,8)
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFire",0,false,16,4)
        TNT1 A 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerActiveCalls",1,2)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinFlamethrowerActiveCalls")
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
        goto PickupTakeCalls
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireStream",0,false,10,8)
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFire",0,false,16,4)
        goto PickupTakeCalls

      PickupCoop:
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireStreamCoop",0,false,10,8)
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireCoop",0,false,16,4)
        TNT1 A 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerActiveCalls",1,2)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinFlamethrowerActiveCalls")
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
        goto PickupTakeCalls
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireStreamCoop",0,false,10,8)
        TNT1 A 0 A_FireCustomMissile("Kingpin_FlamethrowerFireCoop",0,false,16,4)
        goto PickupTakeCalls

      // Active call taking stuff
      PickupTakeCalls:
        TNT1 A 0 A_TakeInventory("SamsaraKingpinFlamethrowerActiveCalls")
        stop
    }
}

actor SamsaraKingpinFlamethrowerIdleSoundStarter : Trigger
{
    States
    {
      // Sound starting stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Kingpin/Flamethrower/Twitch",CHAN_5,1,true)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinFlamethrowerIdleSoundCheck")
        stop
    }
}

actor SamsaraKingpinFlamethrowerIdleSoundStopper : Trigger
{
    States
    {
      // Sound stopping stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraKingpinFlamethrowerIdleSoundCheck",1,1)
        stop
        TNT1 A 0 A_PlaySound("silence",CHAN_5)
        TNT1 A 0 A_StopSound(CHAN_5)
        TNT1 A 0 A_TakeInventory("SamsaraKingpinFlamethrowerIdleSoundCheck")
        stop
    }
}

actor Kingpin_FlamethrowerFire
{
    Projectile
    Radius 2
    Height 4
    Speed 24
    Damage (10)
    Gravity 0.33
    Scale 0.5
	Obituary "%o was roasted in %k's torch."
    +BLOODLESSIMPACT
    +NOTRIGGER
    +THRUACTORS
    States
    {
      Spawn:
        TNT1 A 0
        TNT1 A 1
      Death:
        TNT1 A 0 A_SetArg(0,1+CallACS("Kingpin_ReturnUpgrade", 21))
        TNT1 A 0 A_SetScale(scalex+(0.25*(args[0]-1)))
        TNT1 A 0 A_ChangeVelocity(12*(sqrt(velx*velx+vely*vely)/24)*args[0],0,12*(velz/24)*args[0],CVF_RELATIVE|CVF_REPLACE)
        TNT1 A 1 A_SpawnItemEx("Kingpin_FlamethrowerFireEffect",0,0,0,velx+frandom(-1,1),vely+frandom(-1,1),velz+frandom(-1,1),0,SXF_ABSOLUTEVELOCITY|SXF_TRANSFERPOINTERS|SXF_TRANSFERSCALE)
        stop
    }
}

