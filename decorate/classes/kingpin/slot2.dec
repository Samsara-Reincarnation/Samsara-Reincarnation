actor Kingpin_Shotgun_Magazine : Boolean {}
actor Kingpin_Shotgun_DoubleBarrel : Boolean {}
actor Kingpin_Shotgun_SelectFire : Boolean {}
actor Kingpin_Shotgun_BleedShot : Boolean {}
actor Kingpin_Shotgun_DoubleBarrelAlternate : Boolean {}
actor SamsaraKingpinShotgunAmmoCheckFailed : Boolean {} // just in case

actor Kingpin_Shotgun : Kingpin_Weapon
{
    Inventory.PickupMessage "Shotgun"
    Weapon.SlotNumber 2
    Weapon.SelectionOrder 800
    Weapon.AmmoType1 "Kingpin_ShotgunMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Shell"
    Weapon.AmmoGive2 8
    Tag "Shotgun"
    States
    {
      ReadyActual:
        KP01 E 0 A_TakeInventory("Kingpin_ShootToken")
        KP01 E 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
      ReadyActualNonReloadable:
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReadyActualNonReloadableDouble")
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyActualNonReloadableMagazine")
        KP01 EFGHIJKL 5 A_WeaponReady
        goto ReadyActual

      ReadyActualNonReloadableMagazine:
        KP11 EFGHIJKL 5 A_WeaponReady
        KP11 E 0
        goto ReadyActual

      ReadyActualNonReloadableDouble:
        KP21 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyActualNonReloadableDoubleMagazine")
        KP21 EFGHIJKL 5 A_WeaponReady
        KP21 E 0
        goto ReadyActual

      ReadyActualNonReloadableDoubleMagazine:
        KP31 EFGHIJKL 5 A_WeaponReady
        KP31 E 0
        goto ReadyActual

      ReadyActualReloadable:
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReadyActualReloadableDouble")
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyActualReloadableMagazine")
        KP01 EFGHIJKL 5 A_WeaponReady(WRF_ALLOWRELOAD)
        goto ReadyActual

      ReadyActualReloadableMagazine:
        KP11 EFGHIJKL 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP11 E 0
        goto ReadyActual

      ReadyActualReloadableDouble:
        KP21 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyActualReloadableDoubleMagazine")
        KP21 EFGHIJKL 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP21 E 0
        goto ReadyActual

      ReadyActualReloadableDoubleMagazine:
        KP31 EFGHIJKL 5 A_WeaponReady(WRF_ALLOWRELOAD)
        KP31 E 0
        goto ReadyActual

      Deselect:
        KP01 E 0 A_JumpIfHealthLower(1,"DeselectInstant")
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"DeselectDouble")
        KP01 E 3 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"DeselectMagazine")
        KP01 MNOP 3
        KP01 Q 0
        goto DeselectInstant

      DeselectMagazine:
        KP11 EMNOP 3
        KP11 Q 0
        goto DeselectInstant

      DeselectDouble:
        KP21 E 3 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"DeselectDoubleMagazine")
        KP21 MNOP 3
        KP21 Q 0
        goto DeselectInstant

      DeselectDoubleMagazine:
        KP31 EMNOP 3
        KP31 Q 0
        goto DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 0 A_GiveInventory("Kingpin_SelectedWeapon",3)
        KP00 A 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReadyDouble")
        KP00 A 3 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyMagazine")
        KP00 BCDE 3
        goto ReadyActual

      ReadyMagazine:
        KP10 ABCDE 3
        goto ReadyActual

      ReadyDouble:
        KP20 A 3 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReadyDoubleMagazine")
        KP20 BCDE 3
        goto ReadyActual

      ReadyDoubleMagazine:
        KP30 ABCDE 3
        goto ReadyActual

      Fire:
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"FireDouble")
        KP00 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        KP00 F 0 A_JumpIfInventory("Shell",1,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        KP00 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"FireWaterCheck")
      FireReloadableDryCheck:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP00 F 0 A_JumpIfInventory("Shell",1,"ReloadStart")
        goto FireDry

      FireDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadableDouble")
      FireNonReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        KP20 F 0 A_JumpIfInventory("Shell",2,"FireWaterCheck")
        KP20 F 0 A_JumpIfInventory("Shell",1,"AltFireWaterCheckDouble")
        goto FireDry

      FireReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        KP20 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",2,"FireWaterCheck")
        KP20 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"AltFireWaterCheckDouble")
      FireReloadableDryCheckDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP20 F 0 A_JumpIfInventory("Shell",1,"ReloadStart")
        goto FireDry

      FireWaterCheck:
        KP00 F 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        KP00 F 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        KP01 E 0 A_ClearReFire
        KP01 E 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"FireDryDouble")
        KP01 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireDryMagazine")
        KP01 E 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryMagazine:
        KP11 E 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryDouble:
        KP21 E 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireDryDoubleMagazine")
        KP21 E 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryDoubleMagazine:
        KP31 E 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireStart:
        KP00 F 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 F 0 A_AlertMonsters
        KP00 F 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"FireStartDouble")
        KP00 F 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
      FireStartLastShotCalc:
        KP00 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireStartLastShotCalcReloadable")
      FireStartLastShotCalcNonReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinue")
        KP00 F 0 A_JumpIfInventory("Shell",2,"FireContinue")
        goto FireContinueLast

      FireStartLastShotCalcReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireContinue")
        KP00 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",2,"FireContinue")
        goto FireContinueLast

      FireContinue:
        KP00 F 0 A_GiveInventory("SamsaraKingpinShotgunSingleAttackHandler")
        KP00 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireContinueMagazine")
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueSelect")
        KP00 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP00 J 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP00 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP00 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinish:
        KP01 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP01 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueSelect:
        KP00 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP00 F 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP00 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 I 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinish

      FireContinueMagazine:
        KP10 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueMagazineSelect")
        KP10 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP10 J 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP10 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP10 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishMagazine:
        KP11 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP11 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP11 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueMagazineSelect:
        KP10 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP10 F 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP10 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 I 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishMagazine

      FireContinueLast:
        KP00 F 0 A_GiveInventory("SamsaraKingpinShotgunSingleAttackHandler")
        KP00 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireContinueLastMagazine")
        KP00 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueSelect") // can just reuse the non-last Select states
        KP00 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP00 R 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP00 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      FireFinishLast:
        KP00 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP00 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueLastMagazine:
        KP10 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueMagazineSelect")
        KP10 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP10 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP10 R 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP10 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      FireFinishLastMagazine:
        KP10 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP10 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP10 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireStartDouble:
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrelAlternate",1,"AltFireStartFromFireDouble")
        KP20 F 0 A_GunFlash("FlashDouble",GFF_NOEXTCHANGE)
      FireStartLastShotCalcDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireStartLastShotCalcReloadableDouble")
      FireStartLastShotCalcNonReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinueDouble")
        KP20 F 0 A_JumpIfInventory("Shell",3,"FireContinueDouble")
        goto FireContinueLastDouble

      FireStartLastShotCalcReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireContinueDouble")
        KP20 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",3,"FireContinueDouble")
        goto FireContinueLastDouble

      FireContinueDouble:
        KP20 F 0 A_GiveInventory("SamsaraKingpinShotgunDoubleAttackHandler")
        KP20 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireContinueDoubleMagazine")
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueDoubleSelect")
        KP20 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP20 JJ 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP20 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishDouble:
        KP21 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP21 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP21 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueDoubleSelect:
        KP20 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP20 FF 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 IE 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishDouble

      FireContinueDoubleMagazine:
        KP30 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueDoubleMagazineSelect")
        KP30 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP30 JJ 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP30 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishDoubleMagazine:
        KP31 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP31 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP31 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueDoubleMagazineSelect:
        KP30 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP30 FF 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 IE 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishDoubleMagazine

      FireContinueLastDouble:
        KP20 F 0 A_GiveInventory("SamsaraKingpinShotgunDoubleAttackHandler")
        KP20 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"FireContinueLastDoubleMagazine")
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueDoubleSelect")
        KP20 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP20 RR 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      FireFinishLastDouble:
        KP20 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP20 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP20 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueLastDoubleMagazine:
        KP30 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"FireContinueDoubleMagazineSelect")
        KP30 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,3)
        KP30 RR 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      FireFinishLastDoubleMagazine:
        KP31 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP31 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP31 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      Flash:
        KP99 FG 3 Bright
        stop

      FlashDouble:
        KP97 FG 3 Bright
        stop

      AltFire:
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"AltFireDouble")
        goto ReadyActual

      AltFireDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadableDouble")
      AltFireNonReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireWaterCheckDouble")
        KP20 F 0 A_JumpIfInventory("Shell",1,"AltFireWaterCheckDouble")
        goto FireDry

      AltFireReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireWaterCheckDouble")
        KP20 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"AltFireWaterCheckDouble")
      AltFireReloadableDryCheckDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP20 F 0 A_JumpIfInventory("Shell",1,"ReloadStart")
        goto FireDry

      AltFireWaterCheckDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"AltFireStartDouble")
        KP20 F 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto AltFireStartDouble

      AltFireStartDouble:
        KP20 F 0 A_GiveInventory("Kingpin_ShootToken")
        KP20 F 0 A_AlertMonsters
        KP20 F 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
      AltFireStartFromFireDouble:
        KP20 F 0 A_GunFlash("AltFlashDouble",GFF_NOEXTCHANGE)
      AltFireStartLastShotCalcDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireStartLastShotCalcReloadableDouble")
      AltFireStartLastShotCalcNonReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireContinueDouble")
        KP20 F 0 A_JumpIfInventory("Shell",2,"AltFireContinueDouble")
        goto AltFireContinueLastDouble

      AltFireStartLastShotCalcReloadableDouble:
        KP20 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireContinueDouble")
        KP20 F 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",2,"AltFireContinueDouble")
        goto AltFireContinueLastDouble

      AltFireContinueDouble:
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrelAlternate",1,"AltFireContinueDouble2")
      AltFireContinueDouble1:
        KP20 F 0 A_GiveInventory("SamsaraKingpinShotgunSingleAttackHandler")
        KP20 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 1)
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"AltFireContinueDoubleMagazineSelect")
        goto AltFireContinueDoubleSelect

      AltFireContinueDouble2:
        KP20 F 0 A_GiveInventory("SamsaraKingpinShotgunSingleAttackHandler")
        KP20 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 1)
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"AltFireContinueDoubleMagazine2")
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"AltFireContinueDoubleSelect")
        KP20 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP20 J 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP20 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      AltFireFinishDouble:
        KP21 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP21 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP21 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      AltFireContinueDoubleSelect: // also used for left barrel without select fire
        KP20 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP20 F 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 I 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinishDouble

      AltFireContinueDoubleMagazine2:
        KP30 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"AltFireContinueDoubleMagazineSelect")
        KP30 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 J 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP30 J 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 J 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
        KP30 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      AltFireFinishDoubleMagazine:
        KP31 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP31 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP31 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      AltFireContinueDoubleMagazineSelect:
        KP30 F 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP30 F 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 FGH 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 I 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinishDoubleMagazine

      AltFireContinueLastDouble:
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrelAlternate",1,1)
        goto AltFireContinueDouble1
        KP20 F 0 A_GiveInventory("SamsaraKingpinShotgunSingleAttackHandler")
        KP20 F 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 1)
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"AltFireContinueLastDoubleMagazine")
        KP20 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"AltFireContinueDoubleSelect")
        KP20 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP20 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP20 R 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP20 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      AltFireFinishLastDouble:
        KP20 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP20 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP20 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      AltFireContinueLastDoubleMagazine:
        KP30 F 0 A_JumpIfInventory("Kingpin_Shotgun_SelectFire",1,"AltFireContinueDoubleMagazineSelect")
        KP30 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP30 R 0 A_JumpIfInventory("SamsaraKingpinShotgunAmmoCheckFailed",1,2)
        KP30 R 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        KP30 R 0 A_PlaySound("Kingpin/Shotgun/Cock",CHAN_5)
      AltFireFinishLastDoubleMagazine:
        KP30 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP30 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP30 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReadyActual")
        goto ReloadCheck

      AltFlashDouble:
        KP99 F 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrelAlternate",1,"AltFlashDoubleRight")
      AltFlashDoubleLeft:
        KP99 FG 3 Bright
        stop

      AltFlashDoubleRight:
        KP98 FG 3 Bright
        stop

      Reload:
      ReloadCheck:
        KP01 E 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",0,"ReadyActual")
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP01 E 0 A_JumpIfInventory("Shell",1,"ReloadStart")
        goto ReadyActual

      ReloadStart:
        KP00 R 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 R 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReloadStartDouble")
        KP00 R 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReloadStartMagazine")
        KP00 RSTU 3 A_WeaponReady(WRF_NOFIRE)
      ReloadLoopInit:
        KP00 V 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReloadFinish
        // allow interrupting the sequence before ammo calculations take effect by firing either mode
        KP00 V 0 A_JumpIfInventory("SamsaraSynthFireLeft",1,"ReloadLoopFireCheckPrimary")
        KP00 V 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,1)
        goto ReloadLoopAmmoCheck
        KP00 V 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"ReloadLoopFireCheckSecondary")
      ReloadLoopAmmoCheck:
        KP00 V 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",0,"ReloadFinish")
        KP00 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP00 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 V 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinish
        KP00 V 0 A_PlaySound("Kingpin/Shotgun/Reload",CHAN_7)
        goto ReloadLoopAnim

      ReloadLoopFireCheckPrimary:
        KP00 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire")
        KP00 V 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"Fire")
        goto ReloadLoopAmmoCheck

      ReloadLoopFireCheckSecondary:
        KP00 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFire")
        KP00 V 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"AltFire")
        goto ReloadLoopAmmoCheck

      ReloadLoopAnim:
        KP00 V 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReloadLoopAnimWithAmmo")
        KP00 V 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,"ReloadLoopAnimWithAmmo")
        KP00 V 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReloadLoopAnimDouble")
        KP00 "VWXYZ[\]" 3 A_WeaponReady(WRF_NOFIRE)
        KP00 V 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        goto ReloadLoopInit

      ReloadLoopAnimWithAmmo:
        KP00 V 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReloadLoopAnimWithAmmoDouble")
        KP00 "VWXYZ[\]" 3 A_WeaponReady(WRF_NOSECONDARY)
        KP00 V 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        goto ReloadLoopInit

      ReloadFinish:
        KP01 A 0 A_JumpIfInventory("Kingpin_Shotgun_DoubleBarrel",1,"ReloadFinishDouble")
        KP01 ABCD 3 A_WeaponReady(WRF_NOSECONDARY)
        goto ReadyActual

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",0,"ReloadAmmoCalcFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadAmmoCalcFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadAmmoCalcFinish
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("Kingpin_ShotgunMagazine")
        loop

      ReloadAmmoCalcFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        goto ReloadLoopInit

      ReloadStartMagazine:
        KP10 R 0 A_PlaySound("Kingpin/Shotgun/ReloadMagazine",CHAN_7)
        KP10 R 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoMagazine")
      ReloadFinishMagazine:
        KP10 R 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP10 "RSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 ABCD 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadAmmoMagazine:
        KP10 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",0,"ReloadFinishMagazine")
        KP10 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP10 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 R 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinishMagazine
        KP10 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP10 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP10 R 0 A_TakeInventory("Shell",1)
        KP10 R 0 A_GiveInventory("Kingpin_ShotgunMagazine")
        loop

      ReloadStartDouble:
        KP20 R 0 A_JumpIfInventory("Kingpin_Shotgun_Magazine",1,"ReloadStartDoubleMagazine")
        KP20 RSTU 3 A_WeaponReady(WRF_NOFIRE)
        goto ReloadLoopInit

      ReloadLoopAnimDouble:
        KP20 "VWXYZ[\]" 3 A_WeaponReady(WRF_NOFIRE)
        KP20 V 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        goto ReloadLoopInit

      ReloadLoopAnimWithAmmoDouble:
        KP20 "VWXYZ[\]" 3 A_WeaponReady
        KP20 V 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        goto ReloadLoopInit

      ReloadFinishDouble:
        KP21 ABCD 3 A_WeaponReady
        goto ReadyActual

      ReloadStartDoubleMagazine:
        KP30 R 0 A_PlaySound("Kingpin/Shotgun/ReloadMagazine",CHAN_7)
        KP30 R 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoDoubleMagazine")
      ReloadFinishDoubleMagazine:
        KP30 R 0 ACS_NamedExecuteWithResult("Kingpin_Decorate", 12, 0)
        KP30 "RSTUVWXYZ[\]" 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 ABCD 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadAmmoDoubleMagazine:
        KP30 R 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",0,"ReloadFinishDoubleMagazine")
        KP30 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP30 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP30 R 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinishDoubleMagazine
        KP30 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP30 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP30 R 0 A_TakeInventory("Shell",1)
        KP30 R 0 A_GiveInventory("Kingpin_ShotgunMagazine")
        loop
    }
}

actor SamsaraKingpinShotgunSingleAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraKingpinShotgunAmmoCheckFailed")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto PickupAmmoCheckFailed
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",1,1)
        goto PickupAmmoCheckFailed
        TNT1 A 0 A_TakeInventory("Kingpin_ShotgunMagazine",1)
        goto PickupAttack

      // Ammo checking failure stuff
      PickupAmmoCheckFailed:
        TNT1 A 0 A_GiveInventory("SamsaraKingpinShotgunAmmoCheckFailed")
        stop

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Kingpin/Shotgun/Fire",CHAN_WEAPON)
        //TNT1 A 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        TNT1 A 0 A_JumpIfInventory("Kingpin_Shotgun_BleedShot",1,"PickupAttackBleedShot")
      // Normal rounds
      PickupAttackNormal:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackNormalCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackNormalCoop")
      PickupAttackNormalDM:
        TNT1 A 0 A_FireBullets(5,5,6,0,"Kingpin_ShotgunSmoke",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackNormalCoop:
        TNT1 A 0 A_FireBullets(5,5,6,0,"Kingpin_ShotgunSmokeCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Bleed shot rounds
      PickupAttackBleedShot:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackBleedShotCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackBleedShotCoop")
      PickupAttackBleedShotDM:
        TNT1 A 0 A_FireBullets(5,5,6,0,"Kingpin_ShotgunSmokeBleed",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackBleedShotCoop:
        TNT1 A 0 A_FireBullets(5,5,6,0,"Kingpin_ShotgunSmokeBleedCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 5, 100, 0, 0)
        stop
    }
}

actor SamsaraKingpinShotgunDoubleAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraKingpinShotgunAmmoCheckFailed")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto PickupAmmoCheckFailed
        TNT1 A 0 A_TakeInventory("Shell",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_ShotgunMagazine",2,1)
        goto PickupAmmoCheckFailed
        TNT1 A 0 A_TakeInventory("Kingpin_ShotgunMagazine",2)
        goto PickupAttack

      // Ammo checking failure stuff
      PickupAmmoCheckFailed:
        TNT1 A 0 A_GiveInventory("SamsaraKingpinShotgunAmmoCheckFailed")
        stop

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Kingpin/Shotgun/FireDouble",CHAN_WEAPON)
        //TNT1 A 0 A_FireCustomMissile("Kingpin_ShellCasing",-90,0,4,4)
        TNT1 A 0 A_JumpIfInventory("Kingpin_Shotgun_BleedShot",1,"PickupAttackBleedShot")
      // Normal rounds
      PickupAttackNormal:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackNormalCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackNormalCoop")
      PickupAttackNormalDM:
        TNT1 A 0 A_FireBullets(10,5,12,0,"Kingpin_ShotgunSmoke",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackNormalCoop:
        TNT1 A 0 A_FireBullets(10,5,12,0,"Kingpin_ShotgunSmokeCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Bleed shot rounds
      PickupAttackBleedShot:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackBleedShotCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackBleedShotCoop")
      PickupAttackBleedShotDM:
        TNT1 A 0 A_FireBullets(10,5,12,0,"Kingpin_ShotgunSmokeBleed",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackBleedShotCoop:
        TNT1 A 0 A_FireBullets(10,5,12,0,"Kingpin_ShotgunSmokeBleedCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(1)
        TNT1 A 0 A_Quake(3,2,0,32,"nosoundforyoubitch")
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 5, 260, 0, 0)
        stop
    }
}

actor Kingpin_ShotgunMagazine : Ammo
{
    Inventory.Amount 8
    Inventory.MaxAmount 8
    Tag "Shotgun Magazine"
    +IGNORESKILL
}

actor Kingpin_ShotgunSmoke : Kingpin_BulletSmoke
{
    Args 15
    Obituary "%o accepted %k's load."
}

actor Kingpin_ShotgunSmokeCoop : Kingpin_ShotgunSmoke { +MTHRUSPECIES }

actor Kingpin_ShotgunSmokeBleed : Kingpin_BulletSmokeBleed
{
    Args 15
    Obituary "%o accepted %k's load."
}

actor Kingpin_ShotgunSmokeBleedCoop : Kingpin_ShotgunSmokeBleed { +MTHRUSPECIES }
