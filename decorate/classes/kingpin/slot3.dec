actor Kingpin_GrenadeLauncher_ConcussionGrenades : Boolean {}
actor Kingpin_GrenadeLauncher_MagazineCapacity : Boolean {}
actor Kingpin_GrenadeLauncher_Fragmentation : Boolean {}
actor Kingpin_GrenadeLauncher_ClusterBombs : Boolean {}

actor Kingpin_GrenadeLauncher : Kingpin_Weapon
{
    Inventory.PickupMessage "Copped a Grenade Launcher."
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1000
    Weapon.AmmoType1 "Kingpin_GrenadeLauncherMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "RocketAmmo"
    Weapon.AmmoGive2 3
    Obituary "%o fumbled %k's grenade."
    Tag "Grenade Launcher"
    +EXPLOSIVE
    States
    {
      ReadyActual:
        KP01 E 0 A_TakeInventory("Kingpin_ShootToken")
        KP01 E 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
      ReadyActualNonReloadable:
        KP01 EFGHIJKL 5 A_WeaponReady
        goto ReadyActual

      ReadyActualReloadable:
        KP01 EFGHIJKL 5 A_WeaponReady(WRF_ALLOWRELOAD)
        goto ReadyActual

      Deselect:
        KP01 E 3 A_JumpIfHealthLower(1,"DeselectInstant")
        KP01 MNOP 3
        KP01 Q 0
        goto DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 3 A_GiveInventory("Kingpin_SelectedWeapon",4)
        KP00 BCDE 3
        goto ReadyActual

      Fire:
        KP00 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        KP00 F 0 A_JumpIfInventory("RocketAmmo",1,"FireStart")
        goto FireDry

      FireReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        KP00 F 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",1,"FireStart")
      FireReloadableDryCheck:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP00 F 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
        goto FireDry

      FireDry:
        KP01 E 0 A_ClearReFire
        KP01 E 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP01 E 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireStart:
        KP00 F 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 F 0 A_AlertMonsters
        KP00 F 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 F 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
      FireStartLastShotCalc:
        KP00 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireStartLastShotCalcReloadable")
      FireStartLastShotCalcNonReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinue")
        KP00 F 0 A_JumpIfInventory("RocketAmmo",2,"FireContinue")
        goto FireContinueLast

      FireStartLastShotCalcReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireContinue")
        KP00 F 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",2,"FireContinue")
        goto FireContinueLast

      FireContinue:
        KP00 F 0 A_GiveInventory("SamsaraKingpinGrenadeLauncherAttackHandler")
        KP00 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 J 0 A_FireCustomMissile("Kingpin_GrenadeCasing",-90,0,4,4)
        KP00 JKLMNOPQ 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 E 6 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 E 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP01 E 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireContinueLast:
        KP00 F 0 A_GiveInventory("SamsaraKingpinGrenadeLauncherAttackHandler")
        KP00 FGHI 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP00 R 0 A_FireCustomMissile("Kingpin_GrenadeCasing",-90,0,4,4)
        KP00 R 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP00 R 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",1,"ReadyActual")
        goto ReloadCheck

      Flash:
        KP99 FG 3 Bright
        stop

      Reload:
      ReloadCheck:
        KP01 E 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",0,"ReadyActual")
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 E 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        KP01 E 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
        goto ReadyActual

      ReloadStart:
        KP00 R 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 R 0 A_PlaySound("Kingpin/GrenadeLauncher/Reload",CHAN_WEAPON)
        goto ReloadAmmo

      ReloadFinish:
        KP00 "RSTUVWXYZ[\]" 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 ABCD 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadAmmo:
        KP00 R 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",0,"ReloadFinish")
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 R 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto ReloadFinish
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP00 R 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP00 R 0 A_TakeInventory("RocketAmmo",1)
        KP00 R 0 A_GiveInventory("Kingpin_GrenadeLauncherMagazine")
        loop
    }
}

actor SamsaraKingpinGrenadeLauncherAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_GrenadeLauncherMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Kingpin_GrenadeLauncherMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Kingpin/GrenadeLauncher/Fire",CHAN_WEAPON)
        //TNT1 A 0 A_FireCustomMissile("Kingpin_GrenadeCasing",-90,0,4,4)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Kingpin_Grenade",0,false,8)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Kingpin_GrenadeCoop",0,false,8)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 5, 96)
        stop
    }
}

actor Kingpin_GrenadeLauncherMagazine : Ammo
{
    Inventory.Amount 3
    Inventory.MaxAmount 3
    Tag "Grenade Launcher Magazine"
    +IGNORESKILL
}

actor Kingpin_GrenadeFuse : Counter { Inventory.MaxAmount 105 }

actor Kingpin_Grenade
{
    Projectile
    Radius 6
    Height 12
    Speed 20
    Damage (0)
    DamageType "KingpinExplosive"
    Gravity 0.33
    ReactionTime 0
    BounceType "Hexen"
    BounceSound "Kingpin/Grenade/Bounce"
    +BLOODLESSIMPACT
    +BOUNCEONACTORS
    +FORCERADIUSDMG
    -NOGRAVITY
    +SKYEXPLODE
    States
    {
      Spawn:
        KP00 A 0
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_GrenadeFuse")
        TNT1 A 0 ThrustThingZ(0,20,0,1)
        TNT1 A 0 A_SetGravity(frandom(0.65,0.75))
        TNT1 A 0 A_JumpIfInventory("Kingpin_GrenadeLauncher_ConcussionGrenades",1,"SpawnSetConcussion",AAPTR_TARGET)
        goto SpawnLoop

      SpawnSetConcussion:
        TNT1 A 0 A_ChangeFlag("BOUNCEONACTORS",false)
      SpawnLoop:
        KP00 A 0 A_SpawnItemEx("Kingpin_SmokeTrail",frandom(-2.0,2.0),frandom(-2.0,2.0),frandom(0,2.0))
        KP00 A 1 A_JumpIf(abs(sqrt(velx * velx + vely * vely + velz * velz)) < 4, "Stay")
        KP00 A 0 A_JumpIfInventory("Kingpin_GrenadeFuse",1,"SpawnLoop")
        KP00 A 1 A_Countdown
        wait

      Stay:
        KP00 B 0 A_ChangeVelocity(0,0,velz,CVF_REPLACE)
      StayLoop:
        KP00 B 0 A_ChangeFlag("HEXENBOUNCE",false)
        KP00 B 0 A_ChangeFlag("MISSILE",false)
        KP00 B 1 A_JumpIf(abs(sqrt(velx * velx + vely * vely + velz * velz)) >= 4, "SpawnLoop")
        KP00 B 0 A_JumpIfInventory("Kingpin_GrenadeFuse",1,"SpawnLoop")
        KP00 B 1 A_Countdown
        wait

      Death:
        TNT1 A 0 A_ChangeFlag("MISSILE",true)
        TNT1 A 0 A_Explode(120,120)
        TNT1 A 0 A_RadiusGive("Kingpin_ExplosionRecoil",512,RGF_PLAYERS,1)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_5)
        TNT1 AAAAAAAA 0 A_CustomMissile("Kingpin_ExplosionTrail",20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionEffect",0,0,32)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmoke",0,0,32)
        TNT1 A 0 A_JumpIfInventory("Kingpin_GrenadeLauncher_ClusterBombs",1,"DeathCluster",AAPTR_TARGET)
        TNT1 A 1 A_JumpIfInventory("Kingpin_GrenadeLauncher_Fragmentation",1,"DeathFireFragments",AAPTR_TARGET)
        stop

      DeathCluster:
        TNT1 AAAAAA 0 A_CustomMissile("Kingpin_ClusterGrenade",0,0,random(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 1 A_JumpIfInventory("Kingpin_GrenadeLauncher_Fragmentation",1,"DeathFireFragments",AAPTR_TARGET)
        stop

      DeathFireFragments:
        TNT1 AAAAAAAAAAAAAAAA 0 A_CustomBulletAttack(frandom(0,360),frandom(0,360),16,30,"Kingpin_BulletSmoke",512,CBAF_EXPLICITANGLE|CBAF_NORANDOM)
        TNT1 A 1
        stop
    }
}

actor Kingpin_GrenadeCoop : Kingpin_Grenade
{
    Species "Player"
    +THRUSPECIES
    States
    {
      DeathCluster:
        TNT1 AAAAAA 0 A_CustomMissile("Kingpin_ClusterGrenadeCoop",0,0,random(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 1 A_JumpIfInventory("Kingpin_GrenadeLauncher_Fragmentation",1,"DeathFireFragments",AAPTR_TARGET)
        stop

      DeathFireFragments:
        TNT1 AAAAAAAAAAAAAAAA 0 A_CustomBulletAttack(frandom(0,360),frandom(0,360),16,30,"Kingpin_BulletSmokeCoop",512,CBAF_EXPLICITANGLE|CBAF_NORANDOM)
        TNT1 A 1
        stop
    }
}

actor Kingpin_ClusterGrenade : Kingpin_Grenade
{
    Speed 10
    States
    {
      Spawn:
        KP00 A 0
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_GrenadeFuse")
        TNT1 A 0 A_TakeInventory("Kingpin_GrenadeFuse",70)
        TNT1 A 0 ThrustThingZ(0,8,0,1)
        TNT1 A 0 A_SetGravity(frandom(0.65,0.75))
        TNT1 A 0 A_JumpIfInventory("Kingpin_GrenadeLauncher_ConcussionGrenades",1,"SetConcussion",AAPTR_TARGET)
        goto SpawnLoop

      SetConcussion:
        TNT1 A 0 A_ChangeFlag("BOUNCEONACTORS",false)
      SpawnLoop:
        KP00 A 1 A_JumpIf(abs(sqrt(velx * velx + vely * vely + velz * velz)) < 4, "Stay")
        KP00 A 0 A_JumpIfInventory("Kingpin_GrenadeFuse",1,"SpawnLoop")
        KP00 A 1 A_Countdown
        wait

      Stay:
        KP00 B 0 A_ChangeVelocity(0,0,velz,CVF_REPLACE)
      StayLoop:
        KP00 B 0 A_ChangeFlag("HEXENBOUNCE",false)
        KP00 B 0 A_ChangeFlag("MISSILE",false)
        KP00 B 1 A_JumpIf(abs(sqrt(velx * velx + vely * vely + velz * velz)) >= 4, "SpawnLoop")
        KP00 B 0 A_JumpIfInventory("Kingpin_GrenadeFuse",1,"SpawnLoop")
        KP00 B 1 A_Countdown
        wait

      Death:
        TNT1 A 0 A_ChangeFlag("MISSILE",true)
        TNT1 A 0 A_Explode(60,60)
        TNT1 A 0 A_RadiusGive("Kingpin_ExplosionRecoil",256,RGF_PLAYERS,1)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_5)
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",20,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmokeSmall",0,0,8)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionEffectSmall",0,0,8)
        TNT1 A 1 A_JumpIfInventory("Kingpin_GrenadeLauncher_Fragmentation",1,"DeathFireFragments",AAPTR_TARGET)
        stop

      DeathFireFragments:
        TNT1 AAA 0 A_CustomBulletAttack(frandom(0,360),frandom(0,360),2,30,"Kingpin_BulletSmoke",512,CBAF_EXPLICITANGLE|CBAF_NORANDOM)
        TNT1 A 1
        stop
    }
}

actor Kingpin_ClusterGrenadeCoop : Kingpin_ClusterGrenade
{
    Species "Player"
    +THRUSPECIES
    States
    {
      DeathFireFragments:
        TNT1 AAA 0 A_CustomBulletAttack(frandom(0,360),frandom(0,360),2,30,"Kingpin_BulletSmokeCoop",512,CBAF_EXPLICITANGLE|CBAF_NORANDOM)
        TNT1 A 1
        stop
    }
}
