actor Kingpin_HMG_SelectFire : Boolean {}
actor Kingpin_HMG_AntiMaterial : Boolean {}
actor Kingpin_HMG_CoolingRod : Boolean {}
actor Kingpin_HMG_TacticalScope : Boolean {}
actor Kingpin_HMG_ScopeActive : Boolean {}
actor SamsaraKingpinHMGAttackSilentSound : Boolean {}

actor Kingpin_HMG : Kingpin_Weapon
{
    Inventory.PickupMessage "Copped a HMG."
    Weapon.SlotNumber 7
    Weapon.SelectionOrder 250
    Weapon.AmmoType1 "Kingpin_HMGMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Cell"
    Weapon.AmmoGive2 60
    Obituary "%o was maimed by %k's H.M.G.."
    Tag "HMG"
    +BFG
    States
    {
      ReadyActual:
        KP01 O 0 A_TakeInventory("Kingpin_ShootToken")
        KP01 O 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
      ReadyActualNonReloadable:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyActualNonReloadableZoomed")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ReadyActualNonReloadableScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyActualNonReloadableCoolingRod")
        KP01 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWZOOM)
        goto ReadyActual

      ReadyActualNonReloadableCoolingRod:
        KP11 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWZOOM)
        KP11 O 0
        goto ReadyActual

      ReadyActualNonReloadableScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyActualNonReloadableScopeCoolingRod")
        KP21 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWZOOM)
        KP21 O 0
        goto ReadyActual

      ReadyActualNonReloadableScopeCoolingRod:
        KP31 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWZOOM)
        KP31 O 0
        goto ReadyActual

      ReadyActualNonReloadableZoomed:
        TNT1 A 5 A_WeaponReady(WRF_ALLOWZOOM)
        goto ReadyActual

      ReadyActualReloadable:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyActualReloadableZoomed")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ReadyActualReloadableScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyActualReloadableCoolingRod")
        KP01 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        goto ReadyActual

      ReadyActualReloadableCoolingRod:
        KP11 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        KP11 O 0
        goto ReadyActual

      ReadyActualReloadableScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyActualReloadableScopeCoolingRod")
        KP21 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        KP21 O 0
        goto ReadyActual

      ReadyActualReloadableScopeCoolingRod:
        KP31 OPQRSTUVWXY 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        KP31 O 0
        goto ReadyActual

      ReadyActualReloadableZoomed:
        TNT1 A 5 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        goto ReadyActual

      Deselect:
        KP01 Z 0 A_JumpIfHealthLower(1,"DeselectInstant")
      DeselectScopeCheck:
        KP01 Z 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,1)
        goto DeselectStart
        KP01 O 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP01 O 0 A_ZoomFactor(1)
      DeselectScopeCheckFinish:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"DeselectScopeCheckFinishScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"DeselectScopeCheckFinishCoolingRod")
        KP01 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Deselect

      DeselectScopeCheckFinishCoolingRod:
        KP11 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 O 0
        goto Deselect

      DeselectScopeCheckFinishScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"DeselectScopeCheckFinishScopeCoolingRod")
        KP21 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 O 0
        goto Deselect

      DeselectScopeCheckFinishScopeCoolingRod:
        KP31 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 O 0
        goto Deselect

      DeselectStart:
        KP01 Z 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"DeselectStartScope")
        KP01 Z 3 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"DeselectStartCoolingRod")
        KP01 "[\]" 3
        KP02 AB 3
        goto Super::DeselectInstant

      DeselectStartCoolingRod:
        KP11 "Z[\]" 3
        KP12 AB 3
        goto Super::DeselectInstant

      DeselectStartScope:
        KP21 Z 3 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"DeselectStartScopeCoolingRod")
        KP21 "[\]" 3
        KP22 AB 3
        goto Super::DeselectInstant

      DeselectStartScopeCoolingRod:
        KP31 "Z[\]" 3
        KP32 AB 3
        goto Super::DeselectInstant

      DeselectInstant:
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,1)
        goto Super::DeselectInstant
        TNT1 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        TNT1 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto Super::DeselectInstant

      Ready: // our "Select" state
        KP00 A 0 A_TakeInventory("Kingpin_SelectedWeapon")
        KP00 A 0 A_GiveInventory("Kingpin_SelectedWeapon",8)
        KP00 A 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ReadyScope")
        KP00 A 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyCoolingRod")
        KP00 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut1") // map change hack
      ReadyStart1:
        KP00 A 1
        KP00 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut2") // map change hack
      ReadyStart2:
        KP00 A 2
        KP00 BCDE 3
        goto ReadyActual

      ReadyZoomOut1:
        KP00 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP00 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart1

      ReadyZoomOut2:
        KP00 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP00 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart2

      ReadyCoolingRod:
        KP10 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut1CoolingRod") // map change hack
      ReadyStart1CoolingRod:
        KP10 A 1
        KP10 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut2CoolingRod") // map change hack
      ReadyStart2CoolingRod:
        KP10 A 2
        KP10 BCDE 3
        KP11 O 0
        goto ReadyActual

      ReadyZoomOut1CoolingRod:
        KP10 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP10 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart1CoolingRod

      ReadyZoomOut2CoolingRod:
        KP10 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP10 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart2CoolingRod

      ReadyScope:
        KP20 A 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReadyScopeCoolingRod")
        KP20 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut1Scope") // map change hack
      ReadyStart1Scope:
        KP20 A 1
        KP20 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut2Scope") // map change hack
      ReadyStart2Scope:
        KP20 A 2
        KP20 BCDE 3
        KP21 O 0
        goto ReadyActual

      ReadyZoomOut1Scope:
        KP20 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP20 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart1Scope

      ReadyZoomOut2Scope:
        KP20 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP20 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart2Scope

      ReadyScopeCoolingRod:
        KP30 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut1ScopeCoolingRod") // map change hack
      ReadyStart1ScopeCoolingRod:
        KP30 A 1
        KP30 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ReadyZoomOut2ScopeCoolingRod") // map change hack
      ReadyStart2ScopeCoolingRod:
        KP30 A 2
        KP30 BCDE 3
        KP31 O 0
        goto ReadyActual

      ReadyZoomOut1ScopeCoolingRod:
        KP30 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP30 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart1ScopeCoolingRod

      ReadyZoomOut2ScopeCoolingRod:
        KP30 A 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP30 A 0 A_ZoomFactor(1,ZOOM_INSTANT)
        goto ReadyStart2ScopeCoolingRod

      Fire:
        KP00 F 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        KP00 F 0 A_JumpIfInventory("Cell",2,"FireStart")
        goto FireDry

      FireReloadable:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        KP00 F 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"FireStart")
      FireReloadableDryCheck:
        KP00 F 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadScopeCheck")
        KP00 F 0 A_JumpIfInventory("Cell",2,"ReloadScopeCheck")
        goto FireDry

      FireDry:
        KP01 O 0 A_ClearReFire
        KP01 O 0 A_PlaySound("Kingpin/DryFire",CHAN_WEAPON)
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"FireDryZoomed")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"FireDryScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"FireDryCoolingRod")
        KP01 O 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireDryCoolingRod:
        KP11 O 15 A_WeaponReady(WRF_NOFIRE)
        KP11 O 0
        goto ReadyActual

      FireDryScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"FireDryScopeCoolingRod")
        KP21 O 15 A_WeaponReady(WRF_NOFIRE)
        KP21 O 0
        goto ReadyActual

      FireDryScopeCoolingRod:
        KP31 O 15 A_WeaponReady(WRF_NOFIRE)
        KP31 O 0
        goto ReadyActual

      FireDryZoomed:
        TNT1 A 15 A_WeaponReady(WRF_NOFIRE)
        goto ReadyActual

      FireStart:
        KP00 F 0 A_GiveInventory("Kingpin_ShootToken")
        KP00 F 0 A_AlertMonsters
        KP00 F 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 F 0 A_GunFlash("FlashA",GFF_NOEXTCHANGE)
        KP00 F 0 A_TakeInventory("SamsaraKingpinHMGAttackSilentSound")
        KP00 F 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP00 F 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"FireStartZoomed")
        KP00 F 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"FireStartScope")
        KP00 F 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"FireStartCoolingRod")
        KP00 F 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartSelect")
        KP00 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2

      Fire2:
        KP00 H 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2Reloadable")
      Fire2NonReloadable:
        KP00 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2Start")
        KP00 H 0 A_JumpIfInventory("Cell",2,"Fire2Start")
        goto FireFinishReloadCheck

      Fire2Reloadable:
        KP00 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2Start")
        KP00 H 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2Start")
        goto FireFinishReloadCheck

      Fire2Start:
        KP00 H 0 A_AlertMonsters
        KP00 H 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 H 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        KP00 H 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP00 HI 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3

      Fire3:
        KP00 J 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3Reloadable")
      Fire3NonReloadable:
        KP00 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3Start")
        KP00 J 0 A_JumpIfInventory("Cell",2,"Fire3Start")
        goto FireFinishReloadCheck

      Fire3Reloadable:
        KP00 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3Start")
        KP00 J 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3Start")
        goto FireFinishReloadCheck

      Fire3Start:
        KP00 J 0 A_AlertMonsters
        KP00 J 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP00 J 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        KP00 J 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP00 J 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinish:
        KP01 KLMNOPQRST 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishReloadCheck:
        KP01 O 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        KP01 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActual")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"ReadyActual")
        goto ReloadCheck

      FireStartSelect:
        KP00 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishSelect:
        KP01 KNQT 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheck

      FireStartCoolingRod:
        KP10 F 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartCoolingRodSelect")
        KP10 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2CoolingRod

      Fire2CoolingRod:
        KP10 H 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2ReloadableCoolingRod")
      Fire2NonReloadableCoolingRod:
        KP10 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2StartCoolingRod")
        KP10 H 0 A_JumpIfInventory("Cell",2,"Fire2StartCoolingRod")
        goto FireFinishReloadCheckCoolingRod

      Fire2ReloadableCoolingRod:
        KP10 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2StartCoolingRod")
        KP10 H 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2StartCoolingRod")
        goto FireFinishReloadCheckCoolingRod

      Fire2StartCoolingRod:
        KP10 H 0 A_AlertMonsters
        KP10 H 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP10 H 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        KP10 H 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP10 HI 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3CoolingRod

      Fire3CoolingRod:
        KP10 J 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3ReloadableCoolingRod")
      Fire3NonReloadableCoolingRod:
        KP10 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3StartCoolingRod")
        KP10 J 0 A_JumpIfInventory("Cell",2,"Fire3StartCoolingRod")
        goto FireFinishReloadCheckCoolingRod

      Fire3ReloadableCoolingRod:
        KP10 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3StartCoolingRod")
        KP10 J 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3StartCoolingRod")
        goto FireFinishReloadCheckCoolingRod

      Fire3StartCoolingRod:
        KP10 J 0 A_AlertMonsters
        KP10 J 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP10 J 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        KP10 J 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP10 J 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishCoolingRod:
        KP11 KMOQS 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishReloadCheckCoolingRod:
        KP11 O 0
        goto FireFinishReloadCheck

      FireStartCoolingRodSelect:
        KP10 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishCoolingRodSelect:
        KP11 K 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheckCoolingRod

      FireStartScope:
        KP20 F 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"FireStartScopeCoolingRod")
        KP20 F 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartScopeSelect")
        KP20 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2Scope

      Fire2Scope:
        KP20 H 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2ReloadableScope")
      Fire2NonReloadableScope:
        KP20 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2StartScope")
        KP20 H 0 A_JumpIfInventory("Cell",2,"Fire2StartScope")
        goto FireFinishReloadCheckScope

      Fire2ReloadableScope:
        KP20 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2StartScope")
        KP20 H 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2StartScope")
        goto FireFinishReloadCheckScope

      Fire2StartScope:
        KP20 H 0 A_AlertMonsters
        KP20 H 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP20 H 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        KP20 H 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP20 HI 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3Scope

      Fire3Scope:
        KP20 J 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3ReloadableScope")
      Fire3NonReloadableScope:
        KP20 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3StartScope")
        KP20 J 0 A_JumpIfInventory("Cell",2,"Fire3StartScope")
        goto FireFinishReloadCheckScope

      Fire3ReloadableScope:
        KP20 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3StartScope")
        KP20 J 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3StartScope")
        goto FireFinishReloadCheckScope

      Fire3StartScope:
        KP20 J 0 A_AlertMonsters
        KP20 J 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP20 J 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        KP20 J 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP20 J 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishScope:
        KP21 KLMNOPQRST 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishReloadCheckScope:
        KP21 O 0
        goto FireFinishReloadCheck

      FireStartScopeSelect:
        KP20 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishScopeSelect:
        KP21 KNQT 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheckScope

      FireStartScopeCoolingRod:
        KP30 F 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartScopeCoolingRodSelect")
        KP30 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2ScopeCoolingRod

      Fire2ScopeCoolingRod:
        KP30 H 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2ReloadableScopeCoolingRod")
      Fire2NonReloadableScopeCoolingRod:
        KP30 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2StartScopeCoolingRod")
        KP30 H 0 A_JumpIfInventory("Cell",2,"Fire2StartScopeCoolingRod")
        goto FireFinishReloadCheckScopeCoolingRod

      Fire2ReloadableScopeCoolingRod:
        KP30 H 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2StartScopeCoolingRod")
        KP30 H 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2StartScopeCoolingRod")
        goto FireFinishReloadCheckScopeCoolingRod

      Fire2StartScopeCoolingRod:
        KP30 H 0 A_AlertMonsters
        KP30 H 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP30 H 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        KP30 H 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP30 HI 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3ScopeCoolingRod

      Fire3ScopeCoolingRod:
        KP30 J 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3ReloadableScopeCoolingRod")
      Fire3NonReloadableScopeCoolingRod:
        KP30 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3StartScopeCoolingRod")
        KP30 J 0 A_JumpIfInventory("Cell",2,"Fire3StartScopeCoolingRod")
        goto FireFinishReloadCheckScopeCoolingRod

      Fire3ReloadableScopeCoolingRod:
        KP30 J 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3StartScopeCoolingRod")
        KP30 J 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3StartScopeCoolingRod")
        goto FireFinishReloadCheckScopeCoolingRod

      Fire3StartScopeCoolingRod:
        KP30 J 0 A_AlertMonsters
        KP30 J 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        KP30 J 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        KP30 J 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        KP30 J 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishScopeCoolingRod:
        KP31 KMOQS 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishReloadCheckScopeCoolingRod:
        KP31 O 0
        goto FireFinishReloadCheck

      FireStartScopeCoolingRodSelect:
        KP30 FG 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishScopeCoolingRodSelect:
        KP31 K 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheckScopeCoolingRod

      FireStartZoomed:
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"FireStartZoomedCoolingRod")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartZoomedSelect")
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2Zoomed

      Fire2Zoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2ReloadableZoomed")
      Fire2NonReloadableZoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2StartZoomed")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"Fire2StartZoomed")
        goto FireFinishReloadCheck

      Fire2ReloadableZoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2StartZoomed")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2StartZoomed")
        goto FireFinishReloadCheck

      Fire2StartZoomed:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        TNT1 A 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3Zoomed

      Fire3Zoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3ReloadableZoomed")
      Fire3NonReloadableZoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3StartZoomed")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"Fire3StartZoomed")
        goto FireFinishReloadCheck

      Fire3ReloadableZoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3StartZoomed")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3StartZoomed")
        goto FireFinishReloadCheck

      Fire3StartZoomed:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        TNT1 A 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        TNT1 A 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishZoomed:
        TNT1 AAAAAAAAAA 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheck

      FireStartZoomedSelect:
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishZoomedSelect:
        TNT1 AAAA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheck

      FireStartZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,"FireStartZoomedCoolingRodSelect")
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire2ZoomedCoolingRod

      Fire2ZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire2ReloadableZoomedCoolingRod")
      Fire2NonReloadableZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire2StartZoomedCoolingRod")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"Fire2StartZoomedCoolingRod")
        goto FireFinishReloadCheck

      Fire2ReloadableZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire2StartZoomedCoolingRod")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire2StartZoomedCoolingRod")
        goto FireFinishReloadCheck

      Fire2StartZoomedCoolingRod:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        TNT1 A 0 A_GunFlash("FlashB",GFF_NOEXTCHANGE)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Fire3ZoomedCoolingRod

      Fire3ZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire3ReloadableZoomedCoolingRod")
      Fire3NonReloadableZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire3StartZoomedCoolingRod")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"Fire3StartZoomedCoolingRod")
        goto FireFinishReloadCheck

      Fire3ReloadableZoomedCoolingRod:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire3StartZoomedCoolingRod")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,"Fire3StartZoomedCoolingRod")
        goto FireFinishReloadCheck

      Fire3StartZoomedCoolingRod:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_SpawnItemEx("Kingpin_MuzzleFlash")
        TNT1 A 0 A_GunFlash("FlashC",GFF_NOEXTCHANGE)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinHMGAttackHandler")
        TNT1 A 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishZoomedCoolingRod:
        TNT1 AAAAA 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheck

      FireStartZoomedCoolingRodSelect:
        TNT1 AA 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
      FireFinishZoomedCoolingRodSelect:
        TNT1 A 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinishReloadCheck

      FlashA:
        KP99 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"FlashZoomed")
        KP99 A 0 A_Jump(256,1,2,3)
        KP99 A 2 Bright
        stop
        KP99 B 2 Bright
        stop
        KP99 C 2 Bright
        stop

      FlashB:
        KP99 D 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"FlashZoomed")
        KP99 D 0 A_Jump(256,1,2,3)
        KP99 D 2 Bright
        stop
        KP99 E 2 Bright
        stop
        KP99 F 2 Bright
        stop

      FlashC:
        KP99 G 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"FlashZoomed")
        KP99 G 0 A_Jump(256,1,2,3)
        KP99 G 2 Bright
        stop
        KP99 H 2 Bright
        stop
        KP99 I 2 Bright
        stop

      FlashZoomed:
        TNT1 A 2
        stop

      AltFire:
      Zoom:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,1)
        goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,"ZoomUnscope")
      ZoomScope:
        TNT1 A 0 A_GiveInventory("Kingpin_HMG_ScopeActive")
        TNT1 A 0 A_ZoomFactor(6)
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_ScopeClient")
        TNT1 A 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ZoomUnscope:
        KP01 O 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP01 O 0 A_ZoomFactor(1)
      ZoomUnscopeFinish:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ZoomUnscopeFinishScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ZoomUnscopeFinishCoolingRod")
        KP01 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ZoomUnscopeFinishCoolingRod:
        KP11 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 O 0
        goto ReadyActual

      ZoomUnscopeFinishScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ZoomUnscopeFinishScopeCoolingRod")
        KP21 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 O 0
        goto ReadyActual

      ZoomUnscopeFinishScopeCoolingRod:
        KP31 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 O 0
        goto ReadyActual

      Reload:
      ReloadCheck:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMGMagazine",0,"ReadyActual")
        KP01 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 O 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadScopeCheck")
        KP01 O 0 A_JumpIfInventory("Cell",2,"ReloadScopeCheck")
        goto ReadyActual

      ReloadScopeCheck:
        KP00 U 0 A_JumpIfInventory("Kingpin_HMG_ScopeActive",1,1)
        goto ReloadStart
        KP01 O 0 A_TakeInventory("Kingpin_HMG_ScopeActive")
        KP01 O 0 A_ZoomFactor(1)
      ReloadScopeCheckFinish:
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ReloadScopeCheckFinishScope")
        KP01 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReloadScopeCheckFinishCoolingRod")
        KP01 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReloadCheck

      ReloadScopeCheckFinishCoolingRod:
        KP11 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 O 0
        goto ReloadCheck

      ReloadScopeCheckFinishScope:
        KP21 O 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReloadScopeCheckFinishScopeCoolingRod")
        KP21 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 O 0
        goto ReloadCheck

      ReloadScopeCheckFinishScopeCoolingRod:
        KP31 O 5 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 O 0
        goto ReloadCheck

      ReloadStart:
        KP00 U 0 A_TakeInventory("Kingpin_ShootToken")
        KP00 U 0 A_PlaySound("Kingpin/HMG/Reload",CHAN_5)
        goto ReloadAmmo

      ReloadFinish:
        KP00 K 0 A_JumpIfInventory("Kingpin_HMG_TacticalScope",1,"ReloadFinishScope")
        KP00 K 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReloadFinishCoolingRod")
        KP00 "UVWXYZ[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP01 ABCDEFGHIJKLMN 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto ReadyActual

      ReloadFinishCoolingRod:
        KP10 "UVWXYZ[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 ABCDEFGHIJKLMN 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP11 O 0
        goto ReadyActual

      ReloadFinishScope:
        KP20 U 0 A_JumpIfInventory("Kingpin_HMG_CoolingRod",1,"ReloadFinishScopeCoolingRod")
        KP20 "UVWXYZ[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 ABCDEFGHIJKLMN 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP21 O 0
        goto ReadyActual

      ReloadFinishScopeCoolingRod:
        KP30 "UVWXYZ[\]" 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 ABCDEFGHIJKLMN 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        KP31 O 0
        goto ReadyActual

      ReloadAmmo:
        KP01 U 0 A_JumpIfInventory("Kingpin_HMGMagazine",0,"ReloadFinish")
        KP01 U 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 U 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP01 U 0 A_JumpIfInventory("Cell",2,1)
        goto ReloadFinish
        KP01 U 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        KP01 U 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        KP01 U 0 A_TakeInventory("Cell",2)
        KP01 U 0 A_GiveInventory("Kingpin_HMGMagazine")
        loop
    }
}

actor SamsaraKingpinHMGAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupPlaySound")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupPlaySound

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupPlaySound")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMGMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Kingpin_HMGMagazine",1)
        goto PickupPlaySound

      // Sound playing stuff
      PickupPlaySound:
        TNT1 A 0 A_JumpIfInventory("SamsaraKingpinHMGAttackSilentSound",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_SelectFire",1,2)
        TNT1 A 0 A_PlaySound("Kingpin/HMG/Fire",CHAN_WEAPON)
        goto PickupAttack
        TNT1 A 0 A_PlaySound("Kingpin/HMG/FireSingle",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_FireCustomMissile("Kingpin_HMGCasing",-90,false,4,4)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(1-CallACS("Kingpin_Decorate", 4),1-CallACS("Kingpin_Decorate", 4),-1,0,"Kingpin_HMGBulletSmoke",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(1-CallACS("Kingpin_Decorate", 4),1-CallACS("Kingpin_Decorate", 4),-1,0,"Kingpin_HMGBulletSmokeCoop",FBF_NORANDOM|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 2, 56)
        TNT1 A 0 A_GiveInventory("SamsaraKingpinHMGAttackSilentSound")
        stop
    }
}

actor Kingpin_HMGMagazine : Ammo
{
    Inventory.Amount 30
    Inventory.MaxAmount 30
    Tag "HMG Magazine"
    +IGNORESKILL
}

actor Kingpin_HMGBulletSmoke
{
    Radius 4
    Height 2
    DamageType "KingpinBullet"
    RenderStyle "Add"
    Scale 0.25
    Decal "KingpinBulletHole"
    +BLOODLESSIMPACT
    +FORCERADIUSDMG
    +FORCEXYBILLBOARD
    +HITTRACER
    +NOBLOCKMAP
    +NODAMAGETHRUST
    +NOGRAVITY
    +PUFFGETSOWNER
    +PUFFONACTORS
    States
    {
      Spawn:
        TNT1 A 0
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_AntiMaterial",1,"AntiMaterialMetal",AAPTR_TARGET)
        TNT1 A 0 A_PlaySound("Kingpin/HitMetal",CHAN_5)
        TNT1 A 0 A_Explode(CallACS("Kingpin_BulletDamage", damage),8,0,false,8)
        KP00 A -1 ACS_NamedExecuteWithResult("Kingpin_FX", 1, 10, 0.75 * 65536)
        stop

      AntiMaterialMetal:
        TNT1 A 0 A_SetDamageType("KingpinExplosive")
        TNT1 A 0 A_Explode(275,32,0,true)
        TNT1 A 0 A_Explode(25,32,XF_HURTSOURCE,true)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_6)
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmokeSmall",0,0,8)
        TNT1 A 1 A_SpawnItemEx("Kingpin_ExplosionEffectSmall",0,0,8)
        stop

      Melee:
      Crash:
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_AntiMaterial",1,"AntiMaterialWall",AAPTR_TARGET)
        TNT1 A 0 A_Jump(192,2)
        TNT1 A 0 A_PlaySound("Kingpin/Ricochet",CHAN_5)
        KP00 A -1 ACS_NamedExecuteWithResult("Kingpin_FX", 1, 10, 0.75 * 65536)
        stop

      AntiMaterialWall:
        TNT1 A 0 A_SetDamageType("KingpinExplosive")
        TNT1 A 0 A_Explode(275,32,0,true)
        TNT1 A 0 A_Explode(25,32,XF_HURTSOURCE,true)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_6)
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmokeSmall",0,0,8)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionEffectSmall",0,0,8)
        TNT1 A 1 A_PlaySound("Kingpin/Ricochet",CHAN_5)
        stop

      XDeath:
        TNT1 A 0 A_JumpIfInventory("Kingpin_HMG_AntiMaterial",1,"AntiMaterialTarget",AAPTR_TARGET)
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_BloodGenerator_Offsets")
        TNT1 A 0 A_Explode(CallACS("Kingpin_BulletDamage", damage),8,0,0,8)
        TNT1 A 1 A_GiveInventory("Kingpin_BloodGenerator",1,AAPTR_TRACER)
        stop

      AntiMaterialTarget:
        TNT1 A 0 A_SetDamageType("KingpinExplosive")
        TNT1 A 0 A_Explode(275,32,0,true)
        TNT1 A 0 A_Explode(25,32,XF_HURTSOURCE,true)
        TNT1 A 0 A_PlaySound("Kingpin/Explosion",CHAN_6)
        TNT1 A 0 A_CustomMissile("Kingpin_ExplosionTrail",10,0,frandom(0,360),CMF_AIMDIRECTION,frandom(-30,75))
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionSmokeSmall",0,0,8)
        TNT1 A 0 A_SpawnItemEx("Kingpin_ExplosionEffectSmall",0,0,8)
        TNT1 A 0 ACS_NamedExecuteWithResult("Kingpin_BloodGenerator_Offsets")
        TNT1 A 1 A_GiveInventory("Kingpin_BloodGenerator",1,AAPTR_TRACER)
        stop
    }
}

actor Kingpin_HMGBulletSmokeCoop : Kingpin_HMGBulletSmoke { +MTHRUSPECIES }
