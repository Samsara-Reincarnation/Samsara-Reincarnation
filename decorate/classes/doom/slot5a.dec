actor DGHasRocketLauncher : Boolean {}

actor "Rocket Launcher" : RocketLauncher
{
	Weapon.SlotNumber 5
	Weapon.AmmoGive 2
	//+ALT_USES_BOTH
	+AMMO_OPTIONAL
	+EXPLOSIVE
	+UNDROPPABLE
	+NOALERT
	Inventory.RestrictedTo "DoomguyPlayer"
	Tag "Rocket Launcher"
	States
	{
	Spawn:
		WDRL A -1
		stop

	// Original
	Ready:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyCom")
	ReadyActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"ReadyActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"ReadyActual64")
		DMIS A 1 A_WeaponReady
		loop

	Deselect:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectCom")
	DeselectActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"DeselectActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"DeselectActual64")
		DMIS A 1 A_Lower
		loop

	Select:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"SelectCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"SelectStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Select64")
		DMIS A 1 A_Raise
		loop

	Fire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireCom")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto Nothing
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Fire64")
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireSmooth")
	FireVanilla:
		DMIS B 8 A_GunFlash
		DMIS B 12 A_GiveInventory("SamsaraDoomguyRocketLauncherAttackHandler")
		// 20 frames total
	FireFinish:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto Nothing
		TNT1 A 0 A_ReFire
		goto ReadyActual

	Flash:
		DMSF A 3 Bright A_Light1
		DMSF B 4 Bright
		DMSF CD 4 Bright A_Light2
		goto LightDone

	FireSmooth:
		PKRL A 2
		PKRL A 4 A_GunFlash("FlashSmooth")
		PKRL B 2
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyRocketLauncherAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"FireSmoothRage")
		PKRL DC 3
		PKRL BE 2
		PKRL FG 1
		goto FireFinish

	FireSmoothRage:
		PKRL DC 2 Bright
		PKRL BEFG 2
		goto FireFinish

	FlashSmooth:
		PKRF A 3 Bright A_Light1
		PKRF B 2 Bright
		PKRF C 2 Bright A_Light2
		PKRF DE 3 Bright
		goto LightDone

	// Doom 64 (has recoil visual and kickback)
	ReadyActual64:
		64ML A 1 A_WeaponReady
		goto ReadyActual

	DeselectActual64:
		64ML A 1 A_Lower
		goto DeselectActual

	Select64:
		64ML A 1 A_Raise
		goto Select

	Fire64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64Smooth")
	Fire64Vanilla:
		64ML B 8 A_GunFlash("Flash64")
		64ML B 13 A_GiveInventory("SamsaraDoomguy64RocketLauncherAttackHandler")
		goto FireFinish

	Flash64:
		64MM A 2 Bright A_Light1
		64MM B 4 Bright
		64MM CD 4 Bright A_Light2
		goto LightDone

	Fire64Smooth:
		64ML B 2 A_GunFlash("Flash64Smooth")
		64ML C 6
		64ML C 3 A_GiveInventory("SamsaraDoomguy64RocketLauncherAttackHandler")
		64ML DB 3
		64ML A 4
		goto FireFinish

	Flash64Smooth:
		64MM A 2 Bright A_Light1
		64MM B 4 Bright
		64MM CD 4 Bright A_Light2
		goto LightDone

	// Stronghold
	// Unpowered
	ReadyActualStr:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStrPowered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStrPowered")
		DMIS H 1 A_WeaponReady
		goto ReadyActual

	DeselectActualStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"DeselectActualStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"DeselectActualStrPowered")
	DeselectActualStrContinue:
		TNT1 A 0 A_Lower
		DMIS H 1 A_Lower
		goto DeselectActual

	SelectStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"SelectStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"SelectStrPowered")
	SelectStrContinue:
		TNT1 A 0 A_Raise
		DMIS H 1 A_Raise
		goto Select

	FireStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPowered")
		DMSF H 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRocketLauncherAttackHandler")
		DMSF IJK 5 Bright
		goto FireFinish

	FlashStr:
		TNT1 A 4 A_Light1
		TNT1 A 5 A_Light2
		TNT1 A 5 A_Light1
		goto LightDone

	// Powered
/*
	ReadyActualStrPowered:
		DMIS H 1 A_WeaponReady
		goto ReadyActual
*/

	DeselectActualStrPowered:
		TNT1 A 0 A_Lower
		goto DeselectActualStrContinue

	SelectStrPowered:
		TNT1 A 0 A_Raise
		goto SelectStrContinue

	FireStrPowered:
		DMSF H 4 Bright A_GunFlash("FlashStrPowered")
		DMSF I 2 Bright A_GiveInventory("SamsaraDoomguyStrRocketLauncherPoweredPrimaryAttackHandler")
		DMSF JK 4 Bright
		goto FireFinish

/*
	AltFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto Nothing
        TNT1 A 0 A_AlertMonsters
		DMSF H 4 Bright A_GunFlash("FlashStrPowered")
		DMSF I 2 Bright A_GiveInventory("SamsaraDoomguyStrRocketLauncherPoweredSecondaryAttackHandler1")
		DMSF H 4 Bright A_GunFlash("FlashStrPowered")
		DMSF I 2 Bright A_GiveInventory("SamsaraDoomguyStrRocketLauncherPoweredSecondaryAttackHandler2")
		DMSF H 4 Bright A_GunFlash("FlashStrPowered")
		DMSF I 2 Bright A_GiveInventory("SamsaraDoomguyStrRocketLauncherPoweredSecondaryAttackHandler3")
		DMSF JK 4 Bright
	AltFireFinish:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto Nothing
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"AltFireFinishReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"AltFireFinishReFire")
		//TNT1 A 0 A_CheckReload
		goto ReadyActual

	AltFireFinishReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActual") // 2
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1) // 2
		//TNT1 A 0 A_CheckReload
		goto ReadyActual
		TNT1 A 0 A_ReFire
		goto ReadyActual
*/

	FlashStrPowered:
		TNT1 A 4 A_Light1
		TNT1 A 2 A_Light2
		TNT1 A 4 A_Light1
		goto LightDone

	// Complex Doom
    ReadyCom:
        CD15 B 1 A_PlayWeaponSound("complexdoom/weapons/pickupml")
        CD15 CDEF 1
        Goto ReadyActual

    ReadyActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        CD14 N 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComReloadable:
        CD14 N 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
        CD14 N 1 A_Lower
        goto DeselectActual

    SelectCom:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

    FireCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"FireComStart")
		goto FireComEmpty

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",1,"FireComStart")
        goto FireComEmpty

    FireComEmpty:
        CD14 N 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_Light1 
        CD14 C 1 Bright A_Quake(4,3,0,64,"nosoundforyoubitch")
        CD14 D 1 Bright
        CD14 E 1 Bright A_Light2
        CD14 F 1 Bright A_GiveInventory("SamsaraDoomguyComRocketLauncherAttackHandler")
        CD14 G 2 A_Light0
        CD14 HIJK 1
        CD14 L 3 A_PlaySound("complexdoom/rocket/drumspin")
        CD14 M 3
        CD14 N 4
        TNT1 A 0 A_ReFire
        goto ReadyActual

	Reload:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
		goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",0,"ReadyActual")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"ReloadStart")
		Goto ReadyActual

	ReloadStart:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",1,"ReloadStartLoaded")
        CD14 R 2 A_PlaySound("complexdoom/weapons/rocketdrumin")
        CD14 S 2
        CD14 T 2 A_SpawnItemEx("ComplexDoom_RocketEmptyDrum",2,0,-12,1,0,0,Random(-100,-110),128)
        CD14 UV 2
        CD14 W 8
        CD14 XY 2
        CD14 Z 3
        CD14 "[" 5
        CD14 "\]" 2
        CD15 A 1
        CD14 L 5 A_PlaySound("complexdoom/rocket/drumspin")
        CD14 M 3
        CD14 N 2
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
		goto ReadyActual

	ReloadAmmo:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",0,"ReadyActual")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        TNT1 A 0 A_GiveInventory("ComplexDoom_RocketDrum")
        loop

	ReloadStartLoaded:
        CD14 R 2 A_PlayWeaponSound("complexdoom/weapons/rocketdrumin")
        CD14 S 2
        CD14 T 2 A_SpawnItemEx("ComplexDoom_RocketEmptyDrum",2,0,-12,1,0,0,Random(-100,-110),128)
        CD14 UV 2
        CD14 W 8
        CD14 XY 2
        CD14 Z 3
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoLoaded")
	ReloadFinishLoaded:
        CD14 "[" 5
        CD14 "\]" 2
        CD15 A 1
        CD14 N 2
		Goto ReadyActual

	ReloadAmmoLoaded:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",0,"ReloadFinishLoaded")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
		goto ReloadFinishLoaded
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("RocketAmmo",1)
		TNT1 A 0 A_GiveInventory("ComplexDoom_RocketDrum")
		loop

	FlashCom:
		TNT1 A 0
		stop

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"NothingCom")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
	NothingCom:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguyRocketLauncherAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackVanillaDMSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackVanillaDMSoundPSX")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireCustomMissile("DoomRocket",0,false)
        stop

      PickupAttackVanillaDMSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomRocketSoundPSX",0,false)
        stop

      PickupAttackVanillaDMSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomRocketSoundPerkristan",0,false)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackVanillaCoopSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackVanillaCoopSoundPSX")
        TNT1 A 0 A_FireCustomMissile("DoomRocket2",0,false)
        stop

      PickupAttackVanillaCoopSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomRocket2SoundPSX",0,false)
        stop

      PickupAttackVanillaCoopSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomRocket2SoundPerkristan",0,false)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackImprovedDMSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackImprovedDMSoundPSX")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireCustomMissile("DoomRocketImproved",0,false)
        stop

      PickupAttackImprovedDMSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomRocketImprovedSoundPSX",0,false)
        stop

      PickupAttackImprovedDMSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomRocketImprovedSoundPerkristan",0,false)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackImprovedCoopSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackImprovedCoopSoundPSX")
        TNT1 A 0 A_FireCustomMissile("DoomRocketImproved2",0,false)
        stop

      PickupAttackImprovedCoopSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomRocketImproved2SoundPSX",0,false)
        stop

      PickupAttackImprovedCoopSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomRocketImproved2SoundPerkristan",0,false)
        stop
    }
}

actor DoomRocket : Rocket
{
	Decal Scorch
	SeeSound "doomguy/rocklf"
	DeathSound "doomguy/rocklx"
	Damagetype "DoomDamageTypeExplosive"
	Obituary "$SAMSARA_DOOMGUY_OB_SLOT5"
	//SelfObituary "$OB_ROCKET"
	-BLOODSPLATTER
	States
	{
	Spawn:
		DMSL A -1 Bright Light("DOOMROCKET")
		stop

	Death:
		TNT1 A 0 A_Explode
	DeathFinish:
		DMSL B 8 Bright Light("DOOMROCKET_X1")
		DMSL C 6 Bright Light("DOOMROCKET_X2")
		DMSL D 4 Bright Light("DOOMROCKET_X3")
		stop
	}
}

actor DoomRocket2 : DoomRocket { +THRUSPECIES Species "Player" }

actor DoomRocketImproved : DoomRocket { Damage 30 }

actor DoomRocketImproved2 : DoomRocketImproved { +THRUSPECIES Species "Player" }

actor DoomRocketSoundPSX : DoomRocket { SeeSound "doom64guy/rocklf" DeathSound "doom64guy/rocklx" }
actor DoomRocket2SoundPSX : DoomRocket2 { SeeSound "doom64guy/rocklf" DeathSound "doom64guy/rocklx" }
actor DoomRocketImprovedSoundPSX : DoomRocketImproved { SeeSound "doom64guy/rocklf" DeathSound "doom64guy/rocklx" }
actor DoomRocketImproved2SoundPSX : DoomRocketImproved2 { SeeSound "doom64guy/rocklf" DeathSound "doom64guy/rocklx" }

actor DoomRocketSoundPerkristan : DoomRocket { SeeSound "doomguy/perkristan/rocklf" DeathSound "doomguy/perkristan/rocklx" }
actor DoomRocket2SoundPerkristan : DoomRocket2 { SeeSound "doomguy/perkristan/rocklf" DeathSound "doomguy/perkristan/rocklx" }
actor DoomRocketImprovedSoundPerkristan : DoomRocketImproved { SeeSound "doomguy/perkristan/rocklf" DeathSound "doomguy/perkristan/rocklx" }
actor DoomRocketImproved2SoundPerkristan : DoomRocketImproved2 { SeeSound "doomguy/perkristan/rocklf" DeathSound "doomguy/perkristan/rocklx" }

actor SamsaraDoomguy64RocketLauncherAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireCustomMissile("Doom64Rocket",0,false)
        goto PickupFinish

      PickupAttackVanillaCoop:
        TNT1 A 0 A_FireCustomMissile("Doom64Rocket2",0,false)
        goto PickupFinish

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireCustomMissile("Doom64RocketImproved",0,false)
        goto PickupFinish

      PickupAttackImprovedCoop:
        TNT1 A 0 A_FireCustomMissile("Doom64RocketImproved2",0,false)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(2)
        TNT1 A 0 ACS_NamedExecuteAlways("SamsaraRecoil", 0, 2, 0, 20)
        stop
    }
}

actor Doom64Rocket : Rocket
{
	Decal Scorch
	SeeSound "doom64guy/rocklf"
	DeathSound "doom64guy/rocklx"
	-BLOODSPLATTER
	-DEHEXPLOSION
	-ROCKETTRAIL
	DamageType "DoomDamageTypeExplosive"
	XScale 0.81
	YScale 0.68
	Obituary "%k splattered %o's brains with the Rocket Launcher."
	//SelfObituary "$OB_ROCKET"
	States
	{
	Spawn:
		64MI AA 2 Bright Light("ROCKET64") A_SpawnItemEx("Doom64RocketSmokeTrail")
		Loop

	Death:
        TNT1 A 0 A_Explode
	DeathFinish:
		64MI B 8 Bright Light("ROCKET64_X1")
		64MI C 6 Bright Light("ROCKET64_X2") A_FadeOut(0.2)
		64MI D 3 Bright Light("ROCKET64_X3") A_FadeOut(0.2)
		64MI E 3 Bright Light("ROCKET64_X4") A_FadeOut(0.2)
		64MI F 3 Bright Light("ROCKET64_X5") A_FadeOut(0.2)
		Stop
	}
}

actor Doom64Rocket2 : Doom64Rocket { +THRUSPECIES Species "Player" }

actor Doom64RocketImproved : Doom64Rocket { Damage 30 }

actor Doom64RocketImproved2 : Doom64RocketImproved { +THRUSPECIES Species "Player" }

actor Doom64RocketSmokeTrail : RocketSmokeTrail
{
	+CLIENTSIDEONLY
	RenderStyle Translucent
	Alpha 0.5
	VSpeed 0
	Scale 0.75
	States
	{
	Spawn:
		64RS ABCDE 2 bright
		stop
	}
}

// Unpowered attack handler

actor SamsaraDoomguyStrRocketLauncherAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackVanillaDMSoundDE")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocket",0,false)
        stop

      PickupAttackVanillaDMSoundDE:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketSoundDE",0,false)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackVanillaCoopSoundDE")
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketCoop",0,false)
        stop

      PickupAttackVanillaCoopSoundDE:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketCoopSoundDE",0,false)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackImprovedDMSoundDE")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketImproved",0,false)
        stop

      PickupAttackImprovedDMSoundDE:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketImprovedSoundDE",0,false)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackImprovedCoopSoundDE")
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketImprovedCoop",0,false)
        stop

      PickupAttackImprovedCoopSoundDE:
        TNT1 A 0 A_FireCustomMissile("SamsaraDoomguyStrRocketImprovedCoopSoundDE",0,false)
        stop
    }
}

