// Rocket

actor SamsaraDoomguyStrRocket : Rocket
{
	DamageType "DoomDamageTypeExplosive"
	SeeSound "doomguy/stronghold/rocklf"
	DeathSound "doomguy/stronghold/rocklx"
	Decal "Scorch"
	Obituary "$SAMSARA_DOOMGUY_OB_SLOT5"
	//SelfObituary "$OB_ROCKET"
	-BLOODSPLATTER
	-DEHEXPLOSION
	States
	{
	Spawn:
		DMSL E -1 Bright Light("DOOMROCKET")
		stop

	Death:
		TNT1 A 0 A_SetTranslucent(0.67,1)
		TNT1 A 0 A_Explode
	DeathFinish:
		DMSL B 8 Bright Light("DOOMROCKET_X1")
		DMSL C 6 Bright Light("DOOMROCKET_X2")
		DMSL D 4 Bright Light("DOOMROCKET_X3")
		stop
	}
}

actor SamsaraDoomguyStrRocketCoop : SamsaraDoomguyStrRocket
{
	Species "Player"
	+THRUSPECIES
}

actor SamsaraDoomguyStrRocketSoundDE : SamsaraDoomguyStrRocket
{
	SeeSound "doomguy/demoneclipse/rocklf"
	DeathSound "doomguy/demoneclipse/rocklx"
}

actor SamsaraDoomguyStrRocketCoopSoundDE : SamsaraDoomguyStrRocketSoundDE
{
	Species "Player"
	+THRUSPECIES
}

actor SamsaraDoomguyStrRocketImproved : SamsaraDoomguyStrRocket { Damage 24 }

actor SamsaraDoomguyStrRocketImprovedCoop : SamsaraDoomguyStrRocketImproved
{
	Species "Player"
	+THRUSPECIES
}

actor SamsaraDoomguyStrRocketImprovedSoundDE : SamsaraDoomguyStrRocketImproved
{
	SeeSound "doomguy/demoneclipse/rocklf"
	DeathSound "doomguy/demoneclipse/rocklx"
}

actor SamsaraDoomguyStrRocketImprovedCoopSoundDE : SamsaraDoomguyStrRocketImprovedSoundDE
{
	Species "Player"
	+THRUSPECIES
}

// Powered rocket

actor SamsaraDoomguyStrPowerRocket : SamsaraDoomguyStrRocket
{
	Speed 45
	Damage (70)
	Scale 1.5
	+FORCERADIUSDMG
	+SEEKERMISSILE
	States
	{
	Spawn:
		DMSL F 1 Bright Light("POWERROCKET") A_SeekerMissile(2,10)
		loop

	Death:
		TNT1 A 0 A_SetTranslucent(0.67,1)
		TNT1 A 0 A_Explode(96,128,0)
		TNT1 A 0 A_ChangeFlag("FORCERADIUSDMG",false)
		TNT1 A 0 A_Explode(96,128)
	DeathFinish:
		DMSL B 8 Bright Light("POWERROCKET_X1")
		DMSL C 6 Bright Light("POWERROCKET_X2")
		DMSL D 4 Bright Light("POWERROCKET_X3")
		stop
	}
}

actor SamsaraDoomguyStrPowerRocketCoop : SamsaraDoomguyStrPowerRocket
{
	Species "Player"
	+THRUSPECIES
}

actor SamsaraDoomguyStrPowerRocketSoundDE : SamsaraDoomguyStrPowerRocket
{
	SeeSound "doomguy/demoneclipse/rocklf"
	DeathSound "doomguy/demoneclipse/rocklx"
}

actor SamsaraDoomguyStrPowerRocketCoopSoundDE : SamsaraDoomguyStrPowerRocketSoundDE
{
	Species "Player"
	+THRUSPECIES
}

actor SamsaraDoomguyComRocketLauncherAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_RocketDrum",1,1)
        stop
        TNT1 A 0 A_TakeInventory("ComplexDoom_RocketDrum",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireCustomMissile("ComplexDoom_Rocket",0,false)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_FireCustomMissile("ComplexDoom_RocketCoop",0,false)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireCustomMissile("ComplexDoom_RocketImproved",0,false)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_FireCustomMissile("ComplexDoom_RocketImprovedCoop",0,false)
        stop
    }
}

actor ComplexDoom_RocketDrum : Ammo
{
	Inventory.MaxAmount 6
	Tag "Rocket Launcher Magazine"
	+IGNORESKILL
	+UNTOSSABLE
}

actor ComplexDoom_Rocket : Rocket
{
	Speed 26
	Damage 24
	Obituary "%o ate %k's Rocket."
	SeeSound "complexdoom/rocket/fire"
	DeathSound "complexdoom/weapons/rocklx"
	DamageType "DoomDamageTypeExplosive"
	Decal "ComplexDoom_RocketScorch"
	-ROCKETTRAIL
	-BLOODSPLATTER
	States
	{
	Spawn:
		CD14 B 0 Bright Light("COMPLEXMISSILE") A_CustomMissile("ComplexDoom_MissileTrail",Random(4,6),Random(-2,2))
		CD14 B 1 Bright Light("COMPLEXMISSILE") A_CustomMissile("ComplexDoom_RocketTrailParticle",Random(4,6),Random(-2,2))
		Loop
	Death:
		TNT1 A 0
		TNT1 A 0 A_SpawnItemEx("ComplexDoom_ExplosionParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
		TNT1 AAA 0 A_CustomMissile("ComplexDoom_Explosion", 0, 0, random(0,360), 2, random(0,360))
		TNT1 AAA 0 A_CustomMissile("ComplexDoom_ExplosionSmoke", 0, 0, random(0,360), 2, random(0,360))
		TNT1 AAAA 0 A_SpawnItemEx("ComplexDoom_ExplosionDebris",0,0,0,Random(4,-4),Random(4,-4),Random(4,8),0,128)
		TNT1 A 0 A_Explode
		TNT1 A 1 A_SpawnItem("ComplexDoom_RocketEx")
		Stop
    }
}

actor ComplexDoom_RocketImproved : ComplexDoom_Rocket { Damage 32 }

actor ComplexDoom_RocketCoop : ComplexDoom_Rocket
{
	Species "Player"
	+THRUSPECIES
}

actor ComplexDoom_RocketImprovedCoop : ComplexDoom_RocketImproved { +THRUSPECIES Species "Player" }

actor ComplexDoom_RocketTrailParticle
{
	Height 0
	Radius 0
	Mass 0
	Damage 0
	+THRUACTORS
	+NOTELEPORT
	+DONTSPLASH
	+DOOMBOUNCE
	+CLIENTSIDEONLY
	+MISSILE
	+NOBLOCKMAP
	+FORCEXYBILLBOARD
	+NOGRAVITY
	RENDERSTYLE ADD
	BounceFactor 0.5
	Gravity 0.4
	Scale 0.02
	States
	{
	Spawn:
		CD27 "[" 1 Bright A_FadeOut(0.08)
		Loop
	}
}

actor ComplexDoom_MissileTrail
{
	RenderStyle Translucent
	Alpha 0.5
	Scale 0.2
	+CLIENTSIDEONLY
	+NOBLOCKMAP
	+DONTSPLASH
	+NOCLIP
	+NOINTERACTION
	+THRUACTORS
	States
	{
	Spawn:
		TNT1 A 2
		CD30 ABCDEFGHIJKL 1 A_FadeOut(0.05)
		Stop
	}
}
