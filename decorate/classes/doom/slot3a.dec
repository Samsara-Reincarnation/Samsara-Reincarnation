	AltFireLoopAttack:
		TNT1 A 0 A_GunFlash("FlashStrPowered")
	AltFireLoopContinue:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrSuperShotgunPoweredSecondaryAttackHandler")
