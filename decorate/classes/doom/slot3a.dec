actor SamsaraDoomguyStrSuperShotgunCloseSoundPlayer : Trigger
{
    States
    {
      // Sound playing stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupDE")
      PickupStr:
        TNT1 A 0 A_PlaySound("doomguy/stronghold/sshotc",CHAN_WEAPON)
        stop

      PickupDE:
        TNT1 A 0 A_PlaySound("doomguy/demoneclipse/sshotc",CHAN_WEAPON)
        stop
    }
}

actor SamsaraDoomguyComDoubleBarrelShotgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("ComplexDoom_SSGShell",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("complexdoom/weapons/sshotf",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,Random(4,6)*3,"ComplexDoom_BulletPuff",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackVanillaCoop:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,Random(4,6)*3,"ComplexDoom_BulletPuffCoop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,Random(5,7)*3,"ComplexDoom_BulletPuff",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackImprovedCoop:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,Random(5,7)*3,"ComplexDoom_BulletPuffCoop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
		TNT1 A 0 A_Quake(3,3,0,64,"nosoundforyoubitch")
		TNT1 AAAAAAAA 0 A_FireCustomMissile("ComplexDoom_SGTracer",Random(8,-8),0,0,Random(8,-8))
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        stop
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComSSGFired",2)
        stop
    }
}

