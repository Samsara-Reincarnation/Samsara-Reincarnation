	Tag "Double Barrel Shotgun Magazine"
	+IGNORESKILL
	+UNTOSSABLE
}

// Assault Shotgun

actor SamsaraDoomguyComASGReloadShellSkip : Boolean {}

ACTOR ComplexDoom_AssaultShotgun : Weapon
{
    Scale 0.85
    Weapon.SelectionOrder 400
	Weapon.SlotNumber 3
    Weapon.KickBack 80
    Weapon.AmmoType1 "ComplexDoom_ASGMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Shell"
    //Weapon.AmmoGive2 8
    Inventory.PickupSound "complexdoom/AShotgun/Cock"
    Inventory.PickupMessage "Assault Shotgun"
    Obituary "%o was blown away by %k's Assault Shotgun."
	Tag "Assault Shotgun"
    Inventory.RestrictedTo "DoomguyPlayer"
    +WEAPON.AMMO_OPTIONAL
    +WEAPON.NOALERT
    +INVENTORY.UNDROPPABLE
    States
    {
    Spawn:
        CD09 A -1
        Stop

    Ready:
        CD09 G 1 A_PlayWeaponSound("complexdoom/AShotgun/Cock")
        CD09 BCDEF 1
        Goto ReadyActual

    ReadyActual:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualReloadable")
    ReadyActualNonReloadable:
        CD09 J 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualReloadable:
        CD09 J 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    Deselect: 
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        CD09 J 1 A_Lower
        wait

    Select:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        loop

    Fire:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
	FireNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireStart")
		goto FireEmpty

	FireReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",1,"FireStart")
        goto FireEmpty

    FireEmpty:
        CD09 J 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComAssaultShotgunAttackHandler")
        CD09 H 2 Bright A_Light1
        CD09 I 2 Bright A_Light2
        CD09 K 1 A_Light0
        CD09 LMN 1
        CD09 OJ 2
        Goto ReadyActual

    Reload:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",0,"ReadyActual")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadInit")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadInit")
        Goto ReadyActual

	ReloadInit:
        TNT1 A 0 A_TakeInventory("SamsaraDoomguyComASGReloadShellSkip")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",1,1)
        goto ReloadStart
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComASGReloadShellSkip")
	ReloadStart:
        CD09 UVWX 1
        CD09 YZ 2
        CD09 "[" 6
    ReloadLoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinish
        CD09 "\]" 1
        CD10 A 1 A_PlaySound("complexdoom/Weapons/ASGShellLoad")
        CD10 B 1
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
    ReloadLoopContinue:
        CD10 C 1
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto ReloadFinish
        CD10 DE 1
        CD10 F 2
        CD09 "[" 1 A_WeaponReady(WRF_NOBOB)
        goto ReloadLoop

    ReloadFinish:
        CD10 G 3
        CD10 H 2
        CD09 WVU 1
        CD09 P 1 A_JumpIfInventory("SamsaraDoomguyComASGReloadShellSkip",1,"ReadyActual")
        CD09 Q 2
        CD09 R 3 A_PlayWeaponSound("complexdoom/AShotgun/Cock")
        CD09 S 5
        CD09 T 2
        Goto ReadyActual

    ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
    ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",0,"ReloadLoopContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadLoopContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadLoopContinue
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("ComplexDoom_ASGMagazine")
        loop

	Flash:
		TNT1 A 0
		stop
    }
}

actor SamsaraDoomguyComAssaultShotgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ASGMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("ComplexDoom_ASGMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("complexdoom/AShotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireBullets(5.0,3.0,7,Random(4,6)*3,"ComplexDoom_BulletPuff",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackVanillaCoop:
        TNT1 A 0 A_FireBullets(5.0,3.0,7,Random(4,6)*3,"ComplexDoom_BulletPuffCoop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireBullets(5.0,3.0,7,Random(5,7)*3,"ComplexDoom_BulletPuff",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackImprovedCoop:
        TNT1 A 0 A_FireBullets(5.0,3.0,7,Random(5,7)*3,"ComplexDoom_BulletPuffCoop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
		TNT1 A 0 A_Quake(3,3,0,64,"nosoundforyoubitch")
		TNT1 AAAA 0 A_FireCustomMissile("ComplexDoom_SGTracer",Random(5,-5),0,0,Random(5,-5))
        TNT1 A 0 A_SpawnItemEx("ComplexDoom_ShellCasing",30,5,25,Random(2,4),Random(3,6),Random(3,6),0)
        stop
    }
}

ACTOR ComplexDoom_ASGMagazine : Ammo
{
	Inventory.MaxAmount 8
	Tag "Assault Shotgun Magazine"
	+IGNORESKILL
	+UNTOSSABLE
}
