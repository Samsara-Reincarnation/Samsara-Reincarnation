// Tokens

actor SamsaraDoomComplexLoadoutSlot3 : Counter {}

// Super Shotgun

actor SamsaraDoomguyStrSuperShotgunSecondaryPoweredAttackAmount : Counter { Inventory.MaxAmount 2 }
actor SamsaraDoomguyComSSGFired : Counter { Inventory.MaxAmount 2 }
actor SamsaraDoomguyComSSGAlternate : Boolean {}

actor "Super Shotgun" : SuperShotgun
{
	//Weapon.AmmoType2 "Shell"
	Weapon.AmmoGive 0
	//Weapon.AmmoUse2 4
	Weapon.SlotNumber 3
    +AMMO_OPTIONAL
	+INVENTORY.UNDROPPABLE
	+NOALERT
	AttackSound ""
	Tag "Super Shotgun"
	Obituary "$SAMSARA_DOOMGUY_OB_SLOT3"
	Inventory.RestrictedTo "DoomguyPlayer"
	States
	{
	Spawn:
		WSSG A -1
		stop

	// Original
	Ready:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyCom")
	ReadyActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"ReadyActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"ReadyActual64")
		DSSG A 1 A_WeaponReady(WRF_NOSECONDARY)
		loop

	Deselect:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectCom")
	DeselectActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"DeselectActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"DeselectActual64")
		DSSG A 1 A_Lower
		loop

	Select:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"SelectCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"SelectStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Select64")
		DSSG A 1 A_Raise
		loop

	Fire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireCom")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
        TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStr")
		DSSG A 3 A_JumpIfInventory("DoomClassMode",1,"Fire64")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",2,"FireAttack")
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireContinueSmooth")
		goto FireContinue

	FireAttack:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireAttackSmooth")
		TNT1 A 0 A_GunFlash
	FireContinue:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguySuperShotgunAttackHandler")
	FireVanilla:
		DSSG A 7 Bright
		DSG2 B 7
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 C 7 //A_CheckReload
		DSG2 D 7 A_GiveInventory("SamsaraDoomguySuperShotgunOpenSoundPlayer")
		DSG2 E 7
		DSG2 F 7 A_GiveInventory("SamsaraDoomguySuperShotgunLoadSoundPlayer")
		DSG2 G 6
		TNT1 A 0 A_GiveInventory("SamsaraDoomguySuperShotgunCloseSoundPlayer")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 H 6 A_ReFire
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSSG A 5 A_ReFire
		goto ReadyActual

	FireAttackSmooth:
		TNT1 A 0 A_GunFlash("FlashSmooth")
	FireContinueSmooth:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguySuperShotgunAttackHandler")
	FireSmooth:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"FireSmoothRage")
		XTS2 B 3 offset(0,40) Bright
		XTS2 C 2 offset(0,39) Bright
		XTS2 D 1 offset(0,37) Bright
		DSSG A 1 offset(0,35)
		XTS2 EF 2
		XTS2 G 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		XTS2 H 3 //A_CheckReload
		XTS2 I 2
		XTS3 I 2 offset(0,32)
		XTS3 J 2 A_GiveInventory("SamsaraDoomguySuperShotgunOpenSoundPlayer")
		XTS3 K 2
		XTS2 L 3
		XTS2 MN 1
		XTS2 O 2
		XTS2 P 3
		XTS3 Q 1 A_GiveInventory("SamsaraDoomguySuperShotgunLoadSoundPlayer")
		XTS2 QRS 2
		XTS2 TU 1
		XTS2 V 2
		XTS2 W 2
		XTS2 X 0 A_GiveInventory("SamsaraDoomguySuperShotgunCloseSoundPlayer")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		XTS2 X 3 A_ReFire
		XTS2 Y 2
		XTS2 Z 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSSG A 5 A_ReFire
		goto ReadyActual

	FireSmoothRage:
		XTS2 B 3 offset(0,40) Bright
		XTS2 C 2 offset(0,39) Bright
		DSSG A 1 offset(0,35)
		XTS2 EF 2
		XTS2 G 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		XTS2 H 3 //A_CheckReload
		XTS2 I 2
		XTS3 I 2 offset(0,32)
		XTS3 J 2 A_GiveInventory("SamsaraDoomguySuperShotgunOpenSoundPlayer")
		XTS3 K 2
		XTS2 L 3
		XTS2 M 1
		XTS2 O 2
		XTS2 P 3
		XTS3 Q 2 A_GiveInventory("SamsaraDoomguySuperShotgunLoadSoundPlayer")
		XTS2 RS 2
		XTS2 U 1
		XTS2 V 2
		XTS2 W 3
		XTS2 X 0 A_GiveInventory("SamsaraDoomguySuperShotgunCloseSoundPlayer")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		XTS2 X 3 A_ReFire
		XTS2 Y 2
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSSG A 5 A_ReFire
		goto ReadyActual

	Flash:
		DSSF A 3 Bright A_Light1
		DSSF B 3 Bright A_Light2
		goto LightDone

	FlashSmooth:
		TNT1 A 3 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		goto LightDone

	// Doom 64 (has recoil visual and kickback)
	ReadyActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"ReadyActual64Smooth")
	ReadyActual64Vanilla:
		64DB A 1 A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual

	ReadyActual64Smooth:
		64DB D 1 A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual

	DeselectActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"DeselectActual64Smooth")
	DeselectActual64Vanilla:
		64DB A 1 A_Lower
		goto DeselectActual

	DeselectActual64Smooth:
		64DB D 1 A_Lower
		goto DeselectActual

	Select64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Select64Smooth")
	Select64Vanilla:
		64DB A 1 A_Raise
		goto Select

	Select64Smooth:
		64DB D 1 A_Raise
		goto Select

	Fire64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64Smooth")
	Fire64Vanilla:
		64DB A 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire64VanillaAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",2,"Fire64VanillaAttack")
		goto Fire64VanillaContinue

	Fire64VanillaAttack:
		TNT1 A 0 A_GunFlash("Flash64")
	Fire64VanillaContinue:
		64DB A 5 A_GiveInventory("SamsaraDoomguy64SuperShotgunAttackHandler")
		64DB C 9
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		64DB C 23 //A_CheckReload
		64DB B 6 A_PlaySound("doom64guy/sshoto",CHAN_WEAPON)
		64DB A 6 A_PlaySound("doom64guy/sshotc",CHAN_WEAPON)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		64DB A 5 A_ReFire
		goto ReadyActual

	Fire64Smooth:
		64DB D 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire64SmoothAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",2,"Fire64SmoothAttack")
		goto Fire64SmoothContinue

	Fire64SmoothAttack:
		TNT1 A 0 A_GunFlash("Flash64Smooth")
	Fire64SmoothContinue:
		64DB Y 2 Bright A_GiveInventory("SamsaraDoomguy64SuperShotgunAttackHandler")
		64DB X 2 Bright
		64DB D 1 Bright
		64DB EFH 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		64DB I 4 //A_CheckReload
		64DB JL 3
		64DB M 3 A_PlaySound("doom64guy/sshotl",CHAN_WEAPON)
		64DB NOP 3
		64DB K 4
		64DB Q 2 A_PlaySound("doom64guy/sshoto",CHAN_WEAPON)
		64DB RS 2
		64DB T 2 A_PlaySound("doom64guy/sshotc",CHAN_WEAPON)
		64DB UVWE 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		64DB D 5 A_ReFire
		goto ReadyActual

	Flash64:
		64DM A 2 Bright A_Light1
		64DM A 2 Bright A_Light2
		goto LightDone

	Flash64Smooth:
		64DM B 2 Bright A_Light1
		64DM C 2 Bright A_Light2
		64DM D 1 Bright A_Light0
		goto LightDone

	// Stronghold
	// Unpowered
	ReadyActualStr:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStrPowered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStrPowered")
		DSG2 I 1 A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual

	DeselectActualStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"DeselectActualStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"DeselectActualStrPowered")
	DeselectActualStrContinue:
		TNT1 A 0 A_Lower
		DSG2 I 1 A_Lower
		goto DeselectActual

	SelectStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"SelectStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"SelectStrPowered")
	SelectStrContinue:
		TNT1 A 0 A_Raise
		DSG2 I 1 A_Raise
		goto Select

	FireStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPowered")
		DSG2 I 3 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",2,"FireStrAttack")
		goto FireStrContinue

	FireStrAttack:
		TNT1 A 0 A_GunFlash("FlashStr")
	FireStrContinue:
		DSG2 U 2 Bright A_GiveInventory("SamsaraDoomguyStrSuperShotgunAttackHandler")
		DSG2 V 3 Bright
		DSG2 W 2 Bright
		DSG2 J 3
		DSG2 K 4
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 L 4 //A_CheckReload
		DSG2 K 3
		DSG2 M 3 A_GiveInventory("SamsaraDoomguyStrSuperShotgunOpenSoundPlayer")
		DSG2 N 3
		DSG2 OP 4
		DSG2 Q 3 A_GiveInventory("SamsaraDoomguyStrSuperShotgunLoadSoundPlayer")
		DSG2 RS 3
		DSG2 T 4
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrSuperShotgunCloseSoundPlayer")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 M 6 A_ReFire
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 I 5 A_ReFire
		goto ReadyActual

	FlashStr:
		TNT1 A 2 Bright A_Light1
		TNT1 A 3 Bright A_Light2
	FlashStrFinish:
		TNT1 A 2 Bright A_Light1
		goto LightDone

	// Powered
/*
	ReadyActualStrPowered:
		DSG2 I 1 A_WeaponReady
		goto ReadyActual
*/

	DeselectActualStrPowered:
		TNT1 A 0 A_Lower
		goto DeselectActualStrContinue

	SelectStrPowered:
		TNT1 A 0 A_Raise
		goto SelectStrContinue

	FireStrPowered:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrSuperShotgunSecondaryPoweredAttackAmount") // reset
	FireStrPoweredLoop:
		DSG2 I 2 A_JumpIfInventory("SamsaraDoomguyStrSuperShotgunSecondaryPoweredAttackAmount",0,"FireStrPoweredContinue")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrSuperShotgunSecondaryPoweredAttackAmount")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredLoopAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",2,"FireStrPoweredLoopAttack")
		goto FireStrPoweredLoopContinue

	FireStrPoweredLoopAttack:
		TNT1 A 0 A_GunFlash("FlashStrPowered")
	FireStrPoweredLoopContinue:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrSuperShotgunPoweredPrimaryAttackHandler")
		DSG2 UVW 2 Bright
		goto FireStrPoweredLoop

	FireStrPoweredContinue:
		DSG2 JK 2
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 L 2 //A_CheckReload
		DSG2 K 2
		DSG2 M 2 A_GiveInventory("SamsaraDoomguyStrSuperShotgunOpenSoundPlayer")
		DSG2 NOP 2
		DSG2 Q 2 A_GiveInventory("SamsaraDoomguyStrSuperShotgunLoadSoundPlayer")
		DSG2 RST 2
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrSuperShotgunCloseSoundPlayer")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 M 2 A_ReFire
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        goto Nothing
		DSG2 I 2 A_ReFire
		goto ReadyActual

/*
	AltFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",4,1)
        goto Nothing
        TNT1 A 0 A_AlertMonsters
