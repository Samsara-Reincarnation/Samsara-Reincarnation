		//TNT1 A 0 A_CheckReload
	AltFireFinish2:
		DSG2 I 2
		goto ReadyActual

	AltFireFinishReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"AltFireFinish") // 2
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1) // 2
		//TNT1 A 0 A_CheckReload
		goto AltFireFinish
		TNT1 A 0 A_ReFire
		goto AltFireFinish

	AltFireFinish2ReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"AltFireFinish2") // 2
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1) // 2
		//TNT1 A 0 A_CheckReload
		goto AltFireFinish2
		TNT1 A 0 A_ReFire
		goto AltFireFinish2
*/

	FlashStrPowered:
		TNT1 A 2 Bright A_Light1
		TNT1 A 2 Bright A_Light2
		goto FlashStrFinish

	// Complex Doom (Double Barrel Shotgun)
    ReadyCom:
		CD07 C 1 A_PlayWeaponSound("complexdoom/weapons/pickupssg")
		CD07 DEFGH 1
		CD07 IJ 2
        Goto ReadyActual

    ReadyActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto ReadyActualComNonReloadableContinue
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"ReadyActualComNonReloadableNoAmmo")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",1,"ReadyActualComNonReloadableAmmoOneShot")
        goto ReadyActualComNonReloadableAmmoBothShots

    ReadyActualComNonReloadableContinue:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyActualComNonReloadableAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("Shell",2,"ReadyActualComNonReloadableAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReadyActualComNonReloadableAmmoOneShot")
        Goto ReadyActualComNonReloadableNoAmmo

    ReadyActualComNonReloadableNoAmmo:
        CD07 "]" 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComNonReloadableAmmoOneShot:
        CD08 A 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComNonReloadableAmmoBothShots:
        CD07 K 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActualComReloadableAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",2,"ReadyActualComReloadableAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,"ReadyActualComReloadableAmmoOneShot")
        Goto ReadyActualComReloadableNoAmmo

    ReadyActualComReloadableNoAmmo:
        CD07 "]" 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    ReadyActualComReloadableAmmoOneShot:
        CD08 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    ReadyActualComReloadableAmmoBothShots:
        CD07 K 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"DeselectActualComReloadable")
    DeselectActualComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto DeselectActualComNonReloadableContinue
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"DeselectActualComNoAmmo")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",1,"DeselectActualComAmmoOneShot")
        goto DeselectActualComAmmoBothShots

    DeselectActualComNonReloadableContinue:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectActualComAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("Shell",2,"DeselectActualComAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"DeselectActualComAmmoOneShot")
        Goto DeselectActualComNoAmmo

    DeselectActualComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"DeselectActualComAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",2,"DeselectActualComAmmoBothShots")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,"DeselectActualComAmmoOneShot")
        Goto DeselectActualComNoAmmo

    DeselectActualComNoAmmo:
        CD07 "]" 1 A_Lower
        goto DeselectActual

    DeselectActualComAmmoOneShot:
        CD08 A 1 A_Lower
        goto DeselectActual

    DeselectActualComAmmoBothShots:
        CD07 K 1 A_Lower
        goto DeselectActual

    SelectCom:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

    FireCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireComEmptyNonReloadable
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto FireComNonReloadableDouble
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"ReloadStartBothShots")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",1,"FireComNonReloadableSingle")
    FireComNonReloadableDouble:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
        TNT1 A 0 A_JumpIfInventory("Shell",2,"FireComStart")
        goto FireComNonReloadableSingle

    FireComNonReloadableSingle:
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGAlternate",1,"AltFireStart2")
        goto AltFireStart

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",2,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,1)
        goto FireComEmptyNoAmmo
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGAlternate",1,"AltFireStart2")
        goto AltFireStart

    FireComEmptyNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto FireComEmptyNoAmmo
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"FireComEmptyNoAmmo")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",1,"FireComEmptyAmmoOneShot")
        goto FireComEmptyAmmoBothShots

    FireComEmptyNoAmmo:
        CD07 "]" 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComEmptyAmmoOneShot:
        CD08 A 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComEmptyAmmoBothShots:
        CD07 K 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComDoubleBarrelShotgunAttackHandler")
        TNT1 A 0 ACS_NamedExecuteWithResult("Complex_Decorate", 1, 0)
        CD06 V 2 Bright A_Light1
        CD06 W 2 Bright A_Light2
        CD06 M 1 A_Light0
        CD07 LMNOP 1
        CD07 ONML 2
    FireComFinishCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto FireComFinish
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,4)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireComFinish
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"ReloadStartBothShots")
        goto ReloadStartOneShot
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,"FireComFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireComFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,"ReloadStartOneShot")
        goto ReloadStartBothShots

    FireComFinish:
        CD06 M 2
        Goto ReadyActual

	AltFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
	AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireComEmptyNonReloadable
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGAlternate",1,"AltFireStart2")
        goto AltFireStart
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGFired",0,"ReloadStartBothShots")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGAlternate",1,"AltFireStart2")
        goto AltFireStart

	AltFireReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,1)
        goto FireComEmptyNoAmmo
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComSSGAlternate",1,"AltFireStart2")
        goto AltFireStart

    AltFireStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComDoubleBarrelShotgunAltAttackHandler")
        TNT1 A 0 ACS_NamedExecuteWithResult("Complex_Decorate", 1, 1)
        CD06 B 2 Bright A_Light1
        CD06 C 2 Bright A_Light2
        CD06 X 1 A_Light0
        CD06 "YZ[" 1
        CD08 A 2
        Goto ReadyActual

    AltFireStart2:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComDoubleBarrelShotgunAltAttackHandler")
        TNT1 A 0 ACS_NamedExecuteWithResult("Complex_Decorate", 1, 1)
        CD06 D 2 Bright A_Light1
	    CD06 E 2 Bright A_Light2
        CD06 "\" 1 A_Light0
        CD06 "]" 1
        CD07 AB 1
        CD07 "]" 2
        Goto ReadyActual

	FlashCom:
		TNT1 A 0
		stop

    Reload:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",0,"ReadyActual")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",1,"ReloadStartOneShot")
        goto ReloadStartBothShots

    ReloadStartBothShots:
        CD07 "\[" 2
        CD06 N 2
        CD07 QR 2
        CD06 R 1 A_PlaySound("complexdoom/weapons/sawedopen")
        CD07 S 1
        CD06 S 1
        TNT1 A 0 A_SpawnItemEx("ComplexDoom_SSGShellCasing",25,-2,25,Random(2,4),Random(-3,-6),Random(3,6),0)
        CD06 P 4 A_SpawnItemEx("ComplexDoom_SSGShellCasing",25,-2,25,Random(2,4),Random(-3,-6),Random(3,6),0)
        CD07 T 2 
        CD06 QT 2
        CD07 U 3
        CD07 V 3 A_PlaySound("complexdoom/weapons/shellslide")
        CD07 WX 2
        CD07 YZ 1 
        CD06 U 1 A_PlaySound("complexdoom/weapons/sawedclose")
        CD06 O 1
        CD06 N 2
        CD07 "[\" 2
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        TNT1 A 0 A_TakeInventory("SamsaraDoomguyComSSGFired")
        goto ReloadFinish

    ReloadStartOneShot:
        CD07 "\[" 2
        CD06 N 2
        CD06 O 1
        CD06 U 1 A_PlaySound("complexdoom/weapons/sawedopen")	
        CD07 ZY 1
        CD06 FG 1
        CD06 H 4 A_SpawnItemEx("ComplexDoom_SSGShellCasing",25,-2,25,Random(2,4),Random(-3,-6),Random(3,6),0)
        CD06 IJKL 2
        CD07 V 2 A_PlaySound("complexdoom/weapons/shellslide")
        CD07 WX 2
        CD07 YZ 1 
        CD06 U 1 A_PlaySound("complexdoom/weapons/sawedclose")
        CD06 O 1
        CD06 N 2
        CD07 "[\" 2
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        TNT1 A 0 A_TakeInventory("SamsaraDoomguyComSSGFired")
        goto ReloadFinish

    ReloadFinish:
        TNT1 A 0 ACS_NamedExecuteWithResult("Complex_Decorate", 1, 0)
		Goto ReadyActual

	ReloadAmmo:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_SSGShell",0,"ReloadFinish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
		goto ReloadFinish
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Shell",1)
		TNT1 A 0 A_GiveInventory("ComplexDoom_SSGShell")
		loop

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"NothingCom")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
	NothingCom:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguySuperShotgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",2)
        goto PickupSound

      // Sound stuff
      PickupSound:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupSoundPSX")
        TNT1 A 0 A_PlaySound("doomguy/sshotf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPSX:
        TNT1 A 0 A_PlaySound("doom64guy/sshotf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/sshotf",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,5,"DoomBulletPuffPlayerThruGhost",FBF_NOFLASH)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,random(2,3)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,random(2,4)*5,"DoomBulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_FireBullets(11.2,7.1,20,random(2,4)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
    }
}

