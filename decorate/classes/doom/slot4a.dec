	AltFireFinish:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto Nothing
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"AltFireFinishReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"AltFireFinishReFire")
		//TNT1 A 0 A_CheckReload
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrChaingunFiringEndSoundPlayer")
		goto ReadyActual

	AltFireFinishReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStrFinish")
		//TNT1 A 0 A_CheckReload
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrChaingunFiringEndSoundPlayer")
		goto ReadyActual
*/

	FlashStrPowered:
		TNT1 A 2 Bright A_Light1
		TNT1 A 1 Bright A_Light2
		goto LightDone

	// Complex Doom (Assault Rifle)
    ReadyCom:
		CD11 H 1 A_PlayWeaponSound("complexdoom/items/assaultrifle")
		CD11 IJKLM 1
        Goto ReadyActual

    ReadyActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        CD11 Q 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComReloadable:
        CD11 Q 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
        CD11 Q 1 A_Lower
        goto DeselectActual

    SelectCom:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

    FireCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("Clip",1,"FireComStart")
		goto FireComEmpty

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",1,"FireComStart")
        goto FireComEmpty

    FireComEmpty:
        CD11 Q 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComAssaultRifleAttackHandler")
        CD11 N 2 Bright A_Light1
        CD11 O 1 A_Light0
        CD11 P 1
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,3)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart2")
	    TNT1 A 0 A_JumpIfInventory("Clip",1,"FireComStart2")
        goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart2")
	    TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",1,"FireComStart2")
        goto ReadyActual

    FireComStart2:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComAssaultRifleAttackHandler")
        CD11 N 2 Bright A_Light1
        CD11 O 1 A_Light0
        CD11 P 1
        TNT1 A 0 A_ReFire
        goto ReadyActual

	FlashCom:
		TNT1 A 0
		stop

	Reload:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
		goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",0,"ReadyActual")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
		TNT1 A 0 A_JumpIfInventory("Clip",1,"ReloadStart")
		Goto ReadyActual

	ReloadStart:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",1,"ReloadStartLoaded")
	    CD11 R 1 A_PlayWeaponSound("complexdoom/weapons/arreload")
 	    CD11 STU 1
	    CD11 V 1 A_SpawnItemEx("ComplexDoom_AREmptyMag",2,0,-12,1,0,0,Random(-100,-110),128)
	    CD11 W 1
		CD11 X 8
		CD11 "YZ[\" 1
	    CD11 "]" 8	
		CD12 AB 2
		CD12 CD 1
		CD11 B 1
		CD11 C 3
		CD11 D 4 A_PlayWeaponSound("complexdoom/weapons/arclick")
		CD11 E 3
		CD11 FG 2
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
		goto ReadyActual

	ReloadAmmo:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",0,"ReadyActual")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Clip",1,1)
		goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Clip",1)
		TNT1 A 0 A_GiveInventory("ComplexDoom_ARMagazine")
		loop

	ReloadStartLoaded:
	    CD11 R 1 A_PlayWeaponSound("complexdoom/weapons/arreload")
 	    CD11 STU 1
	    CD11 V 1 A_SpawnItemEx("ComplexDoom_AREmptyMag",2,0,-12,1,0,0,Random(-100,-110),128)
	    CD11 W 1
        CD11 X 8
		CD11 "YZ[\" 1
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoLoaded")
	ReloadFinishLoaded:
	    CD11 "]" 8	
		CD12 AB 2
		CD12 CDEFG 1
	    CD11 Q 2
		Goto ReadyActual

	ReloadAmmoLoaded:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ARMagazine",0,"ReloadFinishLoaded")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Clip",1,1)
		goto ReloadFinishLoaded
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Clip",1)
		TNT1 A 0 A_GiveInventory("ComplexDoom_ARMagazine")
		loop

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"NothingCom")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
	NothingCom:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguyChaingunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupSound

      // Sound stuff
      PickupSound:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupSoundPSX")
        TNT1 A 0 A_PlaySound("doomguy/chngun",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPSX:
        TNT1 A 0 A_PlaySound("doom64guy/chngun",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/chngun",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,5,"DoomBulletPuffPlayerThruGhost",FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,1,5,"DoomBulletPuffPlayerThruGhost",FBF_NOFLASH)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(2,3)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(2,3)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(2,4)*5,"DoomBulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(2,4)*5,"DoomBulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(2,4)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(2,4)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
    }
}

actor SamsaraDoomguy64ChaingunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupPlaySound")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupPlaySound

      // Sound stuff
      PickupPlaySound:
        TNT1 A 0 A_JumpIfInventory("SamsaraDoom64ChaingunSoundChannelCount",0,"PickupPlaySound7")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoom64ChaingunSoundChannelCount",2,"PickupPlaySound6")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoom64ChaingunSoundChannelCount",1,"PickupPlaySound4")
      PickupPlaySound1:
        TNT1 A 0 A_PlaySound("doom64guy/chngun",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraDoom64ChaingunSoundChannelCount")
        goto PickupAttack

      PickupPlaySound4:
        TNT1 A 0 A_PlaySound("doom64guy/chngun")
        TNT1 A 0 A_GiveInventory("SamsaraDoom64ChaingunSoundChannelCount")
        goto PickupAttack

      PickupPlaySound6:
        TNT1 A 0 A_PlaySound("doom64guy/chngun",CHAN_6)
        TNT1 A 0 A_GiveInventory("SamsaraDoom64ChaingunSoundChannelCount")
        goto PickupAttack

      PickupPlaySound7:
        TNT1 A 0 A_PlaySound("doom64guy/chngun",CHAN_7)
        TNT1 A 0 A_TakeInventory("SamsaraDoom64ChaingunSoundChannelCount")
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(1,4)*4,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(1,4)*4,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(1,4)*5,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(1,4)*5,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,1,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,1,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteAlways("SamsaraRecoil", 0, 1, 0, 5)
        stop
    }
}

// Unpowered attack handler

actor SamsaraDoomguyStrChaingunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupSound

      // Sound stuff
      PickupSound:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupSoundDE")
        TNT1 A 0 A_PlaySound("doomguy/stronghold/chnglp",CHAN_WEAPON,1,true)
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrChaingunFiringSoundCheck")
        goto PickupAttack

      PickupSoundDE:
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrChaingunFiringSoundStopper")
        TNT1 A 0 A_PlaySound("doomguy/demoneclipse/chngun",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(4,2.3,1,5,"SamsaraDoomguyStrBulletPuffBallisticThruGhost",FBF_NOFLASH)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(4,2.3,1,5,"SamsaraDoomguyStrBulletPuffBallisticThruGhostCoop",FBF_NOFLASH)
        stop
    }
}

