actor " Shotgun " : Shotgun
{
	Weapon.AmmoGive 8
	Weapon.SlotNumber 2
    +AMMO_OPTIONAL
	//+ALT_USES_BOTH
	+UNDROPPABLE
	+NOALERT
	AttackSound ""
	Tag "Shotgun"
	Obituary "$SAMSARA_DOOMGUY_OB_SLOT2"
	Inventory.RestrictedTo "DoomguyPlayer"
	States
	{
	Spawn:
		WSHT A -1
		stop

	// Original
	Ready:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyCom")
	ReadyActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"ReadyActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"ReadyActual64")
		DSHT A 1 A_WeaponReady
		loop

	Deselect:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectCom")
	DeselectActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"DeselectActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"DeselectActual64")
		DSHT A 1 A_Lower
		loop

	Select:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"SelectCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"SelectStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Select64")
		DSHT A 1 A_Raise
		loop

	Fire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireCom")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStr")
		DSHT A 3 A_JumpIfInventory("DoomClassMode",1,"Fire64")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireAttack")
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireContinueSmooth")
		goto FireContinue

	FireAttack:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireAttackSmooth")
		TNT1 A 0 A_GunFlash
	FireContinue:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyShotgunAttackHandler")
	FireVanilla:
		DSHT A 7 Bright
		DSHT IJ 5
		DSHT K 4
		DSHT JI 5
		DSHT A 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT A 7 A_ReFire
		goto ReadyActual

	FireAttackSmooth:
		TNT1 A 0 A_GunFlash("FlashSmooth")
	FireContinueSmooth:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyShotgunAttackHandler")
	FireSmooth:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"FireSmoothRage")
		XTS1 B 3 offset(0,40) Bright
		XTS1 C 2 offset(0,39) Bright
		XTS1 D 1 offset(0,37) Bright
		DSHT A 1 offset(0,35)
		XTS1 E 2 offset(0,32)
		XTS1 FGH 2
		XTS1 I 4
		XTS1 JK 3
		XTS1 LMN 2
		XTS1 OPQ 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT A 7 A_ReFire
		goto ReadyActual

	FireSmoothRage:
		XTS1 B 3 offset(0,40) Bright
		XTS1 C 2 offset(0,39) Bright
		XTS1 D 1 offset(0,37) Bright
		DSHT A 1 offset(0,35)
		XTS1 E 1 offset(0,32)
		XTS1 FGH 2
		XTS1 I 4
		XTS1 J 2
		XTS1 K 3
		XTS1 LMN 2
		XTS1 OPQ 1
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT A 7 A_ReFire
		goto ReadyActual

	Flash:
		DSHF A 3 Bright A_Light1
		DSHF B 4 Bright A_Light2
		goto LightDone

	FlashSmooth:
		TNT1 A 3 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		goto LightDone

	// Doom 64 (has recoil visual)
	ReadyActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"ReadyActual64Smooth")
	ReadyActual64Vanilla:
		64SG A 1 A_WeaponReady
		goto ReadyActual

	ReadyActual64Smooth:
		64SG M 1 A_WeaponReady
		goto ReadyActual

	DeselectActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Deselect64Smooth")
	Deselect64Vanilla:
		64SG A 1 A_Lower
		goto DeselectActual

	Deselect64Smooth:
		64SG M 1 A_Lower
		goto DeselectActual

	Select64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Select64Smooth")
	Select64Vanilla:
		64SG A 1 A_Raise
		goto Select

	Select64Smooth:
		64SG M 1 A_Raise
		goto Select

	Fire64:
		TNT1 A 0 A_GunFlash("Flash64")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64ShotgunAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64Smooth")
	Fire64Vanilla:
		64SG A 5
		64SG C 21
		64SG B 5
		64SG A 7
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		64SG A 7 A_ReFire
		goto ReadyActual

	Fire64Smooth:
		64SG O 2
		64SG P 2
		64SG M 1
		64SG M 2
		64SG EFG 1
		64SG H 2
		64SG IJ 3
		64SG KJ 4
		64SG I 3
		64SG H 3
		64SG G 2
		64SG F 2
		64SG E 2
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		64SG M 7 A_ReFire
		goto ReadyActual

	Flash64:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Flash64Smooth")
		64SG N 2 Bright A_Light1
		64SG N 2 Bright A_Light2
		goto LightDone
	Flash64Smooth:
		64SF A 2 Bright A_Light1
		64SF B 2 Bright A_Light2
		64SF C 1 Bright A_Light0
		goto LightDone

	// Stronghold
	// Unpowered
	ReadyActualStr:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStrPowered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStrPowered")
		DSHT L 1 A_WeaponReady
		goto ReadyActual

	DeselectActualStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"DeselectActualStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"DeselectActualStrPowered")
	DeselectActualStrContinue:
		TNT1 A 0 A_Lower
		DSHT L 1 A_Lower
		goto DeselectActual

	SelectStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"SelectStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"SelectStrPowered")
	SelectStrContinue:
		TNT1 A 0 A_Raise
		DSHT L 1 A_Raise
		goto Select

	FireStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPowered")
		DSHT L 3 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"FireStrImproved")
	FireStrVanilla:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrAttackVanilla")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireStrAttackVanilla")
		goto FireStrContinueVanilla

	FireStrAttackVanilla:
		TNT1 A 0 A_GunFlash("FlashStrVanilla")
	FireStrContinueVanilla:
		DSHT P 2 Bright A_GiveInventory("SamsaraDoomguyStrShotgunAttackHandler")
		DSHT Q 3 Bright
		DSHT R 2 Bright
		DSHT MN 5
		DSHT O 4
		DSHT NM 5
		DSHT L 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT L 7 A_ReFire
		goto ReadyActual

	FlashStrVanilla:
		TNT1 A 4 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		goto LightDone

	FireStrImproved:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrAttackImproved")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireStrAttackImproved")
		goto FireStrContinueImproved

	FireStrAttackImproved:
		TNT1 A 0 A_GunFlash("FlashStrImproved")
	FireStrContinueImproved:
		DSHT P 2 Bright A_GiveInventory("SamsaraDoomguyStrShotgunAttackHandler")
		DSHT QR 2 Bright
		DSHT MNONM 4
		DSHT L 2
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT L 5 A_ReFire
		goto ReadyActual

	FlashStrImproved:
		TNT1 A 3 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		goto LightDone

	// Powered
/*
	ReadyActualStrPowered:
		DSHT L 1 A_WeaponReady
		goto ReadyActual
*/

	DeselectActualStrPowered:
		TNT1 A 0 A_Lower
		goto DeselectActualStrContinue

	SelectStrPowered:
		TNT1 A 0 A_Raise
		goto SelectStrContinue

	FireStrPowered:
		DSHT L 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireStrPoweredAttack")
		goto FireStrPoweredContinue

	FireStrPoweredAttack:
		TNT1 A 0 A_GunFlash("FlashStrPowered")
	FireStrPoweredContinue:
		DSHT P 2 Bright A_GiveInventory("SamsaraDoomguyStrShotgunPoweredPrimaryAttackHandler")
		DSHT Q 3 Bright
		DSHT R 2 Bright
		DSHT MNONM 2
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT L 1 A_ReFire
		goto ReadyActual

/*
	AltFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		DSHT L 3 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireAttack")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"AltFireAttack")
		goto AltFireContinue

	AltFireAttack:
		TNT1 A 0 A_GunFlash
	AltFireContinue:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrShotgunPoweredSecondaryAttackHandler")
		DSHT PQR 3 Bright
		DSHT MNONM 3
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto Nothing
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"AltFireFinishReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"AltFireFinishReFire")
		//TNT1 A 0 A_CheckReload
	AltFireFinish:
		DSHT L 1
		goto ReadyActual

	AltFireFinishReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"AltFireFinish") // 2
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1) // 2
		//TNT1 A 0 A_CheckReload
		goto AltFireFinish
		TNT1 A 0 A_ReFire
		goto AltFireFinish

	AltFlash:
		TNT1 A 4 Bright A_Light1
		TNT1 A 5 Bright A_Light2
		goto LightDone
*/

	FlashStrPowered:
		TNT1 A 3 Bright A_Light1
		TNT1 A 3 Bright A_Light2
		goto LightDone

	// Complex Doom (Combat Shotgun)
    ReadyCom:
        CD04 B 1 A_PlayWeaponSound("complexdoom/weapons/12gsgcock")
        CD04 CDEF 1
        CD04 G 2
        CD04 H 3
        CD04 GF 2
        CD04 I 1
        Goto ReadyActual

    ReadyActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyActualComNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReadyActualComNonReloadableAmmo")
        Goto ReadyActualComNonReloadableNoAmmo

    ReadyActualComNonReloadableAmmo:
        CD04 T 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComNonReloadableNoAmmo:
        CD04 M 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActualComReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",1,"ReadyActualComReloadableAmmo")
        Goto ReadyActualComReloadableNoAmmo

    ReadyActualComReloadableAmmo:
        CD04 T 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    ReadyActualComReloadableNoAmmo:
        CD04 M 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
        CD04 T 1 A_Lower
        goto DeselectActual

    SelectCom:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

    FireCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireComStart")
		goto FireComEmpty

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",1,"FireComStart")
        goto FireComEmpty

    FireComEmpty:
        CD04 M 10 A_PlayWeaponSound("complexdoom/weapons/click")
        Goto Reload

    FireComStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyComCombatShotgunAttackHandler")
        CD04 N 2 Bright A_Light1
        CD04 O 2 Bright A_Light2
        CD04 P 1 A_Light0
        CD04 QRSUVWXYZ 1
        CD04 Z 1 A_PlaySound("complexdoom/weapons/12gsgcock")
        CD04 "[\" 2
        CD04 "]" 2 A_SpawnItemEx("ComplexDoom_ShellCasing",30,-2,25,Random(2,4),Random(3,6),Random(3,6),0)
        CD04 "\[ZY" 2
        CD04 XWVU 1
	FireComContinue:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComContinueReloadable")
	FireComContinueNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComContinueAmmo")
		TNT1 A 0 A_JumpIfInventory("Shell",1,"FireComContinueAmmo")
		goto FireComContinueNoAmmo

	FireComContinueReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComContinueAmmo")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",1,"FireComContinueAmmo")
        goto FireComContinueNoAmmo

    FireComContinueNoAmmo:
		CD04 M 2
		goto FireComFinish

    FireComContinueAmmo:
		CD04 T 2
		goto FireComFinish

	FireComFinish:
		TNT1 A 0 A_ReFire
        Goto ReadyActual

	FlashCom:
		TNT1 A 0
		stop

    Reload:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReadyActual
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",0,"ReadyActual")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadStart")
        Goto ReadyActual

    ReloadStart:
        CD04 UVW 1
        CD04 XYZ 2
    ReloadLoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",1,"ReloadLoopLoaded")
    ReloadLoopEmpty:
        CD05 ABC 1
        CD05 D 1 A_PlaySound("complexdoom/Weapons/ShellLoad")
        CD05 E 1
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoEmpty")
    ReloadLoopEmptyContinue:
        CD05 FGHI 1
        CD04 K 1
        CD04 L 2
        CD04 Z 2 A_PlayWeaponSound("complexdoom/weapons/12gsgcock")
        CD04 "[\]\" 2
        CD04 "[" 2 A_WeaponReady(WRF_NOBOB)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        Goto ReloadFinish
        CD04 LK 2
        goto ReloadLoop

    ReloadLoopLoaded:
        CD05 ABC 1
        CD05 D 1 A_PlaySound("complexdoom/Weapons/ShellLoad")
        CD05 E 1
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmoLoaded")
    ReloadLoopLoadedContinue:
        CD05 FGHI 1
        CD05 A 1 A_WeaponReady(WRF_NOBOB)
        goto ReloadLoop

    ReloadFinish:
        CD04 ZYXWVU 1
        CD04 T 3
        Goto ReadyActual

    ReloadAmmoEmpty:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
    ReloadAmmoEmptyCalc:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",0,"ReloadLoopEmptyContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadLoopEmptyContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadLoopEmptyContinue
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("ComplexDoom_ShotgunMagazine")
        loop

    ReloadAmmoLoaded:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
    ReloadAmmoLoadedCalc:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_ShotgunMagazine",0,"ReloadLoopLoadedContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadLoopLoadedContinue")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadLoopLoadedContinue
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("ComplexDoom_ShotgunMagazine")
        loop

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"NothingCom")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
	NothingCom:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguyShotgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupSound

      // Sound stuff
      PickupSound:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupSoundPSX")
        TNT1 A 0 A_PlaySound("doomguy/shotgf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPSX:
        TNT1 A 0 A_PlaySound("doom64guy/shotgf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/shotgf",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,5,"DoomBulletPuffPlayerThruGhost",FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,7,5,"DoomBulletPuffPlayerThruGhost",FBF_NOFLASH)
        stop

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,random(2,3)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,7,random(2,3)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,random(2,4)*5,"DoomBulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,7,random(2,4)*5,"DoomBulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        stop

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,random(2,4)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
        TNT1 A 0 A_FireBullets(5.6,3.5,7,random(2,4)*5,"DoomBulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        stop
    }
}

actor SamsaraDoomguy64ShotgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("doom64guy/shotgf",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackImproved")
      // Vanilla
      PickupAttackVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackVanillaCoop")
      PickupAttackVanillaDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,5,"Doom64BulletPuffPlayerThruGhost",FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,7,5,"Doom64BulletPuffPlayerThruGhost",FBF_NOFLASH)
        goto PickupFinish

      PickupAttackVanillaCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,5,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,7,5,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NOFLASH)
        goto PickupFinish

      // Improved
      PickupAttackImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackImprovedCoop")
      PickupAttackImprovedDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,7,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      PickupAttackImprovedCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraUsingVerticalSpread",1,2)
        TNT1 A 0 A_FireBullets(5.6,0,7,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish
        TNT1 A 0 A_FireBullets(5.6,3.5,7,random(2,4)*6,"Doom64BulletPuffPlayerThruGhost_Coop",FBF_NORANDOM|FBF_NOFLASH)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 ACS_NamedExecuteAlways("SamsaraRecoil", 0, 2, 0, 20)
        stop
    }
}

