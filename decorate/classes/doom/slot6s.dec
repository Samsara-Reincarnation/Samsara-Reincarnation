// Bullet puff (railgun)

actor SamsaraDoomguyStrRailgunPuff : SamsaraDoomguyStrBulletPuff { +PIERCEARMOR }

actor SamsaraDoomguyStrRailgunPuffCoop : SamsaraDoomguyStrRailgunPuff
{
	//+ALLOWTHRUFLAGS // doesn't exist in zandronum yet
	+MTHRUSPECIES
}

actor SamsaraDoomguyComRailgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",10,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",10)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,1)
        stop
        TNT1 A 0 A_TakeInventory("ComplexDoom_CellCharge",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_RailAttack(250,0,false,"00 85 FF",None,0,0,"ComplexDoom_RailPuff")
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_RailAttack(250,0,false,"00 85 FF",None,0,0,"ComplexDoom_RailPuffCoop")
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
		TNT1 A 0 A_FireCustomMissile("ComplexDoom_RailgunImpact",0,0)
        TNT1 A 0 A_Quake(12,4,0,64,"nosoundforyoubitch")
        stop
    }
}

actor ComplexDoom_CellCharge : Ammo
{
	Inventory.MaxAmount 5
	Tag "Railgun Magazine"
	+IGNORESKILL
	+UNTOSSABLE
}

actor ComplexDoom_RailPuff : ComplexDoom_BulletPuff
{
	+PIERCEARMOR
	Decal ""
	States
	{
	Spawn:
		TNT1 A 0
		TNT1 A 1 A_SpawnItem("ComplexDoom_RailgunImpactEffect")
		Stop
	}
}

actor ComplexDoom_RailPuffCoop : ComplexDoom_RailPuff
{
	//+ALLOWTHRUFLAGS // doesn't exist in zandronum yet
	+MTHRUSPECIES
}

actor ComplexDoom_RailgunImpact : FastProjectile
{
	Speed 300
	Radius 1
	Height 1
	RenderStyle Add
	Alpha 0.85
	+RANDOMIZE
	+THRUACTORS
	States
	{
	Spawn:
		TNT1 A 1
		Loop
	Death:
		TNT1 A 0
		TNT1 A 1 A_SpawnItem("ComplexDoom_RailgunImpactEffect")
		Stop
	}
}

actor ComplexDoom_RailgunImpactEffect
{
	+CLIENTSIDEONLY
	+NOBLOCKMAP
	+NOGRAVITY
	States
	{
	Spawn:
		TNT1 AAA 0 A_SpawnItemEx("ComplexDoom_PlasmaParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
		TNT1 AAAAAA 1 A_SpawnItem("ComplexDoom_RailImpactFlare",0)
		Stop
	}
}

actor ComplexDoom_RailImpactFlare
{
	Radius 1
	Height 1
	Scale 0.6
	+NOCLIP
	+NOBLOCKMAP
	+NOGRAVITY
	+CLIENTSIDEONLY
	+NOINTERACTION
	+FORCEXYBILLBOARD
	RENDERSTYLE Add
	Alpha 0.3
	States
	{
	Spawn:
		CD29 W 1 Bright
		Stop
	}
}
