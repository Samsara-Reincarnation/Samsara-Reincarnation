actor DGHasRailGun : Boolean {}
actor SamsaraDoomguyStrRailgunScope : Boolean {}
actor SamsaraDoomguyComRailgunScope : Boolean {}
actor SamsaraDoomguyStrRailgunPoweredHeldCheck : Boolean {}

ACTOR " RailGun " : Weapon
{
	Radius 20
	Height 16
	Weapon.Selectionorder 100
	Weapon.AmmoType1 "DoomguyRailgunClip"
	Weapon.AmmoUse1 1
	Weapon.AmmoType2 "Cell"
	Weapon.AmmoGive2 40
	Inventory.Pickupmessage "You got the railgun!"
	Inventory.RestrictedTo "DoomguyPlayer"
	Decal "RailScorch"
	Obituary "$SAMSARA_DOOMGUY_OB_SLOT6S"
	Tag "Railgun"
	+AMMO_OPTIONAL
	+NOALERT
	+UNDROPPABLE
	States
	{
	Spawn:
		WRLG A -1
		stop

	// Original
	Ready:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyCom")
	ReadyActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"ReadyActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"ReadyActual64")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"ReadyZoomOut")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyZoomOut")
		goto ReadyContinue

	ReadyZoomOut:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto ReadyContinue

	ReadyContinue:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",0,"ReadyModernReloadable")
	ReadyNonReloadable:
		DRLG A 1 A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual

	ReadyModernReloadable:
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",0,"ReadyNonReloadable")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		goto ReadyNonReloadable
		DRLG A 1 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		goto ReadyActual

	Deselect:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectCom")
	DeselectActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"DeselectActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"DeselectActual64")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"DeselectZoomOut")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"DeselectZoomOut")
		goto DeselectContinue

	DeselectZoomOut:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto DeselectContinue

	DeselectContinue:
		DRLG A 1 A_Lower
		goto Deselect

	Select:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"SelectCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"SelectStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Select64")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"SelectZoomOut")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"SelectZoomOut")
		goto SelectContinue

	SelectZoomOut:
		TNT1 A 0 A_ZoomFactor(1,ZOOM_INSTANT) // map change
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto SelectContinue

	SelectContinue:
		DRLG A 1 A_Raise
		goto Select

	Fire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Fire64")
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
	FireNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireStart")
		goto Nothing

	FireReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,"FireStart")
	FireReloadableDryCheck:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"ReloadStart")
		goto Nothing

	FireStart:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
		DRLG E 12 A_GiveInventory("SamsaraDoomguyRailgunAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireFinishReloadable")
		goto FireFinish

	FireFinishReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireFinish")
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,"FireFinish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadAfterFire")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"ReloadAfterFire")
		goto FireFinish

	FireFinish:
		DRLG A 6
		goto FireReFireCheck

	FireReFireCheck:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReFireReloadable")
		goto FireReFireNonReloadable

	FireReFireNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireReFire")
		goto Nothing

	FireReFireReloadable:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireComReFireReloadable")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireReFire")
		goto Nothing

	FireReFire:
		TNT1 A 0 A_ReFire
		goto ReadyActual

	Flash:
		TNT1 A 5 Bright A_Light1
		TNT1 A 5 Bright A_Light2
		goto LightDone

	Reload:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReloadCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Reload64")
	ReloadStart:
		DRLG E 6
	ReloadAfterFire:
		DRLG F 6 A_GiveInventory("SamsaraDoomguyRailgunUnloadSoundPlayer")
		DRLG GHIJ 6
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
	ReloadFinish:
		DRLG K 6 A_GiveInventory("SamsaraDoomguyRailgunLoadSoundPlayer")
		DRLG L 6
		goto FireFinish

	ReloadAmmo:
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",0,"ReloadFinish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		goto ReloadFinish
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Cell",10)
		TNT1 A 0 A_GiveInventory("DoomguyRailgunClip")
		loop

	// Doom 64 (reloads slightly slower)
	ReadyActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"Ready64ZoomOut")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"Ready64ZoomOut")
		goto Ready64Continue

	Ready64ZoomOut:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto Ready64Continue

	Ready64Continue:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",0,"Ready64ModernReloadable")
	Ready64NonReloadable:
		64RA A 1 A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual

	Ready64ModernReloadable:
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",0,"Ready64NonReloadable")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		goto Ready64NonReloadable
		64RA A 1 A_WeaponReady(WRF_NOSECONDARY|WRF_ALLOWRELOAD)
		goto ReadyActual

	DeselectActual64:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"DeselectActual64ZoomOut")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"DeselectActual64ZoomOut")
		goto DeselectActual64Continue

	DeselectActual64ZoomOut:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto DeselectActual64Continue

	DeselectActual64Continue:
		64RA A 1 A_Lower
		goto Deselect

	Select64:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"Select64ZoomOut")
		goto Select64Continue

	Select64ZoomOut:
		TNT1 A 0 A_ZoomFactor(1,ZOOM_INSTANT) // map change
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto Select64Continue

	Select64Continue:
		64RA A 1 A_Raise
		goto Select

	Fire64:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire64Reloadable")
	Fire64NonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Fire64Start")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"Fire64Start")
		goto Nothing

	Fire64Reloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire64Start")
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,"Fire64Start")
	Fire64ReloadableDryCheck:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload64")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"Reload64")
		goto Nothing

	Fire64Start:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64StartSmooth")
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
		64RA B 12 Bright A_GiveInventory("SamsaraDoomguy64RailgunAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire64FinishReloadable")
		goto Fire64Finish
		
	Fire64StartSmooth:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
		64RA B 6 Bright A_GiveInventory("SamsaraDoomguy64RailgunAttackHandler")
		64RA IJ 3
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Fire64FinishReloadable")
		goto Fire64Finish

	Fire64FinishReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Fire64Finish")
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,"Fire64Finish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload64")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"Reload64")
		goto Fire64Finish

	Fire64Finish:
		64RA A 6
		goto FireReFireCheck

	Reload64:
		64RA CD 4
		64RA EF 6
		64RA G 18 A_PlaySound("doom64guy/railgu")
		64RA F 6
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Reload64Ammo")
	Reload64Finish:
		64RA E 6 A_PlaySound("doom64guy/railgl")
		64RA DC 4
		goto Fire64Finish

	Reload64Ammo:
		TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",0,"Reload64Finish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		goto Reload64Finish
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Cell",10)
		TNT1 A 0 A_GiveInventory("DoomguyRailgunClip")
		loop

	// Stronghold (its own version)
	ReadyActualStr:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyStrZoom")
		RAIG A 1 A_WeaponReady(WRF_ALLOWZOOM)
		goto ReadyActual

	ReadyStrZoom:
		RSCP A 1 Bright A_WeaponReady(WRF_NOBOB|WRF_ALLOWZOOM)
		goto ReadyActual

	// Unpowered
	DeselectActualStr:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"DeselectActualStrZoomOut")
		goto DeselectActualStrStart

	DeselectActualStrZoomOut:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRailgunZoomOutSoundPlayer")
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto DeselectActualStrStart

	DeselectActualStrStart:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"DeselectActualStrStartPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"DeselectActualStrStartPowered")
	DeselectActualStrContinue:
		TNT1 A 0 A_Lower
		RAIG A 1 A_Lower
		goto Deselect

	SelectStr:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"SelectStrZoomOut")
		goto SelectStrStart

	SelectStrZoomOut:
		// no need for a sound
		TNT1 A 0 A_ZoomFactor(1,ZOOM_INSTANT) // map change
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto SelectStrStart

	SelectStrStart:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"SelectStrStartPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"SelectStrStartPowered")
	SelectStrContinue:
		TNT1 A 0 A_Raise
		RAIG A 1 A_Raise
		goto Select

	AltFire:
	Zoom:
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ZoomCom")
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"Unzoom")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRailgunZoomInSoundPlayer")
		TNT1 A 0 A_ZoomFactor(3)
		RSCP A 8 Bright A_GiveInventory("SamsaraDoomguyStrRailgunScope")
		goto ReadyActual

	Unzoom:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRailgunZoomOutSoundPlayer")
		TNT1 A 0 A_ZoomFactor(1)
		RAIG A 8 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto ReadyActual

	FireStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrCharge")
		TNT1 A 0 A_JumpIfInventory("Cell",5,"FireStrCharge")
		goto Nothing

	FireStrCharge:
		TNT1 A 0 A_PlaySound("doomguy/stronghold/railch",CHAN_WEAPON)
	FireStrCharge0:
		RAIG B 12 Bright A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"FireStrCharge0Zoomed")
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge0Check")
		RAIG E 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RAIG F 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge0AttackHandler")
	FireStrChargeFinish:
		RAIG A 4
		RAIG K 15
		goto ReadyActual

	FireStrCharge0Zoomed:
		RSCP A 12 Bright
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge0Check")
		RSCP A 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RSCP A 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge0AttackHandler")
	FireStrChargeFinishZoomed:
		RSCP A 4 Bright
		RSCP A 15 Bright
		goto ReadyActual

	FireStrCharge0Check:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrCharge1")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireStrCharge1")
		goto FireStrCharge0

	FireStrCharge1:
		RAIG C 12 Bright A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"FireStrCharge1Zoomed")
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge1Check")
		RAIG G 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RAIG H 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge1AttackHandler")
		goto FireStrChargeFinish

	FireStrCharge1Zoomed:
		RSCP A 12 Bright
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge1Check")
		RSCP A 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RSCP A 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge1AttackHandler")
		goto FireStrChargeFinishZoomed

	FireStrCharge1Check:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrCharge2")
		TNT1 A 0 A_JumpIfInventory("Cell",15,"FireStrCharge2")
		goto FireStrCharge1

	FireStrCharge2:
		RAIG D 12 Bright A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"FireStrCharge2Zoomed")
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge2")
		RAIG I 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RAIG J 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge2AttackHandler")
		goto FireStrChargeFinish

	FireStrCharge2Zoomed:
		RSCP A 12 Bright
		TNT1 A 0 A_WeaponReady(WRF_NOBOB|WRF_NOSWITCH|WRF_NOFIRE)
		TNT1 A 0 A_ReFire("FireStrCharge2")
		RSCP A 4 Bright A_GunFlash("FlashStr")
		TNT1 A 0 A_AlertMonsters
		RSCP A 6 Bright A_GiveInventory("SamsaraDoomguyStrRailgunCharge2AttackHandler")
		goto FireStrChargeFinishZoomed

	FlashStr:
		TNT1 A 4 A_Light1
		TNT1 A 6 A_Light2
		goto LightDone

	// Powered
	DeselectActualStrStartPowered:
		TNT1 A 0 A_Lower
		goto DeselectActualStrContinue

	SelectStrStartPowered:
		TNT1 A 0 A_Raise
		goto SelectStrContinue

	FireStrPowered:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"FireStrPoweredZoomed")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredStart")
		TNT1 A 0 A_JumpIfInventory("Cell",2,"FireStrPoweredStart")
		goto Nothing

	FireStrPoweredStart:
		RAIG A 1
		TNT1 A 0 A_PlaySound("doomguy/stronghold/railch",CHAN_WEAPON)
		RAIG BCD 1 Bright
		RAIG I 1 Bright A_GunFlash("FlashStrPowered")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunPoweredHeldCheck")
	FireStrPoweredContinue:
		TNT1 A 0 A_AlertMonsters
		RAIG J 1 Bright A_GiveInventory("SamsaraDoomguyStrRailgunPoweredAttackHandler")
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPoweredFinishReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPoweredFinishReFire")
	FireStrPoweredFinish:
		RAIG K 10
		goto ReadyActual

	FireStrPoweredFinishReFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredFinishReFireStart")
		TNT1 A 0 A_JumpIfInventory("Cell",2,"FireStrPoweredFinishReFireStart")
		goto Nothing

	FireStrPoweredFinishReFireStart:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1)
		goto FireStrPoweredFinish
		TNT1 A 0 A_ReFire(1)
		goto FireStrPoweredFinish
		RAIG A 1
		RAIG BCD 1 Bright
		RAIG I 1 Bright A_GunFlash("FlashStrPowered")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRailgunPoweredHeldCheck")
		goto FireStrPoweredContinue

	FireStrPoweredZoomed:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredStartZoomed")
		TNT1 A 0 A_JumpIfInventory("Cell",4,"FireStrPoweredStartZoomed")
		goto Nothing

	FireStrPoweredStartZoomed:
		RSCP A 1 Bright
		RSCP A 14 Bright A_PlaySound("doomguy/stronghold/railch",CHAN_WEAPON)
		RSCP A 1 Bright A_GunFlash("FlashStrPowered")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunPoweredHeldCheck")
	FireStrPoweredContinueZoomed:
		TNT1 A 0 A_AlertMonsters
		RSCP A 1 Bright A_GiveInventory("SamsaraDoomguyStrRailgunPoweredAttackHandler")
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"FireStrPoweredFinishReFireZoomed")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireStrPoweredFinishReFireZoomed")
	FireStrPoweredFinishZoomed:
		RSCP A 10 Bright
		goto ReadyActual

	FireStrPoweredFinishReFireZoomed:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStrPoweredFinishReFireStartZoomed")
		TNT1 A 0 A_JumpIfInventory("Cell",4,"FireStrPoweredFinishReFireStartZoomed")
		goto Nothing

	FireStrPoweredFinishReFireStartZoomed:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1)
		goto FireStrPoweredFinishZoomed
		TNT1 A 0 A_ReFire(1)
		goto FireStrPoweredFinishZoomed
		RSCP A 1 Bright
		RSCP A 14 Bright
		RSCP A 1 Bright A_GunFlash("FlashStrPowered")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrRailgunPoweredHeldCheck")
		goto FireStrPoweredContinueZoomed

	FlashStrPowered:
		TNT1 A 1 A_Light1
		TNT1 A 1 A_Light2
		goto LightDone

	// Complex Doom
    ReadyCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyComReloadable")
    ReadyComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyComNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",10,"ReadyComNonReloadableAmmo")
        Goto ReadyComNonReloadableNoAmmo

	ReadyComNonReloadableAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railselect")
        CD21 "XYZ[\" 1
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyComZoomOut")
        Goto ReadyActual

	ReadyComNonReloadableNoAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railselect")
        CD20 IJKLM 1
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyComZoomOut")
        Goto ReadyActual

    ReadyComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyComReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"ReadyComReloadableAmmo")
        Goto ReadyComReloadableNoAmmo

	ReadyComReloadableAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railselect")
        CD21 "XYZ[\" 1
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyComZoomOut")
        Goto ReadyActual

	ReadyComReloadableNoAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railselect")
        CD20 IJKLM 1
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"ReadyComZoomOut")
        Goto ReadyActual

	ReadyComZoomOut:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
		goto ReadyActual

    ReadyActualCom:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"ReadyActualComNonReloadableZoomed")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyActualComNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",10,"ReadyActualComNonReloadableAmmo")
        Goto ReadyActualComNonReloadableNoAmmo

    ReadyActualComNonReloadableZoomed:
        CD22 E 1 A_WeaponReady(WRF_ALLOWZOOM)
        Goto ReadyActual

    ReadyActualComNonReloadableAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railgunhum")
        CD20 ZZZXXXYYYZZZXXXYYYZZZXXXYYYZZZXXXYYYZZ 1 A_WeaponReady(WRF_ALLOWZOOM)
        Goto ReadyActual

    ReadyActualComNonReloadableNoAmmo:
        CD20 "[" 1 A_WeaponReady(WRF_ALLOWZOOM)
        Goto ReadyActual

    ReadyActualComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"ReadyActualComReloadableZoomed")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"ReadyActualComReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"ReadyActualComReloadableAmmo")
        Goto ReadyActualComReloadableNoAmmo

    ReadyActualComReloadableZoomed:
        CD22 E 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
        Goto ReadyActual

    ReadyActualComReloadableAmmo:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/railgunhum")
        CD20 ZZZXXXYYYZZZXXXYYYZZZXXXYYYZZZXXXYYYZZ 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
        Goto ReadyActual

    ReadyActualComReloadableNoAmmo:
        CD20 "[" 1 A_WeaponReady(WRF_ALLOWZOOM|WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrRailgunScope")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"DeselectActualComReloadable")
    DeselectActualComNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectActualComNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",10,"DeselectActualComNonReloadableAmmo")
        Goto DeselectActualComNonReloadableNoAmmo

    DeselectActualComNonReloadableAmmo:
        CD20 X 1 A_Lower
        goto DeselectActual

    DeselectActualComNonReloadableNoAmmo:
        CD20 "[" 1 A_Lower
        goto DeselectActual

    DeselectActualComReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"DeselectActualComReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"DeselectActualComReloadableAmmo")
        Goto DeselectActualComReloadableNoAmmo

    DeselectActualComReloadableAmmo:
        CD20 X 1 A_Lower
        goto DeselectActual

    DeselectActualComReloadableNoAmmo:
        CD20 "[" 1 A_Lower
        goto DeselectActual

    SelectCom:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

	FireCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireComStart")
		goto FireComEmpty

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"FireComStart")
        goto FireComEmpty

    FireComEmpty:
        CD20 "[" 15 A_PlaySound("complexdoom/weapons/click2")
        Goto ReloadCom

	FireComStart:
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GunFlash("FlashCom",GFF_NOEXTCHANGE)
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"FireComStartZoomed")
		TNT1 A 0 A_Light1
		CD20 N 2 Bright A_GiveInventory("SamsaraDoomguyComRailgunAttackHandler")
		CD20 O 2 Bright A_Light2
		TNT1 A 0 A_Light0
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"FireComStartAmmo")
		CD20 BCDE 2
		CD20 FGH 1
		CD20 "[" 40
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComFinishReloadable")
		goto FireComFinish

	FireComStartZoomed:
		TNT1 A 0 A_Light2
		CD22 E 4 Bright A_GiveInventory("SamsaraDoomguyComRailgunAttackHandler")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,5)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope",1)
		TNT1 A 0 A_ZoomFactor(1)	
		CD20 "[" 50 A_Light0
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComFinishReloadable")
		goto FireComFinish
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"FireComStartUnZoom")
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"FireComStartUnZoom")
		CD22 E 10 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"FireComStartUnZoom2")
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"FireComStartUnZoom2")
		CD22 E 10 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"FireComStartUnZoom3")
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"FireComStartUnZoom3")
		CD22 E 10 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"FireComStartUnZoom4")
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"FireComStartUnZoom4")
		CD22 E 10 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"FireComStartUnZoom5")
		TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"FireComStartUnZoom5")
		CD22 E 10 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComFinishReloadable")
		goto FireComFinish

	FireComStartAmmo:
		CD20 PQRS 2
		CD20 TUV 1
		CD20 W 40
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComFinishReloadable")
		goto FireComFinish

	FireComFinishReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComFinish")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"FireComFinish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadCom")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"ReloadCom")
		goto FireComFinish

	FireComFinish:
		TNT1 A 0
		goto FireReFireCheck

	ReloadCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
		goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",0,"ReadyActual")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadComStart")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"ReloadComStart")
		Goto ReadyActual

	ReloadComStart:
		TNT1 A 0 A_ZoomFactor(1)
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 "[\]" 1
		CD21 ABCD 1
		CD21 E 4 A_PlayWeaponSound("complexdoom/weapons/cellreload")
		CD21 FGHI 2
		CD21 J 1
		CD21 K 1 A_SpawnItemEx("ComplexDoom_CellCasing",-3,0,-3,Random(2,6),0,0,Random(-80,-90),128)
		CD21 LMNO 1
		CD21 PQ 2
		CD21 R 20
		CD21 STU 1
		CD21 VW 2
		CD21 "]" 2
		goto ReloadComAmmo

	ReloadComFinish:
		CD22 A 4
		CD22 B 3
		CD22 CD 2
		CD20 "[" 30
		CD20 W 10 A_PlayWeaponSound("complexdoom/weapons/plasmacellin")
		Goto ReadyActual

	ReloadComAmmo:
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",0,"ReloadComFinish")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",10,1)
		goto ReloadComFinish
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_TakeInventory("Cell",10)
		TNT1 A 0 A_GiveInventory("ComplexDoom_CellCharge")
		loop

	FlashCom:
		TNT1 A 0
		stop

	ZoomCom:
		TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyComRailgunScope",1,"UnzoomCom")
		TNT1 A 0 A_ZoomFactor(5)
		CD20 X 3 Bright A_GiveInventory("SamsaraDoomguyComRailgunScope")
		CD20 YZ 3
		goto ReadyActual

	UnzoomCom:
		TNT1 A 0 A_ZoomFactor(1)
		CD20 X 3 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 YZ 3
		goto ReadyActual

	FireComStartUnZoom:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 W 50 A_ZoomFactor(1)
		Goto ReadyActual
	FireComStartUnZoom2:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 W 40 A_ZoomFactor(1)
		Goto ReadyActual
	FireComStartUnZoom3:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 W 30 A_ZoomFactor(1)
		Goto ReadyActual
	FireComStartUnZoom4:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 W 20 A_ZoomFactor(1)
		Goto ReadyActual
	FireComStartUnZoom5:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyComRailgunScope")
		CD20 W 10 A_ZoomFactor(1)
		Goto ReadyActual

	FireComReFireReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_CellCharge",1,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireReFire")
		TNT1 A 0 A_JumpIfInventory("Cell",10,"FireReFire")
		goto Nothing

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguyRailgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("Cell",10,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",10)
        goto PickupSound

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupSound")
        TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("DoomguyRailgunClip",1)
        goto PickupSound

      // Sound stuff
      PickupSound:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupSoundPSX")
        TNT1 A 0 A_PlaySound("doomguy/railgf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPSX:
        TNT1 A 0 A_PlaySound("doom64guy/railgf",CHAN_WEAPON)
        goto PickupAttack

      PickupSoundPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/railgf",CHAN_WEAPON)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_RailAttack(75,0,false,"","",RGF_SILENT|RGF_FULLBRIGHT,0,"DoomRailPuff")
        stop

      PickupAttackCoop:
        TNT1 A 0 A_RailAttack(200,0,false,"","",RGF_SILENT|RGF_FULLBRIGHT,0,"DoomRailPuff_Coop")
        stop
    }
}

actor SamsaraDoomguyRailgunUnloadSoundPlayer : Trigger
{
    States
    {
      // Sound playing stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupPSX")
      PickupOriginal:
        TNT1 A 0 A_PlaySound("doomguy/railgu")
        stop

      PickupPSX:
        TNT1 A 0 A_PlaySound("doom64guy/railgu")
        stop

      PickupPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/railgu")
        stop
    }
}

actor SamsaraDoomguyRailgunLoadSoundPlayer : Trigger
{
    States
    {
      // Sound playing stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupPSX")
      PickupOriginal:
        TNT1 A 0 A_PlaySound("doomguy/railgl")
        stop

      PickupPSX:
        TNT1 A 0 A_PlaySound("doom64guy/railgl")
        stop

      PickupPerkristan:
        TNT1 A 0 A_PlaySound("doomguy/perkristan/railgl")
        stop
    }
}

actor SamsaraDoomguy64RailgunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",10,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",10)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("DoomguyRailgunClip",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("doom64guy/railgf",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_RailAttack(75,0,false,"","",RGF_SILENT|RGF_FULLBRIGHT,0,"Doom64RailPuff")
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_RailAttack(200,0,false,"","",RGF_SILENT|RGF_FULLBRIGHT,0,"Doom64RailPuff_Coop")
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(2)
        TNT1 A 0 ACS_NamedExecuteAlways("SamsaraRecoil", 0, 2, 0, 20)
        stop
    }
}

actor SamsaraDoomguyRailgunSpawnReloader : Trigger // used for (re)spawn
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        stop
        TNT1 A 0 A_JumpIfInventory("DoomguyRailgunClip",0,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",10,1)
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Cell",10)
        TNT1 A 0 A_GiveInventory("DoomguyRailgunClip")
        loop
    }
}

actor DoomguyRailgunClip : Ammo
{
	Inventory.MaxAmount 4
	Tag "Railgun Magazine"
	+IGNORESKILL
	+UNTOSSABLE
}

actor DoomRailPuff : DoomBulletPuffPlayer
{
	Decal ""
	+PIERCEARMOR
}

actor DoomRailPuff_Coop : DoomRailPuff
{
	//+ALLOWTHRUFLAGS // doesn't exist in zandronum yet
	+MTHRUSPECIES
}

actor Doom64RailPuff : Doom64BulletPuffPlayer
{
	Decal ""
	+PIERCEARMOR
}

actor Doom64RailPuff_Coop : Doom64RailPuff
{
	//+ALLOWTHRUFLAGS // doesn't exist in zandronum yet
	+MTHRUSPECIES
}

// Unpowered attack handlers

actor SamsaraDoomguyStrRailgunCharge0AttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",5,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",5)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("doomguy/stronghold/railf1",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomguyStrRailgunScope",1,"PickupAttackZoomed")
      // Unzoomed
      PickupAttackUnzoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackUnzoomedImproved")
      // Vanilla
      PickupAttackUnzoomedVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackUnzoomedVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackUnzoomedVanillaCoop")
      PickupAttackUnzoomedVanillaDM:
        TNT1 A 0 A_RailAttack(75,0,false,"FF 00 00","FF FF FF",RGF_SILENT|RGF_FULLBRIGHT,0,"SamsaraDoomguyStrRailgunPuff")
        stop

      PickupAttackUnzoomedVanillaCoop:
        TNT1 A 0 A_RailAttack(100,0,false,"FF 00 00","FF FF FF",RGF_SILENT|RGF_FULLBRIGHT,0,"SamsaraDoomguyStrRailgunPuffCoop")
        stop

      // Improved
      PickupAttackUnzoomedImproved:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackUnzoomedImprovedCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackUnzoomedImprovedCoop")
      PickupAttackUnzoomedImprovedDM:
        TNT1 A 0 A_RailAttack(75,0,false,"FF 00 00","FF FF FF",RGF_SILENT|RGF_FULLBRIGHT,0,"SamsaraDoomguyStrRailgunPuff")
        stop

      PickupAttackUnzoomedImprovedCoop:
        TNT1 A 0 A_RailAttack(100,0,false,"FF 00 00","FF FF FF",RGF_SILENT|RGF_FULLBRIGHT,0,"SamsaraDoomguyStrRailgunPuffCoop")
        stop

      // Zoomed
      PickupAttackZoomed:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackZoomedImproved")
      // Vanilla
      PickupAttackZoomedVanilla:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackZoomedVanillaCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackZoomedVanillaCoop")
      PickupAttackZoomedVanillaDM:
