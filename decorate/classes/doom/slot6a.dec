		//TNT1 A 0 A_CheckReload
	AltFireFinish:
		DPLS L 20 Bright
		goto ReadyActual

	AltFireFinishReFire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"AltFireFinish") // 2
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,1) // 2
		//TNT1 A 0 A_CheckReload
		goto AltFireFinish
		TNT1 A 0 A_ReFire
		goto AltFireFinish
*/

	// Complex Doom
    ReadyCom:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrPlasmaRifleReadySoundCheck")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
        CD19 E 1 A_PlayWeaponSound("complexdoom/weapons/pickuphr")
        CD19 FGHIJK 1
        Goto ReadyActual

    ReadyActualCom:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyActualComReloadable")
    ReadyActualComNonReloadable:
        CD18 B 1 A_WeaponReady
        Goto ReadyActual

    ReadyActualComReloadable:
        CD18 B 1 A_WeaponReady(WRF_ALLOWRELOAD)
        Goto ReadyActual

    DeselectCom:
        TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/weapondown")
        goto DeselectActual

    DeselectActualCom:
        CD18 B 1 A_Lower
        goto DeselectActual

    SelectCom:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        goto Select

    FireCom:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireComReloadable")
	FireComNonReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("Cell",1,"FireComStart")
		goto FireComEmpty

	FireComReloadable:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComStart")
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_PlasmaCell",1,"FireComStart")
        goto FireComEmpty

    FireComEmpty:
        CD18 B 10 A_PlayWeaponSound("complexdoom/weapons/click3")
        Goto Reload

    FireComStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash("FlashCom")
        CD18 O 2 A_GiveInventory("SamsaraDoomguyComPlasmaRifleAttackHandler")
        CD18 B 1 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,3)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireComReFire")
	    TNT1 A 0 A_JumpIfInventory("Cell",1,"FireComReFire")
        goto FireComFinish
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireComReFire")
	    TNT1 A 0 A_JumpIfInventory("ComplexDoom_PlasmaCell",1,"FireComReFire")
        goto FireComFinish

    FireComReFire:
        TNT1 A 0 A_ReFire
	FireComFinish:
		CD18 EFG 1
		CD18 H 10
		CD18 GFEDCB 1
		Goto ReadyActual

	Reload:
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
		goto ReadyActual
		TNT1 A 0 A_JumpIfInventory("ComplexDoom_PlasmaCell",0,"ReadyActual")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadStart")
		TNT1 A 0 A_JumpIfInventory("Cell",1,"ReloadStart")
		Goto ReadyActual

	ReloadStart:
		TNT1 A 0 A_PlayWeaponSound("complexdoom/weapons/plasmacellout")
		CD18 V 1 A_SpawnItemEx("ComplexDoom_CellCasing",2,0,-8,1,0,0,Random(-100,-110),128)
		CD18 WX 2
		CD18 Y 10
		CD18 "Z[\" 1
		TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
	ReloadFinish:
		CD18 "]" 2
		CD19 A 8 A_PlayWeaponSound("complexdoom/weapons/plasmacellin")
		CD19 BC 2
		CD19 D 1
		CD18 B 2
		Goto ReadyActual

	ReloadAmmo:
        TNT1 A 0 A_JumpIfInventory("ComplexDoom_PlasmaCell",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto ReloadFinish
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Cell",1)
        TNT1 A 0 A_GiveInventory("ComplexDoom_PlasmaCell")
        loop

	FlashCom:
		TNT1 A 2 Bright A_Light1
		CD18 N 2 Bright A_Light2
		Goto LightDone

	Nothing:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"NothingCom")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"NothingStr")
        TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Nothing64")
        TNT1 A 0 A_JumpIfInventory("SamsaraDoomOriginalLoadoutFallbackRanged",1,2)
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
        TNT1 A 0 A_SelectWeapon(" Rifle ")
        goto Deselect

	Nothing64:
	NothingStr:
	NothingCom:
        TNT1 A 0 A_SelectWeapon(" Pistol ")
        goto Deselect
	}
}

actor SamsaraDoomguyPlasmaRifleAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackDMSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackDMSoundPSX")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBall",0,false)
        stop

      PickupAttackDMSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBallSoundPSX",0,false)
        stop

      PickupAttackDMSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBallSoundPerkristan",0,false)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",2,"PickupAttackCoopSoundPerkristan")
        TNT1 A 0 A_JumpIfInventory("SamsaraAlternateSoundToken",1,"PickupAttackCoopSoundPSX")
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBall2",0,false)
        stop

      PickupAttackCoopSoundPSX:
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBall2SoundPSX",0,false)
        stop

      PickupAttackCoopSoundPerkristan:
        TNT1 A 0 A_FireCustomMissile("DoomPlasmaBall2SoundPerkristan",0,false)
        stop
    }
}

