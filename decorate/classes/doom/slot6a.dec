		DPLS J 1 Bright A_WeaponReady
		goto ReadyActualStr7

	ReadyActualStr7Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS K 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr8
		DPLS K 1 Bright A_WeaponReady
		goto ReadyActualStr8

	ReadyActualStr8Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS K 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr9
		DPLS K 1 Bright A_WeaponReady
		goto ReadyActualStr9

	ReadyActualStr9Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS K 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActual
		DPLS K 1 Bright A_WeaponReady
		goto ReadyActual
*/

	DeselectActualStrPowered:
		TNT1 A 0 A_Lower
		goto DeselectActualStrContinue

	SelectStrPowered:
		TNT1 A 0 A_Raise
		goto SelectStrContinue

/*
	AltFire:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
        TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
	AltFireStart:
		TNT1 A 0 A_GunFlash("FlashStr",GFF_NOEXTCHANGE)
		DPLS N 1 Bright A_GiveInventory("SamsaraDoomguyStrPlasmaRiflePoweredSecondaryAttackHandler")
		DPLS O 1 Bright A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
		DPLS P 1 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"AltFireFinishReFire")
