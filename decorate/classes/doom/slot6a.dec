// Tokens

actor DGHasPlasmaRifle : Boolean {}
actor SamsaraDoomOriginalLoadoutSlot6 : Counter {}

// Plasma Rifle

actor SamsaraDoom64PlasmaRifleSoundActive : Boolean {}
actor SamsaraDoomguyStrPlasmaRifleReadySoundCheck : Boolean {}

actor "Plasma Rifle" : PlasmaRifle
{
	Weapon.SlotNumber 6
	Weapon.AmmoGive 0
	+INVENTORY.UNDROPPABLE
	+AMMO_OPTIONAL
	+NOALERT
	//+ALT_USES_BOTH
	Tag "Plasma Rifle"
	Inventory.RestrictedTo "DoomguyPlayer"
	States
	{
	Spawn:
		WPLS A -1
		stop

	// Original
	Ready:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyCom")
	ReadyActual:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"ReadyActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"ReadyActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"ReadyActual64")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
	ReadyActualContinue:
		DPLS A 1 A_WeaponReady
		goto ReadyActual

	Deselect:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectCom")
	DeselectActual:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"DeselectActualCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"DeselectActualStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"DeselectActual64")
		DPLS A 1 A_Lower
		goto Deselect

	Select:
		TNT1 A 0 A_TakeInventory("SamsaraDoomguyStrPlasmaRifleReadySoundCheck")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"SelectCom")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"SelectStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Select64")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
	SelectContinue:
		DPLS A 1 A_Raise
		goto Select

	Fire:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,"FireCom")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,"FireStr")
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",1,"Fire64")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
	FireStart:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"FireSmooth")
		TNT1 A 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
		TNT1 A 3 Bright A_GiveInventory("SamsaraDoomguyPlasmaRifleAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		DPLS B 20 A_ReFire
		goto ReadyActual

	Flash:
		TNT1 A 0 A_Jump(256,1,2)
		DPLF A 3 Bright A_Light1
		goto LightDone
		DPLF B 3 Bright A_Light1
		goto LightDone

	FireSmooth:
		TNT1 A 0 A_GunFlash("FlashSmooth",GFF_NOEXTCHANGE)
		KPLS A 3 Bright A_GiveInventory("SamsaraDoomguyPlasmaRifleAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		KPLS A 1 A_ReFire
		KPLS B 2 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"FireSmoothRage")
		KPLS CD 1
		KPLS E 8
		KPLS DCB 2
		KPLS A 1
		goto ReadyActual

	FireSmoothRage:
		KPLS BCD 1
		KPLS E 4
		KPLS DCB 1
		KPLS A 1
		goto ReadyActual

	FlashSmooth:
		TNT1 A 0 A_Light1
		SPLF A 1 Bright A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"FlashSmoothRage")
		SPLF BCD 1 Bright
		goto LightDone

	FlashSmoothRage:
		SPLF AD 1 Bright
		goto LightDone

	// Doom 64 (fires slower, but is more damaging)
	ReadyActual64:
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStarter")
		64PR BCD 2 A_WeaponReady
		goto ReadyActual

	DeselectActual64:
		64PR A 1 A_Lower
		goto DeselectActual

	Select64:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStarter")
		64PR A 1 A_Raise
		goto Select

	Fire64:
        TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStarter")
		TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"Fire64ImprovedBalance")
	Fire64VanillaBalance:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64VanillaBalanceSmooth")
	Fire64VanillaBalanceVanilla:
		TNT1 A 0 A_GunFlash("Flash64",GFF_NOEXTCHANGE)
		64PR A 5 A_GiveInventory("SamsaraDoomguy64PlasmaRifleAttackHandler")
	Fire64Finish:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		TNT1 A 0 A_ReFire
		goto ReadyActual

	Fire64ImprovedBalance:
		TNT1 A 0 A_JumpIfInventory("SamsaraUsingSmoothAnims",1,"Fire64ImprovedBalanceSmooth")
	Fire64ImprovedBalanceVanilla:
		TNT1 A 0 A_GunFlash("Flash64Improved",GFF_NOEXTCHANGE)
		64PR A 4 A_GiveInventory("SamsaraDoomguy64PlasmaRifleAttackHandler")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		64PR A 20 A_ReFire
		goto ReadyActual

	Flash64:
		64RF A 4 Bright A_Light1
		goto LightDone

	Flash64Improved:
		TNT1 A 0 A_Light1
		64RF A 3 Bright A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"Flash64ImprovedRage")
		goto LightDone

	Flash64ImprovedRage:
		64RF A 2 Bright
		goto LightDone

	Fire64VanillaBalanceSmooth:
		TNT1 A 0 A_GunFlash("Flash64Smooth",GFF_NOEXTCHANGE)
		64PR I 2 Bright A_GiveInventory("SamsaraDoomguy64PlasmaRifleAttackHandler")
		64PR J 2 Bright
		64PR K 1 Bright
		goto Fire64Finish

	Fire64ImprovedBalanceSmooth:
		64PR A 0 A_GunFlash("Flash64ImprovedSmooth",GFF_NOEXTCHANGE)
		64PR I 2  Bright A_GiveInventory("SamsaraDoomguy64PlasmaRifleAttackHandler")
		64PR J 1 Bright
		64PR K 1 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		64PR E 3 A_ReFire
		64PR FGHGF 3
		goto ReadyActual

	Flash64Smooth:
		TNT1 A 4 Bright A_Light1
		goto LightDone

	Flash64ImprovedSmooth:
		TNT1 A 0 A_Light1
		TNT1 A 3 Bright A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"Flash64ImprovedSmoothRage")
		goto LightDone

	Flash64ImprovedSmoothRage:
		TNT1 A 2 Bright
		goto LightDone

	// Stronghold
	// Unpowered
	ReadyActualStr: // This is messy, but it must be done.
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStarter")
	ReadyActualStr1:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr1Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr1Powered")
		DPLS I 1 Bright A_WeaponReady
	ReadyActualStr2:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"ReadyActualStr3")
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr2Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr2Powered")
		DPLS I 1 Bright A_WeaponReady
	ReadyActualStr3:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr3Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr3Powered")
		DPLS I 1 Bright A_WeaponReady
	ReadyActualStr4:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr4Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr4Powered")
		DPLS J 1 Bright A_WeaponReady
	ReadyActualStr5:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"ReadyActualStr6")
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr5Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr5Powered")
		DPLS J 1 Bright A_WeaponReady
	ReadyActualStr6:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr6Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr6Powered")
		DPLS J 1 Bright A_WeaponReady
	ReadyActualStr7:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr7Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr7Powered")
		DPLS K 1 Bright A_WeaponReady
	ReadyActualStr8:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,"ReadyActualStr9")
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr8Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr8Powered")
		DPLS K 1 Bright A_WeaponReady
	ReadyActualStr9:
		//TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"ReadyActualStr9Powered")
		//TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"ReadyActualStr9Powered")
		DPLS K 1 Bright A_WeaponReady
		goto ReadyActual

	DeselectActualStr:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"DeselectActualStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"DeselectActualStrPowered")
	DeselectActualStrContinue:
		TNT1 A 0 A_Lower
		DPLS M 1 A_Lower
		goto DeselectActual

	SelectStr:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraDoomguyStrWeaponPower",1,"SelectStrPowered")
		TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"SelectStrPowered")
	SelectStrContinue:
		TNT1 A 0 A_Raise
		DPLS M 1 A_Raise
		goto Select

	FireStr:
		TNT1 A 0 A_GiveInventory("SamsaraDoomguy64PlasmaRifleReadySoundStopper")
		TNT1 A 0 A_GiveInventory("SamsaraDoomguyStrPlasmaRifleReadySoundStopper")
	FireStrStart:
		TNT1 A 0 A_GunFlash("FlashStr",GFF_NOEXTCHANGE)
		DPLS N 1 Bright A_GiveInventory("SamsaraDoomguyStrPlasmaRifleAttackHandler")
		DPLS O 1 Bright A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
		DPLS P 1 Bright
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
		TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Nothing
		DPLS L 20 Bright A_ReFire
		goto ReadyActual

	FlashStr:
		TNT1 A 1 A_Light1
		TNT1 A 1 A_Light2
		TNT1 A 1 A_Light1
		goto LightDone

	// Powered
/*
	ReadyActualStr1Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS I 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr2
		DPLS I 1 Bright A_WeaponReady
		goto ReadyActualStr2

	ReadyActualStr2Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS I 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr3
		DPLS I 1 Bright A_WeaponReady
		goto ReadyActualStr3

	ReadyActualStr3Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS I 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr4
		DPLS I 1 Bright A_WeaponReady
		goto ReadyActualStr4

	ReadyActualStr4Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS J 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr5
		DPLS J 1 Bright A_WeaponReady
		goto ReadyActualStr5

	ReadyActualStr5Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS J 1 Bright A_WeaponReady(WRF_NOSECONDARY)
		goto ReadyActualStr6
		DPLS J 1 Bright A_WeaponReady
		goto ReadyActualStr6

	ReadyActualStr6Powered:
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",3,2)
		TNT1 A 0 A_JumpIfInventory("DoomClassMode",2,2)
		DPLS J 1 Bright A_WeaponReady(WRF_NOSECONDARY)
