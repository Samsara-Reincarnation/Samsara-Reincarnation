actor SamsaraOutlawsGatlingGunClickSpamPrevention : Counter {}

actor Outlaws_GatlingGun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Ash Inc. Semi-Portable Gatling Gun"
    Weapon.SlotNumber 7
    Weapon.SelectionOrder 100
    Weapon.AmmoType "Cell"
    Weapon.AmmoUse 2
    Tag "Ash Inc. Semi-Portable Gatling Gun"
    -ALT_AMMO_OPTIONAL
    +ALT_USES_BOTH // only one ammo type with same ammo amount use, so this makes alt fire behave as intended
    -AMMO_OPTIONAL
    +BFG
    States
    {
      Spawn:
        OL93 H -1
        stop

      Ready:
        OL07 A 1 A_WeaponReady
        loop

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsGatlingGunClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL07 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsGatlingGunClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL07 A 1 A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsGatlingGunAttackHandler")
        OL07 BC 2 Bright
        goto Ready

      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsGatlingGunAltAttackHandler")
        OL07 BC 2 Bright
        OL07 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsGatlingGunClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/GatlingGun/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsGatlingGunClickSpamPrevention",4)
        goto Ready
    }
}

actor SamsaraOutlawsGatlingGunAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/GatlingGun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_RailAttack(100,0,false,None,None,RGF_SILENT|32,0,"OutlawsPuff",5,5)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_RailAttack(100,0,false,None,None,RGF_SILENT|32,0,"OutlawsPuffCoop",5,5)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(1)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 20)
        stop
    }
}

actor SamsaraOutlawsGatlingGunAltAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/GatlingGun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_RailAttack(100,0,false,None,None,RGF_SILENT|32,0,"OutlawsGatlingPuff",1,1)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_RailAttack(100,0,false,None,None,RGF_SILENT|32,0,"OutlawsGatlingPuffCoop",1,1)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(1)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 20)
        stop
    }
}

actor OutlawsGatlingPuff : OutlawsPuff {}

actor OutlawsGatlingPuffCoop : OutlawsGatlingPuff
{
    //+ALLOWTHRUFLAGS // doesn't exist in zandronum yet
    +MTHRUSPECIES
}
