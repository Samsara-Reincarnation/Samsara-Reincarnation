actor SamsaraOutlawsOrganGunAltAttackHandler : Trigger
{
    States
    {
     // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",0,"PickupAttackDM2")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",6,"PickupAttackDM3")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",5,"PickupAttackDM4")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",4,"PickupAttackDM5")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",3,"PickupAttackDM6")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",2,"PickupAttackDM7")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",1,"PickupAttackDM8")
        goto PickupAttackDM1

      PickupAttackDM1:
        TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM2:
        TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM3:
        TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM4:
        TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM5:
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM6:
        TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM7:
        TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackDM8:
        TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,0,"Outlaws_OrganGunPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",0,"PickupAttackCoop2")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",6,"PickupAttackCoop3")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",5,"PickupAttackCoop4")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",4,"PickupAttackCoop5")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",3,"PickupAttackCoop6")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",2,"PickupAttackCoop7")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",1,"PickupAttackCoop8")
        goto PickupAttackCoop1

      PickupAttackCoop1:
        TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop2:
        TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop3:
        TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop4:
        TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop5:
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop6:
        TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop7:
        TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop8:
        TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,0,"Outlaws_OrganGunPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        stop
    }
}

actor Outlaws_OrganGunMagazine : Ammo
{
    Inventory.Amount 8
    Inventory.MaxAmount 8
    Tag "Vanderbilt Magazine"
    +IGNORESKILL
}

actor Outlaws_OrganGunPuff : OutlawsPuff { Args 30 }

actor Outlaws_OrganGunPuffCoop : Outlaws_OrganGunPuff { +MTHRUSPECIES }
