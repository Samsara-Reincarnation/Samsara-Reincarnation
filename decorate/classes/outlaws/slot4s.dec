actor SamsaraOutlawsOrganGunClickSpamPrevention : Counter {}
actor SamsaraOutlawsOrganGunPrimarySuccess : Boolean {}
actor SamsaraOutlawsOrganGunPrimaryFired : Counter { Inventory.MaxAmount 8 }
actor SamsaraOutlawsOrganGunSecondaryCounter : Counter { Inventory.MaxAmount 7 }

actor Outlaws_OrganGun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Vanderbilt Organ Gun"
    Weapon.SlotNumber 4
    Weapon.SlotPriority 1
    Weapon.SelectionOrder 200
    Weapon.AmmoType1 "Outlaws_OrganGunMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Clip"
    Weapon.AmmoGive2 32
    Tag "Vanderbilt Organ Gun"
    States
    {
      Spawn:
        OL93 D -1
        stop

      // if reloadmode 1, don't do auto-reload since the altfire can be used whenever
      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyAllowReload")
      ReadyDisallowReload:
        OL12 A 1 A_WeaponReady
        goto Ready

      ReadyAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReadyDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto ReadyDisallowReload
        OL12 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL12 A 1 A_Lower
        goto DeselectLoop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL12 A 1 A_Raise
        goto SelectLoop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",8,1)
        goto FireDry
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto FireWaterCheck
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimaryFired",1,"Reload")
        goto FireWaterCheck

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",8,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler1")
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        OL12 BC 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        OL12 A 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler2")
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        OL12 DE 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        OL12 F 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler3")
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        OL12 FG 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler4")
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        OL12 HI 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Semi auto fires faster!
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
      AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"AltFireWaterCheck")
        goto AltFireDry

      AltFireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,"AltFireWaterCheck")
      AltFireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"Reload")
        goto FireDry

      AltFireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"AltFireDry")
        goto AltFireStart

      AltFireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunClickSpamPrevention",4)
        goto Ready

      AltFireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",0,"AltFireStart2")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",6,"AltFireStart3")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",5,"AltFireStart4")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",4,"AltFireStart5")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",3,"AltFireStart6")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",2,"AltFireStart7")
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunSecondaryCounter",1,"AltFireStart8")
        goto AltFireStart1

      AltFireStart1:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 AJ 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart2:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 KL 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart3:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 MN 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart4:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 OP 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart5:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 QR 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart6:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 ST 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart7:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 UV 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireStart8:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 1)
        OL12 WX 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto AltFireFinish

      AltFireFinish:
        //Semi auto fires faster!
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      Reload:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
      ReloadFinishNonReloadable:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimaryFired",1,1)
        goto ReloadFinishFullNonReloadable
        OL12 Y 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullNonReloadable:
        OL12 Z 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishReloadable:
        TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync", 0)
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReloadFinishFullReloadable")
        OL12 Y 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullReloadable:
        OL12 Z 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadFinishAllowCheckReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,"ReloadFinishAllowCheckNonReloadable")
        goto Ready

      ReloadFinishAllowCheckNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimaryFired",1,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowNonReloadable")
        TNT1 A 0 A_JumpIfInventory("Clip",8,"ReloadFinishAllowNonReloadable")
        goto Ready

      ReloadFinishAllowNonReloadable:
        OL12 Y 1 A_WeaponReady(WRF_NOBOB)
        goto Ready

      ReloadFinishAllowCheckReloadable:
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowReloadable")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"ReloadFinishAllowReloadable")
        goto Ready

      ReloadFinishAllowReloadable:
        OL12 Y 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto ReloadFinishReloadable
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Clip",1)
        TNT1 A 0 A_GiveInventory("Outlaws_OrganGunMagazine")
        loop
    }
}

actor SamsaraOutlawsOrganGunAttackHandler1 : Trigger
{
    States
    {
      // Initializing stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        goto PickupAmmoCheckLeft

      // Ammo checking/taking stuff (left)
      PickupAmmoCheckLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckLeftReloadable")
      PickupAmmoCheckLeftNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackLeft

      PickupAmmoCheckLeftReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackLeft

      // Attack stuff (left)
      PickupAttackLeft:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackLeftCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackLeftCoop")
      PickupAttackLeftDM:
        TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      PickupAttackLeftCoop:
        TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      // Finishing stuff (left)
      PickupFinishLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRight")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupAmmoCheckRight

      // Ammo checking/taking stuff (right)
      PickupAmmoCheckRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRightReloadable")
      PickupAmmoCheckRightNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackRight

      PickupAmmoCheckRightReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackRight

      // Attack stuff (right)
      PickupAttackRight:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackRightCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackRightCoop")
      PickupAttackRightDM:
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      PickupAttackRightCoop:
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      // Finishing stuff (right)
      PickupFinishRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupRecoil")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupRecoil
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupRecoil

      // Recoil stuff
      PickupRecoil:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        goto PickupAnimation
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        goto PickupAnimation

      // Player animation stuff
      PickupAnimation:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        stop
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraForcePlayerAttackState")
        stop
    }
}

actor SamsaraOutlawsOrganGunAttackHandler2 : Trigger
{
    States
    {
      // Initializing stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        goto PickupAmmoCheckLeft

      // Ammo checking/taking stuff (left)
      PickupAmmoCheckLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckLeftReloadable")
      PickupAmmoCheckLeftNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackLeft

      PickupAmmoCheckLeftReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackLeft

      // Attack stuff (left)
      PickupAttackLeft:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackLeftCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackLeftCoop")
      PickupAttackLeftDM:
        TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      PickupAttackLeftCoop:
        TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      // Finishing stuff (left)
      PickupFinishLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRight")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupAmmoCheckRight

      // Ammo checking/taking stuff (right)
      PickupAmmoCheckRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRightReloadable")
      PickupAmmoCheckRightNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackRight

      PickupAmmoCheckRightReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackRight

      // Attack stuff (right)
      PickupAttackRight:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackRightCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackRightCoop")
      PickupAttackRightDM:
        TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      PickupAttackRightCoop:
        TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      // Finishing stuff (right)
      PickupFinishRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupRecoil")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupRecoil
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupRecoil

      // Recoil stuff
      PickupRecoil:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        goto PickupAnimation
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        goto PickupAnimation

      // Player animation stuff
      PickupAnimation:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        stop
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraForcePlayerAttackState")
        stop
    }
}

actor SamsaraOutlawsOrganGunAttackHandler3 : Trigger
{
    States
    {
      // Initializing stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        goto PickupAmmoCheckLeft

      // Ammo checking/taking stuff (left)
      PickupAmmoCheckLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckLeftReloadable")
      PickupAmmoCheckLeftNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackLeft

      PickupAmmoCheckLeftReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackLeft")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackLeft

      // Attack stuff (left)
      PickupAttackLeft:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackLeftCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackLeftCoop")
      PickupAttackLeftDM:
        TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      PickupAttackLeftCoop:
        TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishLeft

      // Finishing stuff (left)
      PickupFinishLeft:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRight")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupAmmoCheckRight
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupAmmoCheckRight

      // Ammo checking/taking stuff (right)
      PickupAmmoCheckRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupAmmoCheckRightReloadable")
      PickupAmmoCheckRightNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackRight

      PickupAmmoCheckRightReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackRight")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        goto PickupRecoil
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttackRight

      // Attack stuff (right)
      PickupAttackRight:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimarySuccess")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackRightCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackRightCoop")
      PickupAttackRightDM:
        TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,30,"OutlawsPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      PickupAttackRightCoop:
        TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,30,"OutlawsPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ)
        goto PickupFinishRight

      // Finishing stuff (right)
      PickupFinishRight:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupRecoil")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto PickupRecoil
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsOrganGunPrimaryFired",1)
        goto PickupRecoil

      // Recoil stuff
      PickupRecoil:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        goto PickupAnimation
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        goto PickupAnimation

      // Player animation stuff
      PickupAnimation:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsOrganGunPrimarySuccess",1,1)
        stop
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraForcePlayerAttackState")
        stop
    }
}

