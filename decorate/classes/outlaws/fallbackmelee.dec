actor Outlaws_Fist : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Fists"
    Inventory.PickupSound "Outlaws/ItemPickup"
    Weapon.SlotNumber 0
    Weapon.SelectionOrder 1000
    Tag "Fists"
    +MELEEWEAPON
    +WIMPY_WEAPON
    States
    {
      Spawn:
        OL93 J -1
        stop

      Ready:
        OL10 A 1 A_WeaponReady
        loop

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_Lower
        OL10 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_Raise
        OL10 A 1 A_Raise
        loop

      Fire:
        TNT1 A 4
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsFistAttackHandler")
        OL10 BC 4
        OL10 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      AltFire:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsFistAltAttackHandler")
        OL10 DA 4
        goto Ready
    }
}

actor SamsaraOutlawsFistAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/Fist/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupDMSpread")
        TNT1 A 0 A_CustomPunch(25,true,0,"OutlawsMeleePuff")
        stop

      PickupDMSpread:
        TNT1 A 0 A_CustomPunch(25*3,true,0,"OutlawsMeleePuff")
        stop

      PickupCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupCoopSpread")
        TNT1 A 0 A_CustomPunch(25,true,0,"OutlawsMeleePuffCoop")
        stop

      PickupCoopSpread:
        TNT1 A 0 A_CustomPunch(25*3,true,0,"OutlawsMeleePuffCoop")
        stop
    }
}

actor SamsaraOutlawsFistAltAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/Fist/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupDMSpread")
        TNT1 A 0 A_CustomPunch(12,true,0,"OutlawsMeleePuff")
        stop

      PickupDMSpread:
        TNT1 A 0 A_CustomPunch(12*3,true,0,"OutlawsMeleePuff")
        stop

      PickupCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupCoopSpread")
        TNT1 A 0 A_CustomPunch(12,true,0,"OutlawsMeleePuffCoop")
        stop

      PickupCoopSpread:
        TNT1 A 0 A_CustomPunch(12*3,true,0,"OutlawsMeleePuffCoop")
        stop
    }
}
