actor Outlaws_MachineGun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Axiom Light-Weight Machine Gun"
    Weapon.SlotNumber 6
    Weapon.SelectionOrder 200
    Weapon.AmmoType "Cell"
    Weapon.AmmoUse 1
    Tag "Axiom Light-Weight Machine Gun"
    -ALT_AMMO_OPTIONAL
    +ALT_USES_BOTH // only one ammo type with same ammo amount use, so this makes alt fire behave as intended
    -AMMO_OPTIONAL
    States
    {
      Spawn:
        OL93 G -1
        stop

      Ready:
        OL06 A 1 A_WeaponReady
        loop

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_Lower
        OL06 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_Raise
        OL06 A 1 A_Raise
        loop

      Fire:
      AltFire:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsMachineGunAttackHandler")
        OL06 BC 2 Bright
        goto Ready
    }
}

actor SamsaraOutlawsMachineGunAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/MachineGun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,-1,30,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,-1,30,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(0.25)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        stop
    }
}
