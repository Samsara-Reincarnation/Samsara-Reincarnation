actor SamsaraOutlawsCannonClickSpamPrevention : Counter {}

actor Outlaws_Cannon : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Hawksworth Repeating Cannon"
    Weapon.SlotNumber 5
    Weapon.SelectionOrder 300
    Weapon.AmmoType1 "Outlaws_CannonMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "RocketAmmo"
    Weapon.AmmoGive2 5
    Tag "Hawksworth Repeating Cannon"
    +EXPLOSIVE
    States
    {
      Spawn:
        OL93 F -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyAllowReload")
      ReadyDisallowReload:
        OL05 A 1 A_WeaponReady
        goto Ready

      ReadyAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_CannonMagazine",0,"ReadyDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto ReadyDisallowReload
        OL05 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsCannonClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL05 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsCannonClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL05 A 1 A_Raise
        loop

      Fire:
      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_CannonMagazine",1,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsCannonClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Cannon/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsCannonClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsCannonAttackHandler")
        OL05 BC 4 Bright
        OL05 A 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        OL05 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL05 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL05 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL05 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      Reload:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Cannon/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
      ReloadFinish:
        OL05 A 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Outlaws_CannonMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllow")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"ReloadFinishAllow")
        goto Ready

      ReloadFinishAllow:
        OL05 A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_CannonMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        goto ReloadFinish
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        TNT1 A 0 A_GiveInventory("Outlaws_CannonMagazine")
        loop
    }
}

actor SamsaraOutlawsCannonAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_CannonMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_CannonMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Cannon/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_CannonProjectile",0,false,0,0,0,6)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_CannonProjectileCoop",0,false,0,0,0,6)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(5)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 8, 20)
        stop
    }
}

actor Outlaws_CannonMagazine : Ammo
{
    Inventory.Amount 5
    Inventory.MaxAmount 5
    Tag "Hawksworth Magazine"
    +IGNORESKILL
}

actor Outlaws_CannonProjectile
{
    Projectile
    Radius 6
    Height 12
    Speed 20
    Damage (50)
    DamageType "Explosive"
    Gravity 0.2
    Scale 0.5
    DeathSound "Outlaws/Dynamite/Explosion"
    +FORCERADIUSDMG
    -NOGRAVITY
    States
    {
      Spawn:
        OL00 A -1
        stop

      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_Explode(250,128,XF_HURTSOURCE,true)
      DeathFinish:
        OL99 HIJKLMN 4 Bright
        stop
    }
}

actor Outlaws_CannonProjectileCoop : Outlaws_CannonProjectile
{
    Species "Player"
    +THRUSPECIES
}
