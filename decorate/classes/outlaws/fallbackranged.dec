actor SamsaraOutlawsRevolverClickSpamPrevention : Counter {}

actor Outlaws_Revolver : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Pistol"
    Weapon.SlotNumber 1
    Weapon.SelectionOrder 900
    Weapon.AmmoType "Outlaws_RevolverMagazine"
    Weapon.AmmoUse 1
    Tag "Pistol"
    +WIMPY_WEAPON
    States
    {
      Spawn:
        OL93 A -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyAllowReload")
      ReadyDisallowReload:
        OL00 C 1 A_WeaponReady
        goto Ready

      ReadyAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",0,"ReadyDisallowReload")
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto ReadyAllowReloadSuccess
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAllowReloadSuccess")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"ReadyAllowReloadSuccess")
        goto ReadyDisallowReload

      ReadyAllowReloadSuccess:
        OL00 C 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRevolverClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL00 C 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRevolverClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL00 C 1 A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto FireStart
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"FireStart")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireStart")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",1,"FireStart")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto Reload
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"Reload")
        goto FireDry

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsRevolverClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Pistol/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRevolverClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRevolverAttackHandler")
        OL00 DE 4 Bright
        OL00 F 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Semi auto fires faster!
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL00 C 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
      AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto AltFireStart
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"AltFireStart")
        goto FireDry

      AltFireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",1,"AltFireStart")
      AltFireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto Reload
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"Reload")
        goto FireDry

      AltFireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRevolverAltAttackHandler")
        OL00 IJ 4 Bright
        goto Ready

      Reload:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Pistol/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
      ReloadFinish:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",0,"ReloadFinishFull")
        OL00 G 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFull:
        OL00 H 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto ReloadFinishAllow
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllow")
        TNT1 A 0 A_JumpIfInventory("Clip",1,"ReloadFinishAllow")
        goto Ready

      ReloadFinishAllow:
        OL00 G 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,"ReloadAmmoCalcReserve")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinish")
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_GiveInventory("Outlaws_RevolverMagazine")
        loop

      ReloadAmmoCalcReserve:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        goto ReloadFinish
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Clip",1)
        TNT1 A 0 A_GiveInventory("Outlaws_RevolverMagazine")
        goto ReloadAmmoCalc
    }
}

actor SamsaraOutlawsRevolverAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto PickupAttack
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_RevolverMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Pistol/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,-1,25,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,-1,25,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
    }
}

actor SamsaraOutlawsRevolverAltAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("PistolModeOn",1,1)
        goto PickupAttack
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RevolverMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_RevolverMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Pistol/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(4,4,-1,25,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(4,4,-1,25,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
    }
}

actor Outlaws_RevolverMagazine : Ammo
{
    Inventory.Amount 6
    Inventory.MaxAmount 6
    Tag "Pistol Cylinder"
    +IGNORESKILL
}
