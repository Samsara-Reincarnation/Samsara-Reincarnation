actor SamsaraOutlawsWeapon : Weapon
{
	Inventory.PickupMessage "Yeehaw partner! It looks like there's no pickup message hooked up. Please help that Shiny Metagross fella out and fill them for him!"
    Inventory.RestrictedTo "OutlawsPlayer"
	Weapon.BobStyle "InverseSmooth"
    Weapon.BobRangeX 0.4
    Weapon.BobRangeY 0.25
    Weapon.BobSpeed 1.5
	+ALT_AMMO_OPTIONAL
	+AMMO_OPTIONAL
    +NOALERT
    +UNDROPPABLE
}

Actor OutlawsMeleePuff
{
	+NOINTERACTION
	+BLOODLESSIMPACT
	+NOEXTREMEDEATH
	+NODAMAGETHRUST
	Radius 1
	Height 1
	States
	{	
		Spawn:
		Melee:
		XDeath:
			TNT1 A 1 A_PlaySound("Outlaws/Fist/Hit")
			Stop
	}
}

Actor OutlawsPuff
{
	+NOINTERACTION
	+ALWAYSPUFF
	+PUFFONACTORS
	+HITTRACER
	+BLOODLESSIMPACT
	+NOEXTREMEDEATH
	+NODAMAGETHRUST
	Renderstyle Translucent
	Alpha 0.5
	XScale 0.80
	YScale 0.60
	Radius 2
	Height 2
	States
	{
		Spawn:
			TNT1 A 1
			Stop
		Crash:
			OL99 B 0 A_Jump(192,2)
			OL99 B 0 A_PlaySound("Outlaws/Ricochet",CHAN_BODY)
			OL99 B 0 A_SpawnItemEx("OutlawsPuffHole")
			OL99 BBCDEF 4
			Stop
		XDeath:
			TNT1 A 1 ACS_NamedExecuteWithResult("SamsaraBloodGeneratorOffsets")
			TNT1 A 1 A_GiveInventory("Outlaws_BloodGenerator",1,AAPTR_TRACER)
			Stop
	}
}

Actor OutlawsPuffHole
{
	+NOINTERACTION
	+FORCEXYBILLBOARD
	Radius 1
	Height 1
	YScale 1
	States
	{
		Spawn:
			OL99 A 1050
			OL99 AAAAA 1 A_Fadeout(0.2)
			Stop
	}
}

Actor Outlaws_BloodGenerator : CustomInventory
{
	+INVENTORY.ALWAYSPICKUP
	Inventory.PickupMessage ""
	Inventory.PickupSound ""
	States
	{
		Pickup:
			TNT1 A 0
			TNT1 A 0 A_SpawnItemEx("Outlaws_Blood",radius*cos(CallACS("SamsaraBloodGeneratorReturn",1)),radius*sin(CallACS("SamsaraBloodGeneratorReturn",1)),CallACS("SamsaraBloodGeneratorReturn",2),0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR|SXF_ABSOLUTEPOSITION)
			TNT1 A 0
			stop
	}
}

Actor Outlaws_Blood
{
	+NOINTERACTION
	+NOGRAVITY
	//+CLIENTSIDEONLY
	YScale 1
	States
	{
		Spawn:
			TNT1 A 0 A_SpawnItemEx("Switchable_FlyingBlood",0,0,0,random(-350,350)/100.00,random(-350,350)/100.00,random(500,1000)/100.00,random(-180,180),33|SXF_TRANSFERTRANSLATION)
			OL99 OPQ 4 A_Stop
			Stop
	}
}

Actor Outlaws_ThrowCounter : TemporaryCounter { Inventory.MaxAmount 15 }
actor Outlaws_Reloading : TemporaryBoolean {}
actor Outlaws_SwitchWeapon : TemporaryBoolean {}
actor Outlaws_CrouchToken : TemporaryBoolean {}
Actor Outlaws_WeaponToken : TemporaryCounter { Inventory.MaxAmount 11 }