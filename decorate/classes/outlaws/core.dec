{
	+NOINTERACTION
	Radius 1
	Height 1
	States
	{
		Spawn:
			TNT1 A 1
			Stop
		Crash:
			OL99 B 0 A_SpawnItemEx("OutlawsPuffHole")
			OL99 BCDEF 4 
			Stop
	}
}

