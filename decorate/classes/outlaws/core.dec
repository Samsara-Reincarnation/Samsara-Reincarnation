actor SamsaraOutlawsWeapon : Weapon
{
	Inventory.PickupMessage "Yeehaw partner! It looks like there's no pickup message hooked up. Please help that Shiny Metagross fella out and fill them for him!"
    Inventory.RestrictedTo "OutlawsPlayer"
    Weapon.BobRangeX 0.5
    Weapon.BobRangeY 0.5
    Weapon.BobSpeed 1
    +UNDROPPABLE
	+AMMO_OPTIONAL
	+ALT_AMMO_OPTIONAL
}

