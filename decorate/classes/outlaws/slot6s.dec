actor Outlaws_OrganGun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Vanderbilt Organ Gun"
    Weapon.SlotNumber 6
    Weapon.SelectionOrder 200
    Weapon.AmmoType1 "Outlaws_OrganGunMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Cell"
    Weapon.AmmoGive2 40
    Tag "Vanderbilt Organ Gun"
    States
    {
      Spawn:
        OL93 D -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyAllowReload")
      ReadyDisallowReload:
        OL12 A 1 A_WeaponReady
        goto Ready

      ReadyAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReadyDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto ReadyDisallowReload
        OL12 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRifleClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL12 A 1 A_Lower
        goto DeselectLoop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRifleClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL12 A 1 A_Raise
        goto SelectLoop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Cell",8,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",8,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Cell",8,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsRifleClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRifleClickSpamPrevention",4)
        goto Ready

      FireStart:
		TNT1 A 0 A_TakeInventory("Outlaws_OrganGunPrimaryCounter")
      FireContinue:
		OL12 B 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler")
        OL12 BC 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		OL12 A 3 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        OL12 D 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler")
        OL12 DE 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		OL12 F 2 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		OL12 F 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler")
        OL12 FG 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		OL12 H 0 A_GiveInventory("SamsaraOutlawsOrganGunAttackHandler")
        OL12 HI 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Semi auto fires faster!
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready
		
	  AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
      AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"AltFireWaterCheck")
        goto AltFireDry

      AltFireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,"AltFireWaterCheck")
      AltFireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"Reload")
        goto FireDry

      AltFireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"AltFireDry")
        goto AltFireStart

      AltFireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsRifleClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRifleClickSpamPrevention",4)
        goto Ready

      AltFireStart:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",8,"AltFire8")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",7,"AltFire7")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",6,"AltFire6")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",5,"AltFire5")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",4,"AltFire4")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",3,"AltFire3")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",2,"AltFire2")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",1,"AltFire1")
	  AltFire8:
		OL12 A 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 AJ 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire7:
		OL12 K 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 KL 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire6:
		OL12 M 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 MN 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire5:
		OL12 O 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 OP 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire4:
		OL12 Q 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 QR 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire3:
		OL12 S 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 ST 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire2:
		OL12 U 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 UV 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFire1:
		OL12 W 0 A_GiveInventory("SamsaraOutlawsOrganGunAltAttackHandler")
        OL12 WX 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
		Goto AltFireFinish
	  AltFireFinish:
        //Semi auto fires faster!
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL12 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      Reload:
      ReloadStart:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
      ReloadFinish:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReloadFinishFull")
        OL12 Y 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck
	  ReloadFinishFull:
		OL12 ZY 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
		goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllow")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"ReloadFinishAllow")
        goto Ready

      ReloadFinishAllow:
        OL12 Y 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto ReloadFinish
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Cell",1)
        TNT1 A 0 A_GiveInventory("Outlaws_OrganGunMagazine")
        loop
    }
}

actor SamsaraOutlawsOrganGunAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_GiveInventory("Outlaws_OrganGunPrimaryCounter")
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",3,"PickupAttackDM4")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",2,"PickupAttackDM3")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",1,"PickupAttackDM2")
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
        goto PickupFinish
	  PickupAttackDM2:
	    TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM3:
	    TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM4:
	    TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish

      PickupAttackCoop:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",3,"PickupAttackCoop4")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",2,"PickupAttackCoop3")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunPrimaryCounter",1,"PickupAttackCoop2")
        TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
        goto PickupFinish
	  PickupAttackCoop2:
	    TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop3:
	    TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop4:
	    TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        stop
    }
}

actor SamsaraOutlawsOrganGunAltAttackHandler : Trigger
{
	States
    {
     // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttackContinue")
        TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunMagazine",1,1)
        stop
		TNT1 A 0 ACS_NamedExecuteWithResult("Outlaws_OrganGunMagazineSync")
        TNT1 A 0 A_TakeInventory("Outlaws_OrganGunMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
		TNT1 A 0 A_TakeInventory("Outlaws_OrganGunSecondaryCounter",1)
	  PickupAttackContinue:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",7,"PickupAttackDM8")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",6,"PickupAttackDM7")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",5,"PickupAttackDM6")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",4,"PickupAttackDM5")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",3,"PickupAttackDM4")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",2,"PickupAttackDM3")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",1,"PickupAttackDM2")
        TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM2:
	    TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM3:
	    TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM4:
	    TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM5:
	    TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM6:
	    TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM7:
	    TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackDM8:
		TNT1 A 0 A_GiveInventory("Outlaws_OrganGunSecondaryCounter",8)
	    TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish

      PickupAttackCoop:
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",7,"PickupAttackCoop8")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",6,"PickupAttackCoop7")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",5,"PickupAttackCoop6")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",4,"PickupAttackCoop5")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",3,"PickupAttackCoop4")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",2,"PickupAttackCoop3")
		TNT1 A 0 A_JumpIfInventory("Outlaws_OrganGunSecondaryCounter",1,"PickupAttackCoop2")
        TNT1 A 0 A_FireBullets(frandom(-5,-3),frandom(-2,2),-1,20,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop2:
	    TNT1 A 0 A_FireBullets(frandom(-4,-2),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop3:
	    TNT1 A 0 A_FireBullets(frandom(-3,-1),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop4:
	    TNT1 A 0 A_FireBullets(frandom(-2,0),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop5:
	    TNT1 A 0 A_FireBullets(frandom(0,2),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop6:
	    TNT1 A 0 A_FireBullets(frandom(1,3),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop7:
	    TNT1 A 0 A_FireBullets(frandom(2,4),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish
	  PickupAttackCoop8:
		TNT1 A 0 A_GiveInventory("Outlaws_OrganGunSecondaryCounter",8)
	    TNT1 A 0 A_FireBullets(frandom(3,5),frandom(-2,2),-1,20,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ|FBF_EXPLICITANGLE)
		goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_Recoil(0.125)
        TNT1 A 0 ACS_NamedExecuteWithResult("GlobalRecoil", 4, 12)
        stop
    }
}

actor Outlaws_OrganGunPrimaryCounter : TemporaryCounter { Inventory.MaxAmount 4 }
actor Outlaws_OrganGunSecondaryCounter : TemporaryCounter { Inventory.MaxAmount 7 }
actor Outlaws_OrganGunMagazine : Ammo
{
    Inventory.Amount 8
    Inventory.MaxAmount 8
    Tag "Organ Gun Magazine"
    +IGNORESKILL
}
