Actor Outlaws_Knife : SamsaraOutlawsWeapon
{
	Weapon.SlotNumber 1
    Weapon.SelectionOrder 800
	Weapon.AmmoType1 "Outlaws_Knives"
    Weapon.AmmoUse1 1
    Tag "Knife"
	+NOALERT
	States
	{
		Spawn:
			TNT1 A -1
			Stop
		Ready:
			OL08 A 1 A_WeaponReady
			Loop

		Deselect:
			TNT1 A 0 A_Lower
			OL08 A 1 A_Lower
			Loop

		Select:
			TNT1 A 0 A_Raise
			OL08 A 1 A_Raise
			Loop
			
		Fire:
			OL08 B 0 A_GiveInventory("Outlaws_ThrowCounter",10)
		ThrowHold:
			OL08 B 0 A_GiveInventory("Outlaws_ThrowCounter")
			OL08 B 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL08 B 0 A_Refire("ThrowHold")
		ThrowFinish:
			OL08 C 0 A_GiveInventory("SamsaraOutlawsKnifeAttackHandler")
			OL08 C 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL08 A 0 A_TakeInventory("Outlaws_ThrowCounter")
			OL08 A 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready
		AltFire:
			TNT1 A 0 A_GiveInventory("SamsaraOutlawsKnifeAltAttackHandler")
			OL08 DA 4
			Goto Ready
	}
}

actor SamsaraOutlawsKnifeAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack
      // Attack stuff
      PickupAttack:
		TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectile",0,false,0,0,0,15)
        stop
      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectile",0,false,0,0,0,15)
        stop
    }
}

actor SamsaraOutlawsKnifeAltAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/Fist/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupDMSpread")
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsMeleePuff")
        stop

      PickupDMSpread:
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsMeleePuff")
        stop

      PickupCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupCoopSpread")
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsMeleePuff")
        stop

      PickupCoopSpread:
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsMeleePuff")
        stop
    }
}

Actor Outlaws_Knives : Ammo
{
    Inventory.Amount 50
    Inventory.MaxAmount 50
    Tag "Knives"
}

Actor Outlaws_KnifeProjectile
{
	Projectile
	Speed 10
	Gravity 0.33
	Damage (100)
	-NOGRAVITY
	+NOEXTREMEDEATH
	+BLOODLESSIMPACT
	States
	{
		Spawn:
			OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter"))
			OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*(args[0]/10),0,velz*(args[0]/10),CVF_RELATIVE|CVF_REPLACE)
		SpawnLoop:
			OL00 A 1 A_SetPitch(pitch+15)
			Loop
		Death:
			TNT1 A 0 A_SetPitch(0)
			TNT1 A 1 A_SpawnItemEx("Outlaws_KnifePickup")
			Stop
	}
}

Actor OutlawsKnifePuff
{
	+NOINTERACTION
	+BLOODLESSIMPACT
	+NOEXTREMEDEATH
	Radius 1
	Height 1
	States
	{	
		Spawn:
		Melee:
			TNT1 A 1 A_PlaySound("Outlaws/Knife/Hit")
			Stop
		XDeath:
			TNT1 A 1 A_PlaySound("Outlaws/Knife/Jab")
			Stop
	}
}


Actor Outlaws_KnifePickup : CustomInventory
{
    Height 4
    Radius 2
    Inventory.PickupMessage "Picked up a knife."
    Inventory.PickupSound "Outlaws/Knife/Pickup"
    States
    {
        Spawn:
            OL00 A 1
            Loop
        Pickup:
            TNT1 A 0 A_JumpIfInventory("OutlawsClass",1,1)
            fail
            TNT1 A 0 A_GiveInventory("Outlaws_Knives",1)
            Stop
    }
}