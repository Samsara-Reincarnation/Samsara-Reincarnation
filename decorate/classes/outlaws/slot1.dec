actor Outlaws_Knife : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Knife"
    Inventory.PickupSound "Outlaws/KnifePickup"
    Weapon.SlotNumber 1
    Weapon.SelectionOrder 800
    Weapon.AmmoType "Outlaws_Knives"
    Weapon.AmmoGive 5
    Weapon.AmmoUse 1
    Tag "Knife"
    +MELEEWEAPON
    States
    {
      Spawn:
        TNT1 A -1 //OL93 A -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        OL08 A 1 A_WeaponReady
        loop

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_Lower
        OL08 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_Raise
        OL08 A 1 A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("Outlaws_Knives",1,"FireStart")
        goto FireDry

      FireDry:
        TNT1 A 0 A_ClearReFire
        goto Ready

      FireStart:
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
      FireCharge:
        TNT1 A 0 A_GiveInventory("Outlaws_ThrowCounter")
        OL08 B 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire("FireCharge")
      FireFinish:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsKnifeAttackHandler")
        OL08 C 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        OL08 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      AltFire:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsKnifeAltAttackHandler")
        OL08 DA 4
        goto Ready
    }
}

actor SamsaraOutlawsKnifeAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_Knives",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_Knives",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectile",0,false,0,0,0,15)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectileCoop",0,false,0,0,0,15)
        stop

      PickupAttackInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackInfiniteCoop")
      PickupAttackInfiniteDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectileInfinite",0,false,0,0,0,15)
        stop

      PickupAttackInfiniteCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_KnifeProjectileInfiniteCoop",0,false,0,0,0,15)
        stop
    }
}

actor SamsaraOutlawsKnifeAltAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/Fist/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupCoop")
      PickupDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupDMSpread")
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsKnifePuff")
        stop

      PickupDMSpread:
        TNT1 A 0 A_CustomPunch(40*3,true,0,"OutlawsKnifePuff")
        stop

      PickupCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupCoopSpread")
        TNT1 A 0 A_CustomPunch(40,true,0,"OutlawsKnifePuffCoop")
        stop

      PickupCoopSpread:
        TNT1 A 0 A_CustomPunch(40*3,true,0,"OutlawsKnifePuffCoop")
        stop
    }
}

actor Outlaws_Knives : Ammo
{
    Inventory.Amount 50
    Inventory.MaxAmount 50
    Tag "Knives"
}

actor Outlaws_KnivesIgnoreSkill : Outlaws_Knives { +IGNORESKILL }

actor Outlaws_KnifeProjectile
{
    Projectile
    Radius 6
    Height 12
    Speed 10
    Damage (100)
    Gravity 0.33
    +BLOODLESSIMPACT
    +HITTRACER
    +NOEXTREMEDEATH
    -NOGRAVITY
    +NOTIMEFREEZE
    States
    {
      Spawn:
        OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter")+10)
        OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*(args[0]/10),0,velz*(args[0]/10),CVF_RELATIVE|CVF_REPLACE)
        OL00 A 0 A_SetAngle(angle+frandom(-10,10))
        OL00 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
        OL00 A 1 A_SetPitch(pitch+15)
        wait

      Death:
        TNT1 A 0 A_SetPitch(0)
        TNT1 A 1 A_SpawnItemEx("Outlaws_KnifePickup")
        stop

      XDeath:
        TNT1 A 1 ACS_NamedExecuteWithResult("SamsaraBloodGeneratorOffsets")
        TNT1 A 1 A_GiveInventory("Outlaws_BloodGenerator",1,AAPTR_TRACER)
        stop
    }
}

actor Outlaws_KnifeProjectileCoop : Outlaws_KnifeProjectile
{
    Species "Player"
    +THRUSPECIES
}

actor Outlaws_KnifeProjectileInfinite : Outlaws_KnifeProjectile
{
    States
    {
      Death:
        TNT1 A 0 A_SetPitch(0)
        TNT1 A 1 A_SpawnItemEx("Outlaws_KnifePickupInfinite")
        stop
    }
}

actor Outlaws_KnifeProjectileInfiniteCoop : Outlaws_KnifeProjectileInfinite
{
    Species "Player"
    +THRUSPECIES
}

actor OutlawsKnifePuff : OutlawsMeleePuff
{
    +HITTRACER
    +PUFFONACTORS
    States
    {
      Spawn:
      Melee:
        TNT1 A 1 A_PlaySound("Outlaws/Knife/Jab")
        stop

      XDeath:
        TNT1 A 0 A_PlaySound("Outlaws/Knife/Jab")
        TNT1 A 1 ACS_NamedExecuteWithResult("SamsaraBloodGeneratorOffsets")
        TNT1 A 1 A_GiveInventory("Outlaws_BloodGenerator",1,AAPTR_TRACER)
        stop
    }
}

actor OutlawsKnifePuffCoop : OutlawsKnifePuff { +MTHRUSPECIES }

actor Outlaws_KnifePickup : CustomInventory
{
    Inventory.PickupMessage "Knife"
    Inventory.PickupSound "Outlaws/KnifePickup"
    Radius 2
    Height 4
    States
    {
      Spawn:
        OL00 A -1
        stop

      Pickup:
        TNT1 A 0 A_JumpIfInventory("OutlawsClass",1,1)
        fail
        TNT1 A 0 A_GiveInventory("Outlaws_KnivesIgnoreSkill",1)
        stop
    }
}

actor Outlaws_KnifePickupInfinite
{
    Radius 2
    Height 4
    +CLIENTSIDEONLY
    States
    {
      Spawn:
        OL00 A 2 A_FadeOut(0.04)
        loop
    }
}
