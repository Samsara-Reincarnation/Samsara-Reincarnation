Actor Outlaws_Shotgun : SamsaraOutlawsWeapon
{
    Weapon.SlotNumber 2
    Weapon.SelectionOrder 700
    Weapon.AmmoType1 "Outlaws_ShotgunMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Shell"
    Weapon.AmmoGive2 5
    Tag "Shotgun"
    States
    {
        Spawn:
            OL93 B -1
            Stop
        Ready:
            OL01 A 0 A_TakeInventory("Outlaws_Reloading")
            OL01 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
            loop

        Deselect:
            TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
        DeselectLoop:
            TNT1 A 0 A_Lower
            OL01 A 1 A_Lower
            Loop

        Select:
            TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon",1)
        SelectLoop:
            TNT1 A 0 A_Raise
            OL01 A 1 A_Raise
            Loop

        Fire:
        AltFire:
            OL01 B 0 A_JumpIfInventory("Outlaws_ShotgunMagazine",1,1)
            Goto Reload
            OL01 B 0 A_GiveInventory("SamsaraOutlawsShotgunAttackHandler")
            OL01 BC 4 Bright
            OL01 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            //Too spammable without this
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            OL01 A 0 A_Refire(1)
            Goto Ready
            OL01 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
            Goto Ready

        Reload:
            OL01 E 0 A_JumpIfInventory("Outlaws_ShotgunMagazine",0,"Ready")
            OL01 E 0 A_JumpIfInventory("Shell",1,1)
            Goto Ready
            OL01 E 0 A_GiveInventory("Outlaws_Reloading")
            OL01 E 0 A_PlaySound("Outlaws/Shotgun/Reload",CHAN_5)
            OL01 E 0 A_TakeInventory("Shell",1,TIF_NOTAKEINFINITE)
            OL01 E 0 A_GiveInventory("Outlaws_ShotgunMagazine")
            OL01 EF 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
            Goto ReloadFinish
        //Allow reloading again, here
        ReloadFinish:
            OL01 E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
            OL01 E 0 A_TakeInventory("Outlaws_Reloading")
            Goto Ready
    }
}

actor SamsaraOutlawsShotgunAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_ShotgunMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_ShotgunMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(4,4,6,15,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(4,4,6,15,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
    }
}

actor Outlaws_ShotgunMagazine : Ammo
{
    Inventory.Amount 1
    Inventory.MaxAmount 1
    Tag "Shotgun Magazine"
    +IGNORESKILL
}
