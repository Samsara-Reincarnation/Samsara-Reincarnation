actor SamsaraOutlawsDynamiteLoopSoundCheck : Boolean {}
actor Outlaws_DynamiteFuseActive : Boolean {}
actor Outlaws_DynamiteFuse : Counter { Inventory.MaxAmount 35 }

actor Outlaws_Dynamite : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Dynamite"
    Inventory.PickupSound "Outlaws/ItemPickup"
    Weapon.SlotNumber 9
    Weapon.SelectionOrder 500
    Weapon.AmmoType "RocketAmmo"
    Weapon.AmmoGive 5
    Weapon.AmmoUse 1
    Tag "Dynamite"
    -ALT_AMMO_OPTIONAL
    +ALT_USES_BOTH // only one ammo type with same ammo amount use, so this makes alt fire behave as intended
    -AMMO_OPTIONAL
    +EXPLOSIVE
    +NOAUTOFIRE
    States
    {
      Spawn:
        OL09 A -1 // althud placeholder
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsDynamiteLoopSoundCheck")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        TNT1 A 1 A_WeaponReady
        goto Ready

      ReadyAmmo:
        OL09 A 1 A_WeaponReady
        goto Ready

      ReadyFuse:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse",1,1)
        goto OvercookLastShotCalc
        OL09 E 0 A_JumpIfInventory("Outlaws_DynamiteFuse",28,5)
        OL09 F 0 A_JumpIfInventory("Outlaws_DynamiteFuse",21,4)
        OL09 G 0 A_JumpIfInventory("Outlaws_DynamiteFuse",14,3)
        OL09 H 0 A_JumpIfInventory("Outlaws_DynamiteFuse",7,2)
        OL09 I 0
        "####" "#" 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
        "####" "#" 4 A_WeaponReady(WRF_NOSWITCH)
        loop

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteLoopSoundStopper")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
        TNT1 A 0 A_Lower
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectLoopAmmo")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"DeselectLoopAmmo")
        goto DeselectLoopNoAmmo

      DeselectLoopNoAmmo:
        TNT1 A 1 A_Lower
        goto DeselectLoop

      DeselectLoopAmmo:
        OL09 A 1 A_Lower
        goto DeselectLoop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsDynamiteLoopSoundCheck")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
        TNT1 A 0 A_Raise
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectLoopAmmo")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"SelectLoopAmmo")
        goto SelectLoopNoAmmo

      SelectLoopNoAmmo:
        TNT1 A 1 A_Raise
        goto SelectLoop

      SelectLoopAmmo:
        OL09 A 1 A_Raise
        goto SelectLoop

      Fire:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuseActive",1,"AltFireCharge")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
      FireCharge:
        TNT1 A 0 A_GiveInventory("Outlaws_ThrowCounter")
        OL09 C 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire("FireCharge")
      FireThrow:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAttackHandler")
        OL09 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFinish")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"FireFinish")
        goto FireFinishLast

      FireFinish:
        OL09 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready

      FireFinishLast:
        TNT1 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready

      AltFire:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuseActive",1,"AltFireCharge")
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"Fire")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_GiveInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_GiveInventory("Outlaws_DynamiteFuse",35)
      AltFireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteLoopSoundStarter")
        OL09 B 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire("AltFireCharge")
        goto ReadyFuse

      AltFireCharge:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse",1,1)
        goto OvercookLastShotCalc
        TNT1 A 0 A_GiveInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
        OL09 C 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire("AltFireCharge")
      AltFireThrow:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteLoopSoundStopper")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAltAttackHandler")
        OL09 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"AltFireFinish")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,"AltFireFinish")
        goto AltFireFinishLast

      AltFireFinish:
        OL09 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready

      AltFireFinishLast:
        TNT1 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready

      OvercookLastShotCalc:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteLoopSoundStopper")
        TNT1 A 0 A_TakeInventory("Outlaws_ThrowCounter")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuseActive")
        TNT1 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Overcook")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",2,"Overcook")
        goto OvercookLast

      Overcook:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAltOvercookAttackHandler")
        OL09 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready

      OvercookLast:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAltOvercookAttackHandler")
        TNT1 A 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire
        goto Ready
    }
}

actor SamsaraOutlawsDynamiteAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectile",0,false,0,0,0,15)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileCoop",0,false,0,0,0,15)
        stop

      PickupAttackInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackInfiniteCoop")
      PickupAttackInfiniteDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileInfinite",0,false,0,0,0,15)
        stop

      PickupAttackInfiniteCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileInfiniteCoop",0,false,0,0,0,15)
        stop
    }
}

actor SamsaraOutlawsDynamiteAltAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileTimed",0,false,0,0,0,15)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileTimedCoop",0,false,0,0,0,15)
        stop
    }
}

