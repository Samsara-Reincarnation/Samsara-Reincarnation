actor SamsaraOutlawsDynamiteLoopSoundStarter : Trigger
{
    States
    {
      // Sound stopping stuff
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/Dynamite/Fuse",CHAN_WEAPON,1,true)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteLoopSoundCheck")
        stop
    }
}

actor SamsaraOutlawsDynamiteLoopSoundStopper : Trigger
{
    States
    {
      // Sound stopping stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDynamiteLoopSoundCheck",1,1)
        stop
        TNT1 A 0 A_PlaySound("silence",CHAN_WEAPON)
        TNT1 A 0 A_StopSound(CHAN_WEAPON)
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsDynamiteLoopSoundCheck")
        stop
    }
}

actor Outlaws_DynamiteExists : Boolean {}
actor Outlaws_DynamiteExplode : Boolean {}

actor Outlaws_DynamiteProjectile
{
    Projectile
    Radius 6
    Height 12
    Speed 10
    Damage (0)
    Gravity 0.33
    ReactionTime 1
    BounceType "Hexen"
    BounceFactor 0.2
    WallBounceFactor 0.33
    +BLOODLESSIMPACT
    +BOUNCEONACTORS
    +NOEXTREMEDEATH
    -NOGRAVITY
    +NOTIMEFREEZE
    +USEBOUNCESTATE
    States
    {
      Spawn:
        OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter")+10)
        OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*((args[0]*1.0)/10),0,velz*((args[0]*1.0)/10),CVF_RELATIVE|CVF_REPLACE)
        OL00 A 0 A_SetAngle(angle+frandom(-10,10))
        OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        OL00 A 0 A_GiveInventory("Outlaws_DynamiteExists")
        OL00 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
      SpawnLoop:
        OL00 A 0 A_JumpIfInventory("Outlaws_DynamiteExplode",1,"Explode")
        OL00 A 0 A_JumpIf(sqrt(velx*velx+vely*vely+velz*velz) <= 1, "Stay")
        OL00 A 1 A_SetPitch(pitch+15)
        loop

      Stay:
        OL00 B 0 A_Stop
        OL00 B 0 A_SetPitch(0)
      StayLoop:
        OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
        OL00 B 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        OL00 B 1 A_JumpIfInventory("Outlaws_DynamiteExplode",1,"Explode")
        OL00 B 0 A_JumpIfInventory("OutlawsClass",1,1,AAPTR_TARGET)
        loop
        OL00 B 0 A_JumpIfInventory("RocketAmmo",0,"StayLoop",AAPTR_TARGET)
        OL00 B 0 A_JumpIfCloser(48,"TakeRocket")
        loop

      TakeRocket:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAmmoRefund",1,AAPTR_TARGET)
        stop

      Bounce:
        "####" "#" 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
        "####" "#" 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        "####" "#" 0 A_ChangeFlag("NOTIMEFREEZE",false)
        "####" "#" 1 A_Jump(256,"SpawnLoop")
        wait

      Explode:
        "####" "#" 1 A_Countdown
        loop

      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_PlaySound("Outlaws/Dynamite/Explosion",CHAN_WEAPON)
        TNT1 A 0 A_SetDamageType("Explosive") // putting it here just in case
        TNT1 A 0 A_Explode(200,128,0,true)
        TNT1 A 0 A_Explode(50,128,XF_HURTSOURCE,true)
        TNT1 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
      DeathFinish:
        OL99 HIJKLMN 4 Bright
        stop
    }
}

actor Outlaws_DynamiteProjectileCoop : Outlaws_DynamiteProjectile
{
    Species "Player"
    +THRUSPECIES
}

actor Outlaws_DynamiteProjectileInfinite : Outlaws_DynamiteProjectile
{
    States
    {
      Stay:
        OL00 B 0 A_Stop
        OL00 B 0 A_SetPitch(0)
      StayLoop:
        OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
        OL00 B 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        OL00 B 1 A_JumpIfInventory("Outlaws_DynamiteExplode",1,"Explode")
        loop
    }
}

actor Outlaws_DynamiteProjectileInfiniteCoop : Outlaws_DynamiteProjectileInfinite
{
    Species "Player"
    +THRUSPECIES
}

actor Outlaws_DynamiteProjectileTimer : Counter {}

actor Outlaws_DynamiteProjectileTimed : Outlaws_DynamiteProjectile
{
    States
    {
      Spawn:
        OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter")+10)
        OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*((args[0]*1.0)/10),0,velz*((args[0]*1.0)/10),CVF_RELATIVE|CVF_REPLACE)
        OL00 A 0 A_SetAngle(angle+frandom(-10,10))
        OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_TNTAddFuse")
        OL00 A 0 A_GiveInventory("Outlaws_DynamiteExists")
        OL00 A 0 A_PlaySound("Outlaws/Dynamite/Fuse",CHAN_WEAPON,1,true)
        OL00 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
      SpawnLoop:
        OL00 A 0 A_JumpIfInventory("Outlaws_DynamiteExplode",1,"Explode")
        OL00 A 0 A_JumpIf(sqrt(velx*velx+vely*vely+velz*velz) <= 1, "Stay")
        OL00 A 0 A_TakeInventory("Outlaws_DynamiteProjectileTimer",1)
        OL00 A 0 A_JumpIfInventory("Outlaws_DynamiteProjectileTimer",1,1)
        goto Explode
        OL00 A 1 A_SetPitch(pitch+15)
        loop

      Stay:
        OL00 B 0 A_Stop
        OL00 B 0 A_SetPitch(0)
      StayLoop:
        OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
        OL00 B 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
        OL00 B 0 A_TakeInventory("Outlaws_DynamiteProjectileTimer",1)
        OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteProjectileTimer",1,1)
        goto Explode
        OL00 B 1 A_JumpIfInventory("Outlaws_DynamiteExplode",1,"Explode")
        loop
    }
}

actor Outlaws_DynamiteProjectileTimedCoop : Outlaws_DynamiteProjectileTimed
{
    Species "Player"
    +THRUSPECIES
}

actor Outlaws_DynamiteHitBox
{
    Health 5
    Radius 8
    Height 16
    Tag "Dynamite"
    +NOBLOOD
    +NOGRAVITY
    +SHOOTABLE
    +THRUACTORS
    States
    {
      Spawn:
        TNT1 A 0
      SpawnLoop:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,1,AAPTR_TRACER)
        goto Remove
        TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION)
        loop

      Death:
        TNT1 A 1 A_GiveInventory("Outlaws_DynamiteExplode",1,AAPTR_TRACER)
        stop

      Remove:
        TNT1 A 1
        stop
    }
}

actor SamsaraOutlawsDynamiteAmmoRefund : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_PlaySound("Outlaws/ItemPickup",CHAN_ITEM|CHAN_MAYBE_LOCAL)
        TNT1 A 0 A_GiveInventory("Ammo3IgnoreSkill",1)
        stop
    }
}
