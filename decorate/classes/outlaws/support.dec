Actor Outlaws_DynamiteExists : TemporaryBoolean {}
Actor Outlaws_DynamiteFuse : TemporaryCounter { Inventory.MaxAmount 35 }
Actor Outlaws_Dynamite : SamsaraOutlawsWeapon
{
	Weapon.SlotNumber 1
    Weapon.SelectionOrder 500
	Weapon.AmmoType1 "RocketAmmo"
    Weapon.AmmoUse1 1
    Tag "Dynamite"
	+NOALERT
	States
	{
		Spawn:
			TNT1 A -1
			Stop
		Ready:
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 28, "ReadyA")
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 21, "ReadyB")
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 14, "ReadyC")
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 7, "ReadyD")
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 1, "ReadyE")
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
			OL09 A 1 A_WeaponReady
			Loop
		ReadyA:
			OL09 E 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 E 4 A_WeaponReady(WRF_NOSWITCH)
			Goto Ready
		ReadyB:
			OL09 F 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 F 4 A_WeaponReady(WRF_NOSWITCH)
			Goto Ready
		ReadyC:
			OL09 G 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 G 4 A_WeaponReady(WRF_NOSWITCH)
			Goto Ready
		ReadyD:
			OL09 H 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 H 4 A_WeaponReady(WRF_NOSWITCH)
			Goto Ready
		ReadyE:
			OL09 I 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 I 4 A_WeaponReady(WRF_NOSWITCH)
			Goto Suicide

		Deselect:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
			TNT1 A 0 A_Lower
			OL09 A 1 A_Lower
			Loop

		Select:
			TNT1 A 0 A_StopSound(CHAN_WEAPON)
			TNT1 A 0 A_Raise
			OL09 A 1 A_Raise
			Loop
			
		Fire:
			OL09 C 0 A_JumpIfInventory("Outlaws_DynamiteFuse",1,"AltThrowHold")
			OL09 C 0 A_GiveInventory("Outlaws_ThrowCounter",10)
		ThrowHold:
			OL09 C 0 A_GiveInventory("Outlaws_ThrowCounter")
			OL09 C 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL09 C 0 A_Refire("ThrowHold")
		ThrowFinish:
			OL09 D 0 A_GiveInventory("SamsaraOutlawsDynamiteAttackHandler")
			OL09 D 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL09 A 0 A_TakeInventory("Outlaws_ThrowCounter")
			OL09 A 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready
			
		AltFire:
			OL09 B 0 A_JumpIfInventory("Outlaws_DynamiteFuse",1,"AltThrowHold")
			OL09 B 0 A_GiveInventory("Outlaws_DynamiteFuse",35)
			OL09 B 0 A_GiveInventory("Outlaws_ThrowCounter",10)
		AltStart:
			OL09 B 0 A_PlaySound("Outlaws/Dynamite/Fuse",CHAN_WEAPON,1.0,true)
			OL09 B 8 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL09 B 0 A_Refire("AltThrowHold")
			Goto Ready
		AltThrowHold:
			OL09 C 0 A_JumpIfInventory("Outlaws_DynamiteFuse", 1, 1)
			Goto Suicide
			OL09 C 0 A_GiveInventory("Outlaws_ThrowCounter")
			OL09 C 0 A_TakeInventory("Outlaws_DynamiteFuse",1)
			OL09 C 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL09 C 0 A_Refire("AltThrowHold")
		AltThrowFinish:
			OL09 D 0 A_GiveInventory("SamsaraOutlawsDynamiteAltAttackHandler")
			OL09 D 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL09 A 0 A_TakeInventory("Outlaws_ThrowCounter")
			OL09 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
			OL09 A 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready
		
		Suicide:
			OL09 A 0 A_TakeInventory("Outlaws_ThrowCounter")
			OL09 A 0 A_TakeInventory("Outlaws_DynamiteFuse")
			OL09 A 0 A_GiveInventory("SamsaraOutlawsDynamiteAltAttackHandler")
			OL09 A 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready
	}
}

actor SamsaraOutlawsDynamiteAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack
      // Attack stuff
      PickupAttack:
		TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectile",0,false,0,0,0,15)
        stop
      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectile",0,false,0,0,0,15)
        stop
    }
}

actor SamsaraOutlawsDynamiteAltAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("RocketAmmo",1,1)
        stop
        TNT1 A 0 A_TakeInventory("RocketAmmo",1)
        goto PickupAttack
      // Attack stuff
      PickupAttack:
		TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteFuse",1,1)
		Goto PickupAttackContinue
		TNT1 A 0 A_PlaySound("Outlaws/Knife/Throw",CHAN_WEAPON)
	  PickupAttackContinue:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileTimed",0,false,0,0,0,15)
        stop
      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("Outlaws_DynamiteProjectileTimed",0,false,0,0,0,15)
        stop
    }
}

Actor Outlaws_DynamiteProjectile
{
	Projectile
	Speed 10
	Gravity 0.33
	Damage (0)
	BounceFactor 0.2
	WallBounceFactor 0.33
	Radius 6
	Height 12
	+HEXENBOUNCE
	-NOGRAVITY
	+NOEXTREMEDEATH
	+BLOODLESSIMPACT
	+BOUNCEONACTORS
	+USEBOUNCESTATE
	States
	{
		Spawn:
			OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter"))
			OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*(args[0]/10),0,velz*(args[0]/10),CVF_RELATIVE|CVF_REPLACE)
			OL00 A 0 A_SetAngle(angle+frandom(-10,10))
			OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
			OL00 A 0 A_GiveInventory("Outlaws_DynamiteExists")
		SpawnLoop:
			OL00 A 0 A_JumpIf(sqrt(velx*velx+vely*vely+velz*velz) <= 1,"Stay")
			OL00 A 1 A_SetPitch(pitch+15)
			Loop
		Stay:
			OL00 B 0 A_Stop
			OL00 B 0 A_SetPitch(0)
		StayLoop:
			OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
			OL00 B 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
			OL00 B 1 A_JumpIfInventory("Outlaws_DynamiteDetonate",1,"Detonate")
			Loop
		Bounce:
			"####" "#" 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
			"####" "#" 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
			"####" "#" 1 A_Jump(256,"SpawnLoop")
			Wait
		Death:
			TNT1 A 0 A_NoGravity
			TNT1 A 0 A_PlaySound("Outlaws/Dynamite/Explosion",CHAN_WEAPON)
			TNT1 A 0 A_Explode(250,128)
			OL99 HIJKLMN 4 Bright
			Stop
	}
}

Actor Outlaws_DynamiteProjectileTimed : Outlaws_DynamiteProjectile
{
	States
	{
		Spawn:
			OL00 A 0 NoDelay A_SetArg(0,CallACS("Outlaws_ThrowCounter"))
			OL00 A 0 A_ChangeVelocity(sqrt(velx*velx+vely*vely)*(args[0]/10),0,velz*(args[0]/10),CVF_RELATIVE|CVF_REPLACE)
			OL00 A 0 A_SetAngle(angle+frandom(-10,10))
			OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
			OL00 A 0 ACS_NamedExecuteWithResult("Outlaws_TNTAddFuse")
			OL00 A 0 A_GiveInventory("Outlaws_DynamiteExists")
			OL00 A 0 A_PlaySound("Outlaws/Dynamite/Fuse",CHAN_WEAPON,1.0,true)
		SpawnLoop:
			OL00 A 0 A_JumpIf(sqrt(velx*velx+vely*vely+velz*velz) <= 1,"Stay")
			OL00 A 0 A_CountDown
			OL00 A 1 A_SetPitch(pitch+15)
			Loop
		Stay:
			OL00 B 0 A_Stop
			OL00 B 0 A_SetPitch(0)
		StayLoop:
			OL00 B 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,2)
			OL00 B 0 ACS_NamedExecuteWithResult("Outlaws_GenerateHitBox")
			OL00 B 0 A_CountDown
			OL00 B 1 A_JumpIfInventory("Outlaws_DynamiteDetonate",1,"Detonate")
			Loop
	}
}

Actor Outlaws_DynamiteHitBox
{
	Health 5
	Radius 8
	Height 16
	+THRUACTORS
	+SHOOTABLE
	-SOLID
	+NOBLOOD
	+NOGRAVITY
	States
	{
		Spawn:
			TNT1 A 0
		SpawnLoop:
			TNT1 A 0 A_JumpIfInventory("Outlaws_DynamiteExists",1,1,AAPTR_TRACER)
			Goto Remove
			TNT1 A 1 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION)
			Loop
		Death:
			TNT1 A 1 A_KillTracer("None",KILS_KILLMISSILES)
			Stop
		Remove:
			TNT1 A 1
			Stop
	}
}