actor Outlaws_RifleZoomed : Boolean {}
actor SamsaraOutlawsRifleClickSpamPrevention : Counter {}

actor Outlaws_Rifle : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Rifle"
    Weapon.SlotNumber 4
    Weapon.SelectionOrder 500
    Weapon.AmmoType1 "Outlaws_RifleMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Clip"
    Weapon.AmmoGive2 48
    Tag "Rifle"
    States
    {
      Spawn:
        OL93 E -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyAllowReload")
      ReadyDisallowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,2)
        OL04 A 1 A_WeaponReady(WRF_ALLOWZOOM)
        goto Ready
        OL04 G 1 A_WeaponReady(WRF_ALLOWZOOM)
        goto Ready

      ReadyAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",0,"ReadyDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",2,1)
        goto ReadyDisallowReload
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,2)
        OL04 A 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        goto Ready
        OL04 G 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM)
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectZoomCheck:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,1)
        goto DeselectLoop
        TNT1 A 0 A_ZoomFactor(1)
        TNT1 A 0 A_TakeInventory("Outlaws_RifleZoomed")
        goto DeselectLoop

      DeselectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRifleClickSpamPrevention")
        TNT1 A 0 A_Lower
        OL04 A 1 A_Lower
        goto DeselectZoomCheck

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectZoomCheck:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,1)
        goto SelectLoop
        TNT1 A 0 A_ZoomFactor(1,ZOOM_INSTANT) // map change
        TNT1 A 0 A_TakeInventory("Outlaws_RifleZoomed")
        goto SelectLoop

      SelectLoop:
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsRifleClickSpamPrevention")
        TNT1 A 0 A_Raise
        OL04 A 1 A_Raise
        goto SelectZoomCheck

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Clip",2,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",1,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Clip",2,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsRifleClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRifleClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsRifleAttackHandler")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,"FireContinueZoom")
      FireContinue:
        OL04 BC 4 Bright
        OL04 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Semi auto fires faster!
        OL04 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      FireContinueZoom:
        OL04 H 4 Bright
        OL04 G 4
        OL04 G 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Too spammable without this
        OL04 G 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 G 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 G 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto Ready
        OL04 G 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto Ready

      AltFire:
      Zoom:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,"Unzoom")
        TNT1 A 0 A_GiveInventory("Outlaws_RifleZoomed")
        TNT1 A 0 A_ZoomFactor(4)
      ZoomInHold:
        OL04 G 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"ZoomInHold")
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"ZoomInHold")
        goto Ready

      Unzoom:
        TNT1 A 0 A_TakeInventory("Outlaws_RifleZoomed")
        TNT1 A 0 A_ZoomFactor(1)
      ZoomOutHold:
        OL04 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"ZoomOutHold")
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireZoom",1,"ZoomOutHold")
        goto Ready

      Reload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,1)
        goto ReloadStart
        TNT1 A 0 A_TakeInventory("Outlaws_RifleZoomed")
        TNT1 A 0 A_ZoomFactor(1)
        goto ReloadStart

      ReloadStart:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
      ReloadFinish:
        OL04 EF 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllow")
        TNT1 A 0 A_JumpIfInventory("Clip",2,"ReloadFinishAllow")
        goto Ready

      ReloadFinishAllow:
        OL04 F 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_ALLOWZOOM|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",0,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",2,1)
        goto ReloadFinish
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Clip",2)
        TNT1 A 0 A_GiveInventory("Outlaws_RifleMagazine")
        loop
    }
}

actor SamsaraOutlawsRifleAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_RifleMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Rifle/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(0.2,0.2,-1,50,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(0.2,0.2,-1,50,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
    }
}

actor Outlaws_RifleMagazine : Ammo
{
    Inventory.Amount 12
    Inventory.MaxAmount 12
    Tag "Rifle Magazine"
    +IGNORESKILL
}
