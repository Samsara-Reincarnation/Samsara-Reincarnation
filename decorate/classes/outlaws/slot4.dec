Actor Outlaws_RifleZoomed : TemporaryBoolean {}
Actor Outlaws_Rifle : SamsaraOutlawsWeapon
{
	Weapon.SlotNumber 4
    Weapon.SelectionOrder 500
	Weapon.AmmoType1 "Outlaws_RifleMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Clip"
    Weapon.AmmoGive2 48
    Tag ".44 Winchester"
	States
	{
		Spawn:
			TNT1 A -1
			Stop
		Ready:
			OL04 A 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,"ReadyAlt")
			OL04 A 1 A_WeaponReady(WRF_ALLOWRELOAD)	
			Loop
		ReadyAlt:
			OL04 G 1 A_WeaponReady(WRF_ALLOWRELOAD)	
			Loop

		Deselect:
			TNT1 A 0 A_Lower
			OL04 A 1 A_Lower
			Loop

		Select:
			TNT1 A 0 A_Raise
			OL04 A 1 A_Raise
			Loop
			
		Fire:
			OL04 B 0 A_JumpIfInventory("Outlaws_RifleMagazine",1,1)
			Goto Reload
			OL04 B 0 A_GiveInventory("SamsaraOutlawsRifleAttackHandler")
			OL04 B 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,"FireFinishedZoom")
			Goto FireFinish
		AltFire:
			OL04 G 0 A_JumpIfInventory("Outlaws_RifleZoomed",1,"AltFireUnzoom")
			OL04 G 0 A_ZoomFactor(4)
			OL04 G 0 A_GiveInventory("Outlaws_RifleZoomed")
		ZoomInHold:
			OL04 G 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			OL04 G 0 A_Refire("ZoomInHold")
			Goto Ready
		AltFireUnzoom:
			OL04 G 0 A_ZoomFactor(1)
			OL04 G 0 A_TakeInventory("Outlaws_RifleZoomed")
		ZoomOutHold:
			OL04 G 1 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			OL04 G 0 A_Refire("ZoomOutHold")
			Goto Ready
		FireFinish:
			OL04 BC 4 Bright
			OL04 D 4 A_WeaponReady(WRF_NOFIRE|WRF_NOSWITCH)
			//Semi auto fires faster!
			OL04 A 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 A 0 A_Refire(1)
			Goto Ready
			OL04 A 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 A 0 A_Refire(1)
			Goto Ready
			OL04 A 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 A 0 A_Refire(1)
			Goto Ready
			OL04 A 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready
		FireFinishedZoom:
			OL04 H 4 Bright
			OL04 GG 4
			//Too spammable without this
			OL04 G 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 G 0 A_Refire(1)
			Goto Ready
			OL04 G 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 G 0 A_Refire(1)
			Goto Ready
			OL04 G 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			OL04 G 0 A_Refire(1)
			Goto Ready
			OL04 G 1 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto Ready

		Reload:
			OL04 E 0 A_ZoomFactor(1)
			OL04 E 0 A_TakeInventory("Outlaws_RifleZoomed")
			OL04 E 0 A_JumpIfInventory("Outlaws_RifleMagazine",0,"Ready")
			OL04 E 0 A_JumpIfInventory("Clip",2,1)
			Goto Ready
			OL04 E 0 A_PlaySound("Outlaws/Rifle/Reload",CHAN_5)
			OL04 E 0 A_TakeInventory("Clip",2,TIF_NOTAKEINFINITE)
			OL04 E 0 A_GiveInventory("Outlaws_RifleMagazine")
			OL04 EF 4 A_WeaponReady(WRF_DISABLESWITCH|WRF_NOFIRE)
			Goto ReloadFinish
		//Allow reloading again, here
		ReloadFinish:
			OL04 E 1 A_WeaponReady(WRF_ALLOWRELOAD)
			Goto Ready	
	}
}

actor SamsaraOutlawsRifleAttackHandler : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",2)
        goto PickupAttack
		
	  PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_RifleMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_RifleMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
		TNT1 A 0 A_PlaySound("Outlaws/Rifle/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(0.2,0.2,1,50,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(0.2,0.2,1,50,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        stop
    }
}

actor Outlaws_RifleMagazine : Ammo
{
    Inventory.Amount 12
    Inventory.MaxAmount 12
    Tag "Repeater Magazine"
    +IGNORESKILL
}