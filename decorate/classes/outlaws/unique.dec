actor Outlaws_SheriffsBadge : CustomInventory
{
    Inventory.UseSound ""
    Inventory.Icon "OL11G0"
    Inventory.MaxAmount 3
    Inventory.InterHubAmount 3
    Inventory.RestrictedTo "OutlawsPlayer"
    Tag "Sheriff's Badge"
    +INVBAR
    +UNDROPPABLE
    States
    {
      Use:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraPowerupTimerActiveChecker", 24, 0), "UseFail")
        TNT1 A 0 A_PlaySound("Outlaws/Twirl",CHAN_ITEM)
        TNT1 A 0 A_GiveInventory("OutlawsSheriffsBadgePower")
        TNT1 A 0 A_GiveInventory("OutlawsSheriffsBadgeProtection")
        stop

      UseFail:
        TNT1 A 0
        fail
    }
}

actor OutlawsSheriffsBadgePower : SamsaraPowerupGiver { Powerup.Type "SheriffsBadgePower" }

actor PowerSheriffsBadgePower : PowerDamage
{
    Inventory.Icon "OLBADG01"
    Powerup.Duration -30
    DamageFactor "Normal", 2
}

actor OutlawsSheriffsBadgeProtection : SamsaraPowerupGiver { Powerup.Type "SheriffsBadgeProtection" }

actor PowerSheriffsBadgeProtection : PowerProtection
{
    Powerup.Duration -30
    DamageFactor "Normal", 0.5
}
