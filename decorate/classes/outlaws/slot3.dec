        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_DBSMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Double/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,5,30,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,5,30,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        stop
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDoubleBarrelShotgunFired",1)
        stop
    }
}

actor Outlaws_DBSMagazine : Ammo
{
    Inventory.Amount 2
    Inventory.MaxAmount 2
    Tag "Double Barrel Shotgun Magazine"
    +IGNORESKILL
}
