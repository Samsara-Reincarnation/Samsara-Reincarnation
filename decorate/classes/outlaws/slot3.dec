// Token

actor SamsaraOutlawsLoadoutSlot3 : Boolean {}

// Sawed-Off Shotgun

actor SamsaraOutlawsSawedOffShotgunClickSpamPrevention : Counter {}
actor SamsaraOutlawsSawedOffShotgunFired : Counter { Inventory.MaxAmount 2 }

actor Outlaws_SawedOffShotgun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Sawed-Off Shotgun"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 600
    Weapon.AmmoType1 "Outlaws_SawedMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Shell"
    //Weapon.AmmoGive2 6
    Tag "Sawed-Off Shotgun"
    States
    {
      Spawn:
        OL93 D -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyReloadable")
      ReadyNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto ReadyNonReloadableContinue
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",0,"ReadyNonReloadableNoAmmo")
      ReadyNonReloadableContinue:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReadyNonReloadableAmmo")
        goto ReadyNonReloadableNoAmmo

      ReadyNonReloadableNoAmmo:
        OL03 A 1 A_WeaponReady
        goto ReadyNoAmmoCheck

      ReadyNonReloadableAmmo:
        OL03 A 1 A_WeaponReady
        goto Ready

      ReadyReloadable:
        goto ReadyReloadableAllowReload

      ReadyReloadableDisallowReload:
        OL03 A 1 A_WeaponReady
        goto Ready

      ReadyReloadableAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",0,"ReadyReloadableDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReadyReloadableDisallowReload
        OL03 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      ReadyNoAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",0,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_Lower
        OL03 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_Raise
        OL03 A 1 A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireDry
        // loading the second shell with 1 shell will feel a little weird, but it's something
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Shell",2,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",2,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsSawedOffShotgunClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsSawedOffAttackHandler")
        goto FireContinue

      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
      AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireDry
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",0,"Reload")
        goto AltFireWaterCheck

      AltFireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",1,"AltFireWaterCheck")
      AltFireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto FireDry

      AltFireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto AltFireStart

      AltFireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsSawedOffAltAttackHandler")
        goto FireContinue

      FireContinue:
        OL03 BC 4 Bright
        OL03 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Too spammable without this
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL03 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinish

      FireFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Ready")
        goto ReadyNoAmmoCheck

      Reload:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsSawedOffShotgunFired",1)
      ReloadFinishNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",1,1)
        goto ReloadFinishFullNonReloadable
        OL03 E 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullNonReloadable:
        OL03 F 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishReloadable:
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",0,"ReloadFinishFullReloadable")
        OL03 E 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullReloadable:
        OL03 F 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadFinishAllowCheckReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,"ReloadFinishAllowCheckNonReloadable")
        goto Ready

      ReloadFinishAllowCheckNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsSawedOffShotgunFired",1,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowNonReloadable")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadFinishAllowNonReloadable")
        goto Ready

      ReloadFinishAllowNonReloadable:
        OL03 E 1 A_WeaponReady(WRF_NOBOB)
        goto Ready

      ReloadFinishAllowCheckReloadable:
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowReloadable")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadFinishAllowReloadable")
        goto Ready

      ReloadFinishAllowReloadable:
        OL03 E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",0,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinishReloadable
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("Outlaws_SawedMagazine")
        loop
    }
}

actor SamsaraOutlawsSawedOffAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_SawedMagazine",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Sawed/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,30,10,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,30,10,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        stop
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsSawedOffShotgunFired",2)
        stop
    }
}

actor SamsaraOutlawsSawedOffAltAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_SawedMagazine",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_SawedMagazine",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Double/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,15,10,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,15,10,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        stop
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsSawedOffShotgunFired",1)
        stop
    }
}

actor Outlaws_SawedMagazine : Ammo
{
    Inventory.Amount 2
    Inventory.MaxAmount 2
    Tag "Sawed-Off Shotgun Magazine"
    +IGNORESKILL
}

// Double Barrel Shotgun

actor SamsaraOutlawsDoubleBarrelShotgunClickSpamPrevention : Counter {}
actor SamsaraOutlawsDoubleBarrelShotgunFired : Counter { Inventory.MaxAmount 2 }

actor Outlaws_DoubleBarrelShotgun : SamsaraOutlawsWeapon
{
    Inventory.PickupMessage "Double Barrel Shotgun"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 600
    Weapon.AmmoType1 "Outlaws_DBSMagazine"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "Shell"
    //Weapon.AmmoGive2 6
    Tag "Double Barrel Shotgun"
    States
    {
      Spawn:
        OL93 C -1
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("Outlaws_Reloading")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReadyReloadable")
      ReadyNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto ReadyNonReloadableContinue
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",0,"ReadyNonReloadableNoAmmo")
      ReadyNonReloadableContinue:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyNonReloadableAmmo")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReadyNonReloadableAmmo")
        goto ReadyNonReloadableNoAmmo

      ReadyNonReloadableNoAmmo:
        OL02 A 1 A_WeaponReady
        goto ReadyNoAmmoCheck

      ReadyNonReloadableAmmo:
        OL02 A 1 A_WeaponReady
        goto Ready

      ReadyReloadable:
        goto ReadyReloadableAllowReload

      ReadyReloadableDisallowReload:
        OL02 A 1 A_WeaponReady
        goto Ready

      ReadyReloadableAllowReload:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",0,"ReadyReloadableDisallowReload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReadyReloadableDisallowReload
        OL02 A 1 A_WeaponReady(WRF_ALLOWRELOAD)
        goto Ready

      ReadyNoAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",0,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto Ready

      Deselect:
        TNT1 A 0 A_GiveInventory("Outlaws_SwitchWeapon")
      DeselectLoop:
        TNT1 A 0 A_Lower
        OL02 A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("Outlaws_SwitchWeapon")
      SelectLoop:
        TNT1 A 0 A_Raise
        OL02 A 1 A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadable")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireDry
        // loading the second shell with 1 shell will feel a little weird, but it's something
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Shell",2,"FireWaterCheck")
        goto FireDry

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",2,"FireWaterCheck")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto FireDry

      FireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"FireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto FireStart

      FireDry:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunClickSpamPrevention",1,"Ready")
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Empty",CHAN_5)
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDoubleBarrelShotgunClickSpamPrevention",4)
        goto Ready

      FireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDBSAttackHandler")
        goto FireContinue

      AltFire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"AltFireReloadable")
      AltFireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto FireDry
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",0,"Reload")
        goto AltFireWaterCheck

      AltFireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"AltFireWaterCheck")
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",1,"AltFireWaterCheck")
      AltFireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"Reload")
        goto FireDry

      AltFireWaterCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",1,"AltFireStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"FireDry")
        goto AltFireStart

      AltFireStart:
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDBSAltAttackHandler")
        goto FireContinue

      FireContinue:
        OL02 BC 4 Bright
        OL02 D 4 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        //Too spammable without this
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        TNT1 A 0 A_ReFire(1)
        goto FireFinish
        OL02 A 1 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinish

      FireFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"Ready")
        goto ReadyNoAmmoCheck

      Reload:
        TNT1 A 0 A_GiveInventory("Outlaws_Reloading")
        TNT1 A 0 A_PlaySound("Outlaws/Shotgun/Reload",CHAN_5)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadAmmo")
        TNT1 A 0 A_TakeInventory("SamsaraOutlawsDoubleBarrelShotgunFired",1)
      ReloadFinishNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",1,1)
        goto ReloadFinishFullNonReloadable
        OL02 E 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullNonReloadable:
        OL02 F 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishReloadable:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",0,"ReloadFinishFullReloadable")
        OL02 E 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      ReloadFinishFullReloadable:
        OL02 F 8 A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE|WRF_NOBOB)
        goto ReloadFinishAllowCheck

      //Allow reloading again, here
      ReloadFinishAllowCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"ReloadFinishAllowCheckReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,"ReloadFinishAllowCheckNonReloadable")
        goto Ready

      ReloadFinishAllowCheckNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraOutlawsDoubleBarrelShotgunFired",1,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowNonReloadable")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadFinishAllowNonReloadable")
        goto Ready

      ReloadFinishAllowNonReloadable:
        OL02 E 1 A_WeaponReady(WRF_NOBOB)
        goto Ready

      ReloadFinishAllowCheckReloadable:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReloadFinishAllowReloadable")
        TNT1 A 0 A_JumpIfInventory("Shell",1,"ReloadFinishAllowReloadable")
        goto Ready

      ReloadFinishAllowReloadable:
        OL02 E 1 A_WeaponReady(WRF_ALLOWRELOAD|WRF_NOBOB)
        goto Ready

      ReloadAmmo:
        TNT1 A 0 A_TakeInventory("SamsaraReloadCalcs") // reset
      ReloadAmmoCalc:
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",0,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadCalcs",1,"ReloadFinishReloadable")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Shell",1,1)
        goto ReloadFinishReloadable
        TNT1 A 0 A_GiveInventory("SamsaraReloadCalcs")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Shell",1)
        TNT1 A 0 A_GiveInventory("Outlaws_DBSMagazine")
        loop
    }
}

actor SamsaraOutlawsDBSAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Shell",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Shell",2)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Outlaws_DBSMagazine",2,1)
        stop
        TNT1 A 0 A_TakeInventory("Outlaws_DBSMagazine",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("Outlaws/Double/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireBullets(2,2,10,30,"OutlawsPuff",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireBullets(2,2,10,30,"OutlawsPuffCoop",FBF_NOFLASH|FBF_NORANDOM|FBF_NORANDOMPUFFZ)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",1,1)
        stop
        TNT1 A 0 A_GiveInventory("SamsaraOutlawsDoubleBarrelShotgunFired",2)
        stop
    }
}

actor SamsaraOutlawsDBSAltAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
