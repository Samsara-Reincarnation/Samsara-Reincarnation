// Powered

actor Hexen_FSpearSpiker : Hexen_FSpearFX2
{
    SeeSound "Hexen/SpearThrow"
    DeathSound "Hexen/SpearHit"
    +HITTRACER
    +NODAMAGETHRUST
    States
    {
      Spawn:
        H101 S 1 Bright Light("CSPEARPROJECTILE1") A_SpawnItemEx("Hexen_FSpearSpikerFX",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
        loop

      Death:
        TNT1 A 0 A_CheckFloor("XDeath")
        goto Super::Death

      XDeath:
        TNT1 A 0 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION)
        TNT1 A 0 A_SpawnItemEx("Hexen_SpearSpike",0,0,0,0,0,-8192,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
        goto Super::Death
    }
}

actor Hexen_FSpearSpikerCoop : Hexen_FSpearSpiker
{
    Species "Player"
    +THRUSPECIES
    States
    {
      XDeath:
        TNT1 A 0 A_Warp(AAPTR_TRACER,0,0,0,0,WARPF_NOCHECKPOSITION)
        TNT1 A 0 A_SpawnItemEx("Hexen_SpearSpikeCoop",0,0,0,0,0,-8192,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS)
        goto Hexen_FSpearFX2::Death
    }
}

