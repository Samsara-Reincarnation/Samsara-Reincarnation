// Powered

//I feel it's a little neater this way, especially since this attack has nothing in common with the regular
actor SamsaraHexenFrostShardsPoweredAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenFrostShardsPoweredFiredCount",0,2)
        TNT1 A 0 A_GiveInventory("SamsaraHexenFrostShardsPoweredFiredCount")
        goto PickupAttack
        TNT1 A 0 A_TakeInventory("Clip",1)
        TNT1 A 0 A_TakeInventory("SamsaraHexenFrostShardsPoweredFiredCount")
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("IceGuyAttack",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 AAA 0 A_FireCustomMissile("FrostMissileDM",frandom(-6,6),false,0,frandom(-4,8))
        stop

      PickupAttackCoop:
        TNT1 AAA 0 A_FireCustomMissile("FrostMissile2",frandom(-6,6),false,0,frandom(-4,8))
        stop
    }
}

// Baratus

actor "Javelin of Zeal" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Javelin of Zeal"
    Weapon.SlotNumber 2
    Weapon.SelectionOrder 1700
    Weapon.YAdjust 20
    Weapon.AmmoType "Clip"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT2"
    Tag "Javelin of Zeal"
    +AMMO_OPTIONAL
    +BLOODSPLATTER
    +NOALERT
    States
    {
      Spawn:
        H102 Q -1 Bright
        stop

      Ready:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        H101 A 1 A_WeaponReady
        goto Ready

      ReadyAmmo:
        H101 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 D 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 D 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 D 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 D 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 D 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        H101 C 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectNoAmmo:
        H101 A 1 A_Lower
        goto Deselect

      DeselectAmmo:
        H101 B 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"SelectAmmo")
        goto SelectNoAmmo

      SelectNoAmmo:
        H101 A 1 A_Raise
        goto Select

      SelectAmmo:
        H101 B 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_JumpIfCloser(128,"FireMelee")
        goto FireRanged

      FireMelee:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireMeleeAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireMeleeAmmo")
        goto FireMeleeNoAmmo

      FireMeleeNoAmmo:
        H101 A 2 Offset(-32,34)
        H101 A 2 Offset(-64,38)
        goto FireMeleeContinue

      FireMeleeAmmo:
        H101 B 2 Bright Offset(-32,34)
        H101 B 2 Bright Offset(-64,38)
        goto FireMeleeContinue

      FireMeleeContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenJavelinOfZealMeleeAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireMeleeFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireMeleeFinishAmmo")
        goto FireMeleeFinishNoAmmo

      FireMeleeFinishNoAmmo:
        H101 A 2 Offset(-96,42)
        H101 A 2 Offset(-64,38)
        H101 A 2 Offset(-32,34)
        H101 "[" 8 Offset(-32,32) // offset hack via TEXTURES since 0 in either position (especially X) implies the default
        goto Ready

      FireMeleeFinishAmmo:
        H101 B 2 Bright Offset(-96,42)
        H101 B 2 Bright Offset(-64,38)
        H101 B 2 Bright Offset(-32,34)
        H101 "\" 8 Bright Offset(-32,32) // offset hack via TEXTURES since 0 in either position (especially X) implies the default
        goto Ready

      FireRanged:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireRangedAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireRangedAmmo")
        goto FireRangedNoAmmo

      FireRangedNoAmmo:
        H201 UV 4
        H201 WX 3
        H201 Y 2 A_PlaySound("FighterHammerMiss",CHAN_WEAPON)
        goto FireRangedContinue

      FireRangedAmmo:
        H101 EF 4 Bright
        H101 GH 3 Bright
        H101 I 2 Bright A_PlaySound("FighterHammerMiss",CHAN_WEAPON)
        goto FireRangedContinue

      FireRangedContinue:
        H101 J 2 A_GiveInventory("SamsaraHexenJavelinOfZealRangedAttackHandler")
        H101 KLM 2
        TNT1 A 18
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireRangedFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireRangedFinishAmmo")
        goto FireRangedFinishNoAmmo

      FireRangedFinishNoAmmo:
        H101 A 3 Offset(0,92)
        H101 A 3 Offset(0,72)
        H101 A 3 Offset(0,52)
        goto Ready

      FireRangedFinishAmmo:
        H101 B 3 Bright Offset(0,92)
        H101 B 3 Bright Offset(0,72)
        H101 B 3 Bright Offset(0,52)
        goto Ready
    }
}

// Melee

actor SamsaraHexenJavelinOfZealMeleeAttackHandler : Trigger
{
    States
    {
      // Ammo checking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"PickupAttack")
        goto PickupAttackWeak

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackStrongPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackStrongPowered")
        goto PickupAttackStrongUnpowered

      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackWeakCoop")
      PickupAttackWeakDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackWeakDMSpread")
        TNT1 A 0 A_CustomPunch(random(24,48),true,0,"HexenSpearPuff",128)
        stop

      PickupAttackWeakDMSpread:
        TNT1 A 0 A_CustomPunch(random(24,48)*3,true,0,"HexenSpearPuff",128)
        stop

      PickupAttackWeakCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackWeakCoopSpread")
        TNT1 A 0 A_CustomPunch(random(24,48),true,0,"HexenSpearPuffCoop",128)
        stop

      PickupAttackWeakCoopSpread:
        TNT1 A 0 A_CustomPunch(random(24,48)*3,true,0,"HexenSpearPuffCoop",128)
        stop

      // Strong
      // Unpowered
      PickupAttackStrongUnpowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrongUnpoweredInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongUnpoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongUnpoweredCoop")
      PickupAttackStrongUnpoweredDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongUnpoweredDMSpread")
        TNT1 A 0 A_CustomPunch(random(48,96),true,0,"HexenSpearPuffGlow",128)
        stop

      PickupAttackStrongUnpoweredDMSpread:
        TNT1 A 0 A_CustomPunch(random(48,96)*3,true,0,"HexenSpearPuffGlow",128)
        stop

      PickupAttackStrongUnpoweredCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongUnpoweredCoopSpread")
        TNT1 A 0 A_CustomPunch(random(48,96),true,0,"HexenSpearPuffGlowCoop",128)
        stop

      PickupAttackStrongUnpoweredCoopSpread:
        TNT1 A 0 A_CustomPunch(random(48,96)*3,true,0,"HexenSpearPuffGlowCoop",128)
        stop

      PickupAttackStrongUnpoweredInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongUnpoweredInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongUnpoweredInfiniteCoop")
      PickupAttackStrongUnpoweredInfiniteDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongUnpoweredInfiniteDMSpread")
        TNT1 A 0 A_CustomPunch(random(48,96),true,0,"HexenSpearPuffGlowInfinite",128)
        stop

      PickupAttackStrongUnpoweredInfiniteDMSpread:
        TNT1 A 0 A_CustomPunch(random(48,96)*3,true,0,"HexenSpearPuffGlowInfinite",128)
        stop

      PickupAttackStrongUnpoweredInfiniteCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongUnpoweredInfiniteCoopSpread")
        TNT1 A 0 A_CustomPunch(random(48,96),true,0,"HexenSpearPuffGlowInfiniteCoop",128)
        stop

      PickupAttackStrongUnpoweredInfiniteCoopSpread:
        TNT1 A 0 A_CustomPunch(random(48,96)*3,true,0,"HexenSpearPuffGlowInfiniteCoop",128)
        stop

      // Powered
      PickupAttackStrongPowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrongPoweredInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongPoweredCoop")
      PickupAttackStrongPoweredDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongPoweredDMSpread")
        TNT1 A 0 A_CustomPunch(random(96,144),true,0,"HexenSpearPuffGlow",128)
        stop

      PickupAttackStrongPoweredDMSpread:
        TNT1 A 0 A_CustomPunch(random(96,144)*3,true,0,"HexenSpearPuffGlow",128)
        stop

      PickupAttackStrongPoweredCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongPoweredCoopSpread")
        TNT1 A 0 A_CustomPunch(random(96,144),true,0,"HexenSpearPuffGlowCoop",128)
        stop

      PickupAttackStrongPoweredCoopSpread:
        TNT1 A 0 A_CustomPunch(random(96,144)*3,true,0,"HexenSpearPuffGlowCoop",128)
        stop

      PickupAttackStrongPoweredInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongPoweredInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongPoweredInfiniteCoop")
      PickupAttackStrongPoweredInfiniteDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongPoweredInfiniteDMSpread")
        TNT1 A 0 A_CustomPunch(random(96,144),true,0,"HexenSpearPuffGlowInfinite",128)
        stop

      PickupAttackStrongPoweredInfiniteDMSpread:
        TNT1 A 0 A_CustomPunch(random(96,144)*3,true,0,"HexenSpearPuffGlowInfinite",128)
        stop

      PickupAttackStrongPoweredInfiniteCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongPoweredInfiniteCoopSpread")
        TNT1 A 0 A_CustomPunch(random(96,144),true,0,"HexenSpearPuffGlowInfiniteCoop",128)
        stop

      PickupAttackStrongPoweredInfiniteCoopSpread:
        TNT1 A 0 A_CustomPunch(random(96,144)*3,true,0,"HexenSpearPuffGlowInfiniteCoop",128)
        stop
    }
}

