actor Hexen_SpearSpikeGravitySwitchTracker : Boolean {}

actor Hexen_SpearSpikeGravitySwitchOn : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIfInventory("Hexen_SpearSpikeGravitySwitchTracker",1,1)
        stop
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_TakeInventory("Hexen_SpearSpikeGravitySwitchTracker")
        stop
    }
}

actor Hexen_SpearSpikeGravitySwitchOff : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_CheckFlag("NOGRAVITY",1)
        stop
        TNT1 A 0 A_Gravity
        TNT1 A 0 A_GiveInventory("Hexen_SpearSpikeGravitySwitchTracker")
        stop
    }
}

actor Hexen_SpearSpike
{
    Radius 16
    Height 64
    DamageType "HexenJavelinSpike"
    Mass 10000000
    +MISSILE
    +NODAMAGETHRUST
    +THRUACTORS
    States
    {
      Spawn:
      Death:
        TSPK E 0 NoDelay A_SetSolid
        TNT1 A 0 A_SpawnItemEx("HexenDirtClump")
        TNT1 A 0 A_JumpIfTracerCloser(512,1)
        goto SpawnFinish
        TNT1 A 0 A_GiveInventory("Hexen_SpearSpikeGravitySwitchOff",1,AAPTR_TRACER)
        TSPK E 2 A_JumpIfTracerCloser(48,"SpawnFinish")
        wait

      SpawnFinish:
        TNT1 A 0 A_GiveInventory("Hexen_SpearSpikeGravitySwitchOn",1,AAPTR_TRACER)
        TNT1 A 0 A_PlaySound("Hexen/Spike3",CHAN_VOICE)
        TSPK EFGHIJKLMN 3 A_Explode(30,32,0) //We only really need to hurt enemies here
        TSPK A 3 A_PlaySound("Hexen/Spike2")
        TSPK NMLKJIHGFE 3
        stop
    }
}

actor Hexen_SpearSpikeCoop : Hexen_SpearSpike
{
    Species "Player"
    +THRUSPECIES
}

actor HexenDirtClump : DirtClump
{
    States
    {
      Spawn:
        TSPK C 200
        TSPK C 2 A_FadeOut
        wait
    }
}
