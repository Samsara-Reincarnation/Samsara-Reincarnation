// Strong

actor HexenSpearPuffGlow : AxePuffGlow
{
    DamageType "TimonsAxe"
    +PUFFGETSOWNER
    States
    {
      Spawn:
      Crash:
        H101 TU 4 Bright Light("CSPEARPUFF1")
        H101 VW 4 Bright Light("CSPEARPUFF2")
        H101 XYZ 4 Bright Light("CSPEARPUFF3")
        stop

      Melee:
        TNT1 A 0 A_TakeInventory("Clip",3,0,AAPTR_TARGET)
        goto Spawn
    }
}

actor HexenSpearPuffGlowCoop : HexenSpearPuffGlow { +MTHRUSPECIES }

actor HexenSpearPuffGlowInfinite : HexenSpearPuffGlow
{
    States
    {
      Melee:
        goto Spawn
    }
}

actor HexenSpearPuffGlowInfiniteCoop : HexenSpearPuffGlowInfinite { +MTHRUSPECIES }

// Ranged

actor SamsaraHexenJavelinOfZealRangedAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrong")
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto PickupAttackWeak
        TNT1 A 0 A_TakeInventory("Clip",3)
        goto PickupAttackStrong

      // Attack stuff
      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackWeakCoop")
      PickupAttackWeakDM:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearFX1",0,false,8,16)
        stop

      PickupAttackWeakCoop:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearFX1Coop",0,false,8,16)
        stop

      // Strong
      PickupAttackStrong:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackStrongPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackStrongPowered")
      // Unpowered
      PickupAttackStrongUnpowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongUnpoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongUnpoweredCoop")
      PickupAttackStrongUnpoweredDM:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearFX2",0,false,8,16)
        stop

      PickupAttackStrongUnpoweredCoop:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearFX2Coop",0,false,8,16)
        stop

      // Powered
      PickupAttackStrongPowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongPoweredCoop")
      PickupAttackStrongPoweredDM:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearSpiker",0,false,8,16)
        stop

      PickupAttackStrongPoweredCoop:
        TNT1 A 0 A_FireCustomMissile("Hexen_FSpearSpikerCoop",0,false,8,16)
        stop
    }
}

