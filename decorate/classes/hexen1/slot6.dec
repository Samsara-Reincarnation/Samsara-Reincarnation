    Obituary "$SAMSARA_HEXEN_OB_SLOT6"
    +BLOODSPLATTER
    States
    {
      Death:
        CFCF QR 3 Bright
        TNT1 A 0 A_Explode(5,20,0)
      DeathFinish:
        CFCF STUVWXYZ 3 Bright
        stop
    }
}

