// Baratus

actor SamsaraHexenQuickspellGauntletsMeleeHitCount : Counter { Inventory.MaxAmount 2 }
actor SamsaraHexenQuickspellGauntletsMeleeAmmoTaken : Boolean {} // for spread rune
actor SamsaraHexenQuickspellGauntletsRangedFrame : Boolean {}

actor "Quickspell Gauntlets" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Quickspell Gauntlets"
    Weapon.SlotNumber 6
    Weapon.SelectionOrder 1000
    Weapon.YAdjust 10
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 1
    Decal "HexenGauntletPlasmaLightning"
    Obituary "$SAMSARA_HEXEN_OB_SLOT6"
    Tag "Quickspell Gauntlets"
    States
    {
      Spawn:
        H102 R -1 Bright
        stop

      Ready:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        H105 E 1 A_WeaponReady
        goto Ready

      ReadyAmmo:
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto Ready
        H105 H 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectNoAmmo:
        H105 E 1 A_Lower
        goto Deselect

      DeselectAmmo:
        H105 F 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"SelectAmmo")
        goto SelectNoAmmo

      SelectNoAmmo:
        H105 E 1 A_Raise
        goto Select

      SelectAmmo:
        H105 F 1 Bright A_Raise
        goto Select

      // Unpowered
      Fire:
        H105 F 2 Bright A_PlaySound("heretic/gauntletsactivate")
        H105 I 5 Bright
      Hold:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,3)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,2)
        TNT1 A 0 A_JumpIfCloser(65,"HoldMelee") // skipped if powered
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"HoldRanged")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"HoldRanged")
      HoldMelee:
        H106 IJK 4 Bright A_GiveInventory("SamsaraHexenQuickspellGauntletsMeleeAttackHandler")
        goto HoldFinishAmmoCheckUnpowered

      HoldRanged:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"HoldRangedPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"HoldRangedPowered")
      HoldRangedUnpowered:
        H105 J 2 Bright
        H120 G 2 Bright
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsRangedFrame",1,"HoldRangedUnpoweredRight")
      HoldRangedUnpoweredLeft:
        H105 Y 2 Bright A_GiveInventory("SamsaraHexenQuickspellGauntletsRangedAttackHandler")
        H120 W 2 Bright
        goto HoldFinishAmmoCheckUnpowered

      HoldRangedUnpoweredRight:
        H105 Z 2 Bright A_GiveInventory("SamsaraHexenQuickspellGauntletsRangedAttackHandler")
        H120 P 2 Bright
        goto HoldFinishAmmoCheckUnpowered

      HoldFinishAmmoCheckUnpowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"HoldFinishUnpowered")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"HoldFinishUnpowered")
        TNT1 A 0 A_Light0 // basically switching weapons at this point
        goto HoldFinishUnpowered

      HoldFinishUnpowered:
        H105 J 4 Bright A_ReFire
        H105 I 3 Bright A_Light0
        goto Ready

      // Powered
      HoldRangedPowered:
        H105 J 2 Bright
        H120 G 2 Bright
        goto HoldRangedLoopPowered

      HoldRangedLoopInitPowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"HoldRangedLoopPowered")
        TNT1 A 0 A_JumpIfInventory("Cell",2,"HoldRangedLoopPowered")
        goto HoldMelee

      HoldRangedLoopPowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsRangedFrame",1,"HoldRangedLoopPoweredRight")
      HoldRangedLoopPoweredLeft:
        H105 Y 2 Bright A_GiveInventory("SamsaraHexenQuickspellGauntletsRangedPoweredAttackHandler")
        H120 W 2 Bright
        goto HoldFinishAmmoCheckPowered

      HoldRangedLoopPoweredRight:
        H105 Z 2 Bright A_GiveInventory("SamsaraHexenQuickspellGauntletsRangedPoweredAttackHandler")
        H120 P 2 Bright
        goto HoldFinishAmmoCheckPowered

      HoldFinishAmmoCheckPowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"HoldFinishPowered")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"HoldFinishPowered")
        TNT1 A 0 A_Light0 // basically switching weapons at this point
        goto HoldFinishPowered

      HoldFinishPowered:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,1)
        goto HoldFinishUnpowered
        H105 J 4 Bright A_ReFire("HoldRangedLoopInitPowered")
        H105 I 3 Bright A_Light0
        goto Ready
    }
}

// Melee

actor SamsaraHexenQuickspellGauntletsMeleeAttackHandler : Trigger
{
    States
    {
      // Initializing stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraHexenQuickspellGauntletsMeleeAmmoTaken")
        goto PickupAmmoCheck

      // Ammo checking stuff
      PickupAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"PickupAttack")
        stop

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_Saw("heretic/gauntletson","heretic/gauntletshit",4,"HexenGauntletPlasmaSpark",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0,0,1)
        TNT1 A 0 A_Saw("","",4,"HexenGauntletPlasmaSparkInfinite",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_Saw("heretic/gauntletson","heretic/gauntletshit",4,"HexenGauntletPlasmaSparkCoop",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0,0,1)
        TNT1 A 0 A_Saw("","",4,"HexenGauntletPlasmaSparkInfiniteCoop",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0)
        stop

      PickupAttackInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackInfiniteCoop")
      PickupAttackInfiniteDM:
        TNT1 A 0 A_Saw("heretic/gauntletson","heretic/gauntletshit",4,"HexenGauntletPlasmaSparkInfinite",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0,0,1)
        TNT1 A 0 A_Saw("","",4,"HexenGauntletPlasmaSparkInfinite",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0)
        stop

      PickupAttackInfiniteCoop:
        TNT1 A 0 A_Saw("heretic/gauntletson","heretic/gauntletshit",4,"HexenGauntletPlasmaSparkInfiniteCoop",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0,0,1)
        TNT1 A 0 A_Saw("","",4,"HexenGauntletPlasmaSparkInfiniteCoop",SF_RANDOMLIGHTHIT|SF_NOUSEAMMO,65,0)
        stop
    }
}

actor HexenGauntletPlasmaSpark : GauntletPuff1
{
    VSpeed 0
    RenderStyle "Add"
    Alpha 1
    +CANNOTPUSH // trail
    +NODECAL // don't let A_Saw spawn the decals meant for the powered ranged attack
    +NOTELEPORT // trail
    +NOTIMEFREEZE
    +PUFFGETSOWNER
    States
    {
      Spawn:
      Melee:
      XDeath:
        H105 P 0 Bright Light("FGAUNTLETPLASMASPARK_X1") NoDelay A_JumpIfInventory("SamsaraHexenQuickspellGauntletsMeleeAmmoTaken",1,"Crash",AAPTR_TARGET)
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsMeleeHitCount",0,2,AAPTR_TARGET)
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuickspellGauntletsMeleeHitCount",1,AAPTR_TARGET)
        goto AmmoTaken
        TNT1 A 0 A_TakeInventory("Cell",1,0,AAPTR_TARGET)
        TNT1 A 0 A_TakeInventory("SamsaraHexenQuickspellGauntletsMeleeHitCount",0x7FFFFFFF,0,AAPTR_TARGET)
        goto AmmoTaken

      AmmoTaken:
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuickspellGauntletsMeleeAmmoTaken",1,AAPTR_TARGET)
        goto Crash

      Crash:
        H105 P 12 Bright Light("FGAUNTLETPLASMASPARK_X1") A_ChangeFlag("NOTIMEFREEZE",false)
        H105 Q 12 Bright Light("FGAUNTLETPLASMASPARK_X1")
        H105 R 12 Bright Light("FGAUNTLETPLASMASPARK_X2")
        stop
    }
}

actor HexenGauntletPlasmaSparkCoop : HexenGauntletPlasmaSpark { +MTHRUSPECIES }

actor HexenGauntletPlasmaSparkInfinite : HexenGauntletPlasmaSpark // also melee supplement and ranged projectile's trail
{
    States
    {
      Spawn:
      Melee:
      XDeath:
        goto Crash
    }
}

actor HexenGauntletPlasmaSparkInfiniteCoop : HexenGauntletPlasmaSparkInfinite { +MTHRUSPECIES }

// Ranged

// Unpowered

actor SamsaraHexenQuickspellGauntletsRangedAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        goto PickupFinish
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("hexen/weapons/gauntletlightning",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsRangedFrame",1,"PickupAttackRight")
      // Left
      PickupAttackLeft:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackLeftCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackLeftCoop")
      PickupAttackLeftDM:
        TNT1 A 0 A_FireCustomMissile("HexenGauntletPlasma",random(-5,5),false,-5)
        goto PickupFinishLeft

      PickupAttackLeftCoop:
        TNT1 A 0 A_FireCustomMissile("HexenGauntletPlasmaCoop",random(-5,5),false,-5)
        goto PickupFinishLeft

      // Right
      PickupAttackRight:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackRightCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackRightCoop")
      PickupAttackRightDM:
        TNT1 A 0 A_FireCustomMissile("HexenGauntletPlasma",random(-5,5),false,5)
        goto PickupFinishRight

      PickupAttackRightCoop:
        TNT1 A 0 A_FireCustomMissile("HexenGauntletPlasmaCoop",random(-5,5),false,5)
        goto PickupFinishRight

      // Finishing stuff
      PickupFinish: // called when trying to fire when out of ammo
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsRangedFrame",1,"PickupFinishRight")
      // Left
      PickupFinishLeft:
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuickspellGauntletsRangedFrame")
        stop

      // Right
      PickupFinishRight:
        TNT1 A 0 A_TakeInventory("SamsaraHexenQuickspellGauntletsRangedFrame")
        stop
    }
}

actor HexenGauntletPlasma
{
    Projectile
    Radius 5
    Height 6
    Speed 20
    Damage 6
    RenderStyle "Add"
    DeathSound "hexen/weapons/gauntlethit"
    Decal "HexenGauntletPlasmaLightning"
    //Obituary "%o was killed by %k."
    -ACTIVATEIMPACT
    -ACTIVATEPCROSS
    +BLOODSPLATTER
    States
    {
      Spawn:
        H105 MNO 3 Bright Light("FGAUNTLETPLASMA") A_SpawnItemEx("HexenGauntletPlasmaSparkInfinite",0,0,0,random(-2,2),random(-2,2),random(1,2))
        loop

      Death:
        H105 S 5 Bright Light("FGAUNTLETPLASMA_X1") A_Explode(15,112,0)
        H105 T 5 Bright Light("FGAUNTLETPLASMA_X2")
        H105 U 5 Bright Light("FGAUNTLETPLASMA_X3")
        H105 V 5 Bright Light("FGAUNTLETPLASMA_X4")
        H105 WX 5 Bright Light("FGAUNTLETPLASMA_X5")
        stop
    }
}

actor HexenGauntletPlasmaCoop : HexenGauntletPlasma
{
    Species "Player"
    +THRUSPECIES
}

// Powered

actor SamsaraHexenQuickspellGauntletsRangedPoweredAttackHandler : SamsaraHexenQuickspellGauntletsRangedAttackHandler
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",2,1)
        goto PickupFinish
        TNT1 A 0 A_TakeInventory("Cell",2)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("hexen/weapons/gauntletlightning",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuickspellGauntletsRangedFrame",1,"PickupAttackRight")
      // Left
      PickupAttackLeft:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackLeftCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackLeftCoop")
      PickupAttackLeftDM:
        TNT1 A 0 A_RailAttack(30,-8,false,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|32,8.0,"HexenGauntletLightningPuff",2,2,2048,17,20.0,0.1,"HexenGauntletLightningParticle",5)
        goto PickupFinishLeft

      PickupAttackLeftCoop:
        TNT1 A 0 A_RailAttack(30,-8,false,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|32,8.0,"HexenGauntletLightningPuffCoop",2,2,2048,17,20.0,0.1,"HexenGauntletLightningParticle",5)
        goto PickupFinishLeft

      // Right
      PickupAttackRight:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackRightCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackRightCoop")
      PickupAttackRightDM:
        TNT1 A 0 A_RailAttack(30,8,false,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|32,8.0,"HexenGauntletLightningPuff",2,2,2048,17,20.0,0.1,"HexenGauntletLightningParticle",5)
        goto PickupFinishRight

      PickupAttackRightCoop:
        TNT1 A 0 A_RailAttack(30,8,false,"None","None",RGF_SILENT|RGF_NOPIERCING|RGF_FULLBRIGHT|32,8.0,"HexenGauntletLightningPuffCoop",2,2,2048,17,20.0,0.1,"HexenGauntletLightningParticle",5)
        goto PickupFinishRight
    }
}

