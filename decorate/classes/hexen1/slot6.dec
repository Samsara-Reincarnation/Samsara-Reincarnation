        TNT1 A 0 A_Explode(32,64,0)
        goto DeathFinish
    }
}

Actor HexenFireStormVolcanoProjectile
{
	Projectile
	Height 16
	Radius 8
	Speed 32
	Gravity 0.5
	Damage (50*random(1,2))
	DamageType "FireExplosive"
	DeathSound "hexen/volcanofireblast"
	+BLOODLESSIMPACT
	-NOGRAVITY
	States
	{
		Spawn:
			H138 ABCD 3 Bright Light("CFLAME1") A_SpawnItemEx("HammerMissileTrail") //We can probably reuse this
			Loop
		Death:
			MSP1 G 0 A_Stop
			MSP1 G 0 A_NoGravity
			MSP1 G 0 A_Explode(100,128)
			MSP1 G 0 A_JumpIf(abs(z - floorz) <= 48, "SpawnVolcano")
			MSP1 G 0 A_CheckFloor("SpawnVolcano")
		VolcanoBlast:
			MSP1 GHIJKLMNOP 3 Bright Light("BSBALL")
			Stop
		SpawnVolcano:
			MSP1 G 0 A_SpawnItemEx("HexenFireStormVolcano",0,0,floorz,0,0,0,0,SXF_TRANSFERPOINTERS)
			Goto VolcanoBlast
	}
}

Actor HexenFireStormVolcanoProjectileCoop : HexenFireStormVolcanoProjectile
{
	Species "Player"
    +THRUSPECIES
	States
	{
		SpawnVolcano:
			MSP1 G 0 A_SpawnItemEx("HexenFireStormVolcanoCoop",0,0,floorz,0,0,0,0,SXF_TRANSFERPOINTERS)
			Goto VolcanoBlast
	}
}

Actor HexenFireStormVolcano
{
	Projectile
	Height 24
	Radius 24
	Speed 0
	ReactionTime 64
	+THRUACTORS
	+NOEXPLODEFLOOR
	-NOGRAVITY
	States
	{
		Spawn:
			TNT1 A 0 NoDelay A_RadiusThrust(50,64,RTF_AFFECTSOURCE|RTF_NOIMPACTDAMAGE|8) //It's bullshit that THRUSTZ isn't added in Zandronum, yet
			H137 T 0 A_PlaySound("Hexen/Spike2",CHAN_VOICE)
			H137 T 0 A_SpawnItemEx("HexenVolcanoDirtClump",-12,12,0)
			H137 T 0 A_SpawnItemEx("HexenVolcanoDirtClump",12,12,0)
			H137 T 0 A_SpawnItemEx("HexenVolcanoDirtClump",12,-12,0)
			H137 T 0 A_SpawnItemEx("HexenVolcanoDirtClump",-12,-12,0)
			H137 TSRQ 3 //Rise, then shake it, baby
			H137 LMN 4
			H137 LMNLMN 3
			H137 L -1 A_Jump(256,"Krakatoa")
			Wait
		Krakatoa:
			H137 L 3 Bright A_SetScale(1.0,1.1)
			H137 L 3 Bright A_SetScale(1.1,1.2)
			H137 L 3 Bright A_SetScale(1.15,1.3)
			H137 L 3 Bright A_SetScale(1.1,1.2)
			H137 P 3 Bright A_SetScale(1.0,1.1)
			H137 P 0 A_PlaySound("hexen/volcano",CHAN_BODY)
			H137 P 0 A_SpawnItemEx("HexenFireStormVolcanoChunk",0,0,28,frandom(0,12),0,frandom(6,12),random(0,360),SXF_TRANSFERPOINTERS)
		EruptionLoop:
			H137 L 2 Bright Light("CFLAME1") A_CountDown
			H137 P 0 A_SetScale(frandom(1.05,1.15),frandom(1.15,1.3))
			H137 P 0 A_PlaySound("hexen/volcanofireball",random(5,7))
			H137 P 0 A_SetScale(frandom(1.05,1.15),frandom(1.15,1.3))
			H137 P 2 Bright Light("CFLAME1") A_SpawnItemEx("HexenFireStormVolcanoChunk",0,0,28,frandom(0,12),0,frandom(6,12),random(0,360),SXF_TRANSFERPOINTERS)
			Loop
		Death:
			H137 L 0 A_PlaySound("Hexen/Spike2",CHAN_VOICE,0.5)
			H137 LQRST 3 //Lower back into the ground
			Stop
			
	}
}

Actor HexenFireStormVolcanoCoop : HexenFireStormVolcano
{
	Species "Player"
    +THRUSPECIES
	States
	{
		Krakatoa:
			H137 L 3 Bright A_SetScale(1.0,1.1)
			H137 L 3 Bright A_SetScale(1.1,1.2)
			H137 L 3 Bright A_SetScale(1.15,1.3)
			H137 L 3 Bright A_SetScale(1.1,1.2)
			H137 P 3 Bright A_SetScale(1.0,1.1)
			H137 P 0 A_PlaySound("hexen/volcano",CHAN_BODY)
			H137 P 0 A_SpawnItemEx("HexenFireStormVolcanoChunkCoop",0,0,28,frandom(0,12),0,frandom(6,12),random(0,360),SXF_TRANSFERPOINTERS)
		EruptionLoop:
			H137 L 2 Bright Light("CFLAME1") A_CountDown
			H137 P 0 A_SetScale(frandom(1.05,1.15),frandom(1.15,1.3))
			H137 P 0 A_PlaySound("hexen/volcanofireball",random(5,7))
			H137 P 0 A_SetScale(frandom(1.05,1.15),frandom(1.15,1.3))
			H137 P 2 Bright Light("CFLAME1") A_SpawnItemEx("HexenFireStormVolcanoChunkCoop",0,0,28,frandom(0,12),0,frandom(6,12),random(0,360),SXF_TRANSFERPOINTERS)
			Loop
			
	}
}

Actor HexenFireStormVolcanoChunk : VolcanoBlast
{
	Radius 8
	Height 8
	DamageType "FireExplosive"
	Damage 2
	DamageType Fire
	Gravity 0.5
	Scale 0.5
	+NOBLOCKMAP
	+MISSILE
	+DROPOFF
	+NOTELEPORT
	DeathSound "hexen/volcanofireblast"
	States
	{
		Spawn:
			H138 EF 4 BRIGHT A_SpawnItemEx("HammerPuff",0,0,0,0,0,0,0,SXF_ABSOLUTEPOSITION,64)
			Loop
		Death:
			H138 G 0 A_Stop
			H138 G 0 A_SetScale(1.0)
			H138 G 0 A_NoGravity
			H138 G 4 BRIGHT A_Explode(25,25,XF_HURTSOURCE)
			H138 GHIJKL 4 BRIGHT
			Stop
	}
}

Actor HexenFireStormVolcanoChunkCoop : HexenFireStormVolcanoChunk
{
	Species "Player"
    +THRUSPECIES
}

actor HexenVolcanoDirtClump : DirtClump
{
    States
    {
      Spawn:
        TSPK C 350
        TSPK C 2 A_Fadeout(0.1)
        wait
    }
}

// Daedolon

actor "Arc of Death" : MWeapLightning // lmao hardcoded
{
    Inventory.PickupMessage "Arc of Death"
    Inventory.PickupSound "hexen/weaponget"
    Inventory.RestrictedTo "HexenPlayer"
    Weapon.SlotNumber 6
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 0 // 5
    Obituary "$SAMSARA_HEXEN_OB_SLOT6"
    Tag "Arc of Death"
    +NOALERT
    +UNDROPPABLE
    States
    {
      Ready:
        H109 AAAAA 1 Bright A_WeaponReady
        TNT1 A 0 A_GiveInventory("SamsaraHexenArcOfDeathReadySoundPlayer")
        H109 ABBBBBBCCCCC 1 Bright A_WeaponReady
        TNT1 A 0 A_GiveInventory("SamsaraHexenArcOfDeathReadySoundPlayer")
        H109 CBBBBBB 1 Bright A_WeaponReady
        loop

      Deselect:
        H109 A 1 Bright A_Lower
        loop

      Select:
        H109 A 1 Bright A_Raise
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",5,1)
        goto NoAmmoSwitch
        H109 D 3 Bright A_AlertMonsters
        H109 E 3 Bright
      // start attack handler code
      FireAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",5,1)
        goto FireContinue
        TNT1 A 0 A_TakeInventory("Cell",5)
        goto FireAttack

      FireAttack:
        //TNT1 A 0 A_PlaySound("MageLightningFire") // already called in A_MLightningAttack
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"FireAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"FireAttackCoop")
      FireAttackDM:
        TNT1 A 0 A_MLightningAttack("LightningFloorDM","LightningCeilingDM")
        goto FireContinue

      FireAttackCoop:
        TNT1 A 0 A_MLightningAttack("LightningFloor2","LightningCeiling2")
        goto FireContinue
      // end attack handler code

      FireContinue:
        H109 FG 4 Bright
        H109 HI 3 Bright
        H109 I 6 Bright Offset(0,199)
        H109 C 2 Bright Offset(0,55)
        H109 B 2 Bright Offset(0,50)
        H109 B 2 Bright Offset(0,45)
        H109 B 2 Bright Offset(0,40)
        goto Ready

      // "No ammo" switch
      NoAmmoSwitch:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_SelectWeapon("Sapphire Wand")
        goto Deselect
    }
}

actor SamsaraHexenArcOfDeathReadySoundPlayer : Trigger
{
    States
    {
      // Sound playing stuff
      Pickup:
        TNT1 A 0 A_Jump(96,"PickupStop")
        TNT1 A 0 A_PlaySound("MageLightningReady",CHAN_WEAPON)
        stop
    }
}

actor LightningCeilingDM : LightningCeiling
{
    Speed 50
    DamageType "Electric"
    MissileType "LightningZapDM"
    +BLOODSPLATTER
    +NODAMAGETHRUST
    States
    {
      // spread rune fires unreplaced versions of the side projectiles no matter what; use this current naming scheme for the time being
      Spawn:
        MLFX A 2 Bright Light("MAGELIGHT") A_LightningZap
        MLFX BCD 2 Bright Light("MAGELIGHT") A_LightningClip
        loop

      Death:
        MLF2 A 2 Bright Light("MAGELIGHT") A_LightningRemove
        MLF2 BCDEKLM 3 Bright Light("MAGELIGHT")
        ACLO E 35
        MLF2 NO 3 Bright Light("MAGELIGHT")
        MLF2 P 4 Bright Light("MAGELIGHT")
        MLF2 QP 3 Bright Light("MAGELIGHT")
        MLF2 Q 4 Bright Light("MAGELIGHT")
        MLF2 POP 3 Bright Light("MAGELIGHT")
        MLF2 P 1 Bright Light("MAGELIGHT") A_HideThing
        ACLO E 1050
        stop

/*
      Spawn:
        HMLF A 2 Bright Light("MAGELIGHT") A_LightningZap
        HMLF BCD 2 Bright Light("MAGELIGHT") A_LightningClip
        loop

      Death:
        HML2 A 2 Bright Light("MAGELIGHT") A_LightningRemove
        HML2 BCDEKLM 3 Bright Light("MAGELIGHT")
        TNT1 A 35
        HML2 NO 3 Bright Light("MAGELIGHT")
        HML2 P 4 Bright Light("MAGELIGHT")
        HML2 QP 3 Bright Light("MAGELIGHT")
        HML2 Q 4 Bright Light("MAGELIGHT")
        HML2 POP 3 Bright Light("MAGELIGHT")
        HML2 P 1 Bright Light("MAGELIGHT") A_HideThing
        TNT1 A 1050
        stop
*/
    }
}

