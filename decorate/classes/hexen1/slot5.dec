}

// Powered

actor HammerMissilePowered : HammerMissileDM
{
    Damage 20 // should we keep it like this for PVP?
    States
    {
      Spawn:
        FHFX A 2 Bright Light("THROWHAMMER") A_SpawnItemEx("HammerMissileTrail")
        TNT1 A 0 A_PlaySound("FighterHammerContinuous")
        FHFX BCDEFGH 2 Bright Light("THROWHAMMER") A_SpawnItemEx("HammerMissileTrail")
        loop

      Death:
        FHFX I 3 Bright Light("THROWHAMMER_X1") A_SetTranslucent(1,1)
        FHFX J 3 Bright Light("THROWHAMMER_X2")
        TNT1 A 0 A_Explode(128,192,0)
      DeathFinish:
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",-48,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",48,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",0,-48,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        FHFX K 3 Bright Light("THROWHAMMER_X3") A_SpawnItemEx("HexenHammerMissileExplosion",0,48,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",-96,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",96,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",0,-96,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        FHFX L 3 Bright Light("THROWHAMMER_X4") A_SpawnItemEx("HexenHammerMissileExplosion",0,96,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",-144,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",144,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",0,-144,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        FHFX M 3 Bright Light("THROWHAMMER_X4") A_SpawnItemEx("HexenHammerMissileExplosion",0,144,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",-192,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",192,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        TNT1 A 0 A_SpawnItemEx("HexenHammerMissileExplosion",0,-192,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        FHFX N 3 Light("THROWHAMMER_X4") A_SpawnItemEx("HexenHammerMissileExplosion",0,192,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        FHFX OP 3 Bright Light("THROWHAMMER_X4")
        FHFX Q 3 Bright Light("THROWHAMMER_X5")
        FHFX R 3 Bright Light("THROWHAMMER_X6")
        stop
    }
}

