actor SamsaraHexenViscerelaghPoweredAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        //TNT1 A 0 A_JumpIfInventory("SamsaraHexenViscerelaghPoweredSoundPlaying",1,2)
        //TNT1 A 0 ACS_NamedExecuteWithResult("HexenPoweredViscerelaghSound") // also gives the token
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 AA 0 A_FireCustomMissile("SamsaraHexenViscerelaghMiniBall",random(-3,3),false,0,random(-3,3))
        stop

      PickupAttackCoop:
        TNT1 AA 0 A_FireCustomMissile("SamsaraHexenViscerelaghMiniBallCoop",random(-3,3),false,0,random(-3,3))
        stop
    }
}

