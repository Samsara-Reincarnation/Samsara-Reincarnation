// Unpowered

actor SamsaraHexenFrostFangBall : IceGuyFX
{
    Speed 20
    Damage 5
    DamageType "HexenIce"
    DeathSound "Hexen/FrostFang/Hit"
    +ACTIVATEIMPACT
    +ACTIVATEPCROSS
    +BLOODSPLATTER
    States
    {
      Spawn:
        ICPR ABC 3 Bright Light("ICEFANGBALL") A_SpawnItemEx("IceFXPuff",0,0,2)
        loop

      Death:
        ICPR D 4 Bright Light("ICEFANGBALL_X1") A_Explode(80,128,0)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,-135,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,-90,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,-45,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,0,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,45,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,90,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,135,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShard",8,0,180,CMF_TRACKOWNER)
      DeathFinish:
        ICPR E 4 Bright Light("ICEFANGBALL_X2")
        ICPR F 4 Bright Light("ICEFANGBALL_X3")
        ICPR G 4 Bright Light("ICEFANGBALL_X4")
        ICPR H 3 Bright
        stop
    }
}

actor SamsaraHexenFrostFangBallCoop : SamsaraHexenFrostFangBall
{
    Species "Player"
    +THRUSPECIES
    States
    {
      Death:
        ICPR D 4 Bright Light("ICEFANGBALL_X1") A_Explode(80,128,0)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,-135,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,-90,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,-45,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,0,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,45,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,90,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,135,CMF_TRACKOWNER)
        TNT1 A 0 A_CustomMissile("SamsaraHexenFrostFangShardCoop",8,0,180,CMF_TRACKOWNER)
        goto DeathFinish
    }
}

actor SamsaraHexenFrostFangShard : FrostMissileDM { Damage (random(1,4)) }

actor SamsaraHexenFrostFangShardCoop : FrostMissile2 { Damage (random(1,4)) }

// Powered

actor SamsaraHexenFrostFangTwisterBall : SamsaraHexenFrostFangBall
{
    States
    {
      Death:
        ICPR D 4 Bright Light("ICEFANGBALL_X1") A_Explode(80,128,0)
        TNT1 A 0 A_SpawnItemEx("SamsaraHexenFrostFangTwister",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        //Do Stuff here
        goto DeathFinish
    }
}

actor SamsaraHexenFrostFangTwisterBallCoop : SamsaraHexenFrostFangTwisterBall
{
    Species "Player"
    +THRUSPECIES
    States
    {
      Death:
        ICPR D 4 Bright Light("ICEFANGBALL_X1") A_Explode(80,128,0)
        TNT1 A 0 A_SpawnItemEx("SamsaraHexenFrostFangTwisterCoop",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS)
        goto DeathFinish
    }
}

actor SamsaraHexenFrostFangTwister
{
    Projectile
    Radius 24
    Height 24
    Speed 4
    DamageType "HexenIce"
    ReactionTime 25
    MaxStepHeight 32
    BounceType "Hexen"
    BounceFactor 0
    RenderStyle "Translucent"
    Alpha 0.85
    DeathSound "Hexen/FreezeRay"
    +BLOODSPLATTER
    +NOEXPLODEFLOOR
    -NOGRAVITY
    +SEEKERMISSILE
    +STEPMISSILE
    +THRUACTORS
    States
    {
      Spawn:
        H117 I 3 Bright Light("ICEFANGBALL_X1") NoDelay A_PlaySound("Hexen/Blizzard",CHAN_BODY,1,true,0.5)
        H117 JKL 3 Bright Light("ICEFANGBALL_X1")
      SpawnLoop:
        TNT1 A 0 ThrustThing(random(0,256),1)
        TNT1 A 0 A_SeekerMissile(0,30,SMF_LOOK,256,1)
        H117 F 3 Bright Light("ICEFANGBALL_X2") A_Explode(2,32,0)
        TNT1 A 0 ThrustThing(random(0,256),1)
        TNT1 A 0 A_SeekerMissile(0,30,SMF_LOOK,256,1)
        H117 G 3 Bright Light("ICEFANGBALL_X2") A_Explode(2,32,0)
        TNT1 A 0 ThrustThing(random(0,256),1)
        TNT1 A 0 A_SeekerMissile(0,30,SMF_LOOK,256,1)
        H117 H 3 Bright Light("ICEFANGBALL_X2") A_Explode(2,32,0)
        TNT1 A 0 A_Countdown
        loop

      Death:
        H117 L 3 Bright Light("ICEFANGBALL_X1") A_Scream
        H117 KJI 3 Bright Light("ICEFANGBALL_X1")
        stop
    }
}

actor SamsaraHexenFrostFangTwisterCoop : SamsaraHexenFrostFangTwister
{
    Species "Player"
    +THRUSPECIES
}

// Parias (Classic)/Baratus

actor SamsaraHexenHammerOfRetributionMeleePuffSpawned : Boolean {}

actor "Hammer of Retribution" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Hammer of Retribution"
    Weapon.SlotNumber 5
    Weapon.SelectionOrder 900
    Weapon.YAdjust -10
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT5_1"
    Tag "Hammer of Retribution"
    +AMMO_OPTIONAL
    +BLOODSPLATTER
    +EXPLOSIVE
    +MELEEWEAPON
    +NOALERT
    States
    {
      Spawn:
        WFHM A -1
        stop

      // Parias (Classic)
      Ready:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"ReadyFighter")
      ReadyClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"ReadyClericClassicAmmo")
        goto ReadyClericClassicNoAmmo

      ReadyClericClassicNoAmmo:
        FHMR A 1 A_WeaponReady
        goto Ready

      ReadyClericClassicAmmo:
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"DeselectFighter")
      DeselectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"DeselectClericClassicAmmo")
        goto DeselectClericClassicNoAmmo

      DeselectClericClassicNoAmmo:
        FHMR A 1 A_Lower
        goto Deselect

      DeselectClericClassicAmmo:
        FHMR F 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"SelectFighter")
      SelectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"SelectClericClassicAmmo")
        goto SelectClericClassicNoAmmo

      SelectClericClassicNoAmmo:
        FHMR A 1 A_Raise
        goto Select

      SelectClericClassicAmmo:
        FHMR F 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_TakeInventory("SamsaraHexenHammerOfRetributionMeleePuffSpawned")
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"FireFighter")
      FireClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireClericClassicAmmo")
        goto FireClericClassicNoAmmo

      FireClericClassicNoAmmo:
        FHMR B 6 Offset(5,0)
        FHMR C 3 Offset(5,0) A_GiveInventory("SamsaraHexenHammerOfRetributionMeleeAttackHandler")
        FHMR D 3 Offset(5,0)
        FHMR E 2 Offset(5,0)
        goto FireClericClassicContinue

      FireClericClassicAmmo:
        FHMR H 6 Offset(5,0) Bright
        FHMR I 3 Offset(5,0) Bright A_GiveInventory("SamsaraHexenHammerOfRetributionMeleeAttackHandler")
        FHMR J 3 Offset(5,0) Bright
        FHMR K 2 Offset(5,0) Bright
        goto FireClericClassicContinue

      FireClericClassicContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenHammerOfRetributionRangedAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicContinueAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireClericClassicContinueAmmo")
        goto FireClericClassicContinueNoAmmo

      FireClericClassicContinueNoAmmo:
        FHMR E 10 Offset(5,150)
        goto FireClericClassicFinish

      FireClericClassicContinueAmmo:
        FHMR K 10 Offset(5,150) Bright
        goto FireClericClassicFinish

      FireClericClassicFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireClericClassicFinishAmmo")
        goto FireClericClassicFinishNoAmmo

      FireClericClassicFinishNoAmmo:
        FHMR A 1 Offset(0,60)
        FHMR A 1 Offset(0,55)
        FHMR A 1 Offset(0,50)
        FHMR A 1 Offset(0,45)
        FHMR A 1 Offset(0,40)
        FHMR A 2 Offset(0,35)
        goto Ready

      FireClericClassicFinishAmmo:
        FHMR F 1 Bright Offset(0,60)
        FHMR F 1 Bright Offset(0,55)
        FHMR F 1 Bright Offset(0,50)
        FHMR F 1 Bright Offset(0,45)
        FHMR F 1 Bright Offset(0,40)
        FHMR F 2 Bright Offset(0,35)
        goto Ready

      // Baratus
      ReadyFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"ReadyFighterAmmo")
        goto ReadyFighterNoAmmo

      ReadyFighterNoAmmo:
        FHMR A 1 A_WeaponReady
        goto Ready

      ReadyFighterAmmo:
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR F 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto Ready
        FHMR G 1 Bright A_WeaponReady
        goto Ready

      DeselectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"DeselectFighterAmmo")
        goto DeselectFighterNoAmmo

      DeselectFighterNoAmmo:
        FHMR A 1 A_Lower
        goto Deselect

      DeselectFighterAmmo:
        FHMR F 1 Bright A_Lower
        goto Deselect

      SelectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"SelectFighterAmmo")
        goto SelectFighterNoAmmo

      SelectFighterNoAmmo:
        FHMR A 1 A_Raise
        goto Select

      SelectFighterAmmo:
        FHMR F 1 Bright A_Raise
        goto Select

      FireFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireFighterAmmo")
        goto FireFighterNoAmmo

      FireFighterNoAmmo:
        H105 B 6 Offset(5,0)
        H105 C 3 Offset(5,0) A_GiveInventory("SamsaraHexenHammerOfRetributionMeleeAttackHandler")
        H105 D 3 Offset(5,0)
        FHMR E 2 Offset(5,0)
        goto FireFighterContinue

      FireFighterAmmo:
        H106 L 6 Offset(5,0) Bright
        H106 M 3 Offset(5,0) Bright A_GiveInventory("SamsaraHexenHammerOfRetributionMeleeAttackHandler")
        H106 N 3 Offset(5,0) Bright
        FHMR K 2 Offset(5,0) Bright
        goto FireFighterContinue

      FireFighterContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenHammerOfRetributionRangedAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterContinueAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireFighterContinueAmmo")
        goto FireFighterContinueNoAmmo

      FireFighterContinueNoAmmo:
        FHMR E 10 Offset(5,150)
        goto FireFighterFinish

      FireFighterContinueAmmo:
        FHMR K 10 Offset(5,150) Bright
        goto FireFighterFinish

      FireFighterFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Cell",3,"FireFighterFinishAmmo")
        goto FireFighterFinishNoAmmo

      FireFighterFinishNoAmmo:
        FHMR A 1 Offset(0,60)
        FHMR A 1 Offset(0,55)
        FHMR A 1 Offset(0,50)
        FHMR A 1 Offset(0,45)
        FHMR A 1 Offset(0,40)
        FHMR A 2 Offset(0,35)
        goto Ready

      FireFighterFinishAmmo:
        FHMR F 1 Bright Offset(0,60)
        FHMR F 1 Bright Offset(0,55)
        FHMR F 1 Bright Offset(0,50)
        FHMR F 1 Bright Offset(0,45)
        FHMR F 1 Bright Offset(0,40)
        FHMR F 2 Bright Offset(0,35)
        goto Ready
    }
}

// Melee

actor SamsaraHexenHammerOfRetributionMeleeAttackHandler : Trigger
{
    States
    {
      // Attack stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupPowered")
      // Unpowered
      PickupUnpowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupUnpoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupUnpoweredCoop")
      PickupUnpoweredDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupUnpoweredDMSpread")
        TNT1 A 0 A_CustomPunch(random(60,113),true,0,"SamsaraHexenHammerPuff",144)
        stop

      PickupUnpoweredDMSpread:
        TNT1 A 0 A_CustomPunch(random(60,113)*3,true,0,"SamsaraHexenHammerPuff",144)
        stop

      PickupUnpoweredCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupUnpoweredCoopSpread")
        TNT1 A 0 A_CustomPunch(random(90,170),true,0,"SamsaraHexenHammerPuffCoop",144)
        stop

      PickupUnpoweredCoopSpread:
        TNT1 A 0 A_CustomPunch(random(90,170)*3,true,0,"SamsaraHexenHammerPuffCoop",144)
        stop

      // Powered
      PickupPowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupPoweredCoop")
      PickupPoweredDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupPoweredDMSpread")
        TNT1 A 0 A_CustomPunch(random(90,150),true,0,"SamsaraHexenHammerPuff",144)
        stop

      PickupPoweredDMSpread:
        TNT1 A 0 A_CustomPunch(random(90,150)*3,true,0,"SamsaraHexenHammerPuff",144)
        stop

      PickupPoweredCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupPoweredCoopSpread")
        TNT1 A 0 A_CustomPunch(random(150,225),true,0,"SamsaraHexenHammerPuffCoop",144)
        stop

      PickupPoweredCoopSpread:
        TNT1 A 0 A_CustomPunch(random(150,225)*3,true,0,"SamsaraHexenHammerPuffCoop",144)
        stop
    }
}

actor SamsaraHexenHammerPuff : HammerPuff
{
    +NOTIMEFREEZE
    +PUFFGETSOWNER
    States
    {
      Spawn:
        FHFX S 0 NoDelay A_GiveInventory("SamsaraHexenHammerOfRetributionMeleePuffSpawned",1,AAPTR_TARGET)
        TNT1 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
        goto Super::Spawn
    }
}

actor SamsaraHexenHammerPuffCoop : SamsaraHexenHammerPuff { +MTHRUSPECIES }

// Ranged

actor SamsaraHexenHammerOfRetributionRangedAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenHammerOfRetributionMeleePuffSpawned",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",3)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackPowered")
      // Unpowered
      PickupAttackUnpowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackUnpoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackUnpoweredCoop")
      PickupAttackUnpoweredDM:
        TNT1 A 0 A_JumpIfInventory("RJingModeOn",1,"PickupAttackUnpoweredDMRJ")
        TNT1 A 0 A_FireCustomMissile("HammerMissileDM",0,false)
        stop

      PickupAttackUnpoweredDMRJ:
        TNT1 A 0 A_FireCustomMissile("HammerMissileDMRJ",0,false)
        stop

      PickupAttackUnpoweredCoop:
        TNT1 A 0 A_JumpIfInventory("RJingModeOn",1,"PickupAttackUnpoweredCoopRJ")
        TNT1 A 0 A_FireCustomMissile("HammerMissile2",0,false)
        stop

      PickupAttackUnpoweredCoopRJ:
        TNT1 A 0 A_FireCustomMissile("HammerMissile2RJ",0,false)
        stop

      // Powered
      PickupAttackPowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackPoweredCoop")
      PickupAttackPoweredDM:
        TNT1 A 0 A_FireCustomMissile("HammerMissilePowered",0,false)
        stop

      PickupAttackPoweredCoop:
        TNT1 A 0 A_FireCustomMissile("HammerMissilePoweredCoop",0,false)
        stop
    }
}

// Unpowered

actor HammerMissileDM : HammerMissile
{
    DamageType "FireExplosive"
    Decal "Scorch"
    Obituary "$SAMSARA_HEXEN_OB_SLOT5_2"
    +BLOODSPLATTER
    +FORCERADIUSDMG
    +THRUGHOST
    States
    {
      Spawn:
        FHFX A 2 Bright Light("THROWHAMMER")
        FHFX B 2 Bright Light("THROWHAMMER") A_PlaySound("FighterHammerContinuous")
        FHFX CDEFGH 2 Bright Light("THROWHAMMER")
        loop

      Death:
        FHFX I 3 Bright Light("THROWHAMMER_X1") A_SetTranslucent(1,1)
        FHFX J 3 Bright Light("THROWHAMMER_X2")
        TNT1 A 0 A_Explode(128,128,0)
      DeathFinish:
        FHFX K 3 Bright Light("THROWHAMMER_X3")
        FHFX LM 3 Bright Light("THROWHAMMER_X4")
        FHFX N 3 Light("THROWHAMMER_X4")
        FHFX OP 3 Bright Light("THROWHAMMER_X4")
        FHFX Q 3 Bright Light("THROWHAMMER_X5")
        FHFX R 3 Bright Light("THROWHAMMER_X6")
        stop
    }
}

actor HammerMissileDMRJ : HammerMissileDM
{
    States
    {
      Death:
        FHFX I 3 Bright Light("THROWHAMMER_X1") A_SetTranslucent(1,1)
        FHFX J 3 Bright Light("THROWHAMMER_X2")
        TNT1 A 0 A_Explode(128,128)
        goto DeathFinish
    }
}

