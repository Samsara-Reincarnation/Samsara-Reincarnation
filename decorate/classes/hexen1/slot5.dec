}

// Daedolon

actor SamsaraHexenViscerelaghPoweredSoundPlaying : Boolean {}

actor Viscerelagh : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Viscerelagh"
    Weapon.SlotNumber 5
    Weapon.SelectionOrder 900
    //Weapon.YAdjust 20
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 1
    Obituary "$SAMSARA_HEXEN_OB_SLOT5_1"
    Tag "Viscerelagh"
    +NOALERT
    States
    {
      Spawn:
        H107 A -1
        stop

      Ready:
        H107 B 1 A_WeaponReady
        loop

      Deselect:
        H107 B 1 A_Lower
        loop

      Select:
        H107 B 1 A_Raise
        loop

      // Unpowered
      Fire:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"FirePowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FirePowered")
      FireUnpowered:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto NoAmmoSwitch
        TNT1 A 0 A_AlertMonsters
        H107 D 4 A_PlaySound("Hexen/Viscerelagh/Charge",CHAN_WEAPON)
        H107 E 4 Bright Offset(0,30)
        H107 F 4 Bright Offset(0,28)
        H107 G 4 Bright Offset(0,26)
        H107 H 6 Bright Offset(0,38) A_GiveInventory("SamsaraHexenViscerelaghAttackHandler")
        H107 G 4 Bright Offset(0,36) A_PlaySound("Hexen/Viscerelagh/CoolDown")
        H107 F 4 Bright Offset(0,34)
        H107 B 20 Offset(0,33)
        goto Ready

      // Powered
      FirePowered:
        TNT1 A 0 A_AlertMonsters
        H107 D 4 A_PlaySound("Hexen/Viscerelagh/Charge",CHAN_WEAPON)
        H107 E 4 Bright Offset(0,30)
        H107 F 4 Bright Offset(0,28)
        H107 G 4 Bright Offset(0,26)
        goto FireLoopPowered

      FireLoopInitPowered:
        TNT1 A 0 A_AlertMonsters
      FireLoopPowered:
        H107 H 6 Bright Offset(0,38) A_GiveInventory("SamsaraHexenViscerelaghPoweredAttackHandler")
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,3)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,2)
        TNT1 A 0 A_CheckReload
        goto FireFinishPowered
        TNT1 A 0 A_ReFire("FireLoopInitPowered")
        goto FireFinishPowered

      FireFinishPowered:
        TNT1 A 0 A_TakeInventory("SamsaraHexenViscerelaghPoweredSoundPlaying")
        H107 G 4 Bright Offset(0,36) A_PlaySound("Hexen/Viscerelagh/CoolDown")
        H107 F 4 Bright Offset(0,34)
        H107 B 20 Offset(0,33)
        goto Ready

      // "No ammo" switch
      NoAmmoSwitch:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 A_SelectWeapon("Sapphire Wand")
        goto Deselect
    }
}

// Unpowered

actor SamsaraHexenViscerelaghAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",3)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenViscerelaghBall",0,false)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenViscerelaghBallCoop",0,false)
        stop
    }
}

actor SamsaraHexenViscerelaghBall
{
    Projectile
    Radius 8
    Height 12
    Speed 30
    Damage 10
    DamageType "HexenViscerelagh"
    Scale 1.5
    SeeSound "Hexen/Viscerelagh/Fire"
    DeathSound "Hexen/Viscerelagh/Hit"
    //Decal "BigBloodSmear"
    +BLOODSPLATTER
    States
    {
      Spawn:
        H108 ABCDEF 2 Bright Light("BLOODSCEPTERBALL") //H108 AABBCCDDEEFF 1 Bright A_SpawnItemEx("SamsaraHexenViscerelaghTrail",random(-5,5),random(-6,6),random(-6,6),0,0,0,0,SXF_CLIENTSIDE)
        loop

      Death:
      Crash:
        TNT1 A 0 A_Explode(150,150,0)
        TNT1 A 1 A_SpawnItemEx("SamsaraHexenViscerelaghBallDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
        stop

      XDeath:
        TNT1 A 0 A_PlaySound("ClericCStaffHitThing")
        TNT1 A 0 A_GiveInventory("SamsaraHexenViscerelaghBallHealthDrain",1,AAPTR_TARGET)
        goto Crash
    }
}

actor SamsaraHexenViscerelaghBallCoop : SamsaraHexenViscerelaghBall
{
    Species "Player"
    +THRUSPECIES
    States
    {
      Death:
      Crash:
        TNT1 A 0 A_Explode(200,200,0)
        TNT1 A 1 A_SpawnItemEx("SamsaraHexenViscerelaghBallDeath",0,0,0,0,0,0,0,SXF_CLIENTSIDE)
        stop

      XDeath:
        TNT1 A 0 A_PlaySound("ClericCStaffHitThing")
        TNT1 A 0 A_GiveInventory("SamsaraHexenViscerelaghBallHealthDrain",1,AAPTR_TARGET)
        goto Crash
    }
}

