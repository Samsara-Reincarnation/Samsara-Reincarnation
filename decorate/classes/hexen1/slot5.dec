// Parias (Reincarnation)

actor "Ice Fang" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Frost Fang"
    Weapon.SlotNumber 5
    Weapon.SelectionOrder 900
    Weapon.YAdjust -10
    Weapon.AmmoType "Cell"
    Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT5_1"
    Tag "Ice Fang"
    States
    {
      Spawn:
        H117 A -1
        stop

      Ready:
        H117 B 1 A_WeaponReady
        loop

      Deselect:
        H117 B 1 A_Lower
        loop

      Select:
        H117 B 1 A_Raise
        loop

      Fire:
        H117 B 3
        H117 C 4 Bright
        H117 D 5 Bright
        /*TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        goto FireContinue
        TNT1 AAAA 0 A_SpawnItemEx("SamsaraHexenFrostFangFog2",16,0,32,0.5,0,frandom(-0.5,0.5),random(-50,50),SXF_CLIENTSIDE)
        goto FireContinue*/

      FireContinue:
        H117 E 6 Bright A_GiveInventory("SamsaraHexenFrostFangAttackHandler")
        H117 D 1 Bright Offset(0,60)
        H117 D 1 Bright Offset(0,55)
        H117 D 1 Bright Offset(0,50)
        H117 D 1 Bright Offset(0,45)
        H117 D 1 Bright Offset(0,40)
        H117 D 1 Bright Offset(0,35)
        H117 C 5 Bright
        H117 B 4
        goto Ready
    }
}

actor SamsaraHexenFrostFangAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",3,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",3)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Hexen/FrostFang/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackPowered")
      // Unpowered
      PickupAttackUnpowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackUnpoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackUnpoweredCoop")
      PickupAttackUnpoweredDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangBall",0,false,-4)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangBall",0,false,4)
        stop

      PickupAttackUnpoweredCoop:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangBallCoop",0,false,-4)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangBallCoop",0,false,4)
        stop

      // Powered
      PickupAttackPowered:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackPoweredCoop")
      PickupAttackPoweredDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBall",0,false,-8,-10)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBall",0,false,8,-10)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBall",0,false,10,0)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBall",0,false,-10,0)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBall",0,false,0,8)
        stop

      PickupAttackPoweredCoop:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBallCoop",0,false,-8,-10)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBallCoop",0,false,8,-10)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBallCoop",0,false,10,0)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBallCoop",0,false,-10,0)
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenFrostFangTwisterBallCoop",0,false,0,8)
        stop
    }
}

