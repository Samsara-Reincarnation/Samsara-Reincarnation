actor HexenHammerMissileExplosion
{
    Projectile
    Radius 4
    Height 8
    DamageType "FireExplosive"
    +BLOODSPLATTER
    +THRUACTORS
    States
    {
      Spawn:
        MSP1 G 0 Bright Light("BSBALL") NoDelay A_PlaySound("FighterHammerExplodePowered",CHAN_VOICE,1,false,0.33)
        TNT1 A 0 A_Quake(5,35,0,512,"nosoundforyoubitch")
