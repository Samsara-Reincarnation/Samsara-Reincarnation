Actor HexenAxeThunderWave
{
	Projectile
	Speed 32
	Height 32
	Radius 8
	Damage (100*random(1,2))
	SeeSound "Hexen/AxeLightning"
	+BLOODLESSIMPACT
	States
	{
		Spawn:
			H134 AD 2 Bright Light("CAXEPUFF1")
		SpawnLoop:
			H134 EF 3 Bright Light("CAXEPUFF1")
			Loop
		Death:
			H134 D 0 A_PlaySound("Hexen/AxeThunder",CHAN_5,1.0,false,0.25)
			H134 D 0 A_Explode(100*random(1,2),24)
			H134 DCBA 2 Bright Light("CAXEPUFF1")
			Stop
	}
}

