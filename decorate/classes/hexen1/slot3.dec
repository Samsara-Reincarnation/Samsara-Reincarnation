        goto PickupFinishGive

      PickupAttackStrongUnpoweredInfiniteDMSpread:
        TNT1 A 0 A_CustomPunch(random(120,195)*3,true,0,"AxePuffGlow2Infinite",144)
        goto PickupFinishGive

      PickupAttackStrongUnpoweredInfiniteCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongUnpoweredInfiniteCoopSpread")
        TNT1 A 0 A_CustomPunch(random(80,130),true,0,"AxePuffGlow2InfiniteCoop",144)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",112)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",96)
        TNT1 AAA 0 A_CustomPunch(5,true,0,"BlankPuffAxeGlowCoop",84)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",80)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",64)
