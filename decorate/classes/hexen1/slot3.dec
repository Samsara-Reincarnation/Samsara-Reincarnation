// Parias (Reincarnation)

// Token

actor SamsaraHexen1ClericLoadoutSlot3 : Boolean {}

// Bishop's Shortsword

actor "Bishop's Shortsword" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Bishop's Shortsword"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust 9
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 4
    Obituary "$SAMSARA_HEXEN_OB_SLOT3"
    Tag "Bishop's Shortsword"
    +AMMO_OPTIONAL
    +MELEEWEAPON
    +NOALERT
    States
    {
      Spawn:
        H119 H -1 Bright
        stop

      Ready:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        H119 I 1 A_WeaponReady
        goto Ready

      ReadyAmmo:
        H119 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto Ready
        H119 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto Ready
        H119 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto Ready
        H119 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto Ready
        H119 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto Ready
        H119 B 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectNoAmmo:
        H119 I 1 A_Lower
        goto Deselect

      DeselectAmmo:
        H119 A 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"SelectAmmo")
        goto SelectNoAmmo

      SelectNoAmmo:
        H119 I 1 A_Raise
        goto Select

      SelectAmmo:
        H119 A 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"FireAmmo")
        goto FireNoAmmo

      FireNoAmmo:
        H119 J 5
        H119 K 5 A_GiveInventory("SamsaraHexenBishopsShortswordSoundPlayer")
        H119 L 5
        goto FireContinue

      FireAmmo:
        H119 C 5 Bright
        H119 D 5 Bright A_GiveInventory("SamsaraHexenBishopsShortswordSoundPlayer")
        H119 E 5 Bright
        goto FireContinue

      FireContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenBishopsShortswordAttackHandler")
      FireFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"FireFinishAmmo")
        goto FireFinishNoAmmo

      FireFinishNoAmmo:
        H119 MN 5
        goto Ready

      FireFinishAmmo:
        H119 FG 5 Bright
        goto Ready
    }
}

actor SamsaraHexenBishopsShortswordSoundPlayer : Trigger
{
    States
    {
      // Ammo checking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupPlaySoundStrong")
        TNT1 A 0 A_JumpIfInventory("Clip",4,"PickupPlaySoundStrong")
        goto PickupPlaySoundWeak

      // Sound stuff
      // Weak
      PickupPlaySoundWeak:
        TNT1 A 0 A_PlaySound("Hexen/BishopSword/Swing",CHAN_WEAPON)
        stop

      // Strong
      PickupPlaySoundStrong:
        TNT1 A 0 A_PlaySound("Hexen/BishopSword/SwingHoly",CHAN_WEAPON)
        stop
    }
}

actor SamsaraHexenBishopsShortswordAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        goto PickupAttackWeak
        TNT1 A 0 A_TakeInventory("Clip",4)
        goto PickupAttack

      // Attack stuff
	  PickupAttack:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackPowered")
		Goto PickupAttackStrong
      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackWeakCoop")
      PickupAttackWeakDM:
        TNT1 A 0 A_FireBullets(-32,-16,-1,5,"ClericSwordPuffNormal",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(-16,-12,-1,5,"ClericSwordPuffNormal",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(0,-8,-1,5,"ClericSwordPuffNormal",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(16,-12,-1,5,"ClericSwordPuffNormal",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(32,0,-1,5,"ClericSwordPuffNormal",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        stop

      PickupAttackWeakCoop:
        TNT1 A 0 A_FireBullets(-32,-16,-1,5,"ClericSwordPuffNormalCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(-16,-12,-1,5,"ClericSwordPuffNormalCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(0,-8,-1,5,"ClericSwordPuffNormalCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(16,-12,-1,5,"ClericSwordPuffNormalCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(32,0,-1,5,"ClericSwordPuffNormalCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        stop

      // Strong
      PickupAttackStrong:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongCoop")
      PickupAttackStrongDM:
        TNT1 A 0 A_FireBullets(-32,-16,-1,10,"ClericSwordPuff",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(-16,-12,-1,10,"ClericSwordPuff",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(0,-8,-1,10,"ClericSwordWallPuff",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(16,-12,-1,10,"ClericSwordPuff",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(32,0,-1,10,"ClericSwordPuff",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlash",0,false)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlash",0,false,-16)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlash",0,false,16)
        stop

      PickupAttackStrongCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackStrongCoopImproved")
        TNT1 A 0 A_FireBullets(-32,-16,-1,10,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(-16,-12,-1,10,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(0,-8,-1,10,"ClericSwordWallPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(16,-12,-1,10,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(32,0,-1,10,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoop",0,false)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoop",0,false,-16)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoop",0,false,16)
        stop

      PickupAttackStrongCoopImproved:
        TNT1 A 0 A_FireBullets(-32,-16,-1,13,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(-16,-12,-1,13,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(0,-8,-1,13,"ClericSwordWallPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(16,-12,-1,13,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireBullets(32,0,-1,13,"ClericSwordPuffCoop",FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,120)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoopImproved",0,false)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoopImproved",0,false,-16)
        TNT1 A 0 A_FireCustomMissile("ClericSwordSlashCoopImproved",0,false,16)
        stop
		
	  //Powered!
	  PickupAttackPowered:	  
		TNT1 A 0 A_AlertMonsters
		TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackPoweredCoop")
	  PickupAttackPoweredDM:
		TNT1 A 0 A_FireCustomMissile("ClericSwordThrow",0,false)
		stop
		
	  PickupAttackPoweredCoop:
		TNT1 A 0 A_FireCustomMissile("ClericSwordThrowCoop",0,false)
		stop
    }
}

// Weak

actor ClericSwordPuffNormal : AxePuff { ActiveSound "" }
actor ClericSwordPuffNormalCoop : ClericSwordPuffNormal { +MTHRUSPECIES }

// Strong

actor ClericSwordWallPuff
{
    Radius 16
    +CLIENTSIDEONLY
    +NOINTERACTION
    States
    {
      Spawn:
        SPIR K 2 Bright Light("CBISHOPSWORD_X1")
        SPIR L 2 Bright Light("CBISHOPSWORD_X2")
        SPIR M 2 Bright Light("CBISHOPSWORD_X3")
        SPIR N 2 Bright Light("CBISHOPSWORD_X4")
        SPIR O 2 Bright Light("CBISHOPSWORD_X5")
        stop
    }
}

actor ClericSwordWallPuffCoop : ClericSwordWallPuff { +MTHRUSPECIES }

actor ClericSwordPuff
{
    Radius 16
    Alpha 0.5
    +CLIENTSIDEONLY
    +NOINTERACTION
    +PUFFGETSOWNER
    +PUFFONACTORS
    States
    {
      Spawn:
        SPIR P 0 A_FaceTarget
        goto FadeOut

      Melee:
        TNT1 A 0 A_PlaySound("SpiritAttack")
        goto FadeOut

      XDeath:
        TNT1 A 0 A_PlaySound("FighterAxeHitThing")
        goto FadeOut

      FadeOut:
        SPIR P 1 A_FadeOut(0.05)
        loop
    }
}

actor ClericSwordPuffCoop : ClericSwordPuff { +MTHRUSPECIES }

actor ClericSwordSlash
{
    Projectile
    Radius 16
    Speed 24
    Damage (8)
    DamageType "Fire"
    Alpha 0.75
    +BLOODSPLATTER
    +FORCERADIUSDMG
    +NODAMAGETHRUST
    +THRUACTORS //Because this has to work on hellknights
    States
    {
      Spawn:
        //Gonna have to do this the ugly way, huh?
        SPIR P 0 Bright Light("CBISHOPSWORD")
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail2",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail3",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail4",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail5",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail6",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail7",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail8",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail9",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail10",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(8,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(16,52,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        stop

      Death:
        TNT1 A 0 A_Explode(24,52,0,false,24)
      DeathFinish:
        TNT1 A 0 A_SpawnItemEx("ClericSwordWallPuff")
        TNT1 A 0 A_PlaySound("SpiritAttack",CHAN_VOICE)
        SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.15)
        wait
    }
}

actor ClericSwordSlashCoop : ClericSwordSlash
{
    Species "Player"
    +THRUSPECIES
}

