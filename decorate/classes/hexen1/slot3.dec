        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(20,52,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        stop

      Death:
        TNT1 A 0 A_Explode(30,52,0,false,24)
        goto DeathFinish
    }
}

actor ClericSwordSlashTrail
{
    Radius 16
    Alpha 0.5
    +CLIENTSIDEONLY
    +NOINTERACTION
    States
    {
      Spawn:
        SPIR P 1 Bright A_FadeOut(0.05)
        wait
    }
}

