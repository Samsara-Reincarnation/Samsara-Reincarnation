        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(10,24,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        TNT1 A 0 A_SpawnItemEx("ClericSwordSlashTrail11",cos(velx)*-8,0,sin(velz)*-8,0,0,0,0,SXF_NOCHECKPOSITION) TNT1 A 0 A_Explode(20,52,0,false,24) SPIR P 1 Bright Light("CBISHOPSWORD") A_FadeOut(0.075)
        stop

      Death:
        TNT1 A 0 A_Explode(30,52,0,false,24)
        goto DeathFinish
    }
}

actor ClericSwordSlashTrail
{
    Radius 16
    Alpha 0.5
    +CLIENTSIDEONLY
    +NOINTERACTION
    States
    {
      Spawn:
        SPIR P 1 Bright A_FadeOut(0.05)
        wait
    }
}

actor ClericSwordSlashTrail2 : ClericSwordSlashTrail { Alpha 0.45 }
actor ClericSwordSlashTrail3 : ClericSwordSlashTrail { Alpha 0.4 }
actor ClericSwordSlashTrail4 : ClericSwordSlashTrail { Alpha 0.4 }
actor ClericSwordSlashTrail5 : ClericSwordSlashTrail { Alpha 0.35 }
actor ClericSwordSlashTrail6 : ClericSwordSlashTrail { Alpha 0.3 }
actor ClericSwordSlashTrail7 : ClericSwordSlashTrail { Alpha 0.25 }
actor ClericSwordSlashTrail8 : ClericSwordSlashTrail { Alpha 0.2 }
actor ClericSwordSlashTrail9 : ClericSwordSlashTrail { Alpha 0.15 }
actor ClericSwordSlashTrail10 : ClericSwordSlashTrail { Alpha 0.1 }
actor ClericSwordSlashTrail11 : ClericSwordSlashTrail { Alpha 0.05 }

actor ClericSwordThrowContinue : Boolean {}

actor ClericSwordThrow
{
    Projectile
    Radius 16
    Speed 24
    Damage (8)
    DamageType "Fire"
    RenderStyle "Translucent"
    Alpha 0.67
    +FORCERADIUSDMG
    +NODAMAGETHRUST
    +THRUACTORS //Because this has to work on hellknights
    States
    {
      Spawn:
        H133 A 0 Bright Light("CBISHOPSWORD") NoDelay A_PlaySound("FighterHammerContinuous")
        H133 AABBCCDDEEFFGGHH 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
        loop

      /*ReturnBlade:
        TNT1 A 1 A_Die("ReturnBlade")
        loop*/

      Death:
        TNT1 A 0 A_SpawnItemEx("ClericSwordWallPowered")
        TNT1 A 0 A_PlaySound("HolySymbolFire",CHAN_VOICE)
      //Death.ReturnBlade:
        TNT1 A 0 A_ChangeFlag("NOINTERACTION",true)
        TNT1 A 0 ACS_NamedExecuteWithResult("HexenBishopSwordReturn")
      DeathLoop:
        TNT1 A 0 A_PlaySound("Hexen/SwordSwing")
        H133 AABBCCDDEEFFGGHH 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32) // was A_Explode every 2 tics; is this too much?
        loop
    }
}

actor ClericSwordThrowCoop : ClericSwordThrow
{
    Species "Player"
    +THRUSPECIES
}

actor ClericSwordWallPowered
{
    Radius 16
    RenderStyle "Add"
    +CLIENTSIDEONLY
    +NOINTERACTION
    +PUFFGETSOWNER
    +PUFFONACTORS
    States
    {
      Spawn:
        SPIR P 0 A_FaceTarget
        goto FadeOut

      Melee:
        TNT1 A 0 A_PlaySound("SpiritAttack")
        goto FadeOut

      XDeath:
        TNT1 A 0 A_PlaySound("FighterAxeHitThing")
        goto FadeOut

      FadeOut:
        H128 ABCDEFGHIJKLMNOPQR 3 Bright
        stop
    }
}

// Wand of Embers

actor "Wand of Embers" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Wand of Embers"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust -12
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 4
    Obituary "$SAMSARA_HEXEN_OB_SLOT3_LOADOUT1"
    Tag "Wand of Embers"
    States
    {
      Spawn:
        H119 R 1
        loop

      Ready:
        H119 R 1 A_WeaponReady
        loop

      Deselect:
        H119 R 1 A_Lower
        loop

      Select:
        H119 R 1 A_Raise
        loop

      Fire:
        H119 S 2 A_PlaySound("Hexen/WandOfEmbers/Open")
        H119 T 2
        H119 U 2 Bright
      Hold:
        H119 V 6 Bright A_GiveInventory("SamsaraHexenWandOfEmbersAttackHandler")
        H119 W 6 Bright
        H119 T 11
        H119 S 5 A_ReFire
        H119 R 6
        goto Ready
    }
}

actor SamsaraHexenWandOfEmbersAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",4)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Hexen/WandOfEmbers/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenWandOfEmbersBall",0,false)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenWandOfEmbersBallCoop",0,false)
        stop
    }
}

actor SamsaraHexenWandOfEmbersBall
{
    Projectile
    Radius 8
    Height 8
    Speed 32
    Damage (random(6,13)*10)
    DamageType "Fire"
    Gravity 0.8
    RenderStyle "Add"
    Alpha 0.75
    Scale 2.75
    DeathSound "Hexen/WandOfEmbers/Hit"
    Decal "HexenEmberWandScorch"
    -BLOODSPLATTER
    +BLOODLESSIMPACT
    -NOGRAVITY
    States
    {
      Spawn:
        H121 AABBB 1 Bright Light("CEMBERWANDBALL1") A_SpawnItemEx("SamsaraHexenWandOfEmbersTrail")
        loop

      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_CustomMissile("SamsaraHexenEmberGem",0,0,0,CMF_TRACKOWNER)
      DeathFinish:
        H121 C 3 Bright Light("CEMBERWANDBALL2")
        H121 D 3 Bright Light("CEMBERWANDBALL3")
        H121 E 3 Bright Light("CEMBERWANDBALL4")
        H121 F 3 Bright Light("CEMBERWANDBALL5")
        H121 G 3 Bright Light("CEMBERWANDBALL6")
        stop
    }
}

actor SamsaraHexenWandOfEmbersBallCoop : SamsaraHexenWandOfEmbersBall
{
    Species "Player"
    +THRUSPECIES
    States
    {
      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_CustomMissile("SamsaraHexenEmberGemCoop",0,0,0,CMF_TRACKOWNER)
        goto DeathFinish
    }
}

actor SamsaraHexenWandOfEmbersTrail
{
    RenderStyle "Add"
    Alpha 0.5
    Scale 2.75
    +CLIENTSIDEONLY
    +NOINTERACTION
    States
    {
      Spawn:
        TNT1 A 2
        H121 HIJ 3 Bright
        stop
    }
}

actor SamsaraHexenEmberGem
{
    Projectile
    Radius 2
    Height 2
    DamageType "Fire"
    Scale 2.75
    +FLOORHUGGER
    +FORCERADIUSDMG
    //+RIPPER
    +THRUACTORS
    States
    {
      Spawn:
        H120 ABC 4 Bright Light("CEMBERWANDGEM") A_Explode(3,33,0)
        TNT1 A 0 A_Countdown
        loop

      Death:
        H121 D 3 Bright Light("CEMBERWANDBALL3")
        H121 E 3 Bright Light("CEMBERWANDBALL4")
        H121 F 3 Bright Light("CEMBERWANDBALL5")
        H121 G 3 Bright Light("CEMBERWANDBALL6")
        stop
    }
}

actor SamsaraHexenEmberGemCoop : SamsaraHexenEmberGem
{
    Species "Player"
    +THRUSPECIES
}

// Parias (Classic)/Baratus

actor SamsaraHexenTimonsAxeDirectionCounter : Boolean {}

actor "Timon's Axe" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Timon's Axe"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust -12
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT3"
    Tag "Timon's Axe"
    +AMMO_OPTIONAL
    +AXEBLOOD
    +MELEEWEAPON
    +NOALERT
    States
    {
      Spawn:
        WFAX A -1
        stop

      // Parias (Classic)
      Ready:
        TNT1 A 0 A_TakeInventory("SamsaraHexenTimonsAxeDirectionCounter")
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"ReadyFighter")
      ReadyClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"ReadyClericClassicAmmo")
        goto ReadyClericClassicNoAmmo

      ReadyClericClassicNoAmmo:
        FAXE A 1 A_WeaponReady
        goto Ready

      ReadyClericClassicAmmo:
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_TakeInventory("SamsaraHexenTimonsAxeDirectionCounter")
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"DeselectFighter")
      DeselectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"DeselectClericClassicAmmo")
        goto DeselectClericClassicNoAmmo

      DeselectClericClassicNoAmmo:
        FAXE A 1 A_Lower
        goto Deselect

      DeselectClericClassicAmmo:
        FAXE L 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_TakeInventory("SamsaraHexenTimonsAxeDirectionCounter")
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"SelectFighter")
      SelectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"SelectClericClassicAmmo")
        goto SelectClericClassicNoAmmo

      SelectClericClassicNoAmmo:
        FAXE A 1 A_Raise
        goto Select

      SelectClericClassicAmmo:
        FAXE L 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"FireFighter")
      FireClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicAmmo")
        goto FireClericClassicNoAmmo

      FireClericClassicNoAmmo:
        FAXE B 4 Offset(15,32)
        FAXE C 3 Offset(15,32)
        FAXE D 2 Offset(15,32)
        goto FireClericClassicContinue1

      FireClericClassicAmmo:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,1)
        goto FireClericClassicAmmo1
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenTimonsAxeDirectionCounter",1,"FireClericClassicAmmo2")
      FireClericClassicAmmo1:
        FAXE N 4 Bright Offset(15,32)
        FAXE O 3 Bright Offset(15,32)
        FAXE P 2 Bright Offset(15,32)
        goto FireClericClassicContinue1

      FireClericClassicContinue1:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler") // originally jumped a frame if ammo ended up being 0 with this; let's not do that this time
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicContinue1Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicContinue1Ammo")
        goto FireClericClassicContinue1NoAmmo

      FireClericClassicContinue1NoAmmo:
        FAXE D 1 Offset(-5,70)
        FAXE D 2 Offset(-25,90)
        FAXE E 1 Offset(15,32)
        FAXE E 2 Offset(10,54)
        FAXE E 7 Offset(10,150)
        goto FireClericClassicFinish1

      FireClericClassicContinue1Ammo:
        FAXE P 1 Bright Offset(-5,70)
        FAXE P 2 Bright Offset(-25,90)
        FAXE Q 1 Bright Offset(15,32)
        FAXE Q 2 Bright Offset(10,54)
        FAXE Q 7 Bright Offset(10,150)
        goto FireClericClassicFinish1

      FireClericClassicFinish1:
        TNT1 A 0 A_ReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicFinish1Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicFinish1Ammo")
        goto FireClericClassicFinish1NoAmmo

      FireClericClassicFinish1NoAmmo:
        FAXE A 1 Offset(0,60)
        FAXE A 1 Offset(0,52)
        FAXE A 1 Offset(0,44)
        FAXE A 2 Offset(0,36)
        goto Ready

      FireClericClassicFinish1Ammo:
        FAXE L 1 Bright Offset(0,60)
        FAXE L 1 Bright Offset(0,52)
        FAXE L 1 Bright Offset(0,44)
        FAXE L 2 Bright Offset(0,36)
        goto Ready

      FireClericClassicAmmo2:
        FAXE Y 2 Bright Offset(100,80)
        FAXE Y 2 Bright Offset(80,75)
        FAXE Y 2 Bright Offset(60,70)
        FAXE Z 2 Bright Offset(10,70)
        goto FireClericClassicContinue2

      FireClericClassicContinue2:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicContinue2Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicContinue2Ammo")
        goto FireClericClassicContinue2NoAmmo

      FireClericClassicContinue2NoAmmo: // currently no sprites for ammo ending up being 0
      FireClericClassicContinue2Ammo:
        FAXE Z 2 Bright Offset(10,70)
        FAXE Z 2 Bright Offset(-20,60)
        FAXE "[" 2 Bright Offset(40,80)
        FAXE "[" 2 Bright Offset(-20,90)
        FAXE "]" 2 Bright Offset(-40,130)
        TNT1 A 10
        goto Ready

      // Baratus
      ReadyFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"ReadyFighterAmmo")
        goto ReadyFighterNoAmmo

      ReadyFighterNoAmmo:
        FAXE A 1 A_WeaponReady
        goto Ready

      ReadyFighterAmmo:
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        goto Ready

      DeselectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"DeselectFighterAmmo")
        goto DeselectFighterNoAmmo

      DeselectFighterNoAmmo:
        FAXE A 1 A_Lower
        goto Deselect

      DeselectFighterAmmo:
        FAXE L 1 Bright A_Lower
        goto Deselect

      SelectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"SelectFighterAmmo")
        goto SelectFighterNoAmmo

      SelectFighterNoAmmo:
        FAXE A 1 A_Raise
        goto Select

      SelectFighterAmmo:
        FAXE L 1 Bright A_Raise
        goto Select

      FireFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterAmmo")
        goto FireFighterNoAmmo

      FireFighterNoAmmo:
        H104 B 4 Offset(15,32)
        H104 C 3 Offset(15,32)
        H104 D 2 Offset(15,32)
        goto FireFighterContinue1

      FireFighterAmmo:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,1)
        goto FireFighterAmmo1
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenTimonsAxeDirectionCounter",1,"FireFighterAmmo2")
      FireFighterAmmo1:
        H104 N 4 Bright Offset(15,32)
        H104 O 3 Bright Offset(15,32)
        H104 P 2 Bright Offset(15,32)
        goto FireFighterContinue1

      FireFighterContinue1:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler") // originally jumped a frame if ammo ended up being 0 with this; let's not do that this time
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterContinue1Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterContinue1Ammo")
        goto FireFighterContinue1NoAmmo

      FireFighterContinue1NoAmmo:
        H104 D 1 Offset(-5,70)
        H104 D 2 Offset(-25,90)
        FAXE E 1 Offset(15,32)
        FAXE E 2 Offset(10,54)
        FAXE E 7 Offset(10,150)
        goto FireFighterFinish1

      FireFighterContinue1Ammo:
        H104 P 1 Bright Offset(-5,70)
        H104 P 2 Bright Offset(-25,90)
        FAXE Q 1 Bright Offset(15,32)
        FAXE Q 2 Bright Offset(10,54)
        FAXE Q 7 Bright Offset(10,150)
        goto FireFighterFinish1

      FireFighterFinish1:
        TNT1 A 0 A_ReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterFinish1Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterFinish1Ammo")
        goto FireFighterFinish1NoAmmo

      FireFighterFinish1NoAmmo:
        FAXE A 1 Offset(0,60)
        FAXE A 1 Offset(0,52)
        FAXE A 1 Offset(0,44)
        FAXE A 2 Offset(0,36)
        goto Ready

      FireFighterFinish1Ammo:
        FAXE L 1 Bright Offset(0,60)
        FAXE L 1 Bright Offset(0,52)
        FAXE L 1 Bright Offset(0,44)
        FAXE L 2 Bright Offset(0,36)
        goto Ready

      FireFighterAmmo2:
        FAXE Y 2 Bright Offset(100,80)
        FAXE Y 2 Bright Offset(80,75)
        FAXE Y 2 Bright Offset(60,70)
        FAXE Z 2 Bright Offset(10,70)
        goto FireFighterContinue2

      FireFighterContinue2:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterContinue2Ammo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterContinue2Ammo")
        goto FireFighterContinue2NoAmmo

      FireFighterContinue2NoAmmo: // currently no sprites for ammo ending up being 0
      FireFighterContinue2Ammo:
        FAXE Z 2 Bright Offset(10,70)
        FAXE Z 2 Bright Offset(-20,60)
        FAXE "[" 2 Bright Offset(40,80)
        FAXE "[" 2 Bright Offset(-20,90)
        FAXE "]" 2 Bright Offset(-40,130)
        TNT1 A 10
        goto Ready
    }
}

actor SamsaraHexenTimonsAxeAttackHandler : Trigger
{
    States
    {
      // Ammo checking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto PickupAttackWeak
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,1)
        goto PickupAttack
        TNT1 A 0 A_TakeInventory("Clip",3)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackStrongPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackStrongPowered")
        goto PickupAttackStrongUnpowered

      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
