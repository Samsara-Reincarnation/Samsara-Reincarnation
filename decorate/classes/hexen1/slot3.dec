}

// Daedolon

actor "Fire Blast" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Fire Blast"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust 20
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT3"
    Tag "Fire Blast"
    States
    {
      Spawn:
        H113 XYZ 8 Bright
        loop

      Ready:
	    H113 A 0 A_StopSound(CHAN_WEAPON)
        H113 AAAABBBBCCCC 1 A_WeaponReady
        loop

      Deselect:
        H113 A 1 A_Lower
        loop

      Select:
        H113 A 1 A_Raise
        loop

      Fire:
		H113 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"FirePowered")
        H113 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FirePowered")
        H113 DEF 3
        H113 G 5
        H113 H 3 Bright
        H113 F 3 Bright A_GiveInventory("SamsaraHexenFireBlastAttackHandler")
        H113 E 3 Bright
        H113 D 3
        H113 A 2 A_ReFire
        goto Ready
	
	  FirePowered:
		H113 D 0 A_PlaySound("Hexen/FireLaunch",CHAN_5)
		H113 DEF 3
        H113 G 5 A_PlaySound("Hexen/FireLoop",CHAN_WEAPON,1.0,true)
	  FirePoweredLoop:
        H113 H 4 Bright A_GiveInventory("SamsaraHexenFireBlastAttackHandler")
        TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,3)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,2)
        TNT1 A 0 A_CheckReload
        goto FirePoweredFinish
        TNT1 A 0 A_ReFire("FirePoweredLoop")
        goto FirePoweredFinish
	  FirePoweredFinish:
		H113 F 0 A_StopSound(CHAN_WEAPON)
		H113 F 3 Bright
		H113 E 3 Bright
        H113 D 3
		Goto Ready
    }
}

actor SamsaraHexenFireBlastAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
	    TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",3)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("hexen/fireblast/fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",0,false,-4,8)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",3,false,-4,8,0,-1)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",0,false,-4,8,0,-3)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",-3,false,-4,8,0,-1)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",1,false,-4,8,0,2)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_Missile",-1,false,-4,8,0,2)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",0,false,-4,8)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",3,false,-4,8,0,-1)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",0,false,-4,8,0,-3)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",-3,false,-4,8,0,-1)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",1,false,-4,8,0,2)
        TNT1 A 0 A_FireCustomMissile("MWeapFire_MissileCoop",-1,false,-4,8,0,2)
        stop
		
	  //Powered!
	  PickupAttackPowered:
		TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackPoweredDecide")
        TNT1 A 0 A_JumpIfInventory("Clip",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",1)
        goto PickupAttackPoweredDecide
	  PickupAttackPoweredDecide:
		TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackPoweredCoop")
	  PickupAttackDM:
		TNT1 A 0 A_FireCustomMissile("MWeapFire_Crawler",random(-10,10),false,-4,8)
		stop
	  PickupAttackPoweredCoop:
		TNT1 A 0 A_FireCustomMissile("MWeapFire_CrawlerCoop",random(-10,10),false,-4,8)
		stop
    }
}

actor MWeapFire_Missile : FireBall
{
    Projectile
    Speed 32
    DeathSound "ClericFlameCircle"
    Obituary "%k toasted %o with the Fire Blast!"
    +BLOODSPLATTER
    States
    {
      Spawn:
        FBL1 AB 4 Bright Light("MFIREBLAST")
        loop

      Death:
        XPL1 A 4 Bright Light("TIMEBOMB_X1")
        XPL1 B 4 Bright Light("TIMEBOMB_X2")
        XPL1 C 4 Bright Light("TIMEBOMB_X3")
        XPL1 D 4 Bright Light("TIMEBOMB_X4")
        XPL1 EF 4 Bright Light("TIMEBOMB_X5")
        stop
    }
}

actor MWeapFire_MissileCoop : MWeapFire_Missile
{
    Species "Player"
    +THRUSPECIES
}

actor MWeapFire_Crawler : MWeapFire_Missile
{
    Projectile
    Speed 16
    DeathSound "ClericFlameCircle"
    Obituary "%k toasted %o with the Fire Blast!"
    +BLOODSPLATTER
	+THRUACTORS
    States
    {
      Spawn:
        TNT1 A 4 A_SpawnItemEx("MWeapFire_CrawlerFlame",0,0,floorz,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_ABSOLUTEPOSITION)
        Loop

      Death:
        TNT1 A 1
        stop
    }
}

