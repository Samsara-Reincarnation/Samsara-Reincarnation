actor ClericSwordThrowContinue : TemporaryBoolean {}

actor ClericSwordThrow
{
    Projectile
    Radius 16
    Speed 24
    Damage (8)
    DamageType "Fire"
	Alpha 0.67
	Renderstyle Translucent
    +FORCERADIUSDMG
    +NODAMAGETHRUST
    +THRUACTORS //Because this has to work on hellknights
    States
    {
      Spawn:
		H133 A 0 NoDelay A_PlaySound("FighterHammerContinuous",CHAN_5)
        H133 A 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 A 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 B 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 B 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 C 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 C 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 D 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 D 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 E 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 E 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 F 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 F 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 G 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 G 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 H 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
		H133 H 1 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
        Loop
	  ReturnBlade:
		TNT1 A -1 A_Die("ReturnBlade")
        Wait
      Death:
        TNT1 A 0 A_SpawnItemEx("ClericSwordWallPowered")
        TNT1 A 0 A_PlaySound("HolySymbolFire",CHAN_VOICE)
	  Death.ReturnBlade:
		TNT1 A 0 A_ChangeFlag("NOINTERACTION",true)
		TNT1 A 0 A_Stop
		TNT1 A 0 ACS_NamedExecuteWithResult("HexenBishopSwordReturn")
	  ReturnBladeLoop:
		H133 A 0 A_PlaySound("Hexen/SwordSwing",CHAN_5)
		H133 ABCDEFGH 2 Bright Light("CBISHOPSWORD") A_Explode(50,32,0,false,32)
        Loop
    }
}

actor ClericSwordThrowCoop : ClericSwordThrow
{
    Species "Player"
    +THRUSPECIES
}

actor ClericSwordWallPowered
{
    Radius 16
	Renderstyle Add
    +CLIENTSIDEONLY
    +NOINTERACTION
    +PUFFGETSOWNER
    +PUFFONACTORS
    States
    {
      Spawn:
        SPIR P 0 A_FaceTarget
        goto FadeOut

      Melee:
        TNT1 A 0 A_PlaySound("SpiritAttack")
        goto FadeOut

      XDeath:
        TNT1 A 0 A_PlaySound("FighterAxeHitThing")
        goto FadeOut

      FadeOut:
        H128 ABCDEFGHIJKLMNOPQR 3 Bright
        Stop
    }
}

// Wand of Embers

actor "Wand of Embers" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Wand of Embers"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust -12
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 4
    Obituary "$SAMSARA_HEXEN_OB_SLOT3_LOADOUT1"
    Tag "Wand of Embers"
    States
    {
      Spawn:
        H119 R 1
        loop

      Ready:
        H119 R 1 A_WeaponReady
        loop

      Deselect:
        H119 R 1 A_Lower
        loop

      Select:
        H119 R 1 A_Raise
        loop

      Fire:
        H119 S 2 A_PlaySound("Hexen/WandOfEmbers/Open")
        H119 T 2
        H119 U 2 Bright
      Hold:
        H119 V 6 Bright A_GiveInventory("SamsaraHexenWandOfEmbersAttackHandler")
        H119 W 6 Bright
        H119 T 11
        H119 S 5 A_ReFire
        H119 R 6
        goto Ready
    }
}

actor SamsaraHexenWandOfEmbersAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",4,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",4)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("Hexen/WandOfEmbers/Fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenWandOfEmbersBall",0,false)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("SamsaraHexenWandOfEmbersBallCoop",0,false)
        stop
    }
}

actor SamsaraHexenWandOfEmbersBall
{
    Projectile
    Radius 8
    Height 8
    Speed 32
    Damage (random(6,13)*10)
    DamageType "Fire"
    Gravity 0.8
    RenderStyle "Add"
    Alpha 0.75
    Scale 2.75
    DeathSound "Hexen/WandOfEmbers/Hit"
    Decal "HexenEmberWandScorch"
    -BLOODSPLATTER
    +BLOODLESSIMPACT
    -NOGRAVITY
    States
    {
      Spawn:
        H121 AABBB 1 Bright Light("CEMBERWANDBALL1") A_SpawnItemEx("SamsaraHexenWandOfEmbersTrail")
        loop

      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_CustomMissile("SamsaraHexenEmberGem",0,0,0,CMF_TRACKOWNER)
      DeathFinish:
        H121 C 3 Bright Light("CEMBERWANDBALL2")
        H121 D 3 Bright Light("CEMBERWANDBALL3")
        H121 E 3 Bright Light("CEMBERWANDBALL4")
        H121 F 3 Bright Light("CEMBERWANDBALL5")
        H121 G 3 Bright Light("CEMBERWANDBALL6")
        stop
    }
}

actor SamsaraHexenWandOfEmbersBallCoop : SamsaraHexenWandOfEmbersBall
{
    Species "Player"
    +THRUSPECIES
    States
    {
      Death:
        TNT1 A 0 A_NoGravity
        TNT1 A 0 A_CustomMissile("SamsaraHexenEmberGemCoop",0,0,0,CMF_TRACKOWNER)
        goto DeathFinish
    }
}

actor SamsaraHexenWandOfEmbersTrail
{
    RenderStyle "Add"
    Alpha 0.5
    Scale 2.75
    +CLIENTSIDEONLY
    +NOINTERACTION
    States
    {
      Spawn:
        TNT1 A 2
        H121 HIJ 3 Bright
        stop
    }
}

actor SamsaraHexenEmberGem
{
    Projectile
    Radius 2
    Height 2
    DamageType "Fire"
    Scale 2.75
    +FLOORHUGGER
    +FORCERADIUSDMG
    //+RIPPER
    +THRUACTORS
    States
    {
      Spawn:
        H120 ABC 4 Bright Light("CEMBERWANDGEM") A_Explode(3,33,0)
        TNT1 A 0 A_Countdown
        loop

      Death:
        H121 D 3 Bright Light("CEMBERWANDBALL3")
        H121 E 3 Bright Light("CEMBERWANDBALL4")
        H121 F 3 Bright Light("CEMBERWANDBALL5")
        H121 G 3 Bright Light("CEMBERWANDBALL6")
        stop
    }
}

actor SamsaraHexenEmberGemCoop : SamsaraHexenEmberGem
{
    Species "Player"
    +THRUSPECIES
}

// Parias (Classic)/Baratus
Actor HexenAxeDirectionCounter : TemporaryBoolean {}

actor "Timon's Axe" : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Timon's Axe"
    Weapon.SlotNumber 3
    Weapon.SelectionOrder 1500
    Weapon.YAdjust -12
    Weapon.AmmoType "Clip"
    //Weapon.AmmoGive 25
    Weapon.AmmoUse 3
    Obituary "$SAMSARA_HEXEN_OB_SLOT3"
    Tag "Timon's Axe"
    +AMMO_OPTIONAL
    +AXEBLOOD
    +MELEEWEAPON
    +NOALERT
    States
    {
      Spawn:
        WFAX A -1
        stop

      // Parias (Classic)
      Ready:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"ReadyFighter")
      ReadyClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"ReadyClericClassicAmmo")
        goto ReadyClericClassicNoAmmo

      ReadyClericClassicNoAmmo:
        FAXE A 1 A_WeaponReady
        goto Ready

      ReadyClericClassicAmmo:
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"DeselectFighter")
      DeselectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"DeselectClericClassicAmmo")
        goto DeselectClericClassicNoAmmo

      DeselectClericClassicNoAmmo:
        FAXE A 1 A_Lower
        goto Deselect

      DeselectClericClassicAmmo:
        FAXE L 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"SelectFighter")
      SelectClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"SelectClericClassicAmmo")
        goto SelectClericClassicNoAmmo

      SelectClericClassicNoAmmo:
        FAXE A 1 A_Raise
        goto Select

      SelectClericClassicAmmo:
        FAXE L 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_JumpIfInventory("HexenClassMode",3,"FireFighter")
      FireClericClassic:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicAmmo")
        goto FireClericClassicNoAmmo

      FireClericClassicNoAmmo:
        FAXE B 4 Offset(15,32)
        FAXE C 3 Offset(15,32)
        FAXE D 2 Offset(15,32)
        goto FireClericClassicContinue

      FireClericClassicAmmo:
		TNT1 A 0 A_JumpIfInventory("HexenAxeDirectionCounter",1,1)
		Goto FireClericClassicAmmo+3
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"FireClericClassicAmmo2")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireClericClassicAmmo2")
        FAXE N 4 Bright Offset(15,32)
        FAXE O 3 Bright Offset(15,32)
        FAXE P 2 Bright Offset(15,32)
        goto FireClericClassicContinue

      FireClericClassicContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler") // originally jumped a frame if ammo ended up being 0 with this; let's not do that this time
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicContinueAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicContinueAmmo")
        goto FireClericClassicContinueNoAmmo

      FireClericClassicContinueNoAmmo:
        FAXE D 1 Offset(-5,70)
        FAXE D 2 Offset(-25,90)
        FAXE E 1 Offset(15,32)
        FAXE E 2 Offset(10,54)
        FAXE E 7 Offset(10,150)
        goto FireClericClassicFinish

      FireClericClassicContinueAmmo:
        FAXE P 1 Bright Offset(-5,70)
        FAXE P 2 Bright Offset(-25,90)
        FAXE Q 1 Bright Offset(15,32)
        FAXE Q 2 Bright Offset(10,54)
        FAXE Q 7 Bright Offset(10,150)
        goto FireClericClassicFinish

      FireClericClassicFinish:
        TNT1 A 0 A_ReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireClericClassicFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireClericClassicFinishAmmo")
        goto FireClericClassicFinishNoAmmo

      FireClericClassicFinishNoAmmo:
        FAXE A 1 Offset(0,60)
        FAXE A 1 Offset(0,52)
        FAXE A 1 Offset(0,44)
        FAXE A 2 Offset(0,36)
        goto Ready

      FireClericClassicFinishAmmo:
        FAXE L 1 Bright Offset(0,60)
        FAXE L 1 Bright Offset(0,52)
        FAXE L 1 Bright Offset(0,44)
        FAXE L 2 Bright Offset(0,36)
        goto Ready
		
	  FireClericClassicAmmo2:
		FAXE Y 2 Bright Offset(100, 80)
		FAXE Y 2 Bright Offset(80, 75)
		FAXE Y 2 Bright Offset(60, 70)
		FAXE Z 2 Bright Offset(10, 70)
		FAXE Z 2 Bright Offset(10, 70) A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler")
		FAXE Z 2 Bright Offset(-20, 60)
		FAXE "[" 2 Bright Offset(40, 80)
		FAXE "[" 2 Bright Offset(-20, 90)
		FAXE "]" 2 Bright Offset(-40, 130)
		TNT1 A 10
		goto Ready

      // Baratus
      ReadyFighter:
		TNT1 A 0 A_TakeInventory("HexenAxeDirectionCounter")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"ReadyFighterAmmo")
        goto ReadyFighterNoAmmo

      ReadyFighterNoAmmo:
        FAXE A 1 A_WeaponReady
        goto Ready

      ReadyFighterAmmo:
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE L 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Clip",3,1)
        goto Ready
        FAXE M 1 Bright A_WeaponReady
        goto Ready

      DeselectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"DeselectFighterAmmo")
        goto DeselectFighterNoAmmo

      DeselectFighterNoAmmo:
        FAXE A 1 A_Lower
        goto Deselect

      DeselectFighterAmmo:
        FAXE L 1 Bright A_Lower
        goto Deselect

      SelectFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"SelectFighterAmmo")
        goto SelectFighterNoAmmo

      SelectFighterNoAmmo:
        FAXE A 1 A_Raise
        goto Select

      SelectFighterAmmo:
        FAXE L 1 Bright A_Raise
        goto Select

      FireFighter:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterAmmo")
        goto FireFighterNoAmmo

      FireFighterNoAmmo:
        H104 B 4 Offset(15,32)
        H104 C 3 Offset(15,32)
        H104 D 2 Offset(15,32)
        goto FireFighterContinue

      FireFighterAmmo:
		TNT1 A 0 A_JumpIfInventory("HexenAxeDirectionCounter",1,1)
		Goto FireFighterAmmo+3
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"FireFighterAmmo2")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"FireFighterAmmo2")
        H104 N 4 Bright Offset(15,32)
        H104 O 3 Bright Offset(15,32)
        H104 P 2 Bright Offset(15,32)
        goto FireFighterContinue

      FireFighterContinue:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler") // originally jumped a frame if ammo ended up being 0 with this; let's not do that this time
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterContinueAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterContinueAmmo")
        goto FireFighterContinueNoAmmo

      FireFighterContinueNoAmmo:
        H104 D 1 Offset(-5,70)
        H104 D 2 Offset(-25,90)
        FAXE E 1 Offset(15,32)
        FAXE E 2 Offset(10,54)
        FAXE E 7 Offset(10,150)
        goto FireFighterFinish

      FireFighterContinueAmmo:
        H104 P 1 Bright Offset(-5,70)
        H104 P 2 Bright Offset(-25,90)
        FAXE Q 1 Bright Offset(15,32)
        FAXE Q 2 Bright Offset(10,54)
        FAXE Q 7 Bright Offset(10,150)
        goto FireFighterFinish

      FireFighterFinish:
        TNT1 A 0 A_ReFire
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFighterFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"FireFighterFinishAmmo")
        goto FireFighterFinishNoAmmo

      FireFighterFinishNoAmmo:
        FAXE A 1 Offset(0,60)
        FAXE A 1 Offset(0,52)
        FAXE A 1 Offset(0,44)
        FAXE A 2 Offset(0,36)
        goto Ready

      FireFighterFinishAmmo:
        FAXE L 1 Bright Offset(0,60)
        FAXE L 1 Bright Offset(0,52)
        FAXE L 1 Bright Offset(0,44)
        FAXE L 2 Bright Offset(0,36)
        goto Ready
		
      FireFighterAmmo2:
		FAXE Y 2 Bright Offset(100, 80)
		FAXE Y 2 Bright Offset(80, 75)
		FAXE Y 2 Bright Offset(60, 70)
		FAXE Z 2 Bright Offset(10, 70)
		FAXE Z 2 Bright Offset(10, 70) A_GiveInventory("SamsaraHexenTimonsAxeAttackHandler")
		FAXE Z 2 Bright Offset(-20, 60)
		FAXE "[" 2 Bright Offset(40, 80)
		FAXE "[" 2 Bright Offset(-20, 90)
		FAXE "]" 2 Bright Offset(-40, 130)
		TNT1 A 10
		goto Ready
		
      // "No ammo" switch
      NoAmmoSwitch:
        TNT1 A 0 A_ClearReFire
        TNT1 A 0 ACS_NamedExecuteWithResult("Hexen_SwitchPriority")
        goto Deselect
    }
}

actor SamsaraHexenTimonsAxeAttackHandler : Trigger
{
    States
    {
      // Ammo checking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",3,"PickupAttack")
        goto PickupAttackWeak

      // Attack stuff
	  PickupAttack:
		TNT1 A 0 A_JumpIfInventory("PowerSamsaraHexenWeaponLevel2",1,"PickupAttackPowered")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasPermaWeaponLevel2",1,"PickupAttackPowered")
		Goto PickupAttackStrong
      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackWeakCoop")
      PickupAttackWeakDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackWeakDMSpread")
        TNT1 A 0 A_CustomPunch(random(50,78),true,0,"AxePuff",144)
        stop

      PickupAttackWeakDMSpread:
        TNT1 A 0 A_CustomPunch(random(50,78)*3,true,0,"AxePuff",144)
        stop

      PickupAttackWeakCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackWeakCoopSpread")
        TNT1 A 0 A_CustomPunch(random(35,50),true,0,"AxePuffCoop",144)
        TNT1 A 0 A_CustomPunch(random(3,6),true,0,"BlankPuffAxeCoop",128)
        TNT1 A 0 A_CustomPunch(random(3,6),true,0,"BlankPuffAxeCoop",112)
        TNT1 A 0 A_CustomPunch(random(3,6),true,0,"BlankPuffAxeCoop",96)
        TNT1 AA 0 A_CustomPunch(5,true,0,"BlankPuffAxeCoop",84) // keeping the order intact
        TNT1 A 0 A_CustomPunch(random(3,6),true,0,"BlankPuffAxeCoop",80)
        TNT1 A 0 A_CustomPunch(random(3,6),true,0,"BlankPuffAxeCoop",64)
        stop

      PickupAttackWeakCoopSpread:
        TNT1 A 0 A_CustomPunch(random(35,50)*3,true,0,"AxePuffCoop",144)
        TNT1 A 0 A_CustomPunch(random(3,6)*3,true,0,"BlankPuffAxeCoop",128)
        TNT1 A 0 A_CustomPunch(random(3,6)*3,true,0,"BlankPuffAxeCoop",112)
        TNT1 A 0 A_CustomPunch(random(3,6)*3,true,0,"BlankPuffAxeCoop",96)
        TNT1 AA 0 A_CustomPunch(5*3,true,0,"BlankPuffAxeCoop",84)
        TNT1 A 0 A_CustomPunch(random(3,6)*3,true,0,"BlankPuffAxeCoop",80)
        TNT1 A 0 A_CustomPunch(random(3,6)*3,true,0,"BlankPuffAxeCoop",64)
        stop

      // Strong
      PickupAttackStrong:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrongInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongCoop")
      PickupAttackStrongDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongDMSpread")
        TNT1 A 0 A_CustomPunch(random(120,195),true,0,"AxePuffGlow2",144)
        stop

      PickupAttackStrongDMSpread:
        TNT1 A 0 A_CustomPunch(random(120,195)*3,true,0,"AxePuffGlow2",144)
        stop

      PickupAttackStrongCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongCoopSpread")
        TNT1 A 0 A_CustomPunch(random(80,130),true,0,"AxePuffGlow2Coop",144)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",112)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",96)
        TNT1 AAA 0 A_CustomPunch(5,true,0,"BlankPuffAxeGlowCoop",84)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",80)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",64)
        stop

      PickupAttackStrongCoopSpread:
        TNT1 A 0 A_CustomPunch(random(80,130)*3,true,0,"AxePuffGlow2Coop",144)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",112)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",96)
        TNT1 AAA 0 A_CustomPunch(5*3,true,0,"BlankPuffAxeGlowCoop",84)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",80)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",64)
        stop

      PickupAttackStrongInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongInfiniteCoop")
      PickupAttackStrongInfiniteDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongInfiniteDMSpread")
        TNT1 A 0 A_CustomPunch(random(120,195),true,0,"AxePuffGlow2Infinite",144)
        stop

      PickupAttackStrongInfiniteDMSpread:
        TNT1 A 0 A_CustomPunch(random(120,195)*3,true,0,"AxePuffGlow2Infinite",144)
        stop

      PickupAttackStrongInfiniteCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasSpread",1,"PickupAttackStrongInfiniteCoopSpread")
        TNT1 A 0 A_CustomPunch(random(80,130),true,0,"AxePuffGlow2InfiniteCoop",144)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",112)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",96)
        TNT1 AAA 0 A_CustomPunch(5,true,0,"BlankPuffAxeGlowCoop",84)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",80)
        TNT1 A 0 A_CustomPunch(random(8,13),true,0,"BlankPuffAxeGlowCoop",64)
        stop

      PickupAttackStrongInfiniteCoopSpread:
        TNT1 A 0 A_CustomPunch(random(80,130)*3,true,0,"AxePuffGlow2InfiniteCoop",144)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",112)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",96)
        TNT1 AAA 0 A_CustomPunch(5*3,true,0,"BlankPuffAxeGlowCoop",84)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",80)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",64)
        stop
		
	  //Powered!
	  PickupAttackPowered:
		TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackPoweredCoop")
	  PickupAttackPoweredDM:
		TNT1 A 0 A_JumpIfInventory("HexenAxeDirectionCounter",1,"PickupAttackPoweredDM2")
		TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWave",0,false,8)
		TNT1 A 0 A_GiveInventory("HexenAxeDirectionCounter")
		Stop
	  PickupAttackPoweredDM2:
		TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWave2",0,false,8)
		TNT1 A 0 A_TakeInventory("HexenAxeDirectionCounter")
		Stop
	  PickupAttackPoweredCoop:
		TNT1 A 0 A_JumpIfInventory("HexenAxeDirectionCounter",1,"PickupAttackPoweredCoop2")
		TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWaveCoop",0,false,8)
		TNT1 A 0 A_GiveInventory("HexenAxeDirectionCounter")
		Stop
	  PickupAttackPoweredCoop2:
		TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWave2Coop",0,false,8)
		TNT1 A 0 A_TakeInventory("HexenAxeDirectionCounter")
		Stop
    }
}

