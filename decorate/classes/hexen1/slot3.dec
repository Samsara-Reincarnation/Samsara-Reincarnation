        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",64)
        goto PickupFinishGive

      // Powered
      PickupAttackStrongPowered:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongPoweredCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongPoweredCoop")
      PickupAttackStrongPoweredDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenTimonsAxeDirectionCounter",1,2)
        TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWave",0,false,8)
        goto PickupFinishGive
