        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",128)
        TNT1 A 0 A_CustomPunch(random(8,13)*3,true,0,"BlankPuffAxeGlowCoop",112)
