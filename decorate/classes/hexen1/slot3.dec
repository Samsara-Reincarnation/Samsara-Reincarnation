        TNT1 A 0 A_FireCustomMissile("HexenAxeThunderWave2Coop",0,false,8)
        goto PickupFinishTake

      // Finishing stuff
      PickupFinishGive:
        TNT1 A 0 A_GiveInventory("SamsaraHexenTimonsAxeDirectionCounter")
        stop

      PickupFinishTake:
        TNT1 A 0 A_TakeInventory("SamsaraHexenTimonsAxeDirectionCounter")
        stop
    }
}

