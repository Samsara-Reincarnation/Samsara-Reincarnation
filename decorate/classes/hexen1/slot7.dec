// Powered

actor SamsaraHexenWraithvergePoweredAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",10,1)
        stop
        TNT1 A 0 A_JumpIfInventory("Cell",15,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",10)
        TNT1 A 0 A_TakeInventory("Cell",15)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("HolySymbolFire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("HolySpiritGood",0,false)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("HolySpiritGoodCoop",0,false)
        goto PickupFinish

      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("WeaponFlashesAreDisabled",1,"PickupStop")
        TNT1 A 0 A_GiveInventory("SamsaraHexenWeaponPaletteBlendCounter",3)
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraHexenWeaponPaletteBlend", 0)
        stop
    }
}

actor HolySpiritGood : HolySpiritDM
{
    Damage 0
    DamageType "HexenPurify"
    RenderStyle "Add"
    +HITTRACER
    +NODAMAGETHRUST
    -RIPPER
    States
    {
      Spawn:
        SPIR PPPP 3 Bright A_SpawnItemEx("HolyMissilePuff")
      SpawnSpiritInit:
        TNT1 A 0 A_ChangeVelocity(velx/2,vely/2,velz/2,CVF_REPLACE)
        TNT1 A 0 A_SetAngle(angle+frandom(-30.0,30.0))
        TNT1 A 0 ThrustThing(angle*256/360,6,0,0)
      SpawnSpiritStart:
        SPIR A 2 Bright Light("CBISHOPSWORD_X3") // do nothing at this state, as per engine behavior of ignoring most code pointers on first tic
        TNT1 A 0 A_Jump(256,"SpawnSpiritLoop2") // for actors inheriting from this actor
        goto SpawnSpiritLoop2

      SpawnSpiritLoop1:
        TNT1 A 0 A_SpawnItemEx("HolyMissilePuff2",0,0,-6,0,0,0,0,SXF_CLIENTSIDE) //ThrustThing(angle*256/360,4,0,0)
        TNT1 A 0 A_Weave(random(0,4),random(0,4),2,1)
        SPIR A 2 Bright Light("CBISHOPSWORD_X3") A_SeekerMissile(2,10,SMF_LOOK) //A_CHolySeek
        goto SpawnSpiritLoop2

      SpawnSpiritLoop2:
        TNT1 A 0 A_SpawnItemEx("HolyMissilePuff2",0,0,-6,0,0,0,0,SXF_CLIENTSIDE) //ThrustThing(angle*256/360,4,0,0)
        TNT1 A 0 A_Weave(random(0,4),random(0,4),2,1)
        SPIR A 2 Bright Light("CBISHOPSWORD_X3") A_SeekerMissile(2,10,SMF_LOOK) //A_CHolySeek
        goto SpawnSpiritLoop3

      SpawnSpiritLoop3:
        TNT1 A 0 A_SpawnItemEx("HolyMissilePuff2",0,0,-6,0,0,0,0,SXF_CLIENTSIDE) //ThrustThing(angle*256/360,4,0,0)
        TNT1 A 0 A_Weave(random(0,4),random(0,4),2,1)
        SPIR B 2 Bright Light("CBISHOPSWORD_X3") A_SeekerMissile(2,10,SMF_LOOK) //A_CHolySeek
        goto SpawnSpiritLoop4

      SpawnSpiritLoop4:
        TNT1 A 0 A_Jump(20,1)
        goto SpawnSpiritLoop4NoclipCheck
        TNT1 A 0 A_PlaySound("SpiritActive",CHAN_VOICE)
        goto SpawnSpiritLoop4NoclipCheck

      SpawnSpiritLoop4NoclipCheck:
        TNT1 A 0 A_JumpIfTargetInLOS(2,180,JLOSF_PROJECTILE)
        TNT1 A 0 A_ChangeFlag("NOCLIP",false)
        goto SpawnSpiritLoop4Start
        TNT1 A 0 A_ChangeFlag("NOCLIP",true)
        goto SpawnSpiritLoop4Start

      SpawnSpiritLoop4Start:
        TNT1 A 0 A_SpawnItemEx("HolyMissilePuff2",0,0,-6,0,0,0,0,SXF_CLIENTSIDE) //ThrustThing(angle*256/360,4,0,0)
        TNT1 A 0 A_Weave(random(0,4),random(0,4),2,1)
        SPIR B 2 Bright Light("CBISHOPSWORD_X3") A_SeekerMissile(2,10,SMF_LOOK) //A_CHolyCheckScream
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenWraithvergeGhostTimer",0,"TimeOut")
        TNT1 A 0 A_GiveInventory("SamsaraHexenWraithvergeGhostTimer")
        goto SpawnSpiritLoop1

      TimeOut:
        TNT1 A 0 A_ScaleVelocity(0.25)
        SPIR D 4 Bright Light("CBISHOPSWORD_X3") A_SetTics(random(1,4))
        goto DeathFinish

      Death:
        TNT1 A 0 ACS_NamedExecuteWithResult("HexenPurifierDamage", 200, 1000)
        //TNT1 A 0 A_SpawnItemEx("HolySpiritBurn") // currently not present
        H138 T 3 Bright Light("CBISHOPSWORD_X1") A_PlaySound("SpiritGoodImpact")
        H138 UVWX 3 Bright Light("CBISHOPSWORD_X1")
        stop
    }
}

actor HolySpiritGoodCoop : HolySpiritGood
{
    Species "Player"
    +THRUSPECIES
}

// TO-DO clean up!
// Our possessed enemy

actor HexenWraithvergeAlly : SamsaraMiscCharHumanoidStatic
{
    Monster
    Health 100
    Radius 20
    Height 52
    Speed 12
    Mass 200
    PainChance 100
    PainChance "HexenPurify", 0
    DamageFactor "HexenPurify", 0
    SeeSound "parias/see"
    PainSound "parias/pain"
    DeathSound "parias/death"
    Obituary "%o was slain by %k's minion."
    Species "Player"
    Tag "Wraithverge Minion" // placeholderish
    +DONTOVERLAP
    +FRIENDLY
	-COUNTKILL
    States
    {
      Spawn:
        H139 A 0 // allowing A_Look to take effect on first tic
        H139 AB 12 A_Look
        loop

      See:
        H139 ABCD 3 A_Chase
        loop

      Missile:
        TNT1 A 0 A_Jump(256,"MissileSerpentStaff","MissileFirestorm")
        //TNT1 A 0 A_Jump(256,"MissileSerpentStaff","MissileFirestorm","MissileRain")
      MissileSerpentStaff:
        H139 E 4 A_FaceTarget(0,180)
        TNT1 A 0 A_PlaySound("ClericCStaffFire",CHAN_WEAPON)
        TNT1 A 0 A_CustomMissile("SamsaraHexenCStaffMissile",32,-6,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        H139 J 5 Bright A_CustomMissile("SamsaraHexenCStaffMissile2",32,6,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        TNT1 A 0 A_Jump(8,"See")
        TNT1 A 0 A_JumpIfTargetInLOS("MissileSerpentStaff",0,JLOSF_DEADNOJUMP)
        goto See

      MissileFirestorm:
        H139 E 4 A_FaceTarget(0,180)
        H139 F 5
        H139 I 4
        TNT1 A 0 A_PlaySound("ClericFlameFire",CHAN_WEAPON)
        H139 G 5 Bright A_CustomMissile("CFlameMissileDM",32,0,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        H139 I 2
        H139 F 4
        goto See

      Melee:
        H139 E 4 A_FaceTarget
        H139 F 5 A_FaceTarget
        H139 G 2 A_CustomMeleeAttack(5,"FighterHammerHitThing","FighterHammerMiss","",true)
        H139 IF 4
        goto See

      Pain:
        H139 H 1 A_Pain
        H139 H 9
        goto See

      Death:
        TNT1 A 0 A_SpawnItemEx("UniversalBloodyHellGoreDeathEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
      Death.Massacre:
        H139 K 3
        H139 L 3 A_Scream
        H139 MN 6
        H139 O 3 A_NoBlocking
        H139 PQ 6
        H139 R -1
        stop

      XDeath:
        TNT1 A 0 A_SpawnItemEx("UniversalBloodyHellGoreXDeathEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
      XDeath.Massacre:
        H139 S 5 A_PlaySound("parias/crazydeath",CHAN_VOICE)
        H139 T 5
        H139 U 5 A_NoBlocking
        H139 VWXYZ 5
        H139 "[" -1
        stop

      Death.RemoveAlly:
        TNT1 A 0 A_PlaySound("SpiritDie",CHAN_VOICE)
        TNT1 A 0 A_SpawnItemEx("SamsaraHexenMinotaurSmoke")
        TNT1 A 1 A_NoBlocking
        stop
    }
}

actor HexenWraithvergeAllyCoop : HexenWraithvergeAlly
{
    +THRUSPECIES
    States
    {
      MissileSerpentStaff:
        H139 E 4 A_FaceTarget(0,180)
        TNT1 A 0 A_PlaySound("ClericCStaffFire",CHAN_WEAPON)
        TNT1 A 0 A_CustomMissile("SamsaraHexenCStaffMissileCoop",32,-6,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        H139 J 5 Bright A_CustomMissile("SamsaraHexenCStaffMissile2Coop",32,6,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        TNT1 A 0 A_Jump(8,"See")
        TNT1 A 0 A_JumpIfTargetInLOS("MissileSerpentStaff",0,JLOSF_DEADNOJUMP)
        goto See

      MissileFirestorm:
        H139 E 4 A_FaceTarget(0,180)
        H139 F 5
        H139 I 4
        TNT1 A 0 A_PlaySound("ClericFlameFire",CHAN_WEAPON)
        H139 G 5 Bright A_CustomMissile("CFlameMissile2",32,0,0,CMF_AIMDIRECTION,CallACS("InvertForPort", pitch))
        H139 I 2
        H139 F 4
        goto See
    }
}

// Daedolon

actor Bloodscourge : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Bloodscourge"
    Weapon.SelectionOrder 3100
    Weapon.YAdjust 20
    Weapon.AmmoType1 "Clip"
    Weapon.AmmoGive1 25
    Weapon.AmmoUse1 15
    Weapon.AmmoType2 "Cell"
    Weapon.AmmoGive2 25
    Weapon.AmmoUse2 15
    Obituary "$SAMSARA_HEXEN_OB_SLOT7"
    Tag "Bloodscourge"
    +BFG
    +PRIMARY_USES_BOTH
    States
    {
      Spawn:
        H105 A -1 Bright
        stop

      Ready:
        TNT1 A 0 A_TakeInventory("SamsaraHexenWeaponPaletteBlendCounter")
        MSTF AAAAAABBBBBBCCCCCCDDDDDDEEEEEEFFFFF 1 A_WeaponReady
        loop

      Deselect:
        TNT1 A 0 A_TakeInventory("SamsaraHexenWeaponPaletteBlendCounter")
        MSTF A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_TakeInventory("SamsaraHexenWeaponPaletteBlendCounter")
        MSTF A 1 A_Raise
        loop

      Fire:
        MSTF G 4 Offset(0,40)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",15,1)
        goto FireContinue
        TNT1 A 0 A_JumpIfInventory("Cell",15,1)
        goto FireContinue
        TNT1 A 0 A_GunFlash("Flash",GFF_NOEXTCHANGE)
        goto FireContinue

      FireContinue:
        MSTF H 4 Bright Offset(0,48) A_GiveInventory("SamsaraHexenBloodscourgeAttackHandler")
        MSTF H 2 Bright Offset(0,48) A_TakeInventory("SamsaraHexenWeaponPaletteBlendCounter",1)
        MSTF II 2 Offset(0,48) A_TakeInventory("SamsaraHexenWeaponPaletteBlendCounter",1)
        MSTF I 1 Offset(0,40)
        MSTF J 5 Offset(0,36)
        goto Ready

      Flash:
        TNT1 A 4 Bright A_Light1
        TNT1 A 2 Bright
        goto LightDone
    }
}

actor SamsaraHexenBloodscourgeAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",15,1)
        stop
        TNT1 A 0 A_JumpIfInventory("Cell",15,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",15)
        TNT1 A 0 A_TakeInventory("Cell",15)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("MageStaffFire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3",0,false,0,8)
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3",-3,false,0,8)
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3",3,false,0,8)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3Coop",0,false,0,8)
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3Coop",-3,false,0,8)
        TNT1 A 0 A_FireCustomMissile("MageStaffFX3Coop",3,false,0,8)
        goto PickupFinish

      // Finishing stuff
      PickupFinish:
        TNT1 A 0 A_JumpIfInventory("WeaponFlashesAreDisabled",1,"PickupStop")
        TNT1 A 0 A_GiveInventory("SamsaraHexenWeaponPaletteBlendCounter",3)
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraHexenWeaponPaletteBlend", 1)
        stop
    }
}

actor MageStaffFX3 : MageStaffFX2 //Needed for special mage staff ripper that rips everything except bosses
{
    Projectile
    Radius 2
    Height 2
    Speed 17
    Damage 8 // was 16. Nerfed because it turns out 16 damage with hexen native super ripper is way too much
    DamageType "Fire"
    DeathSound "MageStaffExplode"
    Decal "Scorch"
    Obituary "$SAMSARA_HEXEN_OB_INSTAGIB"
    +BLOODSPLATTER
    //+EXTREMEDEATH
    //+SCREENSEEKER
    //+SEEKERMISSILE
    States
    {
      Spawn:
        MSP2 AABBCCDD 1 Bright Light("BSBALL") A_MStaffTrack
        loop

      Death:
        MSP2 E 4 Bright Light("BSBALL_X1") A_SetTranslucent(1,1)
        TNT1 A 0 A_Explode(80,192,0)
        TNT1 A 0 A_ChangeFlag("FORCERADIUSDMG",true)
        TNT1 A 0 A_Explode(80,192,0) // total was 80 damage
      DeathFinish:
        MSP2 F 5 Bright Light("BSBALL_X2")
        MSP2 G 5 Bright Light("BSBALL_X3")
        MSP2 H 5 Bright Light("BSBALL_X4")
        MSP2 I 4 Bright
        stop
    }
}

actor MageStaffFX3Coop : MageStaffFX3
{
    Species "Player"
    +THRUSPECIES
}

// Baratus

actor SamsaraHexenQuietusMeleePuffSpawned : Boolean {}
actor SamsaraHexenQuietusMeleeAmmoTaken : Boolean {}

actor Quietus : SamsaraHexenWeapon
{
    Inventory.PickupMessage "Quietus"
    Weapon.SelectionOrder 2900
    Weapon.YAdjust 10
    Weapon.AmmoType1 "Clip"
    Weapon.AmmoGive1 25
    Weapon.AmmoUse1 7
    Weapon.AmmoType2 "Cell"
    Weapon.AmmoGive2 25
    Weapon.AmmoUse2 7
    Obituary "$SAMSARA_HEXEN_OB_SLOT7"
    Tag "Quietus"
    +ALT_AMMO_OPTIONAL
    +AMMO_OPTIONAL
    +BFG
    +EXPLOSIVE
    +NOALERT
    +PRIMARY_USES_BOTH
    States
    {
      Spawn:
        H102 P -1 Bright
        stop

      Ready:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"ReadyAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto ReadyNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"ReadyAmmo")
        goto ReadyNoAmmo

      ReadyNoAmmo:
        H102 J 1 A_WeaponReady
        goto Ready

      ReadyAmmo:
        H102 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 A 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 B 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 C 1 Bright A_WeaponReady
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,3)
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("Cell",7,1)
        goto Ready
        H102 C 1 Bright A_WeaponReady
        goto Ready

      Deselect:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"DeselectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto DeselectNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"DeselectAmmo")
        goto DeselectNoAmmo

      DeselectNoAmmo:
        H102 J 1 A_Lower
        goto Deselect

      DeselectAmmo:
        H102 A 1 Bright A_Lower
        goto Deselect

      Select:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"SelectAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto SelectNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"SelectAmmo")
        goto SelectNoAmmo

      SelectNoAmmo:
        H102 J 1 A_Raise
        goto Select

      SelectAmmo:
        H102 A 1 Bright A_Raise
        goto Select

      Fire:
        TNT1 A 0 A_TakeInventory("SamsaraHexenQuietusMeleePuffSpawned")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto FireNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"FireAmmo")
        goto FireNoAmmo

      FireNoAmmo:
        H102 KL 3 Offset(5,36)
        H102 M 2 Offset(5,36)
        goto FireContinueAttack

      FireAmmo:
        H102 DE 3 Bright Offset(5,36)
        H102 F 2 Bright Offset(5,36)
        goto FireContinueAttack

      FireContinueAttack:
        TNT1 A 0 A_JumpIfCloser(128,"FireContinueAttackMeleeOnly") // imperfect hack for non-bleeding actors
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusMeleeAttackHandler")
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusRangedAttackHandler")
        goto FireContinue

      FireContinueAttackMeleeOnly:
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusMeleeAttackHandler")
        goto FireContinue

      FireContinue:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireContinueAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto FireContinueNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"FireContinueAmmo")
        goto FireContinueNoAmmo

      FireContinueNoAmmo:
        H102 N 3 Offset(5,36)
        H102 O 2 Offset(5,36)
        TNT1 A 2 Offset(5,36)
        TNT1 A 10 Offset(5,150)
        goto FireFinish

      FireContinueAmmo:
        H102 G 3 Bright Offset(5,36)
        H102 H 2 Bright Offset(5,36)
        H102 I 2 Bright Offset(5,36)
        H102 I 10 Bright Offset(5,150)
        goto FireFinish

      FireFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireFinishAmmo")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto FireFinishNoAmmo
        TNT1 A 0 A_JumpIfInventory("Cell",7,"FireFinishAmmo")
        goto FireFinishNoAmmo

      FireFinishNoAmmo:
        H102 J 1 Offset(5,60)
        H102 J 1 Offset(5,55)
        H102 J 1 Offset(5,50)
        H102 J 1 Offset(5,45)
        H102 J 1 Offset(5,40)
        goto Ready

      FireFinishAmmo:
        H102 A 1 Bright Offset(5,60)
        H102 B 1 Bright Offset(5,55)
        H102 C 1 Bright Offset(5,50)
        H102 A 1 Bright Offset(5,45)
        H102 B 1 Bright Offset(5,40)
        goto Ready
    }
}

// Melee

actor SamsaraHexenQuietusMeleeAttackHandler : Trigger
{
    States
    {
      // Initializing stuff
      Pickup:
        TNT1 A 0 A_TakeInventory("SamsaraHexenQuietusMeleeAmmoTaken")
        goto PickupAmmoCheck

      // Ammo checking stuff
      PickupAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrong")
        TNT1 A 0 A_JumpIfInventory("Clip",7,1)
        goto PickupAttackWeak
        TNT1 A 0 A_JumpIfInventory("Cell",7,"PickupAttackStrong")
        goto PickupAttackWeak

      // Attack stuff
      // Weak
      PickupAttackWeak:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackWeakCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackWeakCoop")
      PickupAttackWeakDM:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(60,100),"FSwordPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(60,100),"FSwordPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(0,0,-1,random(60,10),"FSwordPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(5,5,-1,random(60,100),"FSwordPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(10,10,-1,random(60,100),"FSwordPuff",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        stop

      PickupAttackWeakCoop:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(45,75),"FSwordPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(45,75),"FSwordPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(0,0,-1,random(45,75),"FSwordPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(5,5,-1,random(45,75),"FSwordPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(10,10,-1,random(45,75),"FSwordPuffCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        stop

      // Strong
      PickupAttackStrong:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("FighterSwordFire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttackStrongInfinite")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongCoop")
      PickupAttackStrongDM:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(240,400),"FSwordPuffGlow",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(240,400),"FSwordPuffGlow",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(0,0,-1,random(240,400),"FSwordPuffGlow",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(5,5,-1,random(240,400),"FSwordPuffGlow",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(10,10,-1,random(240,400),"FSwordPuffGlow",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        stop

      PickupAttackStrongCoop:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(240,400),"FSwordPuffGlowCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(240,400),"FSwordPuffGlowCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(0,0,-1,random(240,400),"FSwordPuffGlowCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(5,5,-1,random(240,400),"FSwordPuffGlowCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(10,10,-1,random(240,400),"FSwordPuffGlowCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        stop

      PickupAttackStrongInfinite:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackStrongInfiniteCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackStrongInfiniteCoop")
      PickupAttackStrongInfiniteDM:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(240,400),"FSwordPuffGlowInfinite",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(240,400),"FSwordPuffGlowInfinite",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(0,0,-1,random(240,400),"FSwordPuffGlowInfinite",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(5,5,-1,random(240,400),"FSwordPuffGlowInfinite",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        TNT1 A 0 A_FireBullets(10,10,-1,random(240,400),"FSwordPuffGlowInfinite",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,128)
        stop

      PickupAttackStrongInfiniteCoop:
        TNT1 A 0 A_FireBullets(-10,-10,-1,random(240,400),"FSwordPuffGlowInfiniteCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(-5,-5,-1,random(240,400),"FSwordPuffGlowInfiniteCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(0,0,-1,random(240,400),"FSwordPuffGlowInfiniteCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(5,5,-1,random(240,400),"FSwordPuffGlowInfiniteCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        TNT1 A 0 A_FireBullets(10,10,-1,random(240,400),"FSwordPuffGlowInfiniteCoop",FBF_NORANDOM|FBF_EXPLICITANGLE|FBF_NOFLASH|FBF_NORANDOMPUFFZ,192)
        stop
    }
}

// Weak

actor FSwordPuff : AxePuff
{
    +NOTIMEFREEZE
    +PUFFGETSOWNER
    States
    {
      Spawn:
        FHFX S 0
      XDeath:
      Crash:
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusMeleePuffSpawned",1,AAPTR_TARGET)
        TNT1 A 0 A_ChangeFlag("NOTIMEFREEZE",false)
        goto Super::Spawn
    }
}

actor FSwordPuffCoop : FSwordPuff { +MTHRUSPECIES }

// Strong

actor FSwordPuffGlow : AxePuff
{
    DamageType "HexenQuietusFire"
    RenderStyle "Add"
    Alpha 1
    SeeSound "FighterSwordExplode"
    ActiveSound ""
    AttackSound "FighterSwordExplode"
    Decal "SwordLightning"
    +EXTREMEDEATH
    +NOTIMEFREEZE
    +PUFFGETSOWNER
    States
    {
      Spawn:
        FSFX D 0 Bright Light("SWORDSHOT_X1")
      XDeath:
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuietusMeleeAmmoTaken",1,"Crash",AAPTR_TARGET)
        TNT1 A 0 A_TakeInventory("Clip",7,0,AAPTR_TARGET)
        TNT1 A 0 A_TakeInventory("Cell",7,0,AAPTR_TARGET)
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusMeleeAmmoTaken",1,AAPTR_TARGET)
        goto Crash

      Crash:
        TNT1 A 0 A_GiveInventory("SamsaraHexenQuietusMeleePuffSpawned",1,AAPTR_TARGET)
        FSFX D 4 Bright Light("SWORDSHOT_X1") A_ChangeFlag("NOTIMEFREEZE",false)
        TNT1 A 0 A_Jump(256,1,2,3,4)
        TNT1 AAAA 0 A_SpawnItemEx("FSwordFlame",random(-8,8),random(-8,8),random(-4,4))
        FSFX E 3 Bright Light("SWORDSHOT_X2")
        FSFX F 4 Bright Light("SWORDSHOT_X2")
        FSFX G 3 Bright Light("SWORDSHOT_X2")
        FSFX H 4 Bright Light("SWORDSHOT_X3")
        FSFX I 3 Bright Light("SWORDSHOT_X3")
        FSFX J 4 Bright Light("SWORDSHOT_X4")
        FSFX KL 3 Bright Light("SWORDSHOT_X5")
        FSFX M 3 Bright
        stop
    }
}

actor FSwordPuffGlowCoop : FSwordPuffGlow { +MTHRUSPECIES }

actor FSwordPuffGlowInfinite : FSwordPuffGlow
{
    States
    {
      Spawn:
        FSFX D 0 Bright Light("SWORDSHOT_X1")
      XDeath:
        goto Crash
    }
}

actor FSwordPuffGlowInfiniteCoop : FSwordPuffGlowInfinite { +MTHRUSPECIES }

// Ranged

actor SamsaraHexenQuietusRangedAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraHexenQuietusMeleePuffSpawned",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Clip",14,1)
        stop
        TNT1 A 0 A_JumpIfInventory("Cell",14,1)
        stop
        TNT1 A 0 A_TakeInventory("Clip",14)
        TNT1 A 0 A_TakeInventory("Cell",14)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_PlaySound("FighterSwordFire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3",11.5,false,0,-10)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3",5.625,false,0,-5)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3",0,false)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3",-5.625,false,0,5)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3",-11.5,false,0,10)
        stop

      PickupAttackCoop:
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3Coop",11.5,false,0,-10)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3Coop",5.625,false,0,-5)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3Coop",0,false)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3Coop",-5.625,false,0,5)
        TNT1 A 0 A_FireCustomMissile("FSwordMissile3Coop",-11.5,false,0,10)
        stop
    }
}

actor FSwordMissile3 : FSwordMissile
{
    Damage 24 // was 8
    DamageType "HexenQuietusFire"
    Decal "SwordLightning"
    +BLOODSPLATTER
    +FORCERADIUSDMG
    States
    {
      Spawn:
        FSFX ABC 3 Bright Light("SWORDSHOT")
        loop

      Death:
        FSFX D 4 Bright Light("SWORDSHOT_X1")
        FSFX E 3 Bright Light("SWORDSHOT_X2") A_FSwordFlames
        FSFX F 4 Bright Light("SWORDSHOT_X2") A_Explode(96,192,0) // was 64 damage
        FSFX G 3 Bright Light("SWORDSHOT_X2")
        FSFX H 4 Bright Light("SWORDSHOT_X3")
        FSFX I 3 Bright Light("SWORDSHOT_X3")
        FSFX J 4 Bright Light("SWORDSHOT_X4")
        FSFX KL 3 Bright Light("SWORDSHOT_X5")
        FSFX M 3 Bright
        stop
    }
}

actor FSwordMissile3Coop : FSwordMissile3
{
    Species "Player"
    +THRUSPECIES
}
