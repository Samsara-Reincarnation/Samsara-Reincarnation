{
	States
	{
		Death:
			INS9 A 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlDeath")
			INS9 A 0 A_Scream
			INS9 A 0 A_NoBlocking
			INS9 A 0 A_SpawnItemEx("Q2Insane2DeathAnimation", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER|SXF_TRANSFERSCALE)
			TNT1 A -1
			Stop
		CrawlDeath:
			INS0 J 0 A_Scream
			INS0 J 0 A_NoBlocking
			INS0 J 0 A_SpawnItemEx("Q2Insane2DeathAnimationCrawl", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER|SXF_TRANSFERSCALE)
			TNT1 A -1
			Stop
		Pain.ShrinkerDMG:
			INS8 Q 0
			"####" "#" 0 A_SetUserVar("user_scalex", scalex*65536.0)
			"####" "#" 0 A_SetUserVar("user_scaley", scaley*65536.0)
			"####" "#" 0 A_ChangeFlag("NOPAIN", 1)
