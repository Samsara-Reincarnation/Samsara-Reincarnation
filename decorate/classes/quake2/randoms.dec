Actor Q2InsaneDeathAnimation : SamsaraCorpseActor
{
	Health 50
	Height 40
	Radius 20
	Mass 5000
	BloodType "Q2Blood"
    Tag "Dying Strogg Prisoner"
	+SHOOTABLE
	+VULNERABLE
	+ISMONSTER
	-COUNTKILL
	-SOLID
	+NEVERTARGET
	-FRIENDLY
	States
	{
		Spawn:
			INS9 ABCDEFGHIJKLMNOPQ 4 A_Warp(AAPTR_Master,0,0,0,0,WARPF_INTERPOLATE)
			INS9 Q 0 A_SpawnItemEx("Q2InsaneDeathCorpse",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_NOCHECKPOSITION|SXF_TRANSFERSCALE)
			Stop
		Death:
			TNT1 A 0 A_RemoveMaster
			TNT1 A 0 A_SpawnItemEx("UniversalBloodyHellGoreXDeathEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR|1048576)
			TNT1 A 0 A_ChangeFlag("SOLID",false)
			TNT1 A 0 A_NoBlocking
			TNT1 A 5 A_SpawnItem(Q2GibSpawner)
			TNT1 A -1
			Stop
		Death.Massacre:
			TNT1 A 0 A_RemoveMaster
			TNT1 A 0 A_ChangeFlag("SOLID",false)
			TNT1 A 0 A_NoBlocking
			TNT1 A 5 A_SpawnItem(Q2GibSpawnerMassacre)
			TNT1 A -1
			Stop
	}
}

