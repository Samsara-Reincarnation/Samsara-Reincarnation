Actor Q2Insane : RandomSpawner { DropItem "Q2Insane1" DropItem "Q2Insane2" DropItem "Q2Insane3"}

Actor Q2InsaneDeathmatch
{
	States
	{
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(171,2)
			TNT1 A 1 A_SpawnItemEx("Q2Insane1",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL|SXF_TRANSFERPOINTERS,0,tid)
			Goto Death
			TNT1 A 0 A_Jump(171,2)
			TNT1 A 1 A_SpawnItemEx("Q2Insane2",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL|SXF_TRANSFERPOINTERS,0,tid)
			Goto Death
			TNT1 A 1 A_SpawnItemEx("Q2Insane3",0,0,0,0,0,0,0,SXF_TRANSFERSPECIAL|SXF_TRANSFERPOINTERS,0,tid)
			Goto Death
		Death:
			TNT1 A 0
			Stop
	}
}

Actor Q2InsaneCrawlToken : Inventory { Inventory.MaxAmount 1 }

