Actor Q2Insane1 : SamsaraMiscCharHumanoidStatic
{
	Monster
	Health 100
	Mass 300
	-COUNTKILL
	+FRIENDLY
	+NEVERTARGET
	Speed 1
	Height 56
	Radius 20
	Scale 1.1
	BloodType "Q2Blood"
	DeathSound "Bitterman/Death"
	Painchance 128
	Tag "Strogg Prisoner"
	DropItem "Q2PrisonerDrop"
	States
	{
		Spawn:
		See:
			//TNT1 A 0 A_Jump(128, "StandNormal")
			Goto StandInsane
		StandNormal:
			INS3 HIJKLM 4
			Goto CheckDown
		StandInsane:
			INS3 N 0 A_Jump(128, "WalkInsane")
			INS3 N 0 A_PlaySound("Quake2/Insane/Shake", CHAN_VOICE)
			INS3 NOPQRSTUVWXYZ 4
			INS4 ABCDEFGHIJKLMOP 4
			Goto CheckDown
		CheckDown:
			TNT1 A 0 A_Jump(128, "UpToDown")
			Goto JumpDown
		JumpDown:
			INS4 RSTU 4
			Goto MoveDown
		MoveDown:
			INS4 V 0 A_Jump(128, "Crawl")
			INS4 VWXYZ 4
			INS5 ABCDEFGHIJK 4
			INS5 L 0 A_PlaySoundEx("Quake2/Insane/Fist", CHAN_BODY)
			INS5 LMNOPQRSTUVWXYZ 4
			INS6 ABC 4
			INS6 D 0 A_PlaySoundEx("Quake2/Insane/Moan", CHAN_BODY)
			INS6 DEFGHIJKLMNOPQRSTUVW 4
			INS6 X 0 A_PlaySoundEx("Quake2/Insane/Scream", CHAN_BODY)
			INS6 XYZ 4
			INS7 ABCD 4
			Goto DownToUp
		DownToUp:
			INS2 OPQRSTUVWXYZ 4
			INS3 ABCDEFG 4
			INS3 G 0 A_TakeInventory("Q2InsaneCrawlToken", 1)
			Goto Spawn
		UpToDown:
			INS1 ABCDEFG 4
			INS1 H 0 A_PlaySound("Quake2/Insane/Moan", CHAN_BODY)
			INS1 HIJKLMNOPQRSTUVWXYZ 4
			INS2 A 4
			INS2 B 0 A_PlaySound("Quake2/Insane/Fist", CHAN_BODY)
			INS2 BCDEFG 4
			INS2 H 0 A_PlaySound("Quake2/Insane/Fist", CHAN_BODY)
			INS2 HIJKLMN 4
			INS2 N 0 A_GiveInventory("Q2InsaneCrawlToken", 1)
			Goto MoveDown
		WalkInsane:
			INS7 Q 0 A_PlaySound("Quake2/Insane/Scream", CHAN_BODY)
			INS7 QRSTUVWXYZ 4 A_Wander
			INS8 ABCDEFGHIJKLMNOP 4 A_Wander
			Goto StandInsane+1
		Crawl:
			INS9 R 0 A_PlaySound("Quake2/Insane/Scream", CHAN_BODY)
			INS9 RSTUVWXYZ 4 A_Wander
			Goto MoveDown+1		
		Pain:
			INS8 Q 0 A_JumpIfHealthLower(25, "PainSound25")
			INS8 Q 0 A_JumpIfHealthLower(50, "PainSound50")
			INS8 Q 0 A_JumpIfHealthLower(75, "PainSound75")
			INS8 Q 0 A_JumpIfHealthLower(100, "PainSound100")
			Goto PainSound100
		PainSound100:
			INS8 Q 0 A_PlaySound("Bitterman/Pain100", CHAN_VOICE)
			INS8 Q 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlPain")
			Goto StandPain
		PainSound75:
			INS8 Q 0 A_PlaySound("Bitterman/Pain75", CHAN_VOICE)
			INS8 Q 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlPain")
			Goto StandPain
		PainSound50:
			INS8 Q 0 A_PlaySound("Bitterman/Pain50", CHAN_VOICE)
			INS8 Q 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlPain")
			Goto StandPain
		PainSound25:
			INS8 Q 0 A_PlaySound("Bitterman/Pain25", CHAN_VOICE)
			INS8 Q 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlPain")
			Goto StandPain
		StandPain:
			INS8 QRSTUVWXYZ 4
			Goto WalkInsane
		CrawlPain:
			INS0 ABCDEFGHI 4
			Goto MoveDown
		Death:
			TNT1 A 0 A_SpawnItemEx("UniversalBloodyHellGoreDeathEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR)
		Death.Massacre:
			INS9 A 0 A_JumpIfInventory("Q2InsaneCrawlToken", 1, "CrawlDeath")
			INS9 A 0 A_Scream
			INS9 A 0 A_NoBlocking
			INS9 A 0 A_SpawnItemEx("Q2InsaneDeathAnimation", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER|SXF_TRANSFERSCALE)
			TNT1 A -1
			Stop
		CrawlDeath:
			INS0 J 0 A_Scream
			INS0 J 0 A_NoBlocking
			INS0 J 0 A_SpawnItemEx("Q2InsaneDeathAnimationCrawl", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_SETMASTER|SXF_TRANSFERSCALE)
			TNT1 A -1
			Stop
		XDeathForBitterman:
		XDeath:
			TNT1 A 0 A_SpawnItemEx("UniversalBloodyHellGoreXDeathEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION|SXF_USEBLOODCOLOR|1048576)						
			TNT1 A 0 A_ChangeFlag("SOLID",false)
			TNT1 A 5 A_SpawnItem(Q2GibSpawner)
			TNT1 A -1
			Stop
		XDeath.Massacre:
			TNT1 A 0 A_ChangeFlag("SOLID",false)
			TNT1 A 5 A_SpawnItem(Q2GibSpawnerMassacre)
			TNT1 A -1
			Stop
		Pain.ShrinkerDMG:
			INS8 Q 0
			"####" "#" 0 A_SetUserVar("user_scalex", scalex*65536.0)
			"####" "#" 0 A_SetUserVar("user_scaley", scaley*65536.0)
			"####" "#" 0 A_ChangeFlag("NOPAIN", 1)
			"####" "#" 0 A_ChangeFlag("NODAMAGE", 1)
			"####" "#" 0 A_NoBlocking
			"####" "#" 0 A_PlaySound("duke/shrink")
			"####" "#" 1 A_SetScale(0.95*(user_scalex/65536.0),0.95*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.9*(user_scalex/65536.0),0.9*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.85*(user_scalex/65536.0),0.85*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.8*(user_scalex/65536.0),0.8*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.75*(user_scalex/65536.0),0.75*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.7*(user_scalex/65536.0),0.7*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.65*(user_scalex/65536.0),0.65*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.6*(user_scalex/65536.0),0.6*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.55*(user_scalex/65536.0),0.55*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.5*(user_scalex/65536.0),0.5*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.45*(user_scalex/65536.0),0.45*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.4*(user_scalex/65536.0),0.4*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.35*(user_scalex/65536.0),0.35*(user_scaley/65536.0))
			"####" "#" 1 A_SetScale(0.3*(user_scalex/65536.0),0.3*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_ShrinkEffect",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
			"####" "#" 1 A_SetScale(0.25*(user_scalex/65536.0),0.25*(user_scaley/65536.0))
			"####" "#" 4 A_SetScale(0.2*(user_scalex/65536.0),0.2*(user_scaley/65536.0))
			"####" "#" 0 A_SpawnItemEx("Q2Insane1_Shrink", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_TRANSFERAMBUSHFLAG|SXF_SETMASTER,0,tid)
			TNT1 A 2
			TNT1 A 0 Thing_Remove(0)
			stop
	}
}

actor Q2Insane1_Shrink : Q2Insane1
{
	+FRIGHTENED
	+NOTRIGGER
	-SHOOTABLE
	+THRUACTORS
	+NORADIUSDMG
	+VULNERABLE
	+QUICKTORETALIATE
	+COUNTKILL
	-NOGRAVITY
	+NODAMAGE
	+NOPAIN
	MaxStepHeight 0
	MaxDropOffHeight 0
	MeleeRange 16
	Height 16
	Health 1
	Speed 1
	PainChance "ShrinkDMG", 0
	DamageFactor "ShrinkDMG", 0.0
	PainChance "ExpanderDMG", 0
	DamageFactor "ExpanderDMG", 0.0
	States
	{
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_JumpIfInventory("ShrunkToken",1,"SpawnLoop")
			TNT1 A 0 A_SetUserVar("user_scalex", scalex*65536.0)
			TNT1 A 0 A_SetUserVar("user_scaley", scaley*65536.0)
			TNT1 A 0 A_SetScale(scalex*0.2,scaley*0.2) // setting the scale in ACS does work, but the actor shows up at normal size for a split second
			TNT1 A 0 ACS_NamedExecuteAlways("Samsara_Shrinker", 0, 1)
			INS8 Q 10
			Goto See
		SpawnLoop:
			INS3 HIJKLM 4 A_Look
			Loop
		See:
			"####" "#" 0 A_JumpIfInTargetInventory("ChexClass", 1, 5) // this is supposed to be child friendly
			"####" "#" 0 A_JumpIfInTargetInventory("DukeClass", 1, 3)
			"####" "#" 0 A_JumpIfTargetInSideMeleeRange("Squish")
			"####" "#" 0 A_Jump(256, 2)
			"####" "#" 0 A_JumpIfTargetInSideMeleeRange("DukeStomp")
			INS7 Q 4 A_Wander
