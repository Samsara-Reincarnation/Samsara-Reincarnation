actor SamsaraPowerSlaveWeapon : Weapon
{
    Inventory.PickupSound "PS/Wpickup"
    Inventory.RestrictedTo "PSPlayer"
    Weapon.BobStyle Smooth
    Weapon.BobRangeX 0.75
    Weapon.BobRangeY 0.28
    Weapon.BobSpeed 1.4
    +UNDROPPABLE
    States
    {
      Ready:
        TNT1 A 0 A_TakeInventory("SamsaraPowerSlaveWeapon")
        TNT1 A 1 A_WeaponReady
        loop

      Deselect:
      DeselectInstant:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Lower
        TNT1 A 1 A_Lower
        loop

      Select:
        TNT1 AAAAAAAAAAAAAAAAAAAA 0 A_Raise
        TNT1 A 1 A_Raise
        loop

      Fire:
        TNT1 A 1
        goto Ready
    }
}