actor MCFRFiredS: Counter {}
actor SamsaraMarathonMCFRCanAltReload : Boolean {}
actor SamsaraMarathonMCFRCanAltFire : Boolean {}
actor SamsaraMarathonMCFRAltReloadWaitTime : Counter {}
actor SamsaraMarathonMCFRAltReloadFireLockTime : Counter {}
actor SamsaraMarathonMCFRFireRate : Boolean {}

actor "Mercury Class Fusion Rifle" : SamsaraMarathonWeapon
{
    Inventory.PickupMessage "You picked up a Mercury Class Fusion Rifle!"
    Weapon.SlotNumber 7
    Weapon.SlotPriority 1
    Weapon.SelectionOrder 100
    Weapon.AmmoType1 "MercuryFusionBullet1"
    Weapon.AmmoUse1 1
    Weapon.AmmoType2 "MercuryFusionBullet2"
    Weapon.AmmoUse2 1
    Tag "Mercury Class Fusion Rifle"
    States
    {
      Spawn:
        MCFR C -1
        stop

      Ready:
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRCanAltReload")
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRCanAltFire")
        TNT1 A 0 A_JumpIfInventory("MCFRFiredS",1,4)
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadWaitTime",1,3)
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1,2)
        MCFR A 1 A_WeaponReady
        goto ReadyAmmoCheck
        MCFR A 1 A_WeaponReady(WRF_NOSWITCH)
        goto ReadyAmmoCheck

      ReadyAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,1)
        goto Ready
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"Ready")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",1,"Ready")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"Reload")
        goto Ready

      Deselect:
        TNT1 A 0 A_TakeInventory("MCFRFiredS")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRCanAltReload")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRCanAltFire")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadWaitTime")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadFireLockTime")
        TNT1 A 0 A_JumpIfHealthLower(1,"DeselectInstant")
        MCFR A 1 A_Lower
        loop

      Select:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"SelectReloadAmmoCheck")
      SelectStart:
        TNT1 A 0 A_TakeInventory("UsingFists")
        TNT1 A 0 A_TakeInventory("UsingPistols")
        TNT1 A 0 A_TakeInventory("UsingDualPistols")
        TNT1 A 0 A_TakeInventory("UsingSMG")
        TNT1 A 0 A_TakeInventory("UsingPacifier")
        TNT1 A 0 A_TakeInventory("UsingShotguns")
        TNT1 A 0 A_TakeInventory("UsingDualShotguns")
        //TNT1 A 0 A_TakeInventory("UsingFusionPistol")
        TNT1 A 0 A_TakeInventory("UsingAssaultRifle")
        TNT1 A 0 A_TakeInventory("UsingSpanker")
        TNT1 A 0 A_TakeInventory("UsingToasty")
        TNT1 A 0 A_TakeInventory("UsingWMC")
        TNT1 A 0 A_TakeInventory("UsingAlienWeapon")
        TNT1 A 0 A_TakeInventory("UsingAlienWeapon2")
        TNT1 A 0 A_TakeInventory("UsingMarathonInstagib")

        TNT1 A 0 A_GiveInventory("UsingFusionPistol")
        TNT1 A 0 A_TakeInventory("MCFRFiredS")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRCanAltReload")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRCanAltFire")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadWaitTime")
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadFireLockTime")
        MCFR A 1 A_Raise
        loop

      SelectReloadAmmoCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"SelectStart")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",1,"SelectStart")
      SelectReloadAmmo:
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",0,"SelectStart")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        goto SelectStart
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Cell",1)
        TNT1 A 0 A_GiveInventory("MercuryFusionBullet1")
        TNT1 A 0 A_PlaySound("marathon/mcfr/reload")
        loop

      Fire:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"FireReloadableReloadCheck")
      FireNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"FireInit")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"FireInit")
        goto Ready

      FireReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"FireInit")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",1,"FireInit")
      FireReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"Reload")
        goto Ready

      FireReloadableReloadCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",0,1) // only allowed with modern reloading
        goto FireReloadable
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireReload",1,1) // holding attack + reload?
        goto FireReloadable
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",0,"FireReloadable") // ignore if full on magazine or insufficient reserve
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"Reload")
        TNT1 A 0 A_JumpIfInventory("Cell",1,"Reload")
        goto FireReloadable

      FireInit:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRFireRate",1,2)
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRFireRate")
        goto FireStart
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRFireRate")
        goto FireStart

      FireStart:
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_GunFlash
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRPrimaryAttackHandler")
        TNT1 A 0 A_Light2
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRFireRate",1,"FireContinue2")
      FireContinue1:
        MCFR B 2 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinish

      FireContinue2:
        MCFR B 1 Bright A_WeaponReady(WRF_NOSWITCH|WRF_NOFIRE)
        goto FireFinish

      FireFinish:
        TNT1 A 0 A_Light0
        TNT1 A 0 A_ReFire
        goto Ready

      // AltFire handled in SamsaraMarathonMCFRAltFire trigger

      Reload:
        MCFR A 1 Offset(0,38) A_TakeInventory("SamsaraMarathonMCFRCanAltFire")
        MCFR A 1 Offset(0,44)
        MCFR A 1 Offset(0,50)
        MCFR A 1 Offset(0,56)
        MCFR A 1 Offset(0,62)
        MCFR A 1 Offset(0,68)
        MCFR A 1 Offset(0,74)
        MCFR A 1 Offset(0,80)
        MCFR A 1 Offset(0,86)
        MCFR A 1 Offset(0,92)
        MCFR A 1 Offset(0,98)
        MCFR A 1 Offset(0,104)
        MCFR A 1 Offset(0,110)
        MCFR A 1 Offset(0,116)
        MCFR A 1 Offset(0,122)
        MCFR A 18 Offset(0,128)
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"SelectReloadAmmo")
        goto SelectStart
    }
}

// Alt fire hack (these two triggers are called in ACS)

actor SamsaraMarathonMCFRAltFire : Trigger
{
    States
    {
      // Ready
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRCanAltFire",1,1)
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadWaitTime",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("MCFRFiredS",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,"PickupStart")
        stop

      // Fire
      PickupStart:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupStartReloadable")
      PickupStartNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAltFire")
        TNT1 A 0 A_JumpIfInventory("Cell",4,"PickupAltFire")
        stop

      PickupStartReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAltFire")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet2",1,"PickupAltFire")
      PickupStartReloadableDryCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("Cell",4,"PickupStop")
        stop

      PickupAltFire:
        TNT1 A 0 ACS_NamedExecuteWithResult("SamsaraForcePlayerAttackState", 1)
        TNT1 A 0 A_AlertMonsters
        TNT1 A 0 A_TakeInventory("MCFRFiredS") // reset
        TNT1 A 0 A_GiveInventory("MCFRFiredS",18)
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRSecondaryAttackHandler")
        stop
    }
}

actor SamsaraMarathonMCFRAltReload : Trigger
{
    States
    {
      // Ready
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRCanAltReload",1,1)
        stop
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1,"PickupReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadWaitTime",1,"PickupReload")
        TNT1 A 0 A_JumpIfInventory("MCFRFiredS",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadableReloadCheck")
        stop

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet2",1,"PickupStop")
      PickupReloadableReserveCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupReload")
        TNT1 A 0 A_JumpIfInventory("Cell",4,"PickupReload")
        stop

      PickupReloadableReloadCheck:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",0,1) // only allowed with modern reloading
        goto PickupReloadable
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireRight",1,1) // holding altattack?
        goto PickupReloadable
        TNT1 A 0 A_JumpIfInventory("SamsaraSynthFireReload",1,1) // holding reload as well?
        goto PickupReloadable
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet2",0,"PickupReloadable") // ignore if full on magazine or insufficient reserve
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupReload")
        TNT1 A 0 A_JumpIfInventory("Cell",4,"PickupReload")
        goto PickupReloadable

      // Reload (wait)
      PickupReload:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadWaitTime",1,"PickupReloadWaitTimeDecrement")
      PickupReloadWaitTimeStart:
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRAltReloadWaitTime",30) // tics before ammo giving
        stop

      PickupReloadWaitTimeDecrement:
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadWaitTime",1)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
        goto PickupReloadWaitTimeFinish
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadWaitTime",1)
        goto PickupReloadWaitTimeFinish

      PickupReloadWaitTimeFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadWaitTime",1,"PickupStop")
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadAmmo")
        goto PickupReloadFinish

      // Reload (fire lock)
      PickupReloadFinish:
        TNT1 A 0 A_JumpIfInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1,"PickupReloadFireLockTimeDecrement")
      PickupReloadFireLockTimeStart:
        TNT1 A 0 A_GiveInventory("SamsaraMarathonMCFRAltReloadFireLockTime",31) // tics before being able to alt fire or switch
        stop

      PickupReloadFireLockTimeDecrement:
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasDoubleFiringSpeed",1,1)
        stop
        TNT1 A 0 A_TakeInventory("SamsaraMarathonMCFRAltReloadFireLockTime",1)
        stop

      // Reload (ammo)
      PickupReloadAmmo:
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet2",0,"PickupReloadFinish")
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_JumpIfInventory("Cell",4,1)
        goto PickupReloadFinish
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,2)
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,2)
        TNT1 A 0 A_TakeInventory("Cell",4)
        TNT1 A 0 A_GiveInventory("MercuryFusionBullet2")
        TNT1 A 0 A_PlaySound("marathon/mcfr/reload")
        loop
    }
}

actor SamsaraMarathonMCFRPrimaryAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",1,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",1)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet1",1,1)
        stop
        TNT1 A 0 A_TakeInventory("MercuryFusionBullet1",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("marathon/fusion/fire",CHAN_WEAPON)
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",0,"PickupAttackIgnoreWater")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"PickupAttackDMUnderwater")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShot",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupAttackDMUnderwater:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWater",0,false)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"PickupAttackCoopUnderwater")
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackCoopImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotCoop",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupAttackCoopImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotCoopImproved",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupAttackCoopUnderwater:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackCoopUnderwaterImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWaterCoop",0,false)
        goto PickupFinish

      PickupAttackCoopUnderwaterImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWaterCoopImproved",0,false)
        goto PickupFinish

      // Underwater ignoring attack stuff
      PickupAttackIgnoreWater:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackIgnoreWaterCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackIgnoreWaterCoop")
      PickupAttackIgnoreWaterDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotIgnoreWater",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupAttackIgnoreWaterCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackIgnoreWaterCoopImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotCoopIgnoreWater",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupAttackIgnoreWaterCoopImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotCoopIgnoreWaterImproved",random(-5,5),false,2,6,0,random(-5,5))
        goto PickupFinish

      PickupFinish:
        TNT1 A 0 A_Recoil(0.05)
        stop
    }
}

actor SamsaraMarathonMCFRSecondaryAttackHandler : Trigger
{
    States
    {
      // Ammo checking/taking stuff
      Pickup:
        TNT1 A 0 A_JumpIfInventory("SamsaraReloadMode",2,"PickupReloadable")
      PickupNonReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",1,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("Cell",4,1)
        stop
        TNT1 A 0 A_TakeInventory("Cell",4)
        goto PickupAttack

      PickupReloadable:
        TNT1 A 0 A_JumpIfInventory("SamsaraHasInfiniteAmmo",0,"PickupAttack")
        TNT1 A 0 A_JumpIfInventory("MercuryFusionBullet2",1,1)
        stop
        TNT1 A 0 A_TakeInventory("MercuryFusionBullet2",1)
        goto PickupAttack

      // Attack stuff
      PickupAttack:
        TNT1 A 0 A_PlaySound("marathon/fusion/super",CHAN_6)
        TNT1 A 0 A_JumpIfInventory("SamsaraCanFireWeaponsUnderwater",0,"PickupAttackIgnoreWater")
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackCoop")
      PickupAttackDM:
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"PickupAttackDMUnderwater")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuper",0,false,2,6,0,0)
        goto PickupFinish

      PickupAttackDMUnderwater:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWater2",0,false)
        goto PickupFinish

      PickupAttackCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraCurrentWaterLevel",0,"PickupAttackCoopUnderwater")
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackCoopImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuperCoop",0,false,2,6,0,0)
        goto PickupFinish

      PickupAttackCoopImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuperCoopImproved",0,false,2,6,0,0)
        goto PickupFinish

      PickupAttackCoopUnderwater:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackCoopUnderwaterImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWater2Coop",0,false)
        goto PickupFinish

      PickupAttackCoopUnderwaterImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRShotWater2CoopImproved",0,false)
        goto PickupFinish

      // Underwater ignoring attack stuff
      PickupAttackIgnoreWater:
        TNT1 A 0 A_JumpIfInventory("SPModeOn",1,"PickupAttackIgnoreWaterCoop")
        TNT1 A 0 A_JumpIfInventory("CoopModeOn",1,"PickupAttackIgnoreWaterCoop")
      PickupAttackIgnoreWaterDM:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuperIgnoreWater",0,false,2,6,0,0)
        goto PickupFinish

      PickupAttackIgnoreWaterCoop:
        TNT1 A 0 A_JumpIfInventory("SamsaraImprovedBalance",1,"PickupAttackIgnoreWaterCoopImproved")
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuperCoopIgnoreWater",0,false,2,6,0,0)
        goto PickupFinish

      PickupAttackIgnoreWaterCoopImproved:
        TNT1 A 0 A_FireCustomMissile("SamsaraMarathonMCFRSuperCoopIgnoreWaterImproved",0,false,2,6,0,0)
        goto PickupFinish

      PickupFinish:
        TNT1 A 0 A_Recoil(0.15)
        stop
    }
}

actor MercuryFusionBullet1 : Ammo
{
    Inventory.MaxAmount 100
    Tag "Fusion Rifle Primary Battery"
    +IGNORESKILL
}

actor MercuryFusionBullet2 : Ammo
{
    Inventory.MaxAmount 20
    Tag "Fusion Rifle Secondary Battery"
    +IGNORESKILL
}

actor SamsaraMarathonMCFRShot : SamsaraMarathonFusionShot {}

actor SamsaraMarathonMCFRShotCoop : SamsaraMarathonMCFRShot
{
    Radius 6
    Height 8
    Speed 20
    Species "Player"
    +THRUSPECIES
}

actor SamsaraMarathonMCFRShotCoopImproved : SamsaraMarathonMCFRShotCoop { Damage (random(60,80)) }

actor SamsaraMarathonMCFRShotIgnoreWater : SamsaraMarathonMCFRShot
{
    States
    {
      Spawn:
        MA00 ABC 2 Bright Light("FUSI1")
        loop
    }
}

actor SamsaraMarathonMCFRShotCoopIgnoreWater : SamsaraMarathonMCFRShotCoop
{
    States
    {
      Spawn:
        MA00 ABC 2 Bright Light("FUSI1")
        loop
    }
}

actor SamsaraMarathonMCFRShotCoopIgnoreWaterImproved : SamsaraMarathonMCFRShotCoopImproved
{
    States
    {
      Spawn:
        MA00 ABC 2 Bright Light("FUSI1")
        loop
    }
}

actor SamsaraMarathonMCFRShotWater : SamsaraMarathonFusionShotWater {}

actor SamsaraMarathonMCFRShotWaterCoop : SamsaraMarathonMCFRShotWater
{
    Species "Player"
    +THRUSPECIES
}

actor SamsaraMarathonMCFRShotWaterCoopImproved : SamsaraMarathonMCFRShotWaterCoop
{
    States
    {
      Death:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraDecorate", 47), "DeathFullRadius")
        TNT1 A 0 A_Explode(random(30,40),128,0)
        TNT1 A 1 A_Explode(random(30,40),128)
        stop

      DeathFullRadius:
        TNT1 A 0 A_Explode(random(30,40),128,0,false,128)
        TNT1 A 1 A_Explode(random(30,40),128,XF_HURTSOURCE,false,128)
        stop
    }
}

actor SamsaraMarathonMCFRSuper : SamsaraMarathonFusionSuper {}

actor SamsaraMarathonMCFRSuperCoop : SamsaraMarathonMCFRSuper
{
    Radius 10
    Height 12
    Speed 30
    Species "Player"
    +THRUSPECIES
}

actor SamsaraMarathonMCFRSuperCoopImproved : SamsaraMarathonMCFRSuperCoop { Damage (random(160,200)) }

actor SamsaraMarathonMCFRSuperIgnoreWater : SamsaraMarathonMCFRSuper
{
    States
    {
      Spawn:
        MA02 A 0 Bright Light("CFUS1") NoDelay
        MA02 AAABBBCCC 1 Bright Light("CFUS1") A_SpawnItemEx("SamsaraMarathonFusionTrail")
        loop
    }
}

actor SamsaraMarathonMCFRSuperCoopIgnoreWater : SamsaraMarathonMCFRSuperCoop
{
    States
    {
      Spawn:
        MA02 A 0 Bright Light("CFUS1") NoDelay
        MA02 AAABBBCCC 1 Bright Light("CFUS1") A_SpawnItemEx("SamsaraMarathonFusionTrail")
        loop
    }
}

actor SamsaraMarathonMCFRSuperCoopIgnoreWaterImproved : SamsaraMarathonMCFRSuperCoopImproved
{
    States
    {
      Spawn:
        MA02 A 0 Bright Light("CFUS1") NoDelay
        MA02 AAABBBCCC 1 Bright Light("CFUS1") A_SpawnItemEx("SamsaraMarathonFusionTrail")
        loop
    }
}

actor SamsaraMarathonMCFRShotWater2 : SamsaraMarathonFusionShotWater2 {}

actor SamsaraMarathonMCFRShotWater2Coop : SamsaraMarathonMCFRShotWater2
{
    Species "Player"
    +THRUSPECIES
}

actor SamsaraMarathonMCFRShotWater2CoopImproved : SamsaraMarathonMCFRShotWater2Coop
{
    States
    {
      Death:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraDecorate", 47), "DeathFullRadius")
        TNT1 A 0 A_Explode(random(80,100),128,0)
        TNT1 A 1 A_Explode(random(80,100),128)
        stop

      DeathFullRadius:
        TNT1 A 0 A_Explode(random(80,100),128,0,false,128)
        TNT1 A 1 A_Explode(random(80,100),128,XF_HURTSOURCE,false,128)
        stop
    }
}
