	{
		Pickup:
			TNT1 A 0 ACS_NamedExecuteWithResult("Samsara_Shrinker",2)
			//TNT1 A 0 A_TransferPointer(AAPTR_Master,AAPTR_Default,AAPTR_Master,AAPTR_Master)
			//TNT1 A 0 A_TransferPointer(AAPTR_Master,AAPTR_Default,AAPTR_Master,AAPTR_Master)
			//TNT1 A 0 A_TransferPointer(AAPTR_Master,AAPTR_Default,AAPTR_Master,AAPTR_Master)
