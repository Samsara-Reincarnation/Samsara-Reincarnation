actor SamsaraCatacombRandomGemPickup : Trigger
{
    States
    {
      Pickup:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraDecorate", 75), "PickupInventory")
      PickupPowerup:
        TNT1 A 0 A_Jump(256,"PickupPowerupFireball","PickupPowerupSpread","PickupPowerupFast","PickupPowerupBounce")
      PickupPowerupFireball:
        TNT1 A 0 A_TakeInventory("PowerCatacomb_SpreadShot")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_RapidFire")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_BounceShot")
        TNT1 A 0 A_GiveInventory("Catacomb_FireRing")
        stop

      PickupPowerupSpread:
        TNT1 A 0 A_TakeInventory("PowerCatacomb_FireRing")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_RapidFire")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_BounceShot")
        TNT1 A 0 A_GiveInventory("Catacomb_SpreadShot")
        stop

      PickupPowerupFast:
        TNT1 A 0 A_TakeInventory("PowerCatacomb_FireRing")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_SpreadShot")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_BounceShot")
        TNT1 A 0 A_GiveInventory("Catacomb_RapidFire")
        stop

      PickupPowerupBounce:
        TNT1 A 0 A_TakeInventory("PowerCatacomb_FireRing")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_SpreadShot")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_RapidFire")
        TNT1 A 0 A_GiveInventory("Catacomb_BounceShot")
        stop

      PickupInventory:
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombFireRingInventory",0,1)
        goto PickupInventorySuccess
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombSpreadShotInventory",0,1)
        goto PickupInventorySuccess
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombRapidFireInventory",0,1)
        goto PickupInventorySuccess
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombBounceShotInventory",0,"PickupInventoryFail")
        goto PickupInventorySuccess

      PickupInventorySuccess:
        TNT1 A 0 A_Jump(256,"PickupInventorySuccessFireball","PickupInventorySuccessSpread","PickupInventorySuccessFast","PickupInventorySuccessBounce")
      PickupInventorySuccessFireball:
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombFireRingInventory",0,"PickupInventorySuccess")
        TNT1 A 0 A_GiveInventory("SamsaraCatacombFireRingInventory")
        stop

      PickupInventorySuccessSpread:
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombSpreadShotInventory",0,"PickupInventorySuccess")
        TNT1 A 0 A_GiveInventory("SamsaraCatacombSpreadShotInventory")
        stop

      PickupInventorySuccessFast:
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombRapidFireInventory",0,"PickupInventorySuccess")
        TNT1 A 0 A_GiveInventory("SamsaraCatacombRapidFireInventory")
        stop

      PickupInventorySuccessBounce:
        TNT1 A 0 A_JumpIfInventory("SamsaraCatacombBounceShotInventory",0,"PickupInventorySuccess")
        TNT1 A 0 A_GiveInventory("SamsaraCatacombBounceShotInventory")
        stop

      PickupInventoryFail:
        TNT1 A 0
        fail
    }
}

actor SamsaraCatacombFireRingInventory : CustomInventory
{
    Inventory.UseSound ""
    Inventory.Icon "CTAAP0"
    Inventory.MaxAmount 3
    Inventory.InterHubAmount 3
    Inventory.RestrictedTo "PettonEverhail"
    Tag "Ring of Fire"
    +INVBAR
    +UNDROPPABLE
    States
    {
      Use:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraPowerupTimerActiveChecker", 22, 0), "UseFail")
        TNT1 A 0 A_PlaySound("Catacomb/GemGet",CHAN_ITEM)
        TNT1 A 0 A_TakeInventory("PowerCatacomb_SpreadShot")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_RapidFire")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_BounceShot")
        TNT1 A 0 A_GiveInventory("Catacomb_FireRing")
        stop

      UseFail:
        TNT1 A 0 ACS_NamedExecuteAlways("SamsaraClientDecorate", 0, 20)
        fail
    }
}

actor SamsaraCatacombSpreadShotInventory : SamsaraCatacombFireRingInventory
{
    Inventory.Icon "CTAAQ0"
    Tag "Ring of Earth"
    States
    {
      Use:
        TNT1 A 0 A_JumpIf(CallACS("SamsaraPowerupTimerActiveChecker", 22, 1), "UseFail")
        TNT1 A 0 A_PlaySound("Catacomb/GemGet",CHAN_ITEM)
        TNT1 A 0 A_TakeInventory("PowerCatacomb_FireRing")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_RapidFire")
        TNT1 A 0 A_TakeInventory("PowerCatacomb_BounceShot")
        TNT1 A 0 A_GiveInventory("Catacomb_SpreadShot")
        stop
    }
}

